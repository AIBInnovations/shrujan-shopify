<!doctype html>
<html lang="en"{% if template.name == 'index' %} class="sj-pre"{% endif %}>
  <head>
    <meta charset="UTF-8">
    {%- if template.name == 'index' %}
    {%- comment -%} The loader once a visit: a reload or a return to the home page opens straight onto the hero (assets/sj-home.js reads the class). {%- endcomment %}
    <script>(function(){var h=document.documentElement;try{if(sessionStorage.getItem('sj-seen')){h.classList.add('sj-skip');h.classList.remove('sj-pre');}else{sessionStorage.setItem('sj-seen','1');}}catch(e){}})();</script>
    {%- endif %}
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 64 64'%3E%3Cpath d='M32 6 L44 32 L32 58 L20 32 Z' fill='%23B05C3B'/%3E%3Cpath d='M32 20 L38 32 L32 44 L26 32 Z' fill='%23F5F1E6'/%3E%3C/svg%3E">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- comment -%}
      Per-page title and description, so a product, article or collection is not
      published under one shared title. The home page keeps the designed wording.
    {%- endcomment -%}
    {%- capture meta_desc -%}
      {%- if page_description != blank -%}{{ page_description | escape }}
      {%- else -%}Shrujan, consciously crafted since 1969: clothing, textiles and objects embroidered by hand by the craftswomen of Kutch.
      {%- endif -%}
    {%- endcapture -%}
    <meta name="description" content="{{ meta_desc | strip }}">
    <title>
      {%- if request.page_type == 'index' -%}
        Shrujan – Consciously Crafted since 1969
      {%- else -%}
        {{ page_title }}{% if current_tags %} — {{ current_tags | join: ', ' }}{% endif %}
        {%- if current_page != 1 %} — page {{ current_page }}{% endif %} — SHRUJAN
      {%- endif -%}
    </title>
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    {%- comment -%} the pairing chosen in Theme settings → Typography {%- endcomment -%}
    {%- comment -%}
      Heritage, the default: Marcellus, flared Roman letters in the manner of
      carved inscriptions, for every serif line, headlines included
      (--font-display); it has one weight, so a heading that asks for 500 or
      600 stays regular and the browser is told not to fake a bold
      (font_synthesis_off; it may still fake the small capitals the stat
      labels use). Hind, from the Indian Type Foundry, for everything in sans.
      Calligraphic: Sahitya, drawn alongside Devanagari, with Hind.
      Poster: Rozha One, the Indian Type Foundry's high-contrast display face,
      for headlines, with Eczar and Hind; heavier.
      Original is the pairing the site was first designed with.
      Brand, the default, follows Shrujan's brand language: Baskerville
      throughout, in Google's two Baskerville cuts (Baskervville for headlines,
      Libre Baskerville, drawn for the screen, for the text) until licensed
      webfonts of the brand's Baskerville Serial are added to the theme.
    {%- endcomment -%}
    {%- assign font_synthesis_off = false -%}
    {%- assign font_display = '' -%}
    {%- case settings.font_pairing -%}
      {%- when 'heritage' -%}
        {%- assign font_families = 'family=Marcellus&family=Hind:wght@300;400;500;600' -%}
        {%- assign font_serif = "'Marcellus', 'Optima', Georgia, serif" -%}
        {%- assign font_sans = "'Hind', 'Segoe UI', system-ui, sans-serif" -%}
        {%- assign font_synthesis_off = true -%}
      {%- when 'original' -%}
        {%- assign font_families = 'family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Jost:wght@300;400;500;600' -%}
        {%- assign font_serif = "'Cormorant Garamond', 'Times New Roman', Georgia, serif" -%}
        {%- assign font_sans = "'Jost', 'Futura', 'Avenir Next', system-ui, sans-serif" -%}
      {%- when 'classic' -%}
        {%- assign font_families = 'family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@300;400;500;600' -%}
        {%- assign font_serif = "'Playfair Display', Georgia, serif" -%}
        {%- assign font_sans = "'Inter', system-ui, sans-serif" -%}
      {%- when 'modern' -%}
        {%- assign font_families = 'family=Fraunces:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Work+Sans:wght@300;400;500;600' -%}
        {%- assign font_serif = "'Fraunces', Georgia, serif" -%}
        {%- assign font_sans = "'Work Sans', system-ui, sans-serif" -%}
      {%- when 'poster' -%}
        {%- assign font_families = 'family=Rozha+One&family=Eczar:wght@400;500&family=Hind:wght@300;400;500;600' -%}
        {%- assign font_display = "'Rozha One', 'Bodoni 72', Georgia, serif" -%}
        {%- assign font_serif = "'Eczar', 'Iowan Old Style', Georgia, serif" -%}
        {%- assign font_sans = "'Hind', 'Segoe UI', system-ui, sans-serif" -%}
        {%- assign font_synthesis_off = true -%}
      {%- when 'calligraphic' -%}
        {%- assign font_families = 'family=Sahitya:wght@400&family=Hind:wght@300;400;500;600' -%}
        {%- assign font_serif = "'Sahitya', 'Iowan Old Style', Georgia, serif" -%}
        {%- assign font_sans = "'Hind', 'Segoe UI', system-ui, sans-serif" -%}
        {%- assign font_synthesis_off = true -%}
      {%- else -%}
        {%- assign font_families = 'family=Baskervville:ital,wght@0,400..700;1,400..700&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400' -%}
        {%- assign font_display = "'Baskervville', 'Baskerville', 'Libre Baskerville', Georgia, serif" -%}
        {%- assign font_serif = "'Baskervville', 'Baskerville', 'Libre Baskerville', Georgia, serif" -%}
        {%- assign font_sans = "'Libre Baskerville', 'Baskerville', Georgia, serif" -%}
    {%- endcase -%}
    {%- if font_display == blank -%}{%- assign font_display = font_serif -%}{%- endif -%}
    <link href="https://fonts.googleapis.com/css2?{{ font_families }}&display=swap" rel="stylesheet">
    {%- comment -%} the interface icons: Google's Material Symbols, cut down to the ones the site uses (awwwards-preview/icons.py writes the list and the glyph rules in sj-site.css) {%- endcomment %}
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@24,400,0,0&amp;icon_names=add,apparel,arrow_back,arrow_downward,arrow_forward,auto_awesome,calendar_month,call,chat,check,check_circle,chevron_left,chevron_right,close,content_cut,description,design_services,eco,expand_less,expand_more,favorite,forum,front_hand,globe_asia,grid_view,handshake,history,home,info,local_shipping,location_on,mail,map,menu,menu_book,package_2,pause,person,play_arrow,redeem,remove,search,sell,send,shopping_bag,soap,star,storefront,straighten,support_agent,sync,verified,videocam&amp;display=block">
    <link rel="stylesheet" href="{{ 'shrujan-global.css' | asset_url }}">
    <link rel="stylesheet" href="{{ 'shrujan-pages.css' | asset_url }}">
    {%- comment -%} commerce pages (collection, cart, search, blog, account) {%- endcomment -%}
    <link rel="stylesheet" href="{{ 'shrujan-store.css' | asset_url }}">
    {% comment %} Section/section-group wrapper divs must not affect layout —
        the stylesheets were written for the unwrapped React DOM. {% endcomment %}
    <style>.shopify-section{display:contents}</style>

    {%- comment -%}
      Theme settings → the design tokens the stylesheets already run on, so the
      customizer changes the real system rather than layering overrides. Emitted
      after the stylesheets, and every default equals the packaged value.
    {%- endcomment -%}
    {%- liquid
      case settings.motion_easing
        when 'soft'
          assign ease = 'cubic-bezier(0.16, 1, 0.3, 1)'
        when 'linear'
          assign ease = 'linear'
        else
          assign ease = 'cubic-bezier(0.4, 0, 0.2, 1)'
      endcase
      assign speed = settings.motion_speed | default: 100 | divided_by: 100.0
      assign gutter_f = settings.gutter_scale | default: 100 | divided_by: 100.0
      assign gap_f = settings.section_gap_scale | default: 100 | divided_by: 100.0
    -%}
    <style>
      :root {
        --ivory: {{ settings.color_ivory }};
        --ivory-2: {{ settings.color_ivory_2 }};
        --sand: {{ settings.color_sand }};
        --cream: {{ settings.color_cream }};
        --ink: {{ settings.color_ink }};
        --ink-soft: {{ settings.color_ink_soft }};
        --ink-deep: {{ settings.color_ink_deep }};
        --maroon: {{ settings.color_maroon }};
        --maroon-deep: {{ settings.color_maroon_deep }};
        --tan: {{ settings.color_tan }};
        --gerua: {{ settings.color_gerua }};
        --gerua-600: {{ settings.color_gerua_600 }};
        --gerua-300: {{ settings.color_gerua_300 }};
        --gold: {{ settings.color_gold }};
        --hairline: {{ settings.color_ink | color_modify: 'alpha', 0.16 }};
        --hairline-strong: {{ settings.color_ink | color_modify: 'alpha', 0.4 }};
        --cream-dim: {{ settings.color_cream | color_modify: 'alpha', 0.72 }};

        --font-serif: {{ font_serif }};
        --font-sans: {{ font_sans }};
        --font-display: {{ font_display }};

        --page-max: {{ settings.page_max }}px;
        --header-max: {{ settings.header_max }}px;
        --gutter: calc(clamp(22px, 4vw, 60px) * {{ gutter_f }});
        --section-gap: calc(clamp(56px, calc(36px + 5.2vw), 168px) * {{ gap_f }});
        --radius: {{ settings.radius }}px;
        --radius-pill: {{ settings.radius_pill }}px;

        --ease: {{ ease }};
        --dur-quick: {{ 0.25 | times: speed }}s;
        --dur: {{ 0.55 | times: speed }}s;
        --dur-slow: {{ 0.9 | times: speed }}s;
      }
      /* A phone's own section gap: the shared clamp bottoms out at 56px, which on
         a 390px screen is a seventh of its width between every two sections.
         And a phone's two side margins: --edge, the 5px inset the hero film and
         the marquee sit on, which every card, picture and panel down the page
         shares; and --gutter, the reading margin text keeps from the screen's
         edge. See the phone block in shrujan-store.css. */
      @media (max-width: 720px) {
        :root {
          --section-gap: calc(clamp(40px, 11vw, 52px) * {{ gap_f }});
          --gutter: calc(16px * {{ gutter_f }});
          --edge: 5px;
        }
      }
      {%- if font_synthesis_off %}
      html { font-synthesis: style small-caps; }
      {%- endif -%}
      {%- if settings.type_scale != 100 -%}
        {%- assign ts = settings.type_scale | divided_by: 100.0 -%}
        body { font-size: calc(1rem * {{ ts }}); }
        h1, h2, h3, h4, .page-hero__title, .hero__title { font-size: calc(1em * {{ ts }}); }
      {%- endif -%}
      {%- if settings.custom_css != blank -%}
        {{ settings.custom_css }}
      {%- endif -%}
    </style>
    <script>
      window.SHRUJAN_MOTION = {
        animate: {{ settings.animations_enabled | default: true | json }},
        smooth: {{ settings.smooth_scroll | default: true | json }},
        speed: {{ speed }}
      };
    </script>
    <script>window.SHRUJAN_ASSET_BASE = "{{ 'shrujan-core.js' | asset_url | split: 'shrujan-core.js' | first }}";</script>
    <script src="{{ 'gsap.min.js' | asset_url }}"></script>
    <script src="{{ 'ScrollTrigger.min.js' | asset_url }}"></script>
    <script src="{{ 'lenis.min.js' | asset_url }}"></script>
    <script src="{{ 'shrujan-catalogue.js' | asset_url }}"></script>
    <script src="{{ 'shrujan-core.js' | asset_url }}"></script>
    {%- if template.name == 'index' %}
    {%- comment -%}
      The home page's own layer (awwwards-preview/export_theme.py writes its
      files): its stylesheet, last in the head so it wins over the theme's.
      The html classes above hold the page behind the loader until sj-home.js
      lets it go.
    {%- endcomment %}
    {%- comment -%} If sj-home.js never lets the page go (blocked, failed), it lets itself go after 14 seconds (the loader's own limit is 9); without JavaScript there is no loader at all. {%- endcomment %}
    <script>setTimeout(function(){if(window.__sjRevealed)return;var h=document.documentElement;h.classList.remove('sj-pre');var l=document.querySelector('.sj-loader');if(l)l.remove();if(window.Shrujan&&window.Shrujan.startScroll)window.Shrujan.startScroll();window.__sjRevealed=true;document.dispatchEvent(new CustomEvent('sj:revealed'));},14000);</script>
    <noscript><style>.sj-loader{display:none!important}html.sj-pre,html.sj-pre body{overflow:visible!important}html.sj-pre .dh__content,html.sj-pre .dh__strip,html.sj-pre .site-header,html.sj-pre .offer-bar{opacity:1!important}</style></noscript>
    {%- endif %}
    {{ content_for_header }}
    {%- comment -%} the site's colours and beige ground, on every page (awwwards-preview/src/site.css) {%- endcomment %}
    <link rel="stylesheet" href="{{ 'sj-site.css' | asset_url }}">
    {%- comment -%} the search overlay, the helpdesk and the Enquire tab, on every page (awwwards-preview/src/ui.css, ui.js) {%- endcomment %}
    <link rel="stylesheet" href="{{ 'sj-ui.css' | asset_url }}">
    {%- comment -%} the bag drawer, on every page (snippets/sj-cart-drawer, hand-written) {%- endcomment %}
    <link rel="stylesheet" href="{{ 'sj-cart.css' | asset_url }}">
    {%- if template.name == 'index' %}
    <link rel="stylesheet" href="{{ 'sj-home.css' | asset_url }}">
    {%- endif %}
  </head>
  <body>
    {%- if template.name == 'index' %}{% render 'sj-loader' %}{% endif %}
    <div id="root">
      {% sections 'header-group' %}
      {%- capture is_find_us_page -%}{%- render 'is-find-us-page' -%}{%- endcapture -%}
      <main>
        {%- if is_find_us_page == 'true' -%}
          {% section 'page-find-us' %}
          {% section 'find-us-connect' %}
        {%- else -%}
          {{ content_for_layout }}
        {%- endif -%}
      </main>
      {% sections 'footer-group' %}
    </div>
    {% render 'sj-cart-drawer' %}
    {%- comment -%} enquiries also go to Slide (Theme settings → Slide) {%- endcomment -%}
    <script>window.SJ_UI = Object.assign(window.SJ_UI || {}, { slideWebhook: {{ settings.slide_webhook | default: '' | json }} });</script>
    <script src="{{ 'sj-ui.js' | asset_url }}" defer></script>
    <script src="{{ 'sj-cart.js' | asset_url }}" defer></script>
    {%- if template.name == 'index' %}
    <script src="{{ 'sj-home.js' | asset_url }}"></script>
    <script type="module" src="{{ 'sj-craft3d.js' | asset_url }}"></script>
    {%- endif %}
  </body>
</html>
