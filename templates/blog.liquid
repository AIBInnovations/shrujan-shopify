<section class="container" style="padding: 120px 0; min-height: 40vh;">
  <p class="eyebrow">Journal</p>
  <h1 class="page-hero__title">{{ blog.title }}</h1>
  <ul style="margin-top: 32px;">
    {% for article in blog.articles %}
      <li style="margin: 10px 0;"><a href="{{ article.url }}">{{ article.title }}</a></li>
    {% endfor %}
  </ul>
</section>
