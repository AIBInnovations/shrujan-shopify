<section class="container" style="padding: 120px 0; min-height: 40vh;">
  <p class="eyebrow">Search</p>
  <h1 class="page-hero__title">Search</h1>
  <form action="/search" method="get" role="search" class="fletters__form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search the catalogue" aria-label="Search">
    <button type="submit">Search</button>
  </form>
  {% if search.performed %}
    <ul style="margin-top: 32px;">
      {% for item in search.results %}
        <li style="margin: 10px 0;"><a href="{{ item.url }}">{{ item.title }}</a></li>
      {% endfor %}
    </ul>
  {% endif %}
</section>
