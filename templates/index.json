    "home-faq": {
      "type": "home-faq",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "question": "Are your pieces handcrafted?",
            "answer": "Yes. Every piece is embroidered, printed, woven or shaped by hand by the craftswomen and artisans of Kutch, across sixty-six villages."
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "question": "How do I choose my size?",
            "answer": "Each product page lists its measurements. If you are unsure, write to us on WhatsApp at +91 9099 974319 before you order."
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "question": "How long will my order take to reach me?",
            "answer": "Orders ship from our warehouse at Bhujodi, Kutch, and delivery times are shown on each product page. Shipping is free on every order within India."
          }
        },
        "b4": {
          "type": "item",
          "settings": {
            "question": "Do you offer international shipping?",
            "answer": "Yes. Shipping charges for international orders are shared with you by our delivery partners. International orders are not eligible for return or exchange."
          }
        },
        "b5": {
          "type": "item",
          "settings": {
            "question": "What is your return & exchange policy?",
            "answer": "Orders within India can be exchanged within 7 days of delivery for a credit note, valid for 90 days. Sale items are not eligible. Write to contact@shrujan.com or call +91 90999 74319, Monday to Saturday, 9.30 AM to 5.30 PM."
          }
        }
      },
      "block_order": [
        "b1",
        "b2",
        "b3",
        "b4",
        "b5"
      ]
    },
