    "home-faq": {
      "type": "home-faq",
      "blocks": {
        "b1": {
          "type": "item",
          "settings": {
            "question": "Are your pieces handcrafted?",
            "answer": "Yes. Every garment is embroidered by artisan women across forty villages of Kutch. No machine embroidery, ever. Each piece carries the name of the hands that made it."
          }
        },
        "b2": {
          "type": "item",
          "settings": {
            "question": "What size options are available?",
            "answer": "Our pieces come in XS to XXL, and every silhouette is cut to drape generously. Made-to-measure is available on request for saris, lehengas and bridal commissions."
          }
        },
        "b3": {
          "type": "item",
          "settings": {
            "question": "How long will my order take to reach me?",
            "answer": "Ready pieces ship from Bhuj within 48 hours and arrive in 3–6 days across India. Made-to-order embroidery takes 2–3 weeks. Good things, stitched slowly."
          }
        },
        "b4": {
          "type": "item",
          "settings": {
            "question": "Do you offer international shipping?",
            "answer": "We ship worldwide. International orders arrive in 8–14 days, fully tracked, with duties settled at checkout so there are no surprises."
          }
        },
        "b5": {
          "type": "item",
          "settings": {
            "question": "What is your return & exchange policy?",
            "answer": "Easy returns and exchanges within 14 days for unworn pieces with tags intact. Hand-embroidered commissions and altered garments are made to order and non-returnable."
          }
        }
      },
