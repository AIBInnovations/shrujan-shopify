{%- render 'section-design', section: section -%}
{%- comment -%}
  Region + grid controls. Every default reproduces the built page. The steps grid
  is two across and stacks below 900px, so the column override is confined to the
  band the built rule owns rather than flattening the stack on phones.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign root_sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. The stages grid stacks at 900px and the studio photograph strip
    at 600px, which is also where the stylesheet reshapes those photographs from
    4:3 to 16:10 — so a phone shape belongs in that same 600px tier.
  endcomment
  assign av_style = false
  if cfg.step_cols != 2 or cfg.step_cols_m != 1
    assign av_style = true
  endif
  if cfg.origin_cols_m != 1 or cfg.shot_ratio_m != 'default'
    assign av_style = true
  endif
-%}
{%- if av_style -%}
  <style>
    {%- if cfg.step_cols != 2 -%}
      {{ root_sel }} { --step-cols: {{ cfg.step_cols }}; }
      @media (min-width: 901px) {
        {{ root_sel }} .steps { grid-template-columns: repeat(var(--step-cols), minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.step_cols_m != 1 -%}
      @media (max-width: 900px) {
        {{ root_sel }} .steps { grid-template-columns: repeat({{ cfg.step_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.origin_cols_m != 1 or cfg.shot_ratio_m != 'default' -%}
      @media (max-width: 600px) {
        {%- if cfg.origin_cols_m != 1 -%}
          {{ root_sel }} .origin__gallery { grid-template-columns: repeat({{ cfg.origin_cols_m }}, minmax(0, 1fr)); }
        {%- endif -%}
        {%- if cfg.shot_ratio_m != 'default' -%}
          {{ root_sel }} .origin__shot { aspect-ratio: {{ cfg.shot_ratio_m }}; }
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
{%- assign strand_blocks = section.blocks | where: 'type', 'strand' -%}
{%- assign meta_blocks = section.blocks | where: 'type', 'meta' -%}
{%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
{%- assign shot_blocks = section.blocks | where: 'type', 'shot' -%}
<div class="page">
  <header class="page-hero page-hero--ghost" data-reveal>
    <span class="page-hero__ghost" aria-hidden="true">{{ section.settings.hero_ghost }}</span>

    <div class="container page-hero__grid">
      <div class="page-hero__text">
        <p class="eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <h1 class="page-hero__title">{{ section.settings.hero_title }}</h1>
        <p class="page-hero__lede">{{ section.settings.hero_lede }}</p>
{%- if section.settings.show_meta %}
        <ul class="page-meta">
{%- for block in meta_blocks %}
          <li {{ block.shopify_attributes }}><span class="page-meta__value">{{ block.settings.value }}</span><span class="page-meta__label">{{ block.settings.label }}</span></li>
{%- endfor %}
        </ul>
{%- endif %}
      </div>
    </div>
  </header>
{%- if section.settings.show_strands %}

  <nav class="strands" aria-label="Studio Collection">
    <div class="container strands__inner">
      <ol class="strands__list">
{%- for block in strand_blocks %}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '/pages/studio-avinya' }}" class="strands__link{% if block.settings.current %} is-active{% endif %}"{% if block.settings.current %} aria-current="page"{% endif %}>
            <span class="strands__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="strands__label">{{ block.settings.label | escape }}</span>
          </a>
        </li>
{%- endfor %}
      </ol>
    </div>
  </nav>
{%- endif %}
{%- if section.settings.show_gloss or section.settings.show_origin %}

  <section class="section container">
{%- if section.settings.show_gloss %}
    <figure class="gloss" data-reveal>
      <figcaption class="gloss__head">
        <span class="gloss__word">{{ section.settings.gloss_word }}</span>
        <span class="gloss__lang">{{ section.settings.gloss_lang }}</span>
      </figcaption>
      <p class="gloss__meaning">{{ section.settings.gloss_meaning }}</p>
      <p class="gloss__note">{{ section.settings.gloss_note }}</p>
    </figure>
{%- endif %}
{%- if section.settings.show_origin %}

    <div class="origin" data-reveal>
      <p class="origin__lead">{{ section.settings.lead }}</p>
      <div class="origin__body">
        {{ section.settings.body }}
      </div>
    </div>
{%- endif %}
  </section>
{%- endif %}
{%- if section.settings.show_steps or section.settings.show_pull %}

  <section class="section container">
{%- if section.settings.show_steps %}
    <div class="section-intro" data-reveal>
      <p class="eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
      <h2 class="section-title">{{ section.settings.steps_title }}</h2>
    </div>

    <ol class="steps" data-reveal-child>
{%- for block in step_blocks %}
      <li class="step" {{ block.shopify_attributes }}>
        <span class="step__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <div class="step__body">
          <h3 class="step__title">{{ block.settings.title }}</h3>
          <p class="step__copy">{{ block.settings.copy }}</p>
        </div>
      </li>
{%- endfor %}
    </ol>
{%- endif %}
{%- if section.settings.show_pull %}

    <blockquote class="origin__pull" data-reveal>{{ section.settings.pull }}</blockquote>
{%- endif %}
  </section>
{%- endif %}
{%- if section.settings.show_gallery %}

  <section class="section container">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">{{ section.settings.studio_eyebrow | escape }}</p>
      <h2 class="section-title">{{ section.settings.studio_title }}</h2>
    </div>

    <div class="origin__gallery" data-reveal-child>
{%- for block in shot_blocks %}
      <figure class="origin__shot" {{ block.shopify_attributes }}>
        <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
      </figure>
{%- endfor %}
    </div>
  </section>
{%- endif %}
{%- if section.settings.show_enquiry %}

  <section class="section container enquiry" id="avinya-enquiry" data-done-title="{{ section.settings.done_title | escape }}" data-done-body="{{ section.settings.done_body | escape }}" data-done-again="{{ section.settings.done_again | escape }}">
    <div class="enquiry__intro" data-reveal>
      <p class="eyebrow">{{ section.settings.enq_eyebrow | escape }}</p>
      <h2 class="section-title">{{ section.settings.enq_title }}</h2>
      <p class="enquiry__copy">{{ section.settings.enq_copy }}</p>

      <dl class="enquiry__reach">
        <div>
          <dt>{{ section.settings.call_label }}</dt>
          <dd>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          </dd>
        </div>
        <div>
          <dt>{{ section.settings.write_label }}</dt>
          <dd>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </dd>
        </div>
        <div>
          <dt>{{ section.settings.hours_label }}</dt>
          <dd>{{ section.settings.hours }}</dd>
        </div>
      </dl>
    </div>

    <form class="enquiry__form" data-reveal>
      <p class="field">
        <label for="avinya-enquiry-name">Name <span aria-hidden="true">*</span></label>
        <input id="avinya-enquiry-name" name="name" type="text" required autocomplete="name">
      </p>

      <p class="field">
        <label for="avinya-enquiry-phone">Contact number <span aria-hidden="true">*</span></label>
        <input id="avinya-enquiry-phone" name="phone" type="tel" required autocomplete="tel">
      </p>

      <p class="field">
        <label for="avinya-enquiry-city">City</label>
        <input id="avinya-enquiry-city" name="city" type="text" autocomplete="address-level2">
      </p>

      <p class="field">
        <label for="avinya-enquiry-email">Email</label>
        <input id="avinya-enquiry-email" name="email" type="email" autocomplete="email">
      </p>

      <p class="field field--wide">
        <label for="avinya-enquiry-looking">What are you looking for?</label>
        <textarea id="avinya-enquiry-looking" name="looking" rows="3"></textarea>
      </p>

      <p class="field">
        <label for="avinya-enquiry-slot">Preferred time slot</label>
        <select id="avinya-enquiry-slot" name="slot">
          <option value="" disabled selected>Choose a time</option>
          <option value="9:00 AM">9:00 AM</option>
          <option value="9:30 AM">9:30 AM</option>
          <option value="10:00 AM">10:00 AM</option>
          <option value="10:30 AM">10:30 AM</option>
          <option value="11:00 AM">11:00 AM</option>
          <option value="11:30 AM">11:30 AM</option>
          <option value="12:00 PM">12:00 PM</option>
          <option value="12:30 PM">12:30 PM</option>
          <option value="1:00 PM">1:00 PM</option>
          <option value="1:30 PM">1:30 PM</option>
          <option value="2:00 PM">2:00 PM</option>
          <option value="2:30 PM">2:30 PM</option>
          <option value="3:00 PM">3:00 PM</option>
          <option value="3:30 PM">3:30 PM</option>
          <option value="4:00 PM">4:00 PM</option>
          <option value="4:30 PM">4:30 PM</option>
          <option value="5:00 PM">5:00 PM</option>
          <option value="5:30 PM">5:30 PM</option>
        </select>
      </p>

      <div class="enquiry__submit">
        <button class="btn" type="submit">{{ section.settings.submit_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></button>
        <span class="enquiry__note"><span aria-hidden="true">*</span> {{ section.settings.note }}</span>
      </div>
    </form>
  </section>
{%- endif %}
</div>

<script>
(function () {
  var root = document.getElementById('avinya-enquiry');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var form = root.querySelector('.enquiry__form');
  if (!form) return;

  var arrow = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>';

  var done = document.createElement('div');
  done.className = 'enquiry__done';
  done.setAttribute('role', 'status');
  done.setAttribute('data-reveal', '');
  done.innerHTML =
    '<p class="enquiry__done-title">' + (root.getAttribute('data-done-title') || 'Thank you — we have your request.') + '</p>' +
    '<p>' + (root.getAttribute('data-done-body') || 'Someone from the Bhuj studio will call you in your chosen slot. If it is urgent, reach us on <a href="tel:+919099974319">+91 9099 974319</a>.') + '</p>' +
    '<button class="arrow-link" type="button">' + (root.getAttribute('data-done-again') || 'Send another enquiry') + ' ' + arrow + '</button>';

  done.querySelector('button').addEventListener('click', function () {
    form.reset();
    done.replaceWith(form);
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    form.replaceWith(done);
  });
})();
</script>
