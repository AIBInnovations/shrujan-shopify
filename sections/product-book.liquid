{%- render 'section-design', section: section -%}
{{ 'sj-pdp.css' | asset_url | stylesheet_tag }}
<script src="{{ 'sj-pdp.js' | asset_url }}" defer></script>
{%- comment -%}
  Book a call: the shopper chooses a video call, a phone call or a visit,
  then a day (the next two weeks, Sundays off) and a time inside the
  studio's hours, leaves a name and a number, and sends it. It goes to the
  store as a Shopify contact form, so it needs no app; the store confirms
  on WhatsApp or by email. The same choice can be sent on WhatsApp instead.
  With a booking page set (Calendly, Cal.com), a link to it shows as well.
  The calendar (a month at a time, the open days within reach) and the
  times, grouped by part of the day, are drawn by assets/sj-pdp.js; without
  scripts the form still sends, with a free-text time.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign p_title = ''
  if product
    assign p_title = product.title
  endif
-%}
<section class="pdpx pdpx-book" id="book" aria-labelledby="book-title-{{ section.id }}">
  <div class="pdpx-book__grid">
    <div class="pdpx-book__intro">
      {%- if s.eyebrow != blank %}<p class="pdpx__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
      <h2 class="pdpx__title" id="book-title-{{ section.id }}"><span>{{ s.title_1 | escape }}</span>{% if s.title_2 != blank %}<span class="pdpx__soft">{{ s.title_2 | escape }}</span>{% endif %}</h2>
      {%- if s.lede != blank %}<p class="pdpx__lede">{{ s.lede | escape }}</p>{% endif -%}
      <ul class="pdpx-book__points">
        {%- for n in (1..3) -%}
          {%- assign pk = 'point_' | append: n -%}
          {%- if s[pk] != blank %}<li>{{ s[pk] | escape }}</li>{% endif -%}
        {%- endfor -%}
      </ul>
      {%- if s.hours != blank %}<p class="pdpx-book__hours">{{ s.hours | escape }}</p>{% endif -%}
      {%- if s.booking_url != blank %}<a class="pdpx__link" href="{{ s.booking_url | escape }}" target="_blank" rel="noopener">{{ s.booking_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>{% endif -%}
    </div>

    <div class="pdpx-book__card" data-pdpx-book data-whatsapp="{{ s.whatsapp | remove: '+' | remove: ' ' }}">
      {%- form 'contact', id: 'pdpx-book-form', class: 'pdpx-book__form' -%}
        {%- if form.posted_successfully? -%}
          <div class="pdpx-book__done" role="status">
            <p class="pdpx-book__done-title">{{ s.done_title | escape }}</p>
            <p>{{ s.done_text | escape }}</p>
          </div>
        {%- else -%}
          {%- if form.errors -%}<div class="pdpx-book__error" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
          <input type="hidden" name="contact[tags]" value="booking">
          <input type="hidden" name="contact[Product]" value="{{ p_title | escape }}">
          <input type="hidden" name="contact[Page]" value="{{ request.path | escape }}">

          <fieldset class="pdpx-book__step">
            <legend class="pdpx-book__lab"><b>01</b>How would you like to meet?</legend>
            <div class="pdpx-book__modes">
              {%- assign modes = s.modes | split: ',' -%}
              {%- for m in modes -%}
                {%- liquid
                  assign mm = m | strip
                  assign mlow = mm | downcase
                  assign micon = 'chat-circle-dots'
                  if mlow contains 'video'
                    assign micon = 'video-camera'
                  elsif mlow contains 'phone' or mlow contains 'call'
                    assign micon = 'phone'
                  elsif mlow contains 'visit' or mlow contains 'store'
                    assign micon = 'storefront'
                  endif
                -%}
                <label class="pdpx-book__pill"><input type="radio" name="contact[Call type]" value="{{ mm | escape }}"{% if forloop.first %} checked{% endif %}><span><i class="sj-i sj-i--{{ micon }} ms" aria-hidden="true"></i>{{ mm | escape }}</span></label>
              {%- endfor -%}
            </div>
          </fieldset>

          <fieldset class="pdpx-book__step">
            <legend class="pdpx-book__lab"><b>02</b>When <span class="pdpx-book__tz">IST</span></legend>
            <div class="pdpx-book__when">
              {%- comment -%} the day and the time, each a button that opens its picker (a pop-up; a sheet from the foot on a phone) {%- endcomment -%}
              <div class="pdpx-book__pick" data-pdpx-pick="date">
                <button type="button" class="pdpx-book__pbtn" aria-haspopup="dialog" aria-expanded="false"><i class="sj-i sj-i--calendar ms" aria-hidden="true"></i><span class="pdpx-book__pval"><small>Day</small><b data-pdpx-date-label>Choose a day</b></span><i class="sj-i sj-i--caret-down ms pdpx-book__pcaret" aria-hidden="true"></i></button>
                <div class="pdpx-pop" role="dialog" aria-label="Choose a day" hidden>
                  <div class="pdpx-pop__head"><p>Choose a day</p><button type="button" class="pdpx-pop__x" data-pdpx-close aria-label="Close"><i class="sj-i sj-i--x ms" aria-hidden="true"></i></button></div>
                  <div class="pdpx-book__days" data-pdpx-days data-days="{{ s.days_ahead }}" data-closed="{{ s.closed_days | escape }}"></div>
                </div>
                <input type="hidden" name="contact[Date]" data-pdpx-date>
              </div>
              <div class="pdpx-book__pick" data-pdpx-pick="time">
                <button type="button" class="pdpx-book__pbtn" aria-haspopup="dialog" aria-expanded="false"><i class="sj-i sj-i--clock-counter-clockwise ms" aria-hidden="true"></i><span class="pdpx-book__pval"><small>Time</small><b data-pdpx-time-label>Choose a time</b></span><i class="sj-i sj-i--caret-down ms pdpx-book__pcaret" aria-hidden="true"></i></button>
                <div class="pdpx-pop pdpx-pop--time" role="dialog" aria-label="Choose a time" hidden>
                  <div class="pdpx-pop__head"><p data-pdpx-chosen>Choose a time</p><button type="button" class="pdpx-pop__x" data-pdpx-close aria-label="Close"><i class="sj-i sj-i--x ms" aria-hidden="true"></i></button></div>
                  <div class="pdpx-book__times" data-pdpx-times data-open="{{ s.open_at }}" data-close="{{ s.close_at }}" data-step="{{ s.slot_minutes }}"></div>
                </div>
              </div>
            </div>
            <input type="text" class="pdpx-book__free" name="contact[Time]" data-pdpx-time placeholder="Preferred day and time, e.g. Tuesday 11 AM">
          </fieldset>

          <fieldset class="pdpx-book__step pdpx-book__you">
            <legend class="pdpx-book__lab"><b>03</b>Your details</legend>
            <div class="pdpx-book__row">
              <label><span>Name</span><input type="text" name="contact[name]" autocomplete="name" required></label>
              <label><span>Phone / WhatsApp</span><input type="tel" name="contact[phone]" autocomplete="tel" required></label>
            </div>
            <div class="pdpx-book__row">
              <label><span>Email</span><input type="email" name="contact[email]" autocomplete="email" required></label>
              <label><span>Anything we should know?</span><input type="text" name="contact[body]" data-pdpx-body value="{% if p_title != blank %}About {{ p_title | escape }}{% endif %}"></label>
            </div>
          </fieldset>

          <p class="pdpx-book__summary" data-pdpx-summary hidden><i class="sj-i sj-i--calendar ms" aria-hidden="true"></i><span></span></p>
          <div class="pdpx-book__actions">
            <button type="submit" class="btn pdpx-book__send"><span>{{ s.send_label | escape }}</span><i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></button>
            {%- if s.whatsapp != blank -%}
              <a class="pdpx-book__wa" href="https://api.whatsapp.com/send?phone={{ s.whatsapp | remove: '+' | remove: ' ' }}" target="_blank" rel="noopener" data-pdpx-wa><i class="sj-i sj-i--whatsapp-logo fab" style="font-size:17px" aria-hidden="true"></i><span>{{ s.whatsapp_label | escape }}</span></a>
            {%- endif -%}
          </div>
          {%- if s.note != blank %}<p class="pdpx-book__note">{{ s.note | escape }}</p>{% endif -%}
          <p class="sj-recaptcha">Protected by hCaptcha: its <a href="https://www.hcaptcha.com/privacy" target="_blank" rel="noopener">Privacy Policy</a> and <a href="https://www.hcaptcha.com/terms" target="_blank" rel="noopener">Terms</a> apply.</p>
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product — Book a call",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small heading", "default": "Personal assistance" },
    { "type": "text", "id": "title_1", "label": "Title, first line", "default": "See it with us" },
    { "type": "text", "id": "title_2", "label": "Title, second line (in red)", "default": "before you buy" },
    { "type": "textarea", "id": "lede", "label": "Line under the title", "default": "Book a video call to see the piece up close, ask about its size, colour and care, or plan a gift. Choose a time; we will confirm it on WhatsApp or by email." },
    { "type": "text", "id": "point_1", "label": "Point 1", "default": "See the embroidery and the cloth on camera" },
    { "type": "text", "id": "point_2", "label": "Point 2", "default": "Advice on size, fit, styling and care" },
    { "type": "text", "id": "point_3", "label": "Point 3", "default": "Help with gifting and larger orders" },
    { "type": "text", "id": "hours", "label": "Hours", "default": "Mon–Sat, 10 AM to 7 PM (IST)" },
    { "type": "header", "content": "The booking" },
    { "type": "text", "id": "modes", "label": "Ways to meet (comma separated)", "default": "Video call, Phone call, Visit a store" },
    { "type": "range", "id": "days_ahead", "label": "How far ahead can a day be booked (days)", "min": 7, "max": 90, "step": 1, "default": 45 },
    { "type": "text", "id": "closed_days", "label": "Closed on (0 = Sunday … 6 = Saturday, comma separated)", "default": "0" },
    { "type": "range", "id": "open_at", "label": "First slot (hour, IST)", "min": 6, "max": 14, "step": 1, "default": 10 },
    { "type": "range", "id": "close_at", "label": "Closes at (hour, IST)", "min": 15, "max": 22, "step": 1, "default": 19 },
    { "type": "select", "id": "slot_minutes", "label": "Slot length", "default": "30", "options": [ { "value": "30", "label": "30 minutes" }, { "value": "60", "label": "1 hour" } ] },
    { "type": "text", "id": "send_label", "label": "Send button", "default": "Request this time" },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp number", "info": "With the country code, e.g. 919099974319. Leave empty to hide the WhatsApp button.", "default": "919099974319" },
    { "type": "text", "id": "whatsapp_label", "label": "WhatsApp button", "default": "Or send it on WhatsApp" },
    { "type": "text", "id": "note", "label": "Small print", "default": "We confirm every request personally. Your details are used only to arrange this call." },
    { "type": "text", "id": "done_title", "label": "After sending: title", "default": "Thank you — your request is with us." },
    { "type": "text", "id": "done_text", "label": "After sending: line", "default": "We will confirm the time with you on WhatsApp or by email." },
    { "type": "header", "content": "A booking page (optional)" },
    { "type": "text", "id": "booking_url", "label": "Booking page link", "info": "A Calendly or Cal.com page, if you use one. Leave empty to hide." },
    { "type": "text", "id": "booking_label", "label": "Booking page link label", "default": "Open our calendar" }
  ],
  "presets": [ { "name": "Product — Book a call" } ]
}
{% endschema %}
