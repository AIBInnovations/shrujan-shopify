{% schema %}
{
  "name": "Shrujan header",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Top bar"
    },
    {
      "type": "checkbox",
      "id": "show_topbar",
      "label": "Show the top bar",
      "info": "Hiding it re-centres the logo inside the nav row.",
      "default": true
    },
    {
      "type": "text",
      "id": "topbar_note",
      "label": "Top bar note",
      "default": "Complimentary shipping on orders above ₹5,000"
    },
    {
      "type": "color",
      "id": "topbar_bg",
      "label": "Top bar background",
      "info": "Leave empty to keep the header’s ivory."
    },
    {
      "type": "color",
      "id": "topbar_text",
      "label": "Top bar text",
      "info": "Leave empty to keep the ink tones."
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_size",
      "label": "Logo size",
      "info": "Sets the mark’s height; width follows. 0 keeps the responsive theme default. Desktop only — the phone bar holds its own size.",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "select",
      "id": "logo_align_mobile",
      "label": "Logo alignment (mobile)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "text",
      "id": "brand_tag",
      "label": "Brand tagline",
      "default": "Heritage by Hand"
    },
    {
      "type": "header",
      "content": "Header layout"
    },
    {
      "type": "select",
      "id": "header_width",
      "label": "Header width",
      "info": "Theme default is the wider header rail set in Theme settings → Layout. Narrow lines the header up with the page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "header_pad_top",
      "label": "Extra top padding",
      "info": "Added to the nav row’s own height.",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "header_pad_bottom",
      "label": "Extra bottom padding",
      "min": 0,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "header_separator",
      "label": "Separator line under the header",
      "default": false
    },
    {
      "type": "header",
      "content": "Header utilities"
    },
    {
      "type": "select",
      "id": "utility_style",
      "label": "Utility style",
      "info": "Icon only still carries each item’s label for screen readers.",
      "default": "label",
      "options": [
        {
          "value": "label",
          "label": "Icon with text"
        },
        {
          "value": "icon",
          "label": "Icon only"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "url",
      "id": "search_url",
      "label": "Search link",
      "info": "Defaults to the catalogue on the Shop page."
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_wishlist",
      "label": "Show wishlist",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_bag",
      "label": "Show bag",
      "default": true
    },
    {
      "type": "url",
      "id": "bag_url",
      "label": "Bag link",
      "info": "Defaults to the catalogue on the Shop page."
    },
    {
      "type": "header",
      "content": "Navigation behaviour"
    },
    {
      "type": "select",
      "id": "dropdown_trigger",
      "label": "Open dropdowns on",
      "info": "On click, a menu link opens its panel instead of navigating — the panel’s lead card carries the same destination.",
      "default": "hover",
      "options": [
        {
          "value": "hover",
          "label": "Hover"
        },
        {
          "value": "click",
          "label": "Click"
        }
      ]
    },
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "Sticky header",
      "info": "On scroll up, the bar steps aside while reading down and returns on the way up.",
      "default": "scroll-up",
      "options": [
        {
          "value": "scroll-up",
          "label": "Show on scroll up"
        },
        {
          "value": "always",
          "label": "Always visible"
        },
        {
          "value": "never",
          "label": "Never — scrolls away"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "collapse_on_scroll",
      "label": "Collapse on scroll",
      "info": "Drops the top bar once the header lifts out of flow, so the sticky bar sits slimmer.",
      "default": false
    },
    {
      "type": "header",
      "content": "Story menu — lead card"
    },
    {
      "type": "image_picker",
      "id": "story_lead_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "story_lead_eyebrow",
      "label": "Eyebrow",
      "default": "Story"
    },
    {
      "type": "inline_richtext",
      "id": "story_lead_title",
      "label": "Title",
      "default": "Fifty years, <em>stitched by hand</em>"
    },
    {
      "type": "textarea",
      "id": "story_lead_copy",
      "label": "Copy",
      "default": "From thirty saris in a drought year to four thousand women at the frame. Told in five chapters."
    },
    {
      "type": "text",
      "id": "story_lead_cta",
      "label": "CTA label",
      "default": "Read the story"
    },
    {
      "type": "header",
      "content": "Story menu — featured card"
    },
    {
      "type": "image_picker",
      "id": "story_feat_img",
      "label": "Image"
    },
    {
      "type": "inline_richtext",
      "id": "story_feat_title",
      "label": "Title",
      "default": "<em>Continuity</em>"
    },
    {
      "type": "text",
      "id": "story_feat_sub",
      "label": "Subtitle",
      "default": "The next generation at the frame"
    },
    {
      "type": "text",
      "id": "story_feat_cta",
      "label": "CTA label",
      "default": "Read the story"
    },
    {
      "type": "header",
      "content": "Shop menu — lead card"
    },
    {
