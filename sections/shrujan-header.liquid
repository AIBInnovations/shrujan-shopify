        <span class="topbar__sep" aria-hidden="true"></span>
        <button class="topbar__select" type="button" aria-label="Change language">EN <svg viewBox="0 0 24 24" width="11" height="11" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9.5 6 6 6-6"></path></svg></button>
      </div>
      <span class="topbar__note">{{ section.settings.topbar_note }}</span>
    </div>
  </div>
  {%- endif %}

