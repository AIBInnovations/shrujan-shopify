{%- render 'section-design', section: section -%}

{%- comment -%}
  Header controls. Same two rules as snippets/section-design.liquid: every
  default is a no-op, and because `.shopify-section` is `display: contents` the
  wrapper cannot be painted — so this either publishes custom properties or
  reaches the header's own children through `#shopify-section-<id>`.

  Behaviour (sticky mode, dropdown trigger) is not CSS, so it travels as data
  attributes on `.site-header` — and only when the merchant has moved the
  control off its default, so the packaged markup stays byte-for-byte itself.
  assets/shrujan-core.js (initHeader) reads them with today's values as
  fallbacks.
{%- endcomment -%}

{%- liquid
  assign hs = section.settings
  assign hsel = '#shopify-section-' | append: section.id
  assign hdr_pad = hs.header_pad_top | plus: hs.header_pad_bottom
  assign has_hdr_style = false
  if hs.header_width != 'default' or hdr_pad != 0 or hs.header_separator
    assign has_hdr_style = true
  endif
  if hs.logo_size != 0 or hs.logo_align_mobile != 'center' or hs.show_topbar == false
    assign has_hdr_style = true
  endif
  if hs.utility_style != 'label' or hs.collapse_on_scroll
    assign has_hdr_style = true
  endif
  if hs.topbar_bg != blank or hs.topbar_text != blank
    assign has_hdr_style = true
  endif
-%}

{%- if has_hdr_style -%}
  <style>
    {%- comment -%} the header keeps its own, wider rail — Theme settings → Layout → Header width {%- endcomment -%}
    {%- if hs.header_width == 'full' -%}
      {{ hsel }} { --header-max: 100%; }
    {%- elsif hs.header_width == 'narrow' -%}
      {{ hsel }} { --header-max: var(--page-max); }
    {%- endif -%}

    {%- comment -%}
      `--logo-h` is the brand block's one knob: the logo's height and the offset
      that puts its centre on the topbar rule both derive from it. Desktop only —
      the phone bar pins the mark at 38px on purpose, or the bar grows.
    {%- endcomment -%}
    {%- if hs.logo_size != 0 -%}
      @media (min-width: 1081px) { {{ hsel }} .brand { --logo-h: {{ hs.logo_size }}px; } }
    {%- endif -%}
    {%- if hs.logo_align_mobile != 'center' -%}
      @media (max-width: 1080px) {
        {{ hsel }} .brand { justify-self: {% if hs.logo_align_mobile == 'right' %}end{% else %}start{% endif %}; }
      }
    {%- endif -%}

    {%- comment -%}
      Additive: the row's resting height is the `--header-row-min` token, so the
      padding grows the bar instead of being swallowed by its min-height.
    {%- endcomment -%}
    {%- if hdr_pad != 0 -%}
      {{ hsel }} .site-header__inner {
        padding-top: {{ hs.header_pad_top }}px;
        padding-bottom: {{ hs.header_pad_bottom }}px;
        min-height: calc(var(--header-row-min) + {{ hdr_pad }}px);
      }
    {%- endif -%}

    {%- if hs.header_separator -%}
      {{ hsel }} .site-header { border-bottom: 1px solid var(--hairline); }
    {%- endif -%}

    {%- comment -%}
      No topbar means no rule for the logo to straddle, so the brand takes the
      centred in-flow position the phone bar already uses rather than floating
      half a logo above the header.
    {%- endcomment -%}
    {%- unless hs.show_topbar -%}
      {{ hsel }} .brand {
        position: static;
        transform: none;
        grid-column: 2;
        justify-self: center;
        padding: 8px 0 10px;
        background: transparent;
      }
    {%- endunless -%}

    {%- if hs.topbar_bg != blank -%}
      {{ hsel }} .topbar { background-color: {{ hs.topbar_bg }}; }
    {%- endif -%}
    {%- if hs.topbar_text != blank -%}
      {{ hsel }} .topbar__inner,
      {{ hsel }} .topbar__select,
      {{ hsel }} .topbar__note { color: {{ hs.topbar_text }}; }
      {{ hsel }} .topbar__sep { background: {{ hs.topbar_text | color_modify: 'alpha', 0.35 }}; }
    {%- endif -%}

    {%- comment -%}
      Icon only: the label is hidden, never removed — every utility already
      carries its own aria-label, and this is the same rule the phone bar uses.
    {%- endcomment -%}
    {%- if hs.utility_style == 'icon' -%}
      {{ hsel }} .utility-link span { display: none; }
    {%- endif -%}

    {%- if hs.collapse_on_scroll -%}
      {{ hsel }} .site-header.is-fixed .topbar { display: none; }
    {%- endif -%}
  </style>
{%- endif -%}

<header class="site-header"{% if hs.sticky_mode != 'scroll-up' %} data-sticky="{{ hs.sticky_mode }}"{% endif %}{% if hs.dropdown_trigger != 'hover' %} data-dropdown="{{ hs.dropdown_trigger }}"{% endif %}>
