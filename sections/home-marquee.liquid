{%- render 'section-design', section: section -%}

{%- comment -%}
  Marquee-specific controls. The pace is the stylesheet's own animation duration,
  published as --marquee-dur (46s packaged) so one loop still covers exactly half
  the doubled track at any speed. Direction and the hover pause are plain
  overrides of the packaged rules, emitted only when they move off default.
{%- endcomment -%}
{%- liquid
  assign m = section.settings
  assign msel = '#shopify-section-' | append: section.id

  assign m_style = false
  if m.speed != 46 or m.direction != 'left' or m.pause_on_hover == false
    assign m_style = true
  endif
-%}

{%- if m_style -%}
  <style>
    {%- if m.speed != 46 -%}
      {{ msel }} { --marquee-dur: {{ m.speed }}s; }
    {%- endif -%}
    {%- if m.direction != 'left' -%}
      {{ msel }} .marquee__track { animation-direction: reverse; }
    {%- endif -%}
    {%- if m.pause_on_hover == false -%}
      {{ msel }} .marquee:hover .marquee__track { animation-play-state: running; }
    {%- endif -%}
  </style>
{%- endif -%}
<div class="marquee" role="presentation">
  <div class="marquee__track">
    <div class="marquee__group">
      {%- for block in section.blocks %}
      <span class="marquee__item"{% if block.shopify_attributes != blank %} {{ block.shopify_attributes }}{% endif %}>{{ block.settings.name | escape }}<svg viewBox="0 0 32 32" width="11" height="11" fill="currentColor"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg></span>
      {%- endfor %}
    </div>
    <div class="marquee__group" aria-hidden="true">
      {%- for block in section.blocks %}
      <span class="marquee__item">{{ block.settings.name | escape }}<svg viewBox="0 0 32 32" width="11" height="11" fill="currentColor"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg></span>
      {%- endfor %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Craft marquee",
  "blocks": [
    {
      "type": "craft",
      "name": "Craft name",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Suf"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craft marquee",
      "blocks": [
        {
          "type": "craft",
          "settings": {
            "name": "Suf"
          }
        },
        {
          "type": "craft",
          "settings": {
            "name": "Kharek"
          }
        },
        {
          "type": "craft",
          "settings": {
            "name": "Paako"
          }
        },
        {
          "type": "craft",
          "settings": {
            "name": "Ahir"
          }
        },
        {
          "type": "craft",
          "settings": {
            "name": "Rabari"
          }
        },
        {
          "type": "craft",
          "settings": {
            "name": "Mutava"
          }
        },
        {
          "type": "craft",
          "settings": {
            "name": "Jat Garasia"
          }
        },
        {
          "type": "craft",
          "settings": {
            "name": "Neran"
          }
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Loop duration",
      "info": "Seconds for the ticker to travel one full set of names. Higher is slower.",
      "min": 10,
      "max": 110,
      "step": 1,
      "unit": "s",
      "default": 46
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Right to left"
        },
        {
          "value": "right",
          "label": "Left to right"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "pause_on_hover",
      "label": "Pause on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    }
  ]
}
{% endschema %}
