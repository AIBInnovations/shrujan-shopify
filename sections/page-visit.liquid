    },
    {
      "type": "header",
      "content": "Where to go"
    },
    {
      "type": "checkbox",
      "id": "show_stops",
      "label": "Show this section",
      "info": "The heading and the grid of Stop card blocks. It carries the #places anchor the hero button jumps to, so point that button elsewhere if you switch this off.",
      "default": true
    },
    {
      "type": "text",
      "id": "stops_eyebrow",
      "label": "Eyebrow",
      "default": "Where to go"
    },
    {
      "type": "inline_richtext",
      "id": "stops_title",
      "label": "Title",
      "default": "Six stops, <em>all near Bhuj</em>"
