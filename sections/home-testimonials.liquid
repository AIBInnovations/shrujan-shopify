{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. The card row is a flex scroller, not a grid, so "cards across"
    is the cell's flex-basis — 25% packaged, 50% at 900px, 88% at 720px, that
    last one a deliberate peek at the next card. The grid has no gap, so an
    even split is a plain division. Inside the card the "also bought" pair is a
    real two-column grid that never steps, so it gets a count of its own.
  endcomment
  assign tm_style = false
  if cfg.tm_cols_m != 'default' or cfg.tm_buys_cols_m != 2
    assign tm_style = true
  endif
  if cfg.tm_show_loved_m == false
    assign tm_style = true
  endif
  if cfg.tm_show_arrows and cfg.tm_show_arrows_m == false
    assign tm_style = true
  endif
-%}
{%- if tm_style -%}
  <style>
    @media (max-width: 720px) {
      {%- if cfg.tm_cols_m != 'default' -%}
        {{ sel }} .tw-cell { flex-basis: calc(100% / {{ cfg.tm_cols_m }}); }
      {%- endif -%}
      {%- if cfg.tm_buys_cols_m != 2 -%}
        {{ sel }} .tw-buys { grid-template-columns: repeat({{ cfg.tm_buys_cols_m }}, minmax(0, 1fr)); }
      {%- endif -%}
      {%- if cfg.tm_show_loved_m == false -%}
        {{ sel }} .tw-loved { display: none; }
      {%- endif -%}
      {%- if cfg.tm_show_arrows and cfg.tm_show_arrows_m == false -%}
        {{ sel }} .carousel-arrows { display: none; }
      {%- endif -%}
    }
  </style>
{%- endif -%}
{%- comment -%}
  The reviews, one at a time and large, beside a photograph of what she took
  home, with the reviewers' faces and a pair of arrows to move between them
  (assets/sj-home.js, styled by sj-home.css). Each review is a block: its
  quote, name, place and piece; its face is the block's image and the
  photograph is its first "took home" piece. The head is snippets/sj-hx.liquid.
{%- endcomment -%}
{%- liquid
  assign tm_meta_l = cfg.tm_meta_l | escape
  assign tm_meta_r = 'Reviews'
  if cfg.tm_show_rating
    assign tm_meta_r = section.settings.rating_count | strip
    if tm_meta_r == blank
      assign tm_meta_r = 'Reviews'
    endif
  endif
  assign tm_l1 = cfg.tm_line_1 | escape
  assign tm_l2 = cfg.tm_line_2 | escape
  assign tm_lede = section.settings.intro | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip
  assign tm_count = section.blocks.size
  assign tm_total = tm_count
  if tm_count < 10
    assign tm_total = '0' | append: tm_count
  endif
  assign tm_link = section.settings.picks_url | default: '/pages/shop-shrujan#catalogue'
  assign tm_star = '<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9Z"/></svg>'
-%}
<section class="section container" aria-label="{{ section.settings.title | escape }}">
  {% render 'sj-hx', meta_l: tm_meta_l, meta_r: tm_meta_r, l1: tm_l1, l2: tm_l2, lede: tm_lede %}

  <div class="tq" aria-roledescription="carousel" aria-label="Customer reviews">
    <div class="tq__panel">
      <div class="tq__top"><span class="tq__rating"><span class="tq__stars" aria-label="5 out of 5 stars">{{ tm_star }}{{ tm_star }}{{ tm_star }}{{ tm_star }}{{ tm_star }}</span>{{ section.settings.rating_count | strip }}</span><span class="tq__count" aria-live="polite"><b>01</b> / {{ tm_total }}</span></div>
      <div class="tq__slides">
      {%- for block in section.blocks %}
      {%- capture tm_face %}{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.image_asset | asset_url }}{% endif %}{% endcapture %}
      <figure class="tq__slide{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}"{% unless forloop.first %} aria-hidden="true"{% endunless %} {{ block.shopify_attributes }}>
        <blockquote class="tq__quote">“{{ block.settings.quote | strip }}”</blockquote>
        <figcaption class="tq__who"><img class="tq__face" src="{{ tm_face }}" alt="" loading="lazy"><span><b class="tq__name">{{ block.settings.name | strip }}</b><span class="tq__city">{{ block.settings.place | strip }} · {{ block.settings.label | strip }}</span></span></figcaption>
      </figure>
      {%- endfor %}
      </div>
      <div class="tq__nav">
        <div class="tq__dots">
          {%- for block in section.blocks -%}
          {%- capture tm_face %}{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.image_asset | asset_url }}{% endif %}{% endcapture -%}
          <button class="tq__dot{% if forloop.first %} is-active{% endif %}" type="button" data-i="{{ forloop.index0 }}" aria-label="Review by {{ block.settings.name | strip | escape }}"><img src="{{ tm_face }}" alt="" loading="lazy"></button>
          {%- endfor -%}
        </div>
        <span class="tq__loved">{{ section.settings.loved_line_1 | strip }} {{ section.settings.loved_line_2 | strip }}</span>
        <div class="tq__arrows"><button class="tq__arrow tq__arrow--prev" type="button" aria-label="Previous review">←</button><button class="tq__arrow tq__arrow--next" type="button" aria-label="Next review">→</button></div>
      </div>
    </div>
    <div class="tq__photo">
      {%- for block in section.blocks %}
      {%- capture tm_shot %}{% if block.settings.buy1_image %}{{ block.settings.buy1_image | image_url: width: 1200 }}{% else %}{{ block.settings.buy1_asset | asset_url }}{% endif %}{% endcapture %}
      <a class="tq__shot{% if forloop.first %} is-active{% endif %}" data-i="{{ forloop.index0 }}" href="{{ tm_link }}"{% unless forloop.first %} aria-hidden="true" tabindex="-1"{% endunless %}>
        <img src="{{ tm_shot }}" alt="{{ block.settings.buy1_name | escape }}" loading="lazy">
        <span class="tq__cap"><span class="tq__took">{{ block.settings.name | strip | split: ' ' | first }} {{ section.settings.took_home_label }}</span><span class="tq__item">{{ block.settings.buy1_name | escape }}</span><span class="tq__go">{{ section.settings.picks_label | strip }} <span aria-hidden="true">→</span></span></span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('.tw');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var track = root.querySelector('.tw__grid');

  // Behaviour flags ride on data attributes on this element. The section only
  // writes one when the merchant moves off the built-in value, so every read
  // here falls back to what this carousel has always done.
  var step = root.getAttribute('data-step') || 'page';
  var every = parseInt(root.getAttribute('data-autoplay'), 10) || 0;

  // One cell plus any gap, measured live so it tracks the cell's flex-basis.
  function cellStep() {
    var cell = track.querySelector('.tw-cell');
    if (!cell) return track.clientWidth;
    return cell.getBoundingClientRect().width + (parseFloat(getComputedStyle(track).columnGap) || 0);
  }

  // Scroll one full page (whatever number of cells currently fit), or one cell.
  function page(dir) {
    if (!track) return;
    var by = step === 'cell' ? cellStep() : track.clientWidth;
    track.scrollBy({ left: dir * by, behavior: 'smooth' });
  }

  var arrows = root.querySelectorAll('.carousel-arrows button');
  if (arrows[0]) arrows[0].addEventListener('click', function () { page(-1); });
  if (arrows[1]) arrows[1].addEventListener('click', function () { page(1); });

  // Autoplay is opt-in. It pauses on hover and on keyboard focus — which also
  // keeps it from fighting the flip cards, since those open on focus-within —
  // and never starts for a visitor who asked for reduced motion.
  if (every > 0 && track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var timer = null;

    var stopAuto = function () {
      if (timer) { clearInterval(timer); timer = null; }
    };

    var startAuto = function () {
      stopAuto();
      timer = setInterval(function () {
        // 2px of slack — the scrolled edge and scrollWidth rarely land exactly.
        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          page(1);
        }
      }, every);
    };

    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);
    root.addEventListener('focusin', stopAuto);
    root.addEventListener('focusout', startAuto);
    startAuto();
  }
})();
</script>
