{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. The card row is a flex scroller, not a grid, so "cards across"
    is the cell's flex-basis — 25% packaged, 50% at 900px, 88% at 720px, that
    last one a deliberate peek at the next card. The grid has no gap, so an
    even split is a plain division. Inside the card the "also bought" pair is a
    real two-column grid that never steps, so it gets a count of its own.
  endcomment
  assign tm_style = false
  if cfg.tm_cols_m != 'default' or cfg.tm_buys_cols_m != 2
    assign tm_style = true
  endif
  if cfg.tm_show_loved_m == false
    assign tm_style = true
  endif
  if cfg.tm_show_arrows and cfg.tm_show_arrows_m == false
    assign tm_style = true
  endif
-%}
{%- if tm_style -%}
  <style>
    @media (max-width: 720px) {
      {%- if cfg.tm_cols_m != 'default' -%}
        {{ sel }} .tw-cell { flex-basis: calc(100% / {{ cfg.tm_cols_m }}); }
      {%- endif -%}
      {%- if cfg.tm_buys_cols_m != 2 -%}
        {{ sel }} .tw-buys { grid-template-columns: repeat({{ cfg.tm_buys_cols_m }}, minmax(0, 1fr)); }
      {%- endif -%}
      {%- if cfg.tm_show_loved_m == false -%}
        {{ sel }} .tw-loved { display: none; }
      {%- endif -%}
      {%- if cfg.tm_show_arrows and cfg.tm_show_arrows_m == false -%}
        {{ sel }} .carousel-arrows { display: none; }
      {%- endif -%}
    }
  </style>
{%- endif -%}
<section class="section container" aria-label="{{ section.settings.title | escape }}">
  <div class="tw__intro" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="tw__intro-copy">
      {{ section.settings.intro }}
    </p>
  </div>

  <div class="tw" data-reveal{% if cfg.tm_step != 'page' %} data-step="{{ cfg.tm_step }}"{% endif %}{% if cfg.tm_autoplay %} data-autoplay="{{ cfg.tm_interval | times: 1000 }}"{% endif %}>
    <header class="tw__head">
      <p class="tw__title">
        {{ section.settings.kind_title }}
      </p>

      <div class="tw__meta">
        {% if cfg.tm_show_rating %}
        <div class="tw-rating">
          <span class="tw-rating__stars" aria-label="5 out of 5 stars">
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9Z"></path></svg>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9Z"></path></svg>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9Z"></path></svg>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9Z"></path></svg>
            <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9Z"></path></svg>
          </span>
          <span class="tw-rating__count">{{ section.settings.rating_count }}</span>
        </div>
        {% endif %}

        <div class="tw-loved">
          <span class="tw-loved__stack" aria-hidden="true">
            <img src="{% if section.settings.stack_img_1 %}{{ section.settings.stack_img_1 | image_url: width: 1200 }}{% else %}{{ 'cat-c1.webp' | asset_url }}{% endif %}" alt="" loading="lazy">
            <img src="{% if section.settings.stack_img_2 %}{{ section.settings.stack_img_2 | image_url: width: 1200 }}{% else %}{{ 'cat-c5.webp' | asset_url }}{% endif %}" alt="" loading="lazy">
            <img src="{% if section.settings.stack_img_3 %}{{ section.settings.stack_img_3 | image_url: width: 1200 }}{% else %}{{ 'frame-r5t25.webp' | asset_url }}{% endif %}" alt="" loading="lazy">
          </span>
          <span class="tw-loved__label">
            {{ section.settings.loved_line_1 }}
            <br>
            {{ section.settings.loved_line_2 }}
          </span>
        </div>

        {% if cfg.tm_show_arrows %}
        <div class="carousel-arrows">
          <button type="button" aria-label="Previous testimonials">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5 8 12l6.5 6.5"></path></svg>
          </button>
          <button type="button" aria-label="Next testimonials">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9.5 5.5 6.5 6.5-6.5 6.5"></path></svg>
          </button>
        </div>
        {% endif %}
      </div>
    </header>

    <div class="tw__grid">
      {%- for block in section.blocks %}
      {%- assign twmod = forloop.index0 | modulo: 2 %}
      <article class="tw-cell{% if cfg.tm_alternate and twmod == 1 %} tw-cell--flip{% endif %}" {{ block.shopify_attributes }}>
        <div class="tw-cell__inner">
          <div class="tw-cell__face tw-cell__face--front">
            <div class="tw-cell__person">
              <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.image_asset | asset_url }}{% endif %}" alt="" loading="lazy">
              <div>
                <p class="tw-cell__name">{{ block.settings.name }}</p>
                <p class="tw-cell__role">{{ block.settings.place }}</p>
              </div>
            </div>

            <p class="tw-cell__label">{{ block.settings.label }}</p>

            <blockquote class="tw-cell__quote">“{{ block.settings.quote }}”</blockquote>
          </div>

          <div class="tw-cell__face tw-cell__face--back">
            <p class="tw-buys__eyebrow">{{ block.settings.name | split: ' ' | first }} {{ section.settings.took_home_label }}</p>

            <ul class="tw-buys">
              <li class="tw-buys__item">
                <span class="tw-buys__frame">
                  <img src="{% if block.settings.buy1_image %}{{ block.settings.buy1_image | image_url: width: 1200 }}{% else %}{{ block.settings.buy1_asset | asset_url }}{% endif %}" alt="{{ block.settings.buy1_name | escape }}" loading="lazy">
                </span>
                <span class="tw-buys__name">{{ block.settings.buy1_name }}</span>
              </li>
              <li class="tw-buys__item">
                <span class="tw-buys__frame">
                  <img src="{% if block.settings.buy2_image %}{{ block.settings.buy2_image | image_url: width: 1200 }}{% else %}{{ block.settings.buy2_asset | asset_url }}{% endif %}" alt="{{ block.settings.buy2_name | escape }}" loading="lazy">
                </span>
                <span class="tw-buys__name">{{ block.settings.buy2_name }}</span>
              </li>
            </ul>

            <a class="tw-buys__link" href="{{ section.settings.picks_url | default: '/pages/shop-shrujan#catalogue' }}">
              {{ section.settings.picks_label }}
            </a>
          </div>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('.tw');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var track = root.querySelector('.tw__grid');

  // Behaviour flags ride on data attributes on this element. The section only
  // writes one when the merchant moves off the built-in value, so every read
  // here falls back to what this carousel has always done.
  var step = root.getAttribute('data-step') || 'page';
  var every = parseInt(root.getAttribute('data-autoplay'), 10) || 0;

  // One cell plus any gap, measured live so it tracks the cell's flex-basis.
  function cellStep() {
    var cell = track.querySelector('.tw-cell');
    if (!cell) return track.clientWidth;
    return cell.getBoundingClientRect().width + (parseFloat(getComputedStyle(track).columnGap) || 0);
  }

  // Scroll one full page (whatever number of cells currently fit), or one cell.
  function page(dir) {
    if (!track) return;
    var by = step === 'cell' ? cellStep() : track.clientWidth;
    track.scrollBy({ left: dir * by, behavior: 'smooth' });
  }

  var arrows = root.querySelectorAll('.carousel-arrows button');
  if (arrows[0]) arrows[0].addEventListener('click', function () { page(-1); });
  if (arrows[1]) arrows[1].addEventListener('click', function () { page(1); });

  // Autoplay is opt-in. It pauses on hover and on keyboard focus — which also
  // keeps it from fighting the flip cards, since those open on focus-within —
  // and never starts for a visitor who asked for reduced motion.
  if (every > 0 && track && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    var timer = null;

    var stopAuto = function () {
      if (timer) { clearInterval(timer); timer = null; }
    };

    var startAuto = function () {
      stopAuto();
      timer = setInterval(function () {
        // 2px of slack — the scrolled edge and scrollWidth rarely land exactly.
        if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 2) {
          track.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          page(1);
        }
      }, every);
    };

    root.addEventListener('mouseenter', stopAuto);
    root.addEventListener('mouseleave', startAuto);
    root.addEventListener('focusin', stopAuto);
    root.addEventListener('focusout', startAuto);
    startAuto();
  }
})();
</script>
