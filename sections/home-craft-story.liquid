{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. The two grids step on different breakpoints in the stylesheet
    on different breakpoints: the gallery goes two-up to one at 600px, the stat
    row four-up to two at 900px. So each override sits inside its own query
    rather than one shared phone width. The stat row is hairline-separated, and
    the theme's reflow at 900px is tuned for two columns, so a single column
    repeats what the theme does for the promises row at its narrowest step.
  endcomment
  assign cs_style = false
  if cfg.cs_align == 'center' or cfg.cs_cols_m != 1 or cfg.cs_stat_cols_m != 2
    assign cs_style = true
  endif
-%}
{%- if cs_style -%}
  <style>
    {%- if cfg.cs_align == 'center' -%}
      {%- comment -%}
        Only the two heading lines move. The body copy keeps its 46ch measure and
        its left edge, which is what makes the column readable.
      {%- endcomment -%}
      {{ sel }} .craft__body > .eyebrow,
      {{ sel }} .craft__body > .section-title { text-align: center; }
    {%- endif -%}
    {%- if cfg.cs_cols_m != 1 -%}
      @media (max-width: 600px) {
        {{ sel }} .craft__gallery { grid-template-columns: repeat({{ cfg.cs_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.cs_stat_cols_m != 2 -%}
      @media (max-width: 900px) {
        {{ sel }} .craft__stats { grid-template-columns: repeat({{ cfg.cs_stat_cols_m }}, minmax(0, 1fr)); }
        {%- if cfg.cs_stat_cols_m == 1 -%}
          {{ sel }} .craft__stats .stat { border-left: 0; }
          {{ sel }} .craft__stats .stat + .stat { border-top: 1px solid var(--hairline); }
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
<section class="section container" id="craft">
  <div class="craft">
    <div class="craft__body">
      <p class="eyebrow" data-reveal>
        {{ section.settings.eyebrow | escape }}
      </p>
      <h2 class="section-title" data-reveal>
        {{ section.settings.title_l1 | escape }}
        <br>
        <em>{{ section.settings.title_l2 | escape }}</em>
      </h2>
      <div class="craft__copy" data-reveal>
        {{ section.settings.copy }}
      </div>

      {% if cfg.cs_show_link %}
      <a class="arrow-link craft__link" href="{{ section.settings.link | default: '/pages/video' }}" data-reveal>
        {{ section.settings.link_label | escape }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
      </a>
      {% endif %}
    </div>

    <div class="craft__gallery" data-reveal>
      {%- assign shots = section.blocks | where: 'type', 'shot' -%}
      {%- for block in shots %}
      <figure class="craft__shot" {{ block.shopify_attributes }}>
        <div class="craft__shot-media"{% if forloop.first %} data-parallax{% endif %}>
          <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 900 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
        </div>
        {% if cfg.cs_show_captions %}<figcaption>{{ block.settings.caption | escape }}</figcaption>{% endif %}
      </figure>
      {%- endfor %}
    </div>
  </div>

  {% if cfg.cs_show_stats %}
  <div class="craft__stats" data-reveal-child>
    {%- assign stats = section.blocks | where: 'type', 'stat' -%}
    {%- for block in stats %}
    <div class="stat" {{ block.shopify_attributes }}>
      <p class="stat__value">{{ block.settings.value | escape }}</p>
      <p class="stat__label">{{ block.settings.label | escape }}</p>
    </div>
    {%- endfor %}
  </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Home craft story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Craft"
    },
    {
      "type": "text",
      "id": "title_l1",
      "label": "Title line 1",
      "default": "Every stitch carries"
    },
    {
      "type": "text",
      "id": "title_l2",
      "label": "Title line 2 (italic)",
      "default": "a signature"
    },
    {
      "type": "richtext",
      "id": "copy",
      "label": "Story copy",
      "default": "<p>Shrujan began in 1969 with Chanda Shroff, known as Kaki, who went to Kutch after a famine and found women whose embroidery was extraordinary and whose earnings were not. She turned that skill into a livelihood.</p><p>From her vision to the hands of thousands of women across Kutch, Shrujan has quietly safeguarded the region&rsquo;s living craft traditions for over five decades, preserving the knowledge and the dignity behind it.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Explore the Craft"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "cs_align",
      "label": "Heading alignment",
      "default": "left",
      "info": "Moves the eyebrow and title only. The story below keeps its left edge and its reading measure.",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "cs_show_link",
      "label": "Show story link",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "cs_show_captions",
      "label": "Show photograph captions",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "cs_show_stats",
      "label": "Show figures row",
      "default": true,
      "info": "The bordered row of numbers under the story."
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "cs_cols_m",
      "label": "Gallery columns",
      "info": "600px and under, where the theme stacks the two shots into one column.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "range",
      "id": "cs_stat_cols_m",
      "label": "Statistic columns",
      "info": "900px and under, where the four statistics fall to two across. At one column the hairlines move from the side to the top of each row.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
