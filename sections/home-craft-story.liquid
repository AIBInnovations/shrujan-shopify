    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "header",
      "content": "Design — mobile"
    },
    {
      "type": "select",
      "id": "sec_width_m",
      "label": "Section width on mobile",
      "info": "Only below 768px. Edge-to-edge removes the side gutter entirely.",
      "default": "default",
      "options": [
        {
          "value": "default",
