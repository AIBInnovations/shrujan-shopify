{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. Both grids give way at 900px in the stylesheet: the hung wall
    turns into a plain grid of frames, two across, and the stat row goes four-up
    to two. The stat row is hairline-separated, and the theme's reflow at 900px
    is tuned for two columns, so a single column moves the hairline to the top.
  endcomment
  assign cs_style = false
  if cfg.cs_cols_m != 2 or cfg.cs_stat_cols_m != 2 or cfg.cs_show_captions == false
    assign cs_style = true
  endif

  assign tiles = section.blocks | where: 'type', 'tile'
  assign tile_count = tiles | size
  assign row_split = tile_count | plus: 1 | divided_by: 2
-%}
{%- if cs_style -%}
  <style>
    {%- if cfg.cs_show_captions == false -%}
      {{ sel }} .craft-wall__tile figcaption { display: none; }
    {%- endif -%}
    {%- if cfg.cs_cols_m != 2 or cfg.cs_stat_cols_m != 2 -%}
      @media (max-width: 900px) {
        {%- if cfg.cs_cols_m != 2 -%}
          {{ sel }} .craft-wall { grid-template-columns: repeat({{ cfg.cs_cols_m }}, minmax(0, 1fr)); }
        {%- endif -%}
        {%- if cfg.cs_stat_cols_m != 2 -%}
          {{ sel }} .craft__stats { grid-template-columns: repeat({{ cfg.cs_stat_cols_m }}, minmax(0, 1fr)); }
          {%- if cfg.cs_stat_cols_m == 1 -%}
            {{ sel }} .craft__stats .stat { border-left: 0; }
            {{ sel }} .craft__stats .stat + .stat { border-top: 1px solid var(--hairline); }
          {%- endif -%}
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
{%- liquid
  assign cs_meta_l = section.settings.cs_meta_l | escape
  assign cs_meta_r = section.settings.cs_meta_r | escape
  assign cs_l1 = section.settings.title_l1 | escape
  assign cs_l2 = section.settings.title_l2 | escape
-%}
<!-- Our Craft, a heritage wall — converted from src/components/CraftStory.jsx -->
<section class="section container" id="craft">
  {%- comment -%}
    The home page's head (snippets/sj-hx.liquid): a meta row, then the title
    in two lines. The theme's reveal attributes are left off this section,
    since assets/sj-home.js brings its blocks in itself.
  {%- endcomment %}
  {% render 'sj-hx', meta_l: cs_meta_l, meta_r: cs_meta_r, l1: cs_l1, l2: cs_l2 %}

  {%- comment -%}
    Two hung rows: the first half of the photographs, then the rest inset.
    One reveal for the whole wall, since per-tile reveals would leave GSAP
    transforms behind the flex-grow hover.
  {%- endcomment -%}
  {%- if tile_count > 0 %}
  <div class="craft-wall">
    <div class="craft-wall__row">
      {%- for block in tiles limit: row_split %}
      <figure class="craft-wall__tile" {{ block.shopify_attributes }}>
        <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1000 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
        <figcaption>{{ block.settings.caption | escape }}</figcaption>
      </figure>
      {%- endfor %}
    </div>
    {%- if tile_count > row_split %}
    <div class="craft-wall__row craft-wall__row--offset">
      {%- for block in tiles offset: row_split %}
      <figure class="craft-wall__tile" {{ block.shopify_attributes }}>
        <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1000 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
        <figcaption>{{ block.settings.caption | escape }}</figcaption>
      </figure>
      {%- endfor %}
    </div>
    {%- endif -%}
    {%- if cfg.cs_show_dots %}

    <span class="craft-wall__dot craft-wall__dot--a" aria-hidden="true"></span>
    <span class="craft-wall__dot craft-wall__dot--b" aria-hidden="true"></span>
    <span class="craft-wall__dot craft-wall__dot--c" aria-hidden="true"></span>
    {%- endif %}
  </div>
  {%- endif %}

  {%- if cfg.cs_show_link %}
  <div class="craft-wall__more">
    <a class="arrow-link" href="{{ section.settings.link | default: '/pages/video' }}">{{ section.settings.link_label | escape }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </div>
  {%- endif %}

  {%- if cfg.cs_show_stats %}
  <div class="craft__stats">
    {%- assign stats = section.blocks | where: 'type', 'stat' -%}
    {%- for block in stats %}
    <div class="stat" {{ block.shopify_attributes }}>
      <p class="stat__value">{{ block.settings.value | escape }}</p>
      <p class="stat__label">{{ block.settings.label | escape }}</p>
    </div>
    {%- endfor %}
  </div>
  {%- endif %}
</section>

