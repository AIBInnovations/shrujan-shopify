        },
        {
          "type": "stat",
          "settings": {
            "value": "1969",
            "label": "Founded by Chanda Shroff"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "5",
            "label": "Decades of craft revival"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "12",
