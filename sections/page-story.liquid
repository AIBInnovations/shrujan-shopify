{%- render 'section-design', section: section -%}
{%- comment -%}
  Layout overrides for the controls below. Nothing is emitted while every
  control sits at its default, so the page ships exactly as it was hand-built.
  `.shopify-section` is `display: contents` and cannot be painted or sized, so
  the column count is published as a custom property — which still inherits
  through it — rather than set on the wrapper itself.
{%- endcomment -%}
{%- liquid
  assign st = section.settings
  assign sel = '#shopify-section-' | append: section.id
  assign story_style = false
  if st.journal_cols != 4 or st.chapters_sticky or st.enable_lightbox == false
    assign story_style = true
  endif
-%}
{%- if story_style -%}
  <style>
    {%- if st.journal_cols != 4 -%}
      {{ sel }} { --journal-cols: {{ st.journal_cols }}; }
      {%- comment -%}
        The hand-placed 4 x 7 block only closes flush at four columns, so any
        other count falls back to uniform auto-placed cells — exactly what the
        stylesheet already does for itself below 901px.
      {%- endcomment -%}
      @media (min-width: 901px) {
        {{ sel }} .journal-bento > * { grid-column: auto; grid-row: span 2; }
      }
      {%- comment -%}
        The stylesheet steps the grid down to three columns below 901px. A count
        already narrower than that has to be carried down too, or the grid would
        widen on the smaller screen.
      {%- endcomment -%}
      {%- if st.journal_cols < 3 -%}
        @media (max-width: 900px) {
          {{ sel }} .journal-bento { grid-template-columns: repeat({{ st.journal_cols }}, minmax(0, 1fr)); }
        }
      {%- endif -%}
    {%- endif -%}

    {%- if st.chapters_sticky -%}
      {{ sel }} .chapters {
        position: sticky;
        /* --header-h is the bar's measured height, published by the core script */
        top: calc(var(--header-h, 80px) + 8px);
        /* below the masthead's 60, so the bar still wins when it slides back in */
        z-index: 40;
      }
    {%- endif -%}

    {%- comment -%}
      With the lightbox off the frames are figures, not buttons — so nothing
      may still read as clickable.
    {%- endcomment -%}
    {%- if st.enable_lightbox == false -%}
      {{ sel }} .jshot,
      {{ sel }} .press__sheet { cursor: default; }
      {{ sel }} .jshot:hover img { transform: none; }
      {{ sel }} .press__sheet:hover { transform: none; box-shadow: none; }
    {%- endif -%}
  </style>
{%- endif -%}
<!-- The Shrujan Story — converted from src/pages/ShrujanStory.jsx (+ components/Lightbox.jsx) -->
<header class="page-hero page-hero--ghost" data-reveal{% unless section.settings.enable_lightbox %} data-lightbox-enabled="false"{% endunless %}>
  <span class="page-hero__ghost" aria-hidden="true">{{ section.settings.ghost | escape }}</span>

  <div class="container page-hero__grid">
    <div class="page-hero__text">
      <p class="eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
      <h1 class="page-hero__title">{{ section.settings.hero_title }}</h1>
      <p class="page-hero__lede">{{ section.settings.hero_lede | escape }}</p>
      <ul class="page-meta">
        <li><span class="page-meta__value">{{ section.settings.meta1_value | escape }}</span><span class="page-meta__label">{{ section.settings.meta1_label | escape }}</span></li>
        <li><span class="page-meta__value">{{ section.settings.meta2_value | escape }}</span><span class="page-meta__label">{{ section.settings.meta2_label | escape }}</span></li>
        <li><span class="page-meta__value">{{ section.settings.meta3_value | escape }}</span><span class="page-meta__label">{{ section.settings.meta3_label | escape }}</span></li>
      </ul>
    </div>
  </div>
</header>

<!-- ---- chapter rail ---- -->
{%- if section.settings.show_chapters %}
<nav class="chapters" aria-label="Story chapters">
  <div class="container chapters__inner">
    <ol class="chapters__list">
      {%- assign chapter_n = 0 -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'chapter' -%}
          {%- assign chapter_n = chapter_n | plus: 1 %}
      <li {{ block.shopify_attributes }}>
        <a href="#{{ block.settings.anchor | escape }}" class="chapters__link{% if chapter_n == 1 %} is-active{% endif %}"{% if chapter_n == 1 %} aria-current="true"{% endif %}><span class="chapters__no">{% if chapter_n < 10 %}0{% endif %}{{ chapter_n }}</span><span class="chapters__label">{{ block.settings.label | escape }}</span></a>
      </li>
        {%- endif -%}
      {%- endfor %}
    </ol>
  </div>
</nav>
{%- endif %}

<!-- ---- 01 Origins ---- -->
<section class="section container" id="origins">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.origins_eyebrow | escape }}</p>
    <h2 class="section-title">{{ section.settings.origins_title }}</h2>
  </div>

  <div class="origin" data-reveal>
    <p class="origin__lead">{{ section.settings.origin_lead | escape }}</p>
    <div class="origin__body">
      {%- for block in section.blocks -%}
        {%- if block.type == 'origin_par' %}
      <p {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</p>
        {%- endif -%}
      {%- endfor %}
    </div>
  </div>

  {%- if section.settings.show_origins_gallery %}
  <div class="origin__gallery" data-reveal-child>
    {%- for block in section.blocks -%}
      {%- if block.type == 'origin_shot' %}
    <figure class="origin__shot" {{ block.shopify_attributes }}>
      <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
    </figure>
      {%- endif -%}
    {%- endfor %}
  </div>
  {%- endif %}

  <blockquote class="origin__pull" data-reveal>{{ section.settings.origin_quote | escape }}</blockquote>

  {%- if section.settings.show_stats %}
  <div class="craft__stats" data-reveal-child>
    {%- for block in section.blocks -%}
      {%- if block.type == 'stat' %}
    <div class="stat" {{ block.shopify_attributes }}>
      <p class="stat__value">{{ block.settings.value | escape }}</p>
      <p class="stat__label">{{ block.settings.label | escape }}</p>
    </div>
      {%- endif -%}
    {%- endfor %}
  </div>
  {%- endif %}
</section>

<!-- ---- 02 Philosophy & Values ---- -->
{%- if section.settings.show_values %}
<section class="section container" id="values">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.values_eyebrow | escape }}</p>
    <h2 class="section-title">{{ section.settings.values_title }}</h2>
  </div>

  <div class="values" data-reveal-child>
    {%- assign value_n = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'value' -%}
        {%- assign value_n = value_n | plus: 1 %}
    <article class="value value--{% cycle 'dignity', 'continuity', 'conscious' %}" {{ block.shopify_attributes }}>
      <div class="value__media">
        <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
      </div>
      <div class="value__body">
        <p class="value__no">{% if value_n < 10 %}0{% endif %}{{ value_n }}</p>
        <h3 class="value__title">{{ block.settings.title | escape }}</h3>
        <p class="value__copy">{{ block.settings.copy | escape }}</p>
      </div>
    </article>
      {%- endif -%}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<!-- ---- 03 The People of Shrujan ---- -->
{%- if section.settings.show_people %}
<section class="section container" id="people">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.people_eyebrow | escape }}</p>
    <h2 class="section-title">{{ section.settings.people_title }}</h2>
  </div>

  <div class="people" data-reveal-child>
    {%- for block in section.blocks -%}
      {%- if block.type == 'person' %}
    <article class="person" {{ block.shopify_attributes }}>
      <div class="person__media">
        <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 600 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.name | escape }}" loading="lazy">
      </div>
      <h3 class="person__name">{{ block.settings.name | escape }}</h3>
      <p class="person__role">{{ block.settings.role | escape }}</p>
      <p class="person__copy">{{ block.settings.copy | escape }}</p>
    </article>
      {%- endif -%}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<!-- ---- 04 Photo Journal ---- -->
{%- if section.settings.show_journal %}
<section class="section container" id="journal">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.journal_eyebrow | escape }}</p>
    <h2 class="section-title">{{ section.settings.journal_title }}</h2>
    <p class="section-intro__copy">{{ section.settings.journal_copy | escape }}</p>
  </div>
  {%- if section.settings.enable_lightbox -%}
  {%- capture journal_json -%}
    [
    {%- assign shot_n = 0 -%}
    {%- for block in section.blocks -%}
      {%- if block.type == 'jshot' -%}
        {%- assign shot_n = shot_n | plus: 1 -%}
        {%- if shot_n > 1 -%},{%- endif -%}
        {%- if block.settings.img -%}
          {%- assign shot_full = block.settings.img | image_url: width: 1600 -%}
        {%- else -%}
          {%- assign shot_full = block.settings.asset | asset_url -%}
        {%- endif -%}
        {"src":{{ shot_full | json }},"alt":{{ block.settings.caption | json }}}
      {%- endif -%}
    {%- endfor -%}
    ]
  {%- endcapture -%}
  {%- endif %}

  <div class="journal-bento" data-reveal-child{% if section.settings.enable_lightbox %} data-lightbox="{{ journal_json | escape }}"{% endif %}>
    {%- for block in section.blocks -%}
      {%- if block.type == 'jshot' -%}
        {%- if section.settings.enable_lightbox %}
    <button type="button" class="jshot jshot--{{ block.settings.span }}" aria-label="Open photograph: {{ block.settings.caption | escape }}" {{ block.shopify_attributes }}><img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.caption | escape }}" loading="lazy"><span class="jshot__cap">{{ block.settings.caption | escape }}</span></button>
        {%- else %}
    <figure class="jshot jshot--{{ block.settings.span }}" {{ block.shopify_attributes }}><img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.caption | escape }}" loading="lazy"><span class="jshot__cap">{{ block.settings.caption | escape }}</span></figure>
        {%- endif -%}
      {%- endif -%}
    {%- endfor %}
  </div>
</section>
{%- endif %}

<!-- ---- 05 In the Media ---- -->
{%- if section.settings.show_press or section.settings.show_cta %}
<section class="section container" id="press">
  {%- if section.settings.show_press %}
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.press_eyebrow | escape }}</p>
    <h2 class="section-title">{{ section.settings.press_title }}</h2>
    <p class="section-intro__copy">{{ section.settings.press_copy | escape }}</p>
  </div>

  <div class="press" data-reveal-child>
    {%- for block in section.blocks -%}
      {%- if block.type == 'press' -%}
        {%- assign sheet_list = block.settings.sheets | split: ',' -%}
        {%- if section.settings.enable_lightbox -%}
        {%- capture press_json -%}
          {%- assign page_n = 0 -%}
          {"publication":{{ block.settings.pub | json }},"headline":{{ block.settings.head | json }},"pages":[
          {%- for s in sheet_list -%}
            {%- assign sheet = s | strip -%}
            {%- if sheet != blank -%}
              {%- assign page_n = page_n | plus: 1 -%}
              {%- if page_n > 1 -%},{%- endif -%}
              {{ sheet | asset_url | json }}
            {%- endif -%}
          {%- endfor -%}
          ]}
        {%- endcapture -%}
        {%- endif %}
    <article class="press__item"{% if section.settings.enable_lightbox %} data-press="{{ press_json | escape }}"{% endif %} {{ block.shopify_attributes }}>
      <div class="press__meta">
        <p class="press__section">{{ block.settings.section_label | escape }}</p>
        <h3 class="press__pub">{{ block.settings.pub | escape }}</h3>
        <p class="press__head"{% if block.settings.head_lang != blank %} lang="{{ block.settings.head_lang | escape }}"{% endif %}>{{ block.settings.head | escape }}</p>
        {%- if block.settings.trans != blank %}
        <p class="press__trans">{{ block.settings.trans | escape }}</p>
        {%- endif -%}
        {%- if block.settings.byline != blank %}
        <p class="press__byline">{{ block.settings.byline | escape }}</p>
        {%- endif %}
        <p class="press__note">{{ block.settings.note | escape }}</p>
        <ul class="press__facts">
          {%- assign fact_list = block.settings.facts | newline_to_br | split: '<br />' -%}
          {%- for f in fact_list -%}
            {%- assign fact = f | strip -%}
            {%- if fact != blank %}
          <li>{{ fact | escape }}</li>
            {%- endif -%}
          {%- endfor %}
        </ul>
      </div>

      <div class="press__sheets">
        {%- assign page_n = 0 -%}
        {%- for s in sheet_list -%}
          {%- assign sheet = s | strip -%}
          {%- if sheet != blank -%}
            {%- assign page_n = page_n | plus: 1 -%}
            {%- if section.settings.enable_lightbox %}
        <button type="button" class="press__sheet" aria-label="Read {{ block.settings.pub | escape }}, page {{ page_n }}"><img src="{{ sheet | asset_url }}" alt="{{ block.settings.pub | escape }}, page {{ page_n }}" loading="lazy"><span class="press__pageno">{% if page_n < 10 %}0{% endif %}{{ page_n }}</span></button>
            {%- else %}
        <figure class="press__sheet"><img src="{{ sheet | asset_url }}" alt="{{ block.settings.pub | escape }}, page {{ page_n }}" loading="lazy"><span class="press__pageno">{% if page_n < 10 %}0{% endif %}{{ page_n }}</span></figure>
            {%- endif -%}
          {%- endif -%}
        {%- endfor %}
      </div>
    </article>
      {%- endif -%}
    {%- endfor %}
  </div>
  {%- endif %}

  {%- if section.settings.show_cta %}
  <div class="curated__more" data-reveal>
    <a class="btn btn--ghost" href="{{ section.settings.cta_url | default: '/pages/lldc' }}">{{ section.settings.cta_label | escape }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </div>
  {%- endif %}
</section>
{%- endif %}

<script>
(function () {
  /* The chapter rail is optional, so the run-once guard and the behaviour flags
     hang off the hero instead — the one region that always renders. */
  var host = document.querySelector('.page-hero--ghost');
  var rail = document.querySelector('.chapters');
  if (!host || host.__shrujanInit) return;
  host.__shrujanInit = true;

  // An absent flag means the hand-built default, so today's behaviour stands.
  var LIGHTBOX = host.getAttribute('data-lightbox-enabled') !== 'false';

  /* ---- Lightbox (port of components/Lightbox.jsx) ----
     `items` is [{ src, alt, caption }]; `index` is the open frame, or -1 closed. */

  var ICON_CLOSE = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 6 12 12M18 6 6 18"></path></svg>';
  var ICON_PREV = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5 8 12l6.5 6.5"></path></svg>';
  var ICON_NEXT = '<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9.5 5.5 6.5 6.5-6.5 6.5"></path></svg>';

  var lbItems = [];
  var lbIndex = -1;
  var lbEl = null;

  function lbRender() {
    var item = lbItems[lbIndex];
    var many = lbItems.length > 1;
    var html = '<button class="lightbox__close" aria-label="Close">' + ICON_CLOSE + '</button>';
    if (many) {
      html += '<button class="lightbox__nav lightbox__nav--prev" aria-label="Previous">' + ICON_PREV + '</button>';
    }
    html += '<figure class="lightbox__frame"><img src="' + item.src + '" alt="' + (item.alt || '') + '">';
    if (item.caption || many) {
      html += '<figcaption class="lightbox__cap"><span>' + (item.caption || item.alt) + '</span>';
      if (many) {
        html += '<span class="lightbox__count">' + (lbIndex + 1) + ' / ' + lbItems.length + '</span>';
      }
      html += '</figcaption>';
    }
    html += '</figure>';
    if (many) {
      html += '<button class="lightbox__nav lightbox__nav--next" aria-label="Next">' + ICON_NEXT + '</button>';
    }
    lbEl.setAttribute('aria-label', item.caption || item.alt || 'Image viewer');
    lbEl.innerHTML = html;
  }

  function lbStep(delta) {
    if (!lbItems.length) return;
    lbIndex = (lbIndex + delta + lbItems.length) % lbItems.length; // wrap both ways
    lbRender();
  }

  function lbKey(e) {
    if (e.key === 'Escape') lbClose();
    else if (e.key === 'ArrowRight') lbStep(1);
    else if (e.key === 'ArrowLeft') lbStep(-1);
  }

  function lbClose() {
    if (!lbEl) return;
    lbIndex = -1;
    window.removeEventListener('keydown', lbKey);
    Shrujan.startScroll();
    lbEl.remove();
    lbEl = null;
  }

  function lbOpen(items, index) {
    lbItems = items;
    lbIndex = index;
    if (!(lbIndex >= 0 && lbIndex < lbItems.length)) {
      lbClose();
      return;
    }
    if (lbEl) {
      lbRender();
      return;
    }
    lbEl = document.createElement('div');
    lbEl.setAttribute('class', 'lightbox');
    lbEl.setAttribute('role', 'dialog');
    lbEl.setAttribute('aria-modal', 'true');
    lbEl.addEventListener('click', function (e) {
      if (e.target.closest('.lightbox__close')) { lbClose(); return; }
      if (e.target.closest('.lightbox__nav--prev')) { lbStep(-1); return; }
      if (e.target.closest('.lightbox__nav--next')) { lbStep(1); return; }
      if (e.target.closest('.lightbox__frame')) return; // clicking the picture itself does not close
      lbClose();
    });
    lbRender();
    document.body.appendChild(lbEl);
    Shrujan.stopScroll();
    window.addEventListener('keydown', lbKey);
  }

  /* ---- Photo Journal: open the twelve frames ---- */

  // [{ src, alt }] emitted by the section's journal blocks — every src is
  // already a resolved asset/image URL, ready for the lightbox as it is.
  var journalHost = document.querySelector('.journal-bento');
  var JOURNAL = JSON.parse((journalHost && journalHost.getAttribute('data-lightbox')) || '[]');

  if (LIGHTBOX) {
    document.querySelectorAll('.journal-bento .jshot').forEach(function (btn, i) {
      btn.addEventListener('click', function () {
        lbOpen(JOURNAL.map(function (x) {
          return { src: x.src, alt: x.alt, caption: x.alt };
        }), i);
      });
    });
  }

  /* ---- In the Media: open the tearsheets ---- */

  // Each article carries { publication, headline, pages } emitted by its
  // press block; pages are the resolved tearsheet URLs in reading order.

  if (LIGHTBOX) {
    document.querySelectorAll('.press .press__item').forEach(function (article) {
      var p = JSON.parse(article.getAttribute('data-press') || 'null');
      if (!p) return;
      article.querySelectorAll('.press__sheet').forEach(function (btn, i) {
        btn.addEventListener('click', function () {
          lbOpen(p.pages.map(function (s, n) {
            return {
              src: s,
              alt: p.publication + ': ' + p.headline + ', page ' + (n + 1),
              caption: p.publication + ' · ' + p.headline + ' · page ' + (n + 1) + ' of ' + p.pages.length
            };
          }), i);
        });
      });
    });
  }

  /* ---- Chapter rail: jumps + scroll-spy ---- */

  // Land a section clear of the floating header, which reappears on scroll up.
  // Measured rather than assumed: the bar's height changes with the breakpoint.
  function jumpOffset() {
    var header = document.querySelector('.site-header');
    return (header ? header.offsetHeight : 0) + 28;
  }

  // Empty when the rail is switched off; the scroll-spy below then has nothing
  // to light up, and every other feature on the page carries on regardless.
  var chapterLinks = rail ? Array.prototype.slice.call(rail.querySelectorAll('.chapters__link')) : [];

  chapterLinks.forEach(function (link) {
    link.addEventListener('click', function (e) {
      e.preventDefault();
      var id = (link.getAttribute('href') || '').slice(1);
      var el = document.getElementById(id);
      if (!el) return;
      Shrujan.scrollToY(el.getBoundingClientRect().top + window.scrollY - jumpOffset());
    });
  });

  function setActive(id) {
    chapterLinks.forEach(function (a) {
      var on = a.getAttribute('href') === '#' + id;
      a.classList.toggle('is-active', on);
      if (on) a.setAttribute('aria-current', 'true');
      else a.removeAttribute('aria-current');
    });
  }

  // Light up the chapter the reader is actually in. rootMargin biases the
  // decision to the upper third so a section counts as "current" once its head
  // is near the top, not when it happens to cross the middle.
  var sections = ['origins', 'values', 'people', 'journal', 'press']
    .map(function (id) { return document.getElementById(id); })
    .filter(Boolean);

  if (sections.length) {
    // A callback only carries the sections whose state CHANGED, so it cannot be
    // read on its own — keep the live set across callbacks and decide from that.
    var inBand = new Set();

    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) inBand.add(e.target);
          else inBand.delete(e.target);
        });
        if (!inBand.size) return;
        // At a boundary two sections straddle the band: take the greatest
        // top — the last section to have started — or the rail reads one behind.
        var current = Array.from(inBand).sort(function (a, b) {
          return b.getBoundingClientRect().top - a.getBoundingClientRect().top;
        })[0];
        setActive(current.id);
      },
      { rootMargin: '-18% 0px -62% 0px', threshold: 0 }
    );
    sections.forEach(function (s) { io.observe(s); });
  }

  /* ---- Deep links (/pages/the-shrujan-story#press): land clear of the header ---- */

  function scrollToHash() {
    if (!location.hash) return;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () {
        var el = document.querySelector(location.hash);
        if (!el) return;
        Shrujan.scrollToY(el.getBoundingClientRect().top + window.scrollY - jumpOffset());
      });
    });
  }
  scrollToHash();
  window.addEventListener('hashchange', scrollToHash);
})();
</script>
{% schema %}
{
  "name": "The Shrujan Story",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "text",
      "id": "ghost",
      "label": "Ghost year (background)",
      "default": "1969"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "The Shrujan Story"
    },
    {
      "type": "inline_richtext",
      "id": "hero_title",
      "label": "Title",
      "default": "Fifty years of dignity, stitched by hand"
    },
    {
      "type": "textarea",
      "id": "hero_lede",
      "label": "Lede",
      "default": "The first social enterprise in the crafts sector to turn embroidery into a livelihood for the craftswomen of Kutch."
