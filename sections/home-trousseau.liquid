<section class="section container" id="curated">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="section-intro__copy">
      {{ section.settings.intro }}
    </p>
  </div>

  <div class="curated__filters" data-reveal role="tablist" aria-label="Filter by occasion">
    <button type="button" role="tab" aria-selected="true" class="curated__filter is-active">{{ section.settings.tab_1 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_2 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_3 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_4 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_5 }}</button>
  </div>

  <div class="curated__grid" data-reveal-child>
    <a class="piece" href="/pages/shop-shrujan#catalogue">
      <div class="piece__media">
        <img src="{{ 'sj-black-pakko-hand-embroidered-kanchli-1.webp' | asset_url }}" alt="Model wearing the black pakko hand embroidered kanchli" loading="lazy">
        <button class="piece__wish" type="button" aria-label="Save Black Pakko Hand Embroidered Kanchli to wishlist">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>
        </button>
        <span class="piece__quick">Add to bag</span>
      </div>

      <div class="piece__info">
        <p class="piece__name">Black Pakko Hand Embroidered Kanchli</p>
        <p class="piece__craft">Pakko · Kutch</p>
        <p class="piece__price">₹ 25,000</p>
        <span class="piece__swatches" aria-hidden="true">
          <i style="background: #241f1f"></i><i style="background: #c7a56a"></i><i style="background: #f2ede0"></i>
        </span>
      </div>
    </a>
    <a class="piece" href="/pages/shop-shrujan#catalogue">
      <div class="piece__media">
        <img src="{{ 'sj-coffe-brown-hand-embroidered-kanchli-1.webp' | asset_url }}" alt="Model wearing the coffe brown hand embroidered kanchli" loading="lazy">
        <button class="piece__wish" type="button" aria-label="Save Coffe Brown Hand Embroidered Kanchli to wishlist">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>
        </button>
        <span class="piece__quick">Add to bag</span>
      </div>

      <div class="piece__info">
        <p class="piece__name">Coffe Brown Hand Embroidered Kanchli</p>
        <p class="piece__craft">Kutchi hand-embroidery</p>
        <p class="piece__price">₹ 28,000</p>
        <span class="piece__swatches" aria-hidden="true">
          <i style="background: #5b4033"></i><i style="background: #c7a56a"></i><i style="background: #f2ede0"></i>
        </span>
      </div>
    </a>
    <a class="piece" href="/pages/shop-shrujan#catalogue">
      <div class="piece__media">
        <img src="{{ 'sj-turquoise-hand-embroidered-kanchli-1.webp' | asset_url }}" alt="Model wearing the turquoise hand embroidered kanchli" loading="lazy">
        <button class="piece__wish" type="button" aria-label="Save Turquoise Hand Embroidered Kanchli to wishlist">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>
        </button>
        <span class="piece__quick">Add to bag</span>
      </div>

      <div class="piece__info">
        <p class="piece__name">Turquoise Hand Embroidered Kanchli</p>
        <p class="piece__craft">Kutchi hand-embroidery</p>
        <p class="piece__price">₹ 25,000</p>
        <span class="piece__swatches" aria-hidden="true">
          <i style="background: #1f7a8c"></i><i style="background: #c7a56a"></i><i style="background: #f2ede0"></i>
        </span>
      </div>
    </a>
    <a class="piece" href="/pages/shop-shrujan#catalogue">
      <div class="piece__media">
        <img src="{{ 'sj-megenta-pink-hand-embroidered-kanchli-1.webp' | asset_url }}" alt="Model wearing the megenta pink hand embroidered kanchli" loading="lazy">
        <span class="piece__badge">Sold out</span>
        <button class="piece__wish" type="button" aria-label="Save Megenta Pink Hand Embroidered Kanchli to wishlist">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>
        </button>
        <span class="piece__quick">Add to bag</span>
      </div>

      <div class="piece__info">
        <p class="piece__name">Megenta Pink Hand Embroidered Kanchli</p>
        <p class="piece__craft">Kutchi hand-embroidery</p>
        <p class="piece__price">₹ 25,000</p>
        <span class="piece__swatches" aria-hidden="true">
          <i style="background: #a8306a"></i><i style="background: #c7a56a"></i><i style="background: #f2ede0"></i>
        </span>
      </div>
    </a>
    <a class="piece" href="/pages/shop-shrujan#catalogue">
      <div class="piece__media">
        <img src="{{ 'sj-beige-hand-embroidered-kanchli-1.webp' | asset_url }}" alt="Model wearing the beige hand embroidered kanchli" loading="lazy">
        <button class="piece__wish" type="button" aria-label="Save Beige Hand Embroidered Kanchli to wishlist">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>
        </button>
        <span class="piece__quick">Add to bag</span>
      </div>

      <div class="piece__info">
        <p class="piece__name">Beige Hand Embroidered Kanchli</p>
        <p class="piece__craft">Kutchi hand-embroidery</p>
        <p class="piece__price">₹ 28,000</p>
        <span class="piece__swatches" aria-hidden="true">
          <i style="background: #c9b79c"></i><i style="background: #c7a56a"></i><i style="background: #f2ede0"></i>
        </span>
      </div>
    </a>
  </div>

  <div class="curated__more" data-reveal>
    <a class="btn btn--ghost" href="{{ section.settings.more_url }}">
      {{ section.settings.more_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
    </a>
  </div>

  <div class="curated__promises" data-reveal-child>
    {%- for block in section.blocks %}
    <div class="promise" {{ block.shopify_attributes }}>
      <p class="promise__title">{{ block.settings.title }}</p>
      <p class="promise__copy">{{ block.settings.copy }}</p>
    </div>
    {%- endfor %}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('curated');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var FILTERS = ['All', 'Bridal', 'Festive', 'Everyday', 'Gifting'];
  var grid = root.querySelector('.curated__grid');
  var buttons = root.querySelectorAll('.curated__filter');
  var filter = 'All';

  var HEART =
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">' +
    '<path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>';

  function pieceHTML(p) {
    var badge = p.badge ? '<span class="piece__badge">' + p.badge + '</span>' : '';
    var was = p.was ? '<span>' + p.was + '</span>' : '';
    var swatches = p.swatches
      .map(function (c) { return '<i style="background: ' + c + '"></i>'; })
      .join('');
    return (
      '<a class="piece" href="/pages/shop-shrujan#catalogue">' +
        '<div class="piece__media">' +
          '<img src="' + window.SHRUJAN.asset(p.img) + '" alt="' + p.alt + '" loading="lazy">' +
          badge +
          '<button class="piece__wish" type="button" aria-label="Save ' + p.name + ' to wishlist">' + HEART + '</button>' +
          '<span class="piece__quick">Add to bag</span>' +
        '</div>' +
        '<div class="piece__info">' +
          '<p class="piece__name">' + p.name + '</p>' +
          '<p class="piece__craft">' + p.craft + '</p>' +
          '<p class="piece__price">' + p.price + was + '</p>' +
          '<span class="piece__swatches" aria-hidden="true">' + swatches + '</span>' +
        '</div>' +
      '</a>'
    );
  }

  function renderGrid() {
    var pieces = window.SHRUJAN.PIECES;
    var shown = (filter === 'All'
      ? pieces
      : pieces.filter(function (p) { return p.tag === filter; })
    ).slice(0, 5);
    grid.innerHTML = shown.map(pieceHTML).join('');
  }

  function setFilter(f) {
    if (f === filter) return;
    filter = f;
    buttons.forEach(function (btn, i) {
      var active = FILTERS[i] === filter;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    renderGrid();
  }

  buttons.forEach(function (btn, i) {
    btn.addEventListener('click', function () { setFilter(FILTERS[i]); });
  });

  /* the wishlist heart sits inside the card link — keep its click from navigating */
  root.addEventListener('click', function (e) {
    if (e.target.closest && e.target.closest('.piece__wish')) e.preventDefault();
  });
})();
</script>
