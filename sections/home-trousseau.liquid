{%- render 'section-design', section: section -%}
{%- comment -%}
  Curated pieces — the home-page edit, rendered from real products.

  The grid is five cards, as designed. Each occasion tab is its own five-card
  slice, all of them rendered server-side and all but the open one carried with
  the `hidden` attribute, so pressing a tab needs no reload and no catalogue in
  JavaScript. Price, compare-at price and availability are the product's.

  A tab is filled one of two ways. Give it a collection and it shows that
  collection, which is how a store whose products carry no occasion still gets
  five full tabs. Leave the collection empty and the tab keeps its occasion:
  the products whose `shrujan.occasion` metafield names it. Craft, badge and
  swatches come from the same namespace where they exist.

  Source for the first tab, and for any occasion tab: the collection picked
  below, or every product in the store when none is picked. Layout controls stay in the scoped <style>; the card's own parts
  are now Liquid conditions, because Liquid — not a script — builds the cards.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  assign src = cfg.tr_collection.products
  if cfg.tr_collection == blank
    assign src = collections.all.products
  endif

  comment
    The tabs are fixed occasions in a fixed order — only their labels are
    editable — so the group keys live here and the labels stay settings.
    With the tabs hidden only the opening slice is worth rendering.
  endcomment
  if cfg.tr_show_filters
    assign groups = 'All,Bridal,Festive,Everyday,Gifting' | split: ','
  else
    assign groups = 'All' | split: ','
  endif

  assign has_layout = false
  if cfg.tr_cols != 5 or cfg.tr_cols_m != 2 or cfg.tr_ratio != 'default'
    assign has_layout = true
  endif
  comment
    Mobile group. The card's shape is the one thing the stylesheet steps on its
    own — 3/4, then 5/6 at 1500px, then 4/5 at 600px — so the phone shape goes
    into that 600px query, after the all-widths `tr_ratio` above it. The
    promises row steps 4 → 2 → 1 on 1080 and 600, so its phone count belongs in
    the same 600px band.
  endcomment
  if cfg.tr_ratio_m != 'default' or cfg.tr_promise_cols_m != 2
    assign has_layout = true
  endif
  if cfg.tr_show_filters and cfg.tr_show_filters_m == false
    assign has_layout = true
  endif
-%}
{%- if has_layout -%}
  <style>
    {%- if cfg.tr_cols != 5 -%}
      @media (min-width: 1081px) {
        {{ sel }} .curated__grid { grid-template-columns: repeat({{ cfg.tr_cols }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.tr_cols_m != 2 -%}
      @media (max-width: 720px) {
        {{ sel }} .curated__grid { grid-template-columns: repeat({{ cfg.tr_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.tr_ratio != 'default' -%}
      {{ sel }} .piece__media { aspect-ratio: {{ cfg.tr_ratio }}; }
    {%- endif -%}

    {%- if cfg.tr_ratio_m != 'default' or cfg.tr_promise_cols_m != 2 or cfg.tr_show_filters_m == false -%}
      @media (max-width: 600px) {
        {%- if cfg.tr_ratio_m != 'default' -%}
          {{ sel }} .piece__media { aspect-ratio: {{ cfg.tr_ratio_m }}; }
        {%- endif -%}
        {%- if cfg.tr_promise_cols_m != 2 -%}
          {{ sel }} .curated__promises { grid-template-columns: repeat({{ cfg.tr_promise_cols_m }}, minmax(0, 1fr)); }
          {%- comment -%}
            At one column the theme moves each promise's hairline from its side
            to its top. Side by side again, the side rule is what separates them.
          {%- endcomment -%}
          {{ sel }} .promise + .promise { border-top: 0; }
          {{ sel }} .promise { border-left: 1px solid var(--hairline); }
          {{ sel }} .curated__promises .promise:nth-child({{ cfg.tr_promise_cols_m }}n + 1) { border-left: 0; }
        {%- endif -%}
        {%- if cfg.tr_show_filters and cfg.tr_show_filters_m == false -%}
          {{ sel }} .curated__filters { display: none; }
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
{%- liquid
  comment
    The home page's head (snippets/sj-hx.liquid): a meta row, the title in two
    lines and the intro beside it. The theme's reveal attributes are left off
    this section, since assets/sj-home.js brings its blocks in itself.
  endcomment
  assign tr_meta_l = cfg.tr_meta_l | escape
  assign tr_meta_r = cfg.tr_meta_r | escape
  assign tr_l1 = cfg.tr_line_1 | escape
  assign tr_l2 = cfg.tr_line_2 | escape
  assign tr_lede = section.settings.intro | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip
-%}
<section class="section container" id="curated">
  {% render 'sj-hx', meta_l: tr_meta_l, meta_r: tr_meta_r, l1: tr_l1, l2: tr_l2, lede: tr_lede %}

  {% if cfg.tr_show_filters %}
  <div class="curated__filters" role="tablist" aria-label="Filter the edit">
    <button type="button" role="tab" aria-selected="true" class="curated__filter is-active">{{ section.settings.tab_1 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_2 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_3 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_4 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_5 }}</button>
  </div>
  {% endif %}

  <div class="curated__grid">
    {%- for group in groups %}
    {%- liquid
      assign tab_col = nil
      case forloop.index
        when 2
          assign tab_col = cfg.tab_2_collection
        when 3
          assign tab_col = cfg.tab_3_collection
        when 4
          assign tab_col = cfg.tab_4_collection
        when 5
          assign tab_col = cfg.tab_5_collection
      endcase
      assign tab_src = src
      assign tab_takes_all = false
      if group == 'All'
        assign tab_takes_all = true
      endif
      if tab_col != blank
        assign tab_src = tab_col.products
        assign tab_takes_all = true
      endif
    -%}
    {%- assign taken = 0 %}
    {%- for product in tab_src %}
    {%- if taken >= 5 %}{% break %}{% endif %}
    {%- assign occasion = product.metafields.shrujan.occasion.value %}
    {%- if tab_takes_all or occasion == group %}
    {%- liquid
      assign taken = taken | plus: 1
      assign card_img = product.featured_image


      assign card_craft = product.metafields.shrujan.craft.value

      assign card_swatches = product.metafields.shrujan.swatches.value
    -%}
    <a class="piece" href="{{ product.url }}" data-f="{{ group }}"{% unless group == 'All' %} hidden{% endunless %}>
      <div class="piece__media">
        {%- if card_img %}
        <img src="{{ card_img | image_url: width: 900 }}" alt="{{ card_img.alt | default: product.title | escape }}" loading="lazy">
        {%- else %}
        {{ 'product-1' | placeholder_svg_tag: 'piece__ph' }}
        {%- endif %}
        {%- render 'piece-badge', product: product, show: cfg.tr_show_badge %}
        {%- if cfg.tr_show_wish %}
        {%- endif %}
        {%- if cfg.tr_show_quick %}
        <span class="piece__quick"{% render 'sj-quick-attrs', product: product %}>Add to bag</span>
        {%- endif %}
      </div>

      <div class="piece__info">
        <p class="piece__name">{{ product.title | escape }}</p>
        {%- if card_craft != blank %}
        <p class="piece__craft">{{ card_craft | escape }}</p>
        {%- endif %}
        {%- if cfg.tr_show_price %}
        <p class="piece__price">{{ product.price | money | strip_html }}{% if cfg.tr_show_was and product.compare_at_price > product.price %}<span>{{ product.compare_at_price | money | strip_html }}</span>{% endif %}</p>
        {%- endif %}
        {%- if cfg.tr_show_swatches and card_swatches != blank %}
        <span class="piece__swatches" aria-hidden="true">
          {% for swatch in card_swatches %}<i style="background: {{ swatch }}"></i>{% endfor %}
        </span>
        {%- endif %}
      </div>
    </a>
    {%- endif %}
    {%- endfor %}
    {%- endfor %}
  </div>

  <div class="curated__more">
    <a class="btn btn--ghost" href="{{ section.settings.more_url | default: '/pages/shop-shrujan#catalogue' }}">
      {{ section.settings.more_label }} <i class="sj-i sj-i--arrow-right ms" style="font-size:16px" aria-hidden="true"></i>
    </a>
  </div>

  <div class="curated__promises">
    {%- comment -%} each promise's icon (shown on phones, where the promises are an icon and a heading in one row) {%- endcomment -%}
    {%- assign promise_icons = 'truck,arrows-counter-clockwise,map-pin,clock-counter-clockwise' | split: ',' -%}
    {%- for block in section.blocks %}
    {%- assign p_icon = block.settings.icon | default: promise_icons[forloop.index0] | default: 'sparkle' -%}
    <div class="promise" {{ block.shopify_attributes }}>
      <span class="promise__icon" aria-hidden="true"><i class="sj-i sj-i--{{ p_icon }} ms"></i></span>
      <p class="promise__title">{{ block.settings.title }}</p>
      <p class="promise__copy">{{ block.settings.copy }}</p>
    </div>
    {%- endfor %}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root || root.__shrujanCurated) return;
  root.__shrujanCurated = true;

  var grid = root.querySelector('.curated__grid');
  if (!grid) return;

  /* The five occasion slices are all on the page already, so a tab only has to
     decide which of them is on show. Fixed keys, in the order the tabs are
     rendered — the labels beside them are the merchant's. */
  var FILTERS = ['All', 'Bridal', 'Festive', 'Everyday', 'Gifting'];
  var buttons = root.querySelectorAll('.curated__filter');
  var cards = Array.prototype.slice.call(grid.querySelectorAll('.piece'));
  var filter = 'All';

  function show(f) {
    cards.forEach(function (card) {
      if (card.getAttribute('data-f') === f) card.removeAttribute('hidden');
      else card.setAttribute('hidden', '');
    });
  }

  function setFilter(f) {
    if (f === filter) return;
    filter = f;
    buttons.forEach(function (btn, i) {
      var active = FILTERS[i] === filter;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    show(filter);
    /* on a phone the cards are a swipe row; a new tab starts at its first card */
    grid.scrollLeft = 0;
  }

  buttons.forEach(function (btn, i) {
    btn.addEventListener('click', function () { setFilter(FILTERS[i]); });
  });

  /* the wishlist heart sits inside the card link — keep its click from navigating */
  root.addEventListener('click', function (e) {
    if (e.target.closest && e.target.closest('.piece__wish')) e.preventDefault();
  });
})();
</script>
