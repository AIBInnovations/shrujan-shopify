{%- render 'section-design', section: section -%}
{%- comment -%}
  Curated pieces — the home-page edit, rendered from real products.

  The grid is five cards, as designed. Each occasion tab is its own five-card
  slice, all of them rendered server-side and all but the open one carried with
  the `hidden` attribute, so pressing a tab needs no reload and no catalogue in
  JavaScript. The occasion itself is the product's `shrujan.occasion` metafield,
  editable per product in admin; craft, badge and swatches come from the same
  namespace, and price, compare-at price and availability from the product.

  Source: the collection picked below, or every product in the store when none
  is picked. Layout controls stay in the scoped <style>; the card's own parts
  are now Liquid conditions, because Liquid — not a script — builds the cards.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  assign src = cfg.tr_collection.products
  if cfg.tr_collection == blank
    assign src = collections.all.products
  endif

  comment
    The tabs are fixed occasions in a fixed order — only their labels are
    editable — so the group keys live here and the labels stay settings.
    With the tabs hidden only the opening slice is worth rendering.
  endcomment
  if cfg.tr_show_filters
    assign groups = 'All,Bridal,Festive,Everyday,Gifting' | split: ','
  else
    assign groups = 'All' | split: ','
  endif

  assign has_layout = false
  if cfg.tr_cols != 5 or cfg.tr_cols_m != 2 or cfg.tr_ratio != 'default'
    assign has_layout = true
  endif
-%}
{%- if has_layout -%}
  <style>
    {%- if cfg.tr_cols != 5 -%}
      @media (min-width: 1081px) {
        {{ sel }} .curated__grid { grid-template-columns: repeat({{ cfg.tr_cols }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.tr_cols_m != 2 -%}
      @media (max-width: 720px) {
        {{ sel }} .curated__grid { grid-template-columns: repeat({{ cfg.tr_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.tr_ratio != 'default' -%}
      {{ sel }} .piece__media { aspect-ratio: {{ cfg.tr_ratio }}; }
    {%- endif -%}
  </style>
{%- endif -%}
<section class="section container" id="curated">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="section-intro__copy">
      {{ section.settings.intro }}
    </p>
  </div>

  {% if cfg.tr_show_filters %}
  <div class="curated__filters" data-reveal role="tablist" aria-label="Filter by occasion">
    <button type="button" role="tab" aria-selected="true" class="curated__filter is-active">{{ section.settings.tab_1 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_2 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_3 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_4 }}</button>
    <button type="button" role="tab" aria-selected="false" class="curated__filter">{{ section.settings.tab_5 }}</button>
  </div>
  {% endif %}

  <div class="curated__grid" data-reveal-child>
    {%- for group in groups %}
    {%- assign taken = 0 %}
    {%- for product in src %}
    {%- if taken >= 5 %}{% break %}{% endif %}
    {%- assign occasion = product.metafields.shrujan.occasion.value %}
    {%- if group == 'All' or occasion == group %}
    {%- liquid
      assign taken = taken | plus: 1
      assign card_img = product.featured_image

      # The merchant's own badge, overridden by a piece that cannot be bought.
      assign card_badge = product.metafields.shrujan.badge.value
      if product.available == false
        assign card_badge = 'Sold out'
      endif

      assign card_craft = product.metafields.shrujan.craft.value
      if card_craft == blank
        assign card_craft = product.type
      endif

      assign card_swatches = product.metafields.shrujan.swatches.value
    -%}
    <a class="piece" href="{{ product.url }}" data-f="{{ group }}"{% unless group == 'All' %} hidden{% endunless %}>
      <div class="piece__media">
        {%- if card_img %}
        <img src="{{ card_img | image_url: width: 900 }}" alt="{{ card_img.alt | default: product.title | escape }}" loading="lazy">
        {%- else %}
        {{ 'product-1' | placeholder_svg_tag: 'piece__ph' }}
        {%- endif %}
        {%- if cfg.tr_show_badge and card_badge != blank %}
        <span class="piece__badge">{{ card_badge | escape }}</span>
        {%- endif %}
        {%- if cfg.tr_show_wish %}
        <button class="piece__wish" type="button" aria-label="Save {{ product.title | escape }} to wishlist">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>
        </button>
        {%- endif %}
        {%- if cfg.tr_show_quick %}
        <span class="piece__quick">Add to bag</span>
        {%- endif %}
      </div>

      <div class="piece__info">
        <p class="piece__name">{{ product.title | escape }}</p>
        {%- if card_craft != blank %}
        <p class="piece__craft">{{ card_craft | escape }}</p>
        {%- endif %}
        {%- if cfg.tr_show_price %}
        <p class="piece__price">{{ product.price | money }}{% if cfg.tr_show_was and product.compare_at_price > product.price %}<span>{{ product.compare_at_price | money }}</span>{% endif %}</p>
        {%- endif %}
        {%- if cfg.tr_show_swatches and card_swatches != blank %}
        <span class="piece__swatches" aria-hidden="true">
          {% for swatch in card_swatches %}<i style="background: {{ swatch }}"></i>{% endfor %}
        </span>
        {%- endif %}
      </div>
    </a>
    {%- endif %}
    {%- endfor %}
    {%- endfor %}
  </div>

  <div class="curated__more" data-reveal>
    <a class="btn btn--ghost" href="{{ section.settings.more_url | default: '/pages/shop-shrujan#catalogue' }}">
      {{ section.settings.more_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
    </a>
  </div>

  <div class="curated__promises" data-reveal-child>
    {%- for block in section.blocks %}
    <div class="promise" {{ block.shopify_attributes }}>
      <p class="promise__title">{{ block.settings.title }}</p>
      <p class="promise__copy">{{ block.settings.copy }}</p>
    </div>
    {%- endfor %}
  </div>
</section>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root || root.__shrujanCurated) return;
  root.__shrujanCurated = true;

  var grid = root.querySelector('.curated__grid');
  if (!grid) return;

  /* The five occasion slices are all on the page already, so a tab only has to
     decide which of them is on show. Fixed keys, in the order the tabs are
     rendered — the labels beside them are the merchant's. */
  var FILTERS = ['All', 'Bridal', 'Festive', 'Everyday', 'Gifting'];
  var buttons = root.querySelectorAll('.curated__filter');
  var cards = Array.prototype.slice.call(grid.querySelectorAll('.piece'));
  var filter = 'All';

  function show(f) {
    cards.forEach(function (card) {
      if (card.getAttribute('data-f') === f) card.removeAttribute('hidden');
      else card.setAttribute('hidden', '');
    });
  }

  function setFilter(f) {
    if (f === filter) return;
    filter = f;
    buttons.forEach(function (btn, i) {
      var active = FILTERS[i] === filter;
      btn.classList.toggle('is-active', active);
      btn.setAttribute('aria-selected', active ? 'true' : 'false');
    });
    show(filter);
  }

  buttons.forEach(function (btn, i) {
    btn.addEventListener('click', function () { setFilter(FILTERS[i]); });
  });

  /* the wishlist heart sits inside the card link — keep its click from navigating */
  root.addEventListener('click', function (e) {
    if (e.target.closest && e.target.closest('.piece__wish')) e.preventDefault();
  });
})();
</script>
