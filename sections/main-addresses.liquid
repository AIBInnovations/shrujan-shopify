{%- render 'section-design', section: section -%}
{%- comment -%}
  Addresses — add, edit and delete, all through the `customer_address` form tag.

  Add and edit are `<details>` disclosures rather than JavaScript panels, so
  they work with scripts blocked; the add form opens itself for a customer who
  has no address yet. Delete is a plain POST with `_method=delete` — exactly
  the request Shopify's own helper builds — so it also works without JS, with
  the confirmation added on top when JS is available.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
-%}
<header class="store-head container" data-reveal>
  {%- if cfg.eyebrow != blank %}
  <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
  {%- endif %}
  <h1 class="store-head__title">{{ cfg.heading }}</h1>
  {%- if cfg.lede != blank %}
  <p class="store-head__lede">{{ cfg.lede }}</p>
  {%- endif %}
  <p class="store-note"><a href="{{ routes.account_url }}">{{ cfg.back_label }}</a></p>
</header>

<div class="container store-stack store-stack--page" data-reveal>
  <details class="store-reveal" {% if customer.addresses_count == 0 %}open{% endif %}>
    <summary>{{ cfg.new_title }}</summary>
    {%- form 'customer_address', customer.new_address %}
      {%- render 'store-form-errors', form: form -%}
      <div class="store-form store-form--wide">
        {%- render 'store-address-fields', form: form, cfg: cfg, prefix: 'NewAddress', is_default: false -%}
        <button type="submit" class="store-btn">{{ cfg.new_submit }}</button>
      </div>
    {%- endform %}
  </details>

  {%- if customer.addresses_count > 0 %}
  <div class="store-addresses">
    {%- for address in customer.addresses %}
    {%- liquid
      assign is_default = false
      if address.id == customer.default_address.id
        assign is_default = true
      endif
      comment
        Field ids must start with a letter to stay valid selectors, and be
        unique across every form on the page — hence the address id behind a
        prefix rather than on its own.
      endcomment
      assign edit_prefix = 'Address' | append: address.id
    -%}
    <div class="store-panel">
      {%- if is_default %}
      <span class="journal-pill">{{ cfg.default_badge }}</span>
      {%- endif %}
      <div class="store-address__lines">{{ address | format_address }}</div>

      <div class="store-address__actions">
        <details class="store-reveal">
          <summary>{{ cfg.edit_label }}</summary>
          {%- form 'customer_address', address %}
            {%- render 'store-form-errors', form: form -%}
            <div class="store-form store-form--wide">
              {%- render 'store-address-fields', form: form, cfg: cfg, prefix: edit_prefix, is_default: is_default -%}
              <button type="submit" class="store-btn">{{ cfg.update_label }}</button>
            </div>
          {%- endform %}
        </details>

        <form method="post" action="{{ address.url }}">
          <input type="hidden" name="_method" value="delete">
          <button type="submit" class="store-btn store-btn--quiet" data-confirm="{{ cfg.delete_confirm | escape }}">{{ cfg.delete_label }}</button>
        </form>
      </div>
    </div>
    {%- endfor %}
  </div>
  {%- endif %}
</div>

<script>
(function () {
  /* ---- delete: confirm before the POST goes out ---- */
  document.querySelectorAll('[data-confirm]').forEach(function (button) {
    button.addEventListener('click', function (event) {
      if (!window.confirm(button.getAttribute('data-confirm'))) event.preventDefault();
    });
  });

  /* ---- country → province, read off Shopify's own option data ----
     `all_country_option_tags` hangs each country's provinces on its option as
     JSON, so the second select can be built from the first with no vendor
     script. A country with no provinces hides the field instead of offering an
     empty menu. */
  document.querySelectorAll('[data-address-country]').forEach(function (country) {
    var scope = country.closest('form');
    if (!scope) return;
    var province = scope.querySelector('[data-address-province]');
    var field = province ? province.closest('.store-field') : null;
    if (!province || !field) return;

    function fill() {
      var option = country.options[country.selectedIndex];
      var list = [];
      try { list = JSON.parse(option.getAttribute('data-provinces') || '[]'); } catch (e) { list = []; }

      province.innerHTML = '';
      if (!list.length) {
        field.hidden = true;
        return;
      }
      field.hidden = false;

      var wanted = province.getAttribute('data-default');
      list.forEach(function (pair) {
        var opt = document.createElement('option');
        opt.value = pair[0];
        opt.textContent = pair[1];
        if (pair[0] === wanted) opt.selected = true;
        province.appendChild(opt);
      });
    }

    var preset = country.getAttribute('data-default');
    if (preset) country.value = preset;
    fill();
    country.addEventListener('change', fill);
  });
})();
</script>
