{%- render 'section-design', section: section -%}

{%- comment -%}
  The hero, the way Delta Cafés' is: three stories, each a craft film across
  the screen under a soft dark wash — the title and a pill button low on the
  left, a small grid of glass cards on the right (two of them turn over with
  the story), the stories as numbered thumbnails along the foot whose lines
  fill as each plays — and under the film the heritage of Kutch: its makers,
  villages, crafts and land, in a strip of captioned photographs that drifts
  and can be dragged.

  Stories and heritage tiles are blocks; with none added, the defaults
  below are shown. Styles and behaviour are the home page layer's
  (assets/sj-home.css and sj-home.js, from awwwards-preview/src/hero.css and
  hero.js); the loader opens onto the first film. The awwwards preview builds
  the same markup (awwwards-preview/build.py). Films go through
  snippets/sj-film-url, so the craft films play in 1080p.
{%- endcomment -%}
{%- liquid
  assign h = section.settings
  assign arrow = '<i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i>'
  assign story_defaults = 'craft-embroidery.mp4|craft-embroidery-poster.webp|38|Consciously crafted~since 1969.|Shop the collection|/pages/shop-shrujan^craft-ajrakh.mp4|craft-ajrakh-poster.webp|8|A sustainable story~of the crafts of Kutch.|Craft Traditions|/pages/video^craft-weaving.mp4|craft-weaving-poster.webp|8|Threads~of life.|The Shrujan Story|/pages/the-shrujan-story' | split: '^'
  assign tile_defaults = 'The Banni villages|Village|/pages/visit-experience|visit-banni.webp|Artisan women embroidering together at the centre^The People of Shrujan|People|/pages/the-shrujan-story|journal-10.webp|A craftswoman beside a finished embroidered panel^Ajrakh Block Print|Craft|/pages/video|visit-ajrakhpur.webp|A printer working a block along a long table of cloth^The Rann of Kutch|Place|/pages/visit-experience|kutch-rann.webp|Camels on the salt flat of the Rann of Kutch^Continuity of Craft|Heritage|/pages/the-shrujan-story|story-continuity.webp|A younger embroiderer learning the craft^Kutch weaving|Craft|/pages/video|bottom-left.webp|Master weaver working threads at his handloom^The exhibition hall|Heritage|/pages/the-shrujan-story|journal-7.webp|Craftswomen seated in the exhibition hall, textiles hung on the walls^Dignity and Respect|People|/pages/the-shrujan-story|story-dignity.webp|A craftswoman beside her embroidery^Pottery|Craft|/pages/video|lldc-studio.webp|A potter throwing a vessel on the wheel in the LLDC crafts studio^Lakhpat|Place|/pages/visit-experience|visit-lakhpat.webp|The walled fort at Lakhpat above the salt flat^The LLDC galleries|Museum|/pages/lldc|lldc-gallery-3.webp|A curved gallery of Kutchi costume under museum lighting^From the archive|Archive|/pages/the-shrujan-story|journal-3.webp|A craftswoman bent over her embroidery frame' | split: '^'
  assign stories = section.blocks | where: 'type', 'story'
  assign tiles = section.blocks | where: 'type', 'tile'

  comment
    Each story, whether a block or a default, becomes one line
    film|poster url|start|title lines (~)|button|link, so one loop draws them.
  endcomment
  assign rows = ''
  if stories.size > 0
    for b in stories limit: 3
      assign bs = b.settings
      if bs.poster != blank
        assign p_url = bs.poster | image_url: width: 1600
      else
        assign p_url = bs.poster_asset | default: 'craft-embroidery-poster.webp' | asset_url
      endif
      assign t_lines = bs.title | strip | newline_to_br | replace: '<br />', '~'
      assign row = bs.film | append: '|' | append: p_url | append: '|' | append: bs.start | append: '|' | append: t_lines | append: '|' | append: bs.btn_label | append: '|' | append: bs.btn_link
      assign rows = rows | append: row | append: '^'
    endfor
  else
    for d in story_defaults
      assign f = d | split: '|'
      assign p_url = f[1] | asset_url
      assign row = f[0] | append: '|' | append: p_url | append: '|' | append: f[2] | append: '|' | append: f[3] | append: '|' | append: f[4] | append: '|' | append: f[5]
      assign rows = rows | append: row | append: '^'
    endfor
  endif
  assign rows = rows | split: '^'
-%}
<section class="hero hero--delta" aria-roledescription="carousel" aria-label="{{ h.aria_label | escape }}" data-duration="{{ h.duration }}">
  <div class="dh__fold">
    <div class="dh__bg" aria-hidden="true">
      {%- for r in rows -%}
        {%- assign f = r | split: '|' -%}
        {%- capture film -%}{% render 'sj-film-url', src: f[0] %}{%- endcapture -%}
        <div class="dh__media{% if forloop.first %} is-active{% endif %}"><video class="dh__video" data-src="{{ film }}" preload="{% if forloop.first %}auto{% else %}none{% endif %}" poster="{{ f[1] }}" data-start="{{ f[2] | default: 0 }}" muted playsinline aria-hidden="true"></video></div>
      {%- endfor -%}
    </div>
    <div class="dh__content">
      <div class="dh__top">
        <div class="dh__titles">
          {%- for r in rows -%}
            {%- assign f = r | split: '|' -%}
            {%- assign lines = f[3] | split: '~' -%}
            <div class="dh__slide{% if forloop.first %} is-active{% endif %}" id="dh-slide-{{ forloop.index }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ rows.size }}">
              {%- if forloop.first %}<h1 class="dh__title">{% else %}<h2 class="dh__title">{% endif -%}
              {%- for l in lines %}<span class="dh__line"><span>{{ l | strip | escape }}</span></span>{% endfor -%}
              {%- if forloop.first %}</h1>{% else %}</h2>{% endif -%}
              {%- if f[4] != blank -%}
              <a class="dh-btn" href="{{ f[5] | escape }}"><span class="dh-btn__bg"></span><span class="dh-btn__icon"><span class="dh-btn__ic">{{ arrow }}</span><span class="dh-btn__ic dh-btn__ic--ghost">{{ arrow }}</span></span><span class="dh-btn__label">{{ f[4] | escape }}</span></a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- liquid
          if h.c2a_image != blank
            assign c2a = h.c2a_image | image_url: width: 600
          else
            assign c2a = h.c2a_asset | default: 'craft-hero.webp' | asset_url
          endif
          if h.c2b_image != blank
            assign c2b = h.c2b_image | image_url: width: 600
          else
            assign c2b = h.c2b_asset | default: 'visit-banni.webp' | asset_url
          endif
          if h.c3_image != blank
            assign c3 = h.c3_image | image_url: width: 300
          else
            assign c3 = h.c3_asset | default: 'sj-red-hand-ahir-embroidered-kanchli-1.webp' | asset_url
          endif
          if h.c4a_image != blank
            assign c4a = h.c4a_image | image_url: width: 400
          else
            assign c4a = h.c4a_asset | default: 'story-origin-4.webp' | asset_url
          endif
          if h.c4b_image != blank
            assign c4b = h.c4b_image | image_url: width: 400
          else
            assign c4b = h.c4b_asset | default: 'mandala.webp' | asset_url
          endif
        -%}
        <div class="dh__cards">
          <div class="dh__cell dh__cell--1"><a class="dh__cta" href="{{ h.c1_link | escape }}"><span class="dh__label">{{ h.c1_label | escape }}</span><span class="dh__arrow">{{ arrow }}</span></a></div>
          <div class="dh__cell dh__cell--2" data-alt>
            <a class="dh__cta" href="{{ h.c2a_link | escape }}"><img src="{{ c2a }}" alt="{{ h.c2a_alt | escape }}" loading="lazy"><span class="dh__label">{{ h.c2a_label | escape }}</span></a>
            <a class="dh__cta is-off" href="{{ h.c2b_link | escape }}" tabindex="-1"><img src="{{ c2b }}" alt="{{ h.c2b_alt | escape }}" loading="lazy"><span class="dh__label">{{ h.c2b_label | escape }}</span></a>
          </div>
          <div class="dh__cell dh__cell--3"><a class="dh__cta" href="{{ h.c3_link | escape }}"><span class="dh__thumb"><img src="{{ c3 }}" alt="{{ h.c3_alt | escape }}" loading="lazy"></span><span class="dh__label">{{ h.c3_label | escape }}</span></a></div>
          <div class="dh__cell dh__cell--4" data-alt>
            <a class="dh__cta" href="{{ h.c4a_link | escape }}"><span class="dh__thumb"><img src="{{ c4a }}" alt="{{ h.c4a_alt | escape }}" loading="lazy"></span><span class="dh__copy"><span class="dh__label">{{ h.c4a_title | escape }}</span><span class="dh__desc">{{ h.c4a_desc | escape }}</span></span><span class="dh__arrow">{{ arrow }}</span></a>
            <a class="dh__cta is-off" href="{{ h.c4b_link | escape }}" tabindex="-1"><span class="dh__thumb"><img{% if h.c4b_spin %} class="dh__spin"{% endif %} src="{{ c4b }}" alt="" loading="lazy"></span><span class="dh__copy"><span class="dh__label">{{ h.c4b_title | escape }}</span><span class="dh__desc">{{ h.c4b_desc | escape }}</span></span><span class="dh__arrow">{{ arrow }}</span></a>
          </div>
        </div>
      </div>

      <div class="dh__bottom">
        <div class="dh__thumbs">
          <ul class="dh__tabs" role="tablist" aria-label="Choose a story">
            {%- for r in rows -%}
              {%- assign f = r | split: '|' -%}
              {%- assign lines = f[3] | split: '~' -%}
              <li><button class="dh__tab{% if forloop.first %} is-active{% endif %}" type="button" role="tab" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="dh-slide-{{ forloop.index }}"><span class="dh__prog"><i></i></span><span class="dh__tthumb"><img src="{{ f[1] }}" alt="" loading="lazy"></span><span class="dh__tcopy"><span>{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><span>{% for l in lines %}{{ l | strip | escape }}{% unless forloop.last %} <br>{% endunless %}{% endfor %}</span></span></button></li>
            {%- endfor -%}
          </ul>
          <span class="dh__remain" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>

  {%- if h.show_strip %}
  <div class="dh__strip" aria-label="{{ h.strip_label | escape }}">
    <div class="dh__track">
      <ul class="dh__list">
        {%- if tiles.size > 0 -%}
          {%- for b in tiles -%}
            {%- liquid
              if b.settings.image != blank
                assign t_img = b.settings.image | image_url: width: 640
                assign t_alt = b.settings.alt | default: b.settings.image.alt | default: b.settings.label
              else
                assign t_img = b.settings.asset | default: 'visit-banni.webp' | asset_url
                assign t_alt = b.settings.alt | default: b.settings.label
              endif
            -%}
            <li class="dh__tile" {{ b.shopify_attributes }}><a href="{{ b.settings.link | escape }}" draggable="false"><span class="dh__tmedia"><img src="{{ t_img }}" alt="{{ t_alt | escape }}" loading="lazy"><span class="dh__tname"><span class="dh__kicker">{{ b.settings.kicker | escape }}</span><span class="dh__tlabel">{{ b.settings.label | escape }}</span></span></span></a></li>
          {%- endfor -%}
        {%- else -%}
          {%- for d in tile_defaults -%}
            {%- assign t = d | split: '|' -%}
            <li class="dh__tile"><a href="{{ t[2] }}" draggable="false"><span class="dh__tmedia"><img src="{{ t[3] | asset_url }}" alt="{{ t[4] | escape }}" loading="lazy"><span class="dh__tname"><span class="dh__kicker">{{ t[1] | escape }}</span><span class="dh__tlabel">{{ t[0] | escape }}</span></span></span></a></li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
  </div>
  {%- endif %}
</section>

{% schema %}
{
  "name": "Home — Hero",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "aria_label", "label": "Name read out to screen readers", "default": "Shrujan stories" },
    { "type": "range", "id": "duration", "label": "Seconds on each story", "min": 4, "max": 12, "step": 0.5, "unit": "s", "default": 6.5 },
    { "type": "header", "content": "Card 1 — the pill" },
    { "type": "text", "id": "c1_label", "label": "Label", "default": "Shop Shrujan" },
    { "type": "text", "id": "c1_link", "label": "Link", "default": "/pages/shop-shrujan" },
    { "type": "header", "content": "Card 2 — the tall photograph (turns over)" },
    { "type": "image_picker", "id": "c2a_image", "label": "Front: photograph" },
    { "type": "text", "id": "c2a_asset", "label": "Front: or theme image file", "default": "craft-hero.webp" },
    { "type": "text", "id": "c2a_alt", "label": "Front: image description", "default": "Embroiderers of Kutch working together outside their village" },
    { "type": "text", "id": "c2a_label", "label": "Front: label", "default": "Craft Traditions of Kutch" },
    { "type": "text", "id": "c2a_link", "label": "Front: link", "default": "/pages/video" },
    { "type": "image_picker", "id": "c2b_image", "label": "Back: photograph" },
    { "type": "text", "id": "c2b_asset", "label": "Back: or theme image file", "default": "visit-banni.webp" },
    { "type": "text", "id": "c2b_alt", "label": "Back: image description", "default": "Artisan women embroidering together at the centre" },
    { "type": "text", "id": "c2b_label", "label": "Back: label", "default": "Visit Kutch" },
    { "type": "text", "id": "c2b_link", "label": "Back: link", "default": "/pages/visit-experience" },
    { "type": "header", "content": "Card 3 — the small picture" },
    { "type": "image_picker", "id": "c3_image", "label": "Picture" },
    { "type": "text", "id": "c3_asset", "label": "Or theme image file", "default": "sj-red-hand-ahir-embroidered-kanchli-1.webp" },
    { "type": "text", "id": "c3_alt", "label": "Image description", "default": "Red Ahir hand-embroidered kanchli" },
    { "type": "text", "id": "c3_label", "label": "Label", "default": "Studio Collection" },
    { "type": "text", "id": "c3_link", "label": "Link", "default": "/pages/studio-collection" },
    { "type": "header", "content": "Card 4 — the wide card (turns over)" },
    { "type": "image_picker", "id": "c4a_image", "label": "Front: picture" },
    { "type": "text", "id": "c4a_asset", "label": "Front: or theme image file", "default": "story-origin-4.webp" },
    { "type": "text", "id": "c4a_alt", "label": "Front: image description", "default": "Archive photograph of Shrujan artisans" },
    { "type": "text", "id": "c4a_title", "label": "Front: title", "default": "The Shrujan Story" },
    { "type": "textarea", "id": "c4a_desc", "label": "Front: line", "default": "From Kaki’s vision to the hands of thousands of women across Kutch." },
    { "type": "text", "id": "c4a_link", "label": "Front: link", "default": "/pages/the-shrujan-story" },
    { "type": "image_picker", "id": "c4b_image", "label": "Back: picture" },
    { "type": "text", "id": "c4b_asset", "label": "Back: or theme image file", "default": "mandala.webp" },
    { "type": "checkbox", "id": "c4b_spin", "label": "Back: turn the picture slowly (for a round motif)", "default": true },
    { "type": "text", "id": "c4b_title", "label": "Back: title", "default": "The LLDC Museum" },
    { "type": "textarea", "id": "c4b_desc", "label": "Back: line", "default": "A museum and cultural institution dedicated to the crafts of Kutch." },
    { "type": "text", "id": "c4b_link", "label": "Back: link", "default": "/pages/lldc" },
    { "type": "header", "content": "Heritage strip" },
    { "type": "checkbox", "id": "show_strip", "label": "Show the heritage strip under the film", "default": true },
    { "type": "text", "id": "strip_label", "label": "Name read out to screen readers", "default": "The heritage of Kutch" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story",
      "limit": 3,
      "settings": [
        { "type": "text", "id": "film", "label": "Film", "info": "A full URL from Content → Files, or a theme file. The craft films (craft-*.mp4) play in 1080p.", "default": "craft-embroidery.mp4" },
        { "type": "number", "id": "start", "label": "Start the film at (seconds)", "default": 0 },
        { "type": "image_picker", "id": "poster", "label": "Still (shown before the film and in its thumbnail)" },
        { "type": "text", "id": "poster_asset", "label": "Or theme image file", "default": "craft-embroidery-poster.webp" },
        { "type": "textarea", "id": "title", "label": "Title", "info": "One line per line of the title.", "default": "Living craft traditions,\ncarried forward\nsince 1969." },
        { "type": "text", "id": "btn_label", "label": "Button label", "default": "Shop the collection" },
        { "type": "text", "id": "btn_link", "label": "Button link", "default": "/pages/shop-shrujan" }
      ]
    },
    {
      "type": "tile",
      "name": "Heritage tile",
      "settings": [
        { "type": "text", "id": "label", "label": "Name", "default": "The Banni villages" },
        { "type": "text", "id": "kicker", "label": "Small word over the name", "info": "Village, People, Craft, Place, Museum…", "default": "Village" },
        { "type": "text", "id": "link", "label": "Link", "default": "/pages/visit-experience" },
        { "type": "image_picker", "id": "image", "label": "Photograph", "info": "Artisans, villages, the land; a landscape photograph fits best." },
        { "type": "text", "id": "asset", "label": "Or theme image file", "default": "visit-banni.webp" },
        { "type": "text", "id": "alt", "label": "Photograph description", "default": "Artisan women embroidering together at the centre" }
      ]
    }
  ],
  "presets": [ { "name": "Home — Hero" } ]
}
{% endschema %}
