{%- render 'section-design', section: section -%}

{%- comment -%}
  The hero is one film: the craft montage, on the marquee's inset and ending at
  the bottom of the screen, with the headline set over its middle. Nothing else
  sits in it.

  Hero-specific controls. --hero-h is how far down the screen the film reaches,
  header included (100 packaged, the bottom of the screen), and it plays under
  a dark wash that keeps the words readable (--hero-scrim, 0.45 packaged).
  Nothing is emitted unless a setting has moved, so an untouched hero is
  byte-identical.

  The two heights are each written inside their own width range rather than one
  overriding the other, so changing the desktop height leaves a phone on its own
  setting, and the reverse.
{%- endcomment -%}
{%- liquid
  assign h = section.settings
  assign hsel = '#shopify-section-' | append: section.id

  assign h_style = false
  if h.hero_h != 100 or h.hero_h_m != 100 or h.hero_scrim != 45
    assign h_style = true
  endif
-%}

{%- if h_style -%}
  <style>
    {%- if h.hero_h != 100 -%}
      @media (min-width: 721px) { {{ hsel }} { --hero-h: {{ h.hero_h }}; } }
    {%- endif -%}
    {%- if h.hero_h_m != 100 -%}
      @media (max-width: 720px) { {{ hsel }} { --hero-h: {{ h.hero_h_m }}; } }
    {%- endif -%}
    {%- if h.hero_scrim != 45 -%}
      {{ hsel }} { --hero-scrim: {{ h.hero_scrim | divided_by: 100.0 }}; }
    {%- endif -%}
  </style>
{%- endif -%}

{%- comment -%}
  The craft films, one after another: a few seconds from the middle of each,
  where the hands are working. One line per film: film | poster.
{%- endcomment -%}
{%- assign montage_lines = h.montage_films | newline_to_br | split: '<br />' -%}
{%- assign montage_first = '' -%}
{%- assign montage_first_poster = '' -%}
{%- capture montage_json -%}[
  {%- assign m_n = 0 -%}
  {%- for l in montage_lines -%}
    {%- assign line = l | strip -%}
    {%- if line != blank -%}
      {%- assign parts = line | split: '|' -%}
      {%- assign m_film = parts[0] | strip | asset_url -%}
      {%- assign m_poster = parts[1] | strip -%}
      {%- if m_poster != blank -%}{%- assign m_poster = m_poster | asset_url -%}{%- endif -%}
      {%- if m_n == 0 -%}
        {%- assign montage_first = m_film -%}
        {%- assign montage_first_poster = m_poster -%}
      {%- else -%},{%- endif -%}
      {"src":{{ m_film | json }},"poster":{{ m_poster | json }}}
      {%- assign m_n = m_n | plus: 1 -%}
    {%- endif -%}
  {%- endfor -%}
]{%- endcapture %}
<section class="hero hero--film" aria-label="{{ section.settings.title_l1 | strip_html | escape }} {{ section.settings.title_l2 | strip_html | downcase | escape }} {{ section.settings.title_l3 | strip_html | downcase | escape }}"{% if h.hero_animate == false %} data-hero-animate="false"{% endif %}>
  {%- if montage_first != blank %}
  <video class="hero-montage__video" poster="{{ montage_first_poster }}" playsinline muted preload="auto" aria-hidden="true" data-hero-montage="{{ montage_json | escape }}" data-clip="{{ h.montage_clip }}" data-seek="{{ h.montage_seek }}"><source src="{{ montage_first }}" type="video/mp4"></video>
  {%- endif %}
  <span class="hero-film__scrim" aria-hidden="true"></span>

  <div class="hero-film__message">
    <h1 class="hero-message__title"><span class="line"><span class="t-ink">{{ section.settings.title_l1 }}</span></span><span class="line"><span class="t-red">{{ section.settings.title_l2 }}</span></span><span class="line"><span class="t-red">{{ section.settings.title_l3 }}</span></span></h1>
    <span class="hero-message__rule" data-hero="rule" aria-hidden="true"></span>
    <p class="hero-message__copy" data-hero="copy">{{ section.settings.copy }}</p>
    <a class="hero-message__cta" href="{{ section.settings.cta_url | escape }}" data-hero="cta">{{ section.settings.cta_label | escape }} <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('.hero');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  /* Intro animation is on unless the section says otherwise. Skipping the
     timeline leaves the words in their natural, fully visible state — the
     hidden start values only ever exist as GSAP inline styles. */
  var animate = root.getAttribute('data-hero-animate') !== 'false';

  /* ---- The film: the craft montage (port of CraftMontage in Hero.jsx) ----
     Each film opens at its middle, plays for the clip length, then hands over
     to the next. Off screen the montage stops and fetches nothing; with reduced
     motion it never starts, and the first poster simply stands. */
  var montage = root.querySelector('[data-hero-montage]');
  if (montage) {
    var films = [];
    try { films = JSON.parse(montage.getAttribute('data-hero-montage')) || []; } catch (e) {}
    var source = montage.querySelector('source');
    var clipMs = (parseFloat(montage.getAttribute('data-clip')) || 4) * 1000;
    var seekTo = parseFloat(montage.getAttribute('data-seek')) || 0;
    var still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var current = 0, timer = null, inView = true, started = false;
    montage.muted = true;

    var showFilm = function (i) {
      current = i;
      if (films[i].poster) montage.setAttribute('poster', films[i].poster);
      source.setAttribute('src', films[i].src);
      montage.load();
    };

    montage.addEventListener('loadedmetadata', function () {
      montage.currentTime = Math.min(seekTo, Math.max(0, montage.duration / 2 - 2));
    });
    montage.addEventListener('seeked', function () {
      if (!inView) return;
      var p = montage.play();
      if (p && p.catch) p.catch(function () {});
      clearTimeout(timer);
      if (films.length > 1) timer = setTimeout(function () { showFilm((current + 1) % films.length); }, clipMs);
    });

    if (films.length && !still) {
      if ('IntersectionObserver' in window) {
        new IntersectionObserver(function (entries) {
          inView = entries[0].isIntersecting;
          if (!inView) {
            clearTimeout(timer);
            montage.pause();
          } else {
            showFilm(started ? (current + 1) % films.length : 0);
            started = true;
          }
        }).observe(montage);
      } else {
        showFilm(0);
      }
    }
  }

  var mm = gsap.matchMedia(root);

  /* The film itself never animates in — it is the first thing painted, and
     holding it back would only delay the page. The words arrive over it. */
  if (animate) mm.add('(prefers-reduced-motion: no-preference)', function () {
    var tl = gsap.timeline({
      defaults: { ease: 'power3.out', duration: 0.9 },
    });

    tl.fromTo(
      '.hero-message__title .line > span',
      { yPercent: 110 },
      { yPercent: 0, duration: 1, stagger: 0.12, ease: 'power4.out' },
      0.15
    )
      .fromTo(
        '[data-hero="rule"]',
        { scaleX: 0, transformOrigin: 'center center' },
        { scaleX: 1, duration: 0.6 },
        0.6
      )
      .fromTo('[data-hero="copy"]', { opacity: 0, y: 16 }, { opacity: 1, y: 0 }, 0.7)
      .fromTo('[data-hero="cta"]', { opacity: 0, y: 14 }, { opacity: 1, y: 0 }, 0.82);
  });

  mm.add('(prefers-reduced-motion: reduce)', function () {
    gsap.set('[data-hero], .hero-message__title .line > span', { clearProps: 'all', opacity: 1 });
  });
})();
</script>

{% schema %}
{
  "name": "Home hero",
  "settings": [
    {
      "type": "header",
      "content": "Film hero"
    },
    {
      "type": "range",
      "id": "hero_h",
      "label": "Height",
      "info": "How far down the screen the film reaches, header included. 100 ends it at the bottom of the screen. On phones, use the Mobile setting below.",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "range",
      "id": "hero_scrim",
      "label": "Darken the film",
      "info": "The dark wash over the film that keeps the words readable. 0 shows the film as shot.",
      "min": 0,
      "max": 80,
      "step": 5,
      "unit": "%",
      "default": 45
    },
    {
      "type": "checkbox",
      "id": "hero_animate",
      "label": "Play the intro animation",
      "info": "Off renders the hero in place — the headline lines, rule, copy and button never animate in.",
      "default": true
    },
    {
      "type": "header",
      "content": "Film"
    },
    {
      "type": "textarea",
      "id": "montage_films",
      "label": "Films (one per line)",
      "info": "Film | poster, both theme asset filenames. They play in this order.",
      "default": "craft-embroidery.mp4 | craft-embroidery-poster.webp\ncraft-ajrakh.mp4 | craft-ajrakh-poster.webp\ncraft-weaving.mp4 | craft-weaving-poster.webp\ncraft-tiedye.mp4 | craft-tiedye-poster.webp\ncraft-discharge.mp4 | craft-discharge-poster.webp\ncraft-pottery.mp4 | craft-pottery-poster.webp"
    },
    {
      "type": "range",
      "id": "montage_clip",
      "label": "Seconds of each film",
      "min": 2,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "range",
      "id": "montage_seek",
      "label": "Start each film at",
      "info": "Seconds in. Short films start nearer their middle instead.",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "s",
      "default": 6
    },
    {
      "type": "header",
      "content": "Centre message"
    },
    {
      "type": "inline_richtext",
      "id": "title_l1",
      "label": "Title line 1",
      "default": "Tradition,"
    },
    {
      "type": "inline_richtext",
      "id": "title_l2",
      "label": "Title line 2",
      "default": "Styled"
    },
    {
      "type": "inline_richtext",
      "id": "title_l3",
      "label": "Title line 3",
      "default": "Forward"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Where centuries-old craftsmanship meets contemporary design. Timeless pieces for today&rsquo;s tastemakers."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop the Collection"
    },
    {
      "type": "text",
      "id": "cta_url",
      "label": "Button link (URL or #anchor)",
      "default": "#categories"
    },
    {
      "type": "header",
      "content": "Mobile"
    },
    {
      "type": "range",
      "id": "hero_h_m",
      "label": "Height on phones",
      "info": "Phones only (720px and under).",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "vh",
      "default": 100
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "header",
      "content": "Design — mobile"
    },
    {
      "type": "select",
      "id": "sec_width_m",
      "label": "Section width on mobile",
      "info": "Only below 768px. Edge-to-edge removes the side gutter entirely.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow (wider gutters)"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "edge",
          "label": "Edge to edge"
        }
      ]
    },
    {
      "type": "select",
      "id": "sec_align_m",
      "label": "Text alignment on mobile",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Leave as designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "sec_custom_css_m",
      "label": "Custom CSS (mobile only)",
      "info": "Wrapped in a max-width: 767px media query for this section."
    }
  ],
  "presets": [
    {
      "name": "Home hero"
    }
  ]
}
{% endschema %}
