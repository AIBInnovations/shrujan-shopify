      "default": "First name"
    },
    {
      "type": "text",
      "id": "last_name_label",
      "label": "Last name label",
      "default": "Last name"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password label",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "password_hint",
      "label": "Password hint",
      "default": "At least five characters."
    },
    {
      "type": "text",
      "id": "submit_label",
