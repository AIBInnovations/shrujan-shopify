{%- render 'section-design', section: section -%}
{%- comment -%}
  Create account — the real `create_customer` form tag, nothing faked. Shopify
  signs the customer straight in on success and redirects to the account page,
  so the only state this template has to handle is the error state.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
-%}
<header class="store-head container" data-reveal>
  {%- if cfg.eyebrow != blank %}
  <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
  {%- endif %}
  <h1 class="store-head__title">{{ cfg.heading }}</h1>
  {%- if cfg.lede != blank %}
  <p class="store-head__lede">{{ cfg.lede }}</p>
  {%- endif %}
</header>

<div class="container store-duo" data-reveal>
  <div>
    {%- form 'create_customer' %}
      {%- render 'store-form-errors', form: form -%}
      <div class="store-form store-form--wide">
        {%- if cfg.show_names %}
        <div class="store-fields">
          <div class="store-field">
            <label for="RegisterFirstName">{{ cfg.first_name_label }}</label>
            <input type="text" id="RegisterFirstName" name="customer[first_name]" value="{{ form.first_name }}" autocomplete="given-name">
          </div>
          <div class="store-field">
            <label for="RegisterLastName">{{ cfg.last_name_label }}</label>
            <input type="text" id="RegisterLastName" name="customer[last_name]" value="{{ form.last_name }}" autocomplete="family-name">
          </div>
        </div>
        {%- endif %}

        <div class="store-field">
          <label for="RegisterEmail">{{ cfg.email_label }}</label>
          <input type="email" id="RegisterEmail" name="customer[email]" value="{{ form.email }}" autocomplete="email" autocapitalize="off" spellcheck="false" required>
        </div>

        <div class="store-field">
          <label for="RegisterPassword">{{ cfg.password_label }}</label>
          <input type="password" id="RegisterPassword" name="customer[password]" autocomplete="new-password" required>
          {%- if cfg.password_hint != blank %}
          <p class="store-note">{{ cfg.password_hint }}</p>
          {%- endif %}
        </div>

        {%- if cfg.show_marketing %}
        <label class="store-check" for="RegisterMarketing">
          <input type="checkbox" id="RegisterMarketing" name="customer[accepts_marketing]" value="true">
          {{ cfg.marketing_label }}
        </label>
        {%- endif %}

        <button type="submit" class="store-btn">{{ cfg.submit_label }}</button>
      </div>
    {%- endform %}
  </div>

  {%- if cfg.show_login %}
  <div class="store-stack">
    <div class="store-panel">
      <p class="store-panel__title">{{ cfg.login_title }}</p>
      <p class="store-panel__copy">{{ cfg.login_copy }}</p>
      <div class="store-address__actions">
        <a class="store-btn store-btn--quiet" href="{{ routes.account_login_url }}">{{ cfg.login_label }}</a>
      </div>
    </div>
  </div>
  {%- endif %}
</div>
{% schema %}
{
  "name": "Register",
  "settings": [
    {
      "type": "header",
      "content": "Masthead"
    },
    {
      "type": "text",
