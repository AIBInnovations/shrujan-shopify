{%- render 'section-design', section: section -%}
{%- comment -%}
  Account overview — real orders, real default address.

  `customer.orders` is paginated, so an old customer with two hundred orders
  gets pages rather than a truncated list, and each row links to Shopify's own
  order page for that customer (`order.customer_url`).
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
-%}
<header class="store-head container" data-reveal>
  {%- if cfg.eyebrow != blank %}
  <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
  {%- endif %}
  <h1 class="store-head__title">{{ cfg.heading }}</h1>
  {%- if cfg.lede != blank %}
  <p class="store-head__lede">{{ cfg.lede }}</p>
  {%- endif %}
</header>

<div class="container store-duo" data-reveal>
  <div>
    <h2 class="store-section-title">{{ cfg.orders_title }}</h2>

    {%- paginate customer.orders by cfg.per_page %}
      {%- if customer.orders.size > 0 %}
    <div class="store-scroll">
      <table class="store-table">
        <thead>
          <tr>
            <th scope="col">{{ cfg.col_order }}</th>
            <th scope="col">{{ cfg.col_date }}</th>
            <th scope="col">{{ cfg.col_payment }}</th>
            <th scope="col">{{ cfg.col_fulfillment }}</th>
            <th scope="col">{{ cfg.col_total }}</th>
          </tr>
        </thead>
        <tbody>
          {%- for order in customer.orders %}
          <tr>
            <td><a class="store-table__name" href="{{ order.customer_url }}">{{ order.name }}</a></td>
            <td>{{ order.created_at | date: format: cfg.date_format }}</td>
            <td>{{ order.financial_status_label }}</td>
            <td>{{ order.fulfillment_status_label }}</td>
            <td>{{ order.total_price | money }}</td>
          </tr>
          {%- endfor %}
        </tbody>
      </table>
    </div>

        {%- if paginate.pages > 1 %}
    <nav class="store-pager" role="navigation" aria-label="{{ cfg.orders_title | escape }}">
      {%- if paginate.previous.is_link %}<a href="{{ paginate.previous.url }}" rel="prev">&#8592;</a>{% endif %}
      {%- for part in paginate.parts %}
        {%- if part.is_link %}
      <a href="{{ part.url }}">{{ part.title }}</a>
        {%- elsif part.title == paginate.current_page %}
      <span aria-current="page">{{ part.title }}</span>
        {%- else %}
      <span>{{ part.title }}</span>
        {%- endif %}
      {%- endfor %}
      {%- if paginate.next.is_link %}<a href="{{ paginate.next.url }}" rel="next">&#8594;</a>{% endif %}
    </nav>
        {%- endif %}
      {%- else %}
    <div class="store-panel">
      <p class="store-panel__title">{{ cfg.empty_title }}</p>
      <p class="store-panel__copy">{{ cfg.empty_copy }}</p>
      <div class="store-address__actions">
        <a class="store-btn" href="{{ cfg.empty_cta_url | default: '/pages/shop-shrujan' }}">{{ cfg.empty_cta_label }}</a>
      </div>
    </div>
      {%- endif %}
    {%- endpaginate %}
  </div>

  <div class="store-stack">
    <div class="store-panel">
      <p class="store-panel__title">{{ cfg.address_title }}</p>
      {%- if customer.default_address %}
      <div class="store-address__lines">{{ customer.default_address | format_address }}</div>
      {%- else %}
      <p class="store-panel__copy">{{ cfg.no_address_note }}</p>
      {%- endif %}
      <div class="store-address__actions">
        <a class="store-btn store-btn--quiet" href="{{ routes.account_addresses_url }}">{{ cfg.address_manage_label }}</a>
      </div>
    </div>

    <div class="store-panel">
      <p class="store-panel__title">{{ cfg.details_title }}</p>
      <p class="store-panel__copy">{{ customer.name }}<br>{{ customer.email }}</p>
      <div class="store-address__actions">
        <a class="store-btn store-btn--quiet" href="{{ routes.account_logout_url }}">{{ cfg.logout_label }}</a>
      </div>
    </div>
  </div>
</div>
