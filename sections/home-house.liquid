{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id
-%}
{%- if cfg.house_cols_m != 2 -%}
  <style>
    {%- comment -%}
      Below 900px the theme already resets every tile's explicit grid placement
      (`grid-column: auto !important`), so a plain column count lands cleanly
      there. Above it the bento is hand-placed tile by tile and has no column
      count to change.
    {%- endcomment -%}
    @media (max-width: 900px) {
      {{ sel }} .house__grid { grid-template-columns: repeat({{ cfg.house_cols_m }}, minmax(0, 1fr)); }
    }
  </style>
{%- endif -%}
<section class="section container house" id="house">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="section-title">
      {{ section.settings.title }}
    </h2>
    <p class="section-intro__copy">
      {{ section.settings.copy | escape }}
    </p>
  </div>

  <div class="house__grid">
    {%- assign tiles = section.blocks | where: 'type', 'tile' -%}
    {%- for block in tiles %}
    <a class="house-tile" href="{{ block.settings.link | default: '/pages/shop-shrujan?c=kanchli' }}" {{ block.shopify_attributes }}>
      <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
      {% if cfg.house_show_scrim %}<span class="house-tile__scrim" aria-hidden="true"></span>{% endif %}
      <span class="house-tile__body">
        <span class="house-tile__name">{{ block.settings.name | escape }}</span>
        {% if cfg.house_show_note %}<span class="house-tile__note">{{ block.settings.note | escape }}</span>{% endif %}
      </span>
      {% if cfg.house_show_arrow %}
      <span class="house-tile__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
      </span>
      {% endif %}
    </a>
    {%- endfor %}
  </div>

  {% if cfg.house_show_strip %}
  <div class="house__strip" data-reveal>
    <span class="house__strip-label">{{ section.settings.strip_label | escape }}</span>
    <ul class="house__strip-links">
      {%- assign strip_links = section.blocks | where: 'type', 'strip_link' -%}
      {%- for block in strip_links %}
      <li {{ block.shopify_attributes }}>
        <a href="{{ block.settings.link | default: '/pages/shop-shrujan?c=potlis-and-batwas' }}">
          {{ block.settings.label | escape }} <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
        </a>
      </li>
      {%- endfor %}
    </ul>
  </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Home house grid",
