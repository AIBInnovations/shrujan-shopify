{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. The bento has no ratio box — its row height comes from the
    grid's own template rows, which the theme swaps for a per-tile min-height
    once the tiles stack (260px at 900px, 230px at 600px). 230px is therefore
    what a phone height control keys on. The corner arrow and the small note are
    markup switches already, so the phone versions only have work to do while
    the tile is still rendering them.
  endcomment
  assign h_style = false
  if cfg.house_cols_m != 2 or cfg.house_tile_h_m != 230
    assign h_style = true
  endif
  if cfg.house_show_arrow and cfg.house_show_arrow_m == false
    assign h_style = true
  endif
  if cfg.house_show_note and cfg.house_show_note_m == false
    assign h_style = true
  endif
-%}
{%- if h_style -%}
  <style>
    {%- if cfg.house_cols_m != 2 -%}
      {%- comment -%}
        Below 900px the theme already resets every tile's explicit grid placement
        (`grid-column: auto !important`), so a plain column count lands cleanly
        there. Above it the bento is hand-placed tile by tile and has no column
        count to change.
      {%- endcomment -%}
      @media (max-width: 900px) {
        {{ sel }} .house__grid { grid-template-columns: repeat({{ cfg.house_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.house_tile_h_m != 230 or cfg.house_show_arrow_m == false or cfg.house_show_note_m == false -%}
      @media (max-width: 600px) {
        {%- if cfg.house_tile_h_m != 230 -%}
          {{ sel }} .house-tile { min-height: {{ cfg.house_tile_h_m }}px; }
        {%- endif -%}
        {%- if cfg.house_show_arrow and cfg.house_show_arrow_m == false -%}
          {{ sel }} .house-tile__arrow { display: none; }
        {%- endif -%}
        {%- if cfg.house_show_note and cfg.house_show_note_m == false -%}
          {{ sel }} .house-tile__note { display: none; }
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
{%- comment -%}
  What Shrujan has mastered: the collections as a mosaic, Kanchli large on
  the left, each a photograph with its number, name, line and arrow over its
  foot, faint cross-stitch motifs round its corners, and a "View" disc that follows the cursor over them
  (assets/sj-home.js, styled by sj-home.css). The collections are the
  section's tile blocks; the strip-link blocks no longer show here.
{%- endcomment -%}
{%- liquid
  assign tiles = section.blocks | where: 'type', 'tile'
  assign count_words = 'One,Two,Three,Four,Five,Six,Seven,Eight,Nine,Ten,Eleven,Twelve' | split: ','
  assign n_plain = 0
  for t in tiles
    if t.settings.cta_label == blank
      assign n_plain = n_plain | plus: 1
    endif
  endfor
  assign count_word = n_plain
  if n_plain > 0 and n_plain <= count_words.size
    assign count_i = n_plain | minus: 1
    assign count_word = count_words[count_i]
  endif
-%}
<section class="idx" id="house" aria-label="{{ cfg.idx_line_1 | append: ' ' | append: cfg.idx_line_2 | escape }}">
  <div class="idx__meta"><span>{{ section.settings.eyebrow | escape }}</span><span>{{ count_word }} {{ cfg.idx_count_label | escape }}</span></div>
  <div class="idx__head">
    <h2 class="idx__title"><span class="idx__line">{{ cfg.idx_line_1 | escape }}</span><span class="idx__line idx__line--soft">{{ cfg.idx_line_2 | escape }}</span></h2>
    <p class="idx__lede">{{ section.settings.copy | escape }}</p>
    <span class="idx__rule" aria-hidden="true"><i></i><svg viewBox="-6 -6 12 12"><path d="M0-5 5 0 0 5-5 0z" fill="none" stroke="currentColor" stroke-width="1"/><path d="M0-2.2 2.2 0 0 2.2-2.2 0z" fill="currentColor"/></svg><i></i></span>
  </div>
  <div class="col__grid">
    {% for block in tiles -%}
    {%- assign cta = block.settings.cta_label -%}
    <a class="col__tile{% if cta != blank %} col__tile--shop{% endif %}" href="{{ block.settings.link | default: '/pages/shop-shrujan?c=kanchli' }}" {{ block.shopify_attributes }}>
      {%- if cta == blank -%}<span class="col__media"><img class="col__img" src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy"></span>{%- endif -%}
      {%- if cta != blank -%}<span class="col__cap"><span class="col__kick">Shop</span><span class="col__name">{{ block.settings.name | escape }}</span><span class="col__note">{{ block.settings.note | escape }}</span><span class="col__cta">{{ cta | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></span></span>{%- else -%}<span class="col__cap"><span class="col__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><span class="col__name">{{ block.settings.name | escape }}</span><span class="col__go" aria-hidden="true"><i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></span><span class="col__note">{{ block.settings.note | escape }}</span></span>{%- endif -%}
    </a>
    {%- endfor %}
  </div>
  <div class="idx__foot"><a class="arch__btn idx__btn" href="{{ cfg.idx_cta_link | default: '/pages/shop-shrujan' }}">{{ cfg.idx_cta_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>
    {%- if cfg.house_show_strip and section.settings.strip_label != blank -%}
    <a class="idx__more" href="{{ cfg.idx_more_link | default: '/pages/shop-shrujan?c=bags' }}">{{ section.settings.strip_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>
    {%- endif -%}
  </div>
  <div class="col__cursor" aria-hidden="true">View</div>
</section>

