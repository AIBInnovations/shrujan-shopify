  <section class="section container shop-why" aria-label="Why Shrujan">
    <div class="shop-head" data-reveal>
      <span class="orn" aria-hidden="true"><i></i><svg viewBox="0 0 32 32" width="15" height="15" fill="currentColor"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg><i></i></span>
