{%- render 'section-design', section: section -%}
{%- comment -%}
  Layout + region controls for this page. Two rules keep them safe:

   1. The scoped <style> below is written only when a value differs from the
      built design, and each override is confined to the breakpoint band it
      belongs to — an id-specificity rule would otherwise flatten the grid's
      own 3 → 2 → 1 steps.
   2. The catalogue grid, its cards and the sort order are rendered client-side
      from window.SHRUJAN, so those controls travel as data-* attributes on the
      section root and the inline script reads them with today's values as
      fallbacks. Each attribute is appended only when the merchant has changed
      it, so the default markup is byte-for-byte what it has always been.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign root_sel = '#shopify-section-' | append: section.id

  assign shop_data = ''
  if cfg.sort_default != 'featured'
    assign shop_data = shop_data | append: ' data-sort="' | append: cfg.sort_default | append: '"'
  endif
  unless cfg.card_badge
    assign shop_data = shop_data | append: ' data-card-badge="false"'
  endunless
  unless cfg.card_was
    assign shop_data = shop_data | append: ' data-card-was="false"'
  endunless
  unless cfg.card_swatches
    assign shop_data = shop_data | append: ' data-card-swatches="false"'
  endunless
  unless cfg.card_wish
    assign shop_data = shop_data | append: ' data-card-wish="false"'
  endunless
  unless cfg.card_quick
    assign shop_data = shop_data | append: ' data-card-quick="false"'
  endunless

  assign has_layout = false
  if cfg.grid_cols != 3 or cfg.grid_cols_m != 1 or cfg.show_rail == false
    assign has_layout = true
  endif
-%}
{%- if has_layout -%}
  <style>
    {%- if cfg.grid_cols != 3 or cfg.grid_cols_m != 1 -%}
      {{ root_sel }} { --shop-cols: {{ cfg.grid_cols }}; --shop-cols-m: {{ cfg.grid_cols_m }}; }
      {%- if cfg.grid_cols != 3 -%}
        @media (min-width: 901px) {
          {{ root_sel }} .shop-grid { grid-template-columns: repeat(var(--shop-cols), minmax(0, 1fr)); }
        }
      {%- endif -%}
      {%- if cfg.grid_cols_m != 1 -%}
        @media (max-width: 600px) {
          {{ root_sel }} .shop-grid { grid-template-columns: repeat(var(--shop-cols-m), minmax(0, 1fr)); }
        }
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      With the filter rail gone the body must give its column back, or the grid
      would render inside the 260px rail track.
    {%- endcomment -%}
    {%- if cfg.show_rail == false -%}
      {{ root_sel }} .shop-body { grid-template-columns: minmax(0, 1fr); }
    {%- endif -%}
  </style>
{%- endif -%}
<div class="page"{{ shop_data }}>
  <!-- ---- hero banner ---- -->
  <section class="shop-banner" aria-label="The handcrafted edit">
    <div class="shop-banner__frame">
      <img src="{{ 'shop-hero.webp' | asset_url }}" alt="Embroidered tote and potli, a handwoven cushion, and models in a bandhani dupatta and an embroidered blouse" fetchpriority="high">

      <div class="shop-banner__overlay">
        <p class="shop-banner__eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="shop-banner__title">{{ section.settings.hero_title }}</h1>
        <p class="shop-banner__copy">{{ section.settings.hero_copy }}</p>
        <a class="shop-banner__view" href="#catalogue">{{ section.settings.hero_view }}</a>
      </div>
    </div>
  </section>
{%- if section.settings.show_assure %}

  <!-- ---- what every piece comes with ---- -->
  <section class="shop-assure" aria-label="What every piece comes with">
    <ul class="container shop-assure__row" data-reveal-child>
      {%- for block in section.blocks %}{% if block.type == 'assure' %}
      <li{{ block.shopify_attributes }}>
        <span class="shop-assure__mark" aria-hidden="true">{% case block.settings.icon %}{% when 'leaf' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><path d="M20 4c0 8-4.6 13-11 13H5c0-8 4.6-13 11-13Z" stroke-linejoin="round"></path><path d="M5 20c2.4-4.4 5.6-7.4 9.5-9.3" stroke-linecap="round"></path></svg>{% when 'tape' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><rect x="2.5" y="8.5" width="19" height="7" rx="1.4"></rect><path d="M7 8.5v3M11 8.5v4.4M15 8.5v3M19 8.5v4.4" stroke-linecap="round"></path></svg>{% when 'truck' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><path d="M2 7h11v9H2zM13 10h4.5l3 3v3H13z" stroke-linejoin="round"></path><circle cx="6.5" cy="18" r="1.7"></circle><circle cx="17" cy="18" r="1.7"></circle></svg>{% when 'heart' %}<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><path d="M4 20 19 5" stroke-linecap="round"></path><circle cx="20.2" cy="3.8" r="1.6"></circle><path d="M7 17.5c1.8.6 3 .2 3.6-1.2" stroke-linecap="round"></path></svg>{% endcase %}</span>
        <span class="shop-assure__title">{{ block.settings.title }}</span>
        <span class="shop-assure__copy">{{ block.settings.copy }}</span>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </section>
{%- endif %}
