{%- render 'section-design', section: section -%}
{%- comment -%}
  Shop Shrujan — the catalogue, rendered from real Shopify collections.

  Where the data comes from
   · The medallion rail, the filter rail and the grid all read one list: the
     `collection` blocks, in block order, so the built sequence survives and a
     merchant can reorder, swap or drop a collection in the theme editor. A
     store that has never configured a block falls back to every collection
     that has products, so the section is never empty on a fresh install.
   · Cards read the product: title, url, featured image, price, compare-at
     price and availability. The four things Shopify has no native field for
     come from editable metafields in the `shrujan` namespace — craft, badge,
     swatches (occasion belongs to the home-page edit).
   · Counts are `collection.all_products_count`, so they follow the admin.

  What is still done in the browser, and only this
   1. `?c=<handle>` — the link contract the home page and the header already
      use. Liquid cannot read a query parameter on a page template, so every
      card is rendered server-side carrying the handles of the collections it
      belongs to, and the script hides the ones outside the selection. That is
      the same job the rail did before, minus the catalogue in JS.
   2. The sort menu is a listbox, so its pointer and keyboard behaviour is
      scripted. The order itself is computed in Liquid from the theme setting,
      so the page arrives sorted; picking another order re-lays the cards that
      are already on the page.

  Layout controls stay in a scoped <style>, written only when a value differs
  from the built design — an id-specificity rule would otherwise flatten the
  grid's own 3 → 2 → 1 steps.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign root_sel = '#shopify-section-' | append: section.id

  comment
    One list of collection handles, used three times below. Blocks first; every
    collection that has products when a merchant has configured none.
  endcomment
  assign col_keys = ''
  assign has_cols = false
  for block in section.blocks
    if block.type == 'collection'
      assign block_col = block.settings.collection
      if block_col != blank and block_col.all_products_count > 0
        assign col_keys = col_keys | append: block_col.handle | append: ','
        assign has_cols = true
      endif
    endif
  endfor
  unless has_cols
    for shop_col in collections
      if shop_col.all_products_count > 0
        assign col_keys = col_keys | append: shop_col.handle | append: ','
        assign has_cols = true
      endif
    endfor
  endunless
  assign col_keys = col_keys | split: ','

  comment
    The grid is every listed collection's products, in rail order — the order
    the catalogue has always opened in — deduplicated, then ordered server-side
    so the page needs no script to arrive sorted.
  endcomment
  assign grid_count = 0
  if has_cols
    for key in col_keys
      assign key_col = collections[key]
      if forloop.first
        assign grid_products = key_col.products
      else
        assign grid_products = grid_products | concat: key_col.products
      endif
    endfor
    assign grid_products = grid_products | uniq: 'id'

    case cfg.sort_default
      when 'price-asc'
        assign grid_products = grid_products | sort: 'price'
      when 'price-desc'
        assign grid_products = grid_products | sort: 'price' | reverse
      when 'name'
        assign grid_products = grid_products | sort: 'title'
    endcase

    assign grid_count = grid_products.size
  endif

  assign count_word = 'pieces'
  if grid_count == 1
    assign count_word = 'piece'
  endif

  comment
    The sort orders this menu implements. The keys travel on the options as
    data-sort so the script never has to carry a copy of the labels.
  endcomment
  assign sort_keys = 'featured,price-asc,price-desc,name' | split: ','
  assign sort_labels = 'Featured~Price, low to high~Price, high to low~Name, A–Z' | split: '~'
  assign sort_index = 0
  for key in sort_keys
    if key == cfg.sort_default
      assign sort_index = forloop.index0
    endif
  endfor

  assign has_layout = false
  if cfg.grid_cols != 3 or cfg.grid_cols_m != 1 or cfg.show_rail == false
    assign has_layout = true
  endif
-%}
{%- if has_layout -%}
  <style>
    {%- if cfg.grid_cols != 3 or cfg.grid_cols_m != 1 -%}
      {{ root_sel }} { --shop-cols: {{ cfg.grid_cols }}; --shop-cols-m: {{ cfg.grid_cols_m }}; }
      {%- if cfg.grid_cols != 3 -%}
        @media (min-width: 901px) {
          {{ root_sel }} .shop-grid { grid-template-columns: repeat(var(--shop-cols), minmax(0, 1fr)); }
        }
      {%- endif -%}
      {%- if cfg.grid_cols_m != 1 -%}
        @media (max-width: 600px) {
          {{ root_sel }} .shop-grid { grid-template-columns: repeat(var(--shop-cols-m), minmax(0, 1fr)); }
        }
      {%- endif -%}
    {%- endif -%}

    {%- comment -%}
      With the filter rail gone the body must give its column back, or the grid
      would render inside the 260px rail track.
    {%- endcomment -%}
    {%- if cfg.show_rail == false -%}
      {{ root_sel }} .shop-body { grid-template-columns: minmax(0, 1fr); }
    {%- endif -%}
  </style>
{%- endif -%}
<div class="page">
  <!-- ---- hero banner ---- -->
  <section class="shop-banner" aria-label="The handcrafted edit">
    <div class="shop-banner__frame">
      <img src="{{ 'shop-hero.webp' | asset_url }}" alt="Embroidered tote and potli, a handwoven cushion, and models in a bandhani dupatta and an embroidered blouse" fetchpriority="high">

      <div class="shop-banner__overlay">
        <p class="shop-banner__eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="shop-banner__title">{{ section.settings.hero_title }}</h1>
        <p class="shop-banner__copy">{{ section.settings.hero_copy }}</p>
        <a class="shop-banner__view" href="#catalogue">{{ section.settings.hero_view }}</a>
      </div>
    </div>
  </section>
{%- if section.settings.show_assure %}

  <!-- ---- what every piece comes with ---- -->
  <section class="shop-assure" aria-label="What every piece comes with">
    <ul class="container shop-assure__row" data-reveal-child>
      {%- for block in section.blocks %}{% if block.type == 'assure' %}
      <li{{ block.shopify_attributes }}>
        <span class="shop-assure__mark" aria-hidden="true">{% case block.settings.icon %}{% when 'leaf' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><path d="M20 4c0 8-4.6 13-11 13H5c0-8 4.6-13 11-13Z" stroke-linejoin="round"></path><path d="M5 20c2.4-4.4 5.6-7.4 9.5-9.3" stroke-linecap="round"></path></svg>{% when 'tape' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><rect x="2.5" y="8.5" width="19" height="7" rx="1.4"></rect><path d="M7 8.5v3M11 8.5v4.4M15 8.5v3M19 8.5v4.4" stroke-linecap="round"></path></svg>{% when 'truck' %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><path d="M2 7h11v9H2zM13 10h4.5l3 3v3H13z" stroke-linejoin="round"></path><circle cx="6.5" cy="18" r="1.7"></circle><circle cx="17" cy="18" r="1.7"></circle></svg>{% when 'heart' %}<svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>{% else %}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" width="19" height="19"><path d="M4 20 19 5" stroke-linecap="round"></path><circle cx="20.2" cy="3.8" r="1.6"></circle><path d="M7 17.5c1.8.6 3 .2 3.6-1.2" stroke-linecap="round"></path></svg>{% endcase %}</span>
        <span class="shop-assure__title">{{ block.settings.title }}</span>
        <span class="shop-assure__copy">{{ block.settings.copy }}</span>
      </li>
      {%- endif %}{% endfor %}
    </ul>
  </section>
{%- endif %}
{%- if section.settings.show_cats and has_cols %}

  <!-- ---- categories as medallions ---- -->
  <section class="section container shop-cats" aria-label="Collections">
    <div class="shop-head" data-reveal>
      <span class="orn" aria-hidden="true"><i></i><svg viewBox="0 0 32 32" width="15" height="15" fill="currentColor"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg><i></i></span>
      <h2 class="section-title">{{ section.settings.cats_title }}</h2>
      <p class="shop-head__copy">{{ section.settings.cats_copy }}</p>
    </div>

    <div class="shop-cats__wrap">
      <div class="shop-cats__rail" data-reveal-child>
        {%- for key in col_keys %}
        {%- liquid
          assign med = collections[key]
          assign med_img = med.image
          unless med_img
            assign med_img = med.products.first.featured_image
          endunless
          assign med_n = med.all_products_count
          assign med_word = 'pieces'
          if med_n == 1
            assign med_word = 'piece'
          endif
        -%}
        {%- if med.title != blank %}
        <button type="button" class="medallion" data-c="{{ med.handle }}" data-title="{{ med.title | escape }}">
          <span class="medallion__disc" style="--tint: {% cycle 'medallion': 'var(--ivory-2)', 'var(--gerua-100)', 'var(--mehendi-200)', 'var(--sand)' %}">{% if med_img %}<img src="{{ med_img | image_url: width: 640 }}" alt="{{ med_img.alt | default: med.title | escape }}" loading="lazy">{% else %}{{ 'collection-1' | placeholder_svg_tag: 'medallion__ph' }}{% endif %}</span>
          <span class="medallion__name">{{ med.title | escape }}</span>
          <span class="medallion__sub">{{ med_n }} {{ med_word }}</span>
          <span class="medallion__go" aria-hidden="true">Shop <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></span>
        </button>
        {%- endif %}
        {%- endfor %}
      </div>

      <div class="carousel-arrows shop-cats__arrows">
        <button type="button" aria-label="Previous collections"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5 8 12l6.5 6.5"></path></svg></button>
        <button type="button" aria-label="Next collections"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9.5 5.5 6.5 6.5-6.5 6.5"></path></svg></button>
      </div>
    </div>
  </section>
{%- endif %}

  <!-- ---- collection rail + product grid ---- -->
  <section class="section container shop-body" id="catalogue">
{%- if section.settings.show_rail %}
    <aside class="shop-rail" data-reveal>
      <p class="shop-rail__title"><svg viewBox="0 0 32 32" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg> Browse by collection</p>
      <ul class="shop-rail__list">
        <li><button type="button" class="shop-rail__item is-active" aria-pressed="true" data-c="" data-title="Everything">Everything</button></li>
        {%- for key in col_keys %}
        {%- assign rail_col = collections[key] %}
        {%- if rail_col.title != blank %}
        <li><button type="button" class="shop-rail__item" aria-pressed="false" data-c="{{ rail_col.handle }}" data-title="{{ rail_col.title | escape }}">{{ rail_col.title | escape }}<span class="shop-rail__n">{{ rail_col.all_products_count }}</span></button></li>
        {%- endif %}
        {%- endfor %}
      </ul>

      <p class="shop-rail__note">Suf is counted from the reverse. Paako is worked from the front. Aabhla cages a mirror in thread. The stitch is the difference.</p>
    </aside>
{%- endif %}

    <div class="shop-main">
      <div class="shop-main__bar" data-reveal>
        <p class="shop-main__count">{{ grid_count }} {{ count_word }}</p>
        <div class="shop-sort">
          <div class="sortmenu">
            <button type="button" class="sortmenu__button" aria-haspopup="listbox" aria-expanded="false"><span class="sortmenu__label">Sort</span><span class="sortmenu__value">{{ sort_labels[sort_index] }}</span><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9.5 6 6 6-6"></path></svg></button>

            <ul class="sortmenu__list" role="listbox" aria-label="Sort by" tabindex="-1">
              {%- for key in sort_keys %}
              <li role="option" aria-selected="{% if forloop.index0 == sort_index %}true{% else %}false{% endif %}" class="sortmenu__option{% if forloop.index0 == sort_index %} is-selected is-cursor{% endif %}" data-sort="{{ key }}">{{ sort_labels[forloop.index0] }}</li>
              {%- endfor %}
            </ul>
          </div>
        </div>
      </div>
{%- if grid_count > 0 %}

      <div class="curated__grid shop-grid" data-reveal-child>
        {%- for product in grid_products %}
        {%- liquid
          assign card_img = product.featured_image

          comment
            The badge is the merchant's own label, and a piece that cannot be
            bought overrides it — nothing else may sit where "Sold out" belongs.
          endcomment
          assign card_badge = product.metafields.shrujan.badge.value
          if product.available == false
            assign card_badge = 'Sold out'
          endif

          assign card_craft = product.metafields.shrujan.craft.value
          if card_craft == blank
            assign card_craft = product.type
          endif

          assign card_swatches = product.metafields.shrujan.swatches.value
        -%}
        <a class="piece shop-piece" href="{{ product.url }}" data-c="{% for pc in product.collections %}{{ pc.handle }} {% endfor %}" data-price="{{ product.price }}">
          <div class="piece__media" style="--tint: {% cycle 'piece': 'var(--ivory-2)', 'var(--gerua-100)', 'var(--mehendi-200)', 'var(--sand)' %}">{% if card_img %}<img src="{{ card_img | image_url: width: 900 }}" alt="{{ card_img.alt | default: product.title | escape }}" loading="lazy">{% else %}{{ 'product-1' | placeholder_svg_tag: 'piece__ph' }}{% endif %}{% if cfg.card_badge and card_badge != blank %}<span class="piece__badge">{{ card_badge | escape }}</span>{% endif %}{% if cfg.card_wish %}<button class="piece__wish" type="button" aria-label="Save {{ product.title | escape }} to wishlist"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg></button>{% endif %}{% if cfg.card_quick %}<span class="piece__quick">Add to bag</span>{% endif %}</div>

          <div class="piece__info">
            <p class="piece__name">{{ product.title | escape }}</p>
            {%- if card_craft != blank %}
            <p class="piece__craft">{{ card_craft | escape }}</p>
            {%- endif %}
            <p class="piece__price">{{ product.price | money }}{% if cfg.card_was and product.compare_at_price > product.price %}<span>{{ product.compare_at_price | money }}</span>{% endif %}</p>
            {%- if cfg.card_swatches and card_swatches != blank %}
            <span class="piece__swatches" aria-hidden="true">{% for swatch in card_swatches %}<i style="background: {{ swatch }}"></i>{% endfor %}</span>
            {%- endif %}
          </div>
        </a>
        {%- endfor %}
      </div>
{%- else %}

      <p class="shop-main__empty">Nothing online in this collection right now. <a href="mailto:marketing@shrujan.com?subject=Collection%20enquiry">Ask the studio</a>.</p>
{%- endif %}
    </div>
  </section>
{%- if section.settings.show_spotlight %}

  <!-- ---- one collection, given a full spread ---- -->
  <section class="section container spotlight-col" aria-label="Kanchli">
    <div class="spotlight-col__media" data-reveal>
      <img src="{{ 'sj-red-hand-ahir-embroidered-kanchli-1.webp' | asset_url }}" alt="Model in a dark embroidered kanchli with a black silk drape" loading="lazy">
      <figure class="spotlight-col__inset">
        <img src="{{ 'sj-megenta-pink-hand-embroidered-kanchli-1.webp' | asset_url }}" alt="Model in a ceremonial embroidered kanchli" loading="lazy">
      </figure>
    </div>

    <div class="spotlight-col__body" data-reveal>
      <p class="spotlight-col__no" aria-hidden="true">01 / 11</p>
      <p class="eyebrow">Suf · Paako · Aabhla</p>
      <h2 class="spotlight-col__name">Kanchli</h2>
      <p class="spotlight-col__copy">The Kutchi bodice, cut and stitched the way it has been for generations. Sixty hours on the frame before a single seam is closed, and no two are alike — the embroiderer holds the whole geometry in her head as she works.</p>

      <ul class="spotlight-col__facts">
        <li><strong>60 hrs</strong><span>On the frame</span></li>
        <li><strong>3</strong><span>Crafts in one piece</span></li>
        <li><strong>24</strong><span>Pieces online</span></li>
      </ul>

      <a class="btn" href="#catalogue">Shop the collection <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
    </div>
  </section>
{%- endif %}
{%- if section.settings.show_why %}

  <!-- ---- why it costs what it costs ---- -->
  <section class="section container shop-why" aria-label="Why Shrujan">
    <div class="shop-head" data-reveal>
      <span class="orn" aria-hidden="true"><i></i><svg viewBox="0 0 32 32" width="15" height="15" fill="currentColor"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg><i></i></span>
      <h2 class="section-title">{{ section.settings.why_title }}</h2>
    </div>

    <div class="shop-why__grid" data-reveal-child>
      {%- assign why_i = 0 -%}
      {%- for block in section.blocks %}{% if block.type == 'why' %}{% assign why_i = why_i | plus: 1 %}
      <article class="why-card"{{ block.shopify_attributes }}>
        <div class="why-card__media">
          <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.img_asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
          <span class="why-card__no" aria-hidden="true">{% if why_i < 10 %}0{% endif %}{{ why_i }}</span>
        </div>
        <h3 class="why-card__title">{{ block.settings.title }}</h3>
        <p class="why-card__copy">{{ block.settings.copy }}</p>
      </article>
      {%- endif %}{% endfor %}
    </div>
  </section>
{%- endif %}

  <section class="section container page-cta" data-reveal>
    <p>{{ section.settings.cta_text }}</p>
    <a class="btn btn--ghost" href="{{ section.settings.cta_link | default: '/pages/video' }}">{{ section.settings.cta_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </section>
</div>

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root || root.__shrujanShop) return;
  root.__shrujanShop = true;

  var body = root.querySelector('.shop-body');
  if (!body) return;

  var countEl = body.querySelector('.shop-main__count');
  var sortWrap = body.querySelector('.shop-sort');
  var menu = body.querySelector('.sortmenu');
  if (!countEl || !sortWrap || !menu) return;

  function list(sel, from) {
    return Array.prototype.slice.call((from || root).querySelectorAll(sel));
  }

  /* The catalogue itself is server-rendered. This only decides which of the
     rendered cards are on show, and in what order. */
  var ALL = '';

  /* a rotating tint, so grids carry colour of their own rather than reading as
     rectangles on flat ivory. Re-applied whenever the shown run changes, so a
     filtered grid starts the cycle again exactly as the built page does. */
  var TINTS = ['var(--ivory-2)', 'var(--gerua-100)', 'var(--mehendi-200)', 'var(--sand)'];

  var catRail = root.querySelector('.shop-cats__rail');
  var medallions = list('.shop-cats__rail .medallion');
  var arrowBtns = root.querySelectorAll('.shop-cats__arrows button');
  var railButtons = list('.shop-rail__item');
  var shopMain = body.querySelector('.shop-main');
  var grid = body.querySelector('.shop-grid');
  var cards = grid ? list('.piece', grid) : [];
  var painted = cards.slice(); /* the order Liquid rendered — "Featured" */
  var clearBtn = null;
  var active = ALL;

  /* handle -> title for the count line, taken off whichever rail is on the
     page rather than a copy of the collection list in script */
  var titles = {};
  railButtons.concat(medallions).forEach(function (el) {
    var key = el.getAttribute('data-c');
    if (key && !titles[key]) titles[key] = el.getAttribute('data-title') || key;
  });

  /* a card carries every collection it belongs to, space separated */
  function inCollection(card, key) {
    return (' ' + (card.getAttribute('data-c') || '') + ' ').indexOf(' ' + key + ' ') !== -1;
  }

  /* the URL is the source of truth, so a header or home-page link lands on the
     right filter. An unknown key falls back to Everything. */
  function readActive() {
    var key = new URLSearchParams(location.search).get('c');
    if (!key) return ALL;
    for (var i = 0; i < cards.length; i++) {
      if (inCollection(cards[i], key)) return key;
    }
    return ALL;
  }

  function render() {
    var shown = 0;

    cards.forEach(function (card) {
      if (active === ALL || inCollection(card, active)) {
        card.removeAttribute('hidden');
        var media = card.querySelector('.piece__media');
        if (media) media.style.setProperty('--tint', TINTS[shown % TINTS.length]);
        shown++;
      } else {
        card.setAttribute('hidden', '');
      }
    });

    var name = titles[active];
    countEl.textContent =
      shown + ' ' + (shown === 1 ? 'piece' : 'pieces') + (active !== ALL && name ? ' in ' + name : '');

    if (active !== ALL) {
      if (!clearBtn) {
        clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.className = 'shop-main__clear';
        clearBtn.textContent = 'Clear filter';
        clearBtn.addEventListener('click', function () { setActive(ALL); });
        sortWrap.insertBefore(clearBtn, sortWrap.firstChild);
      }
    } else if (clearBtn) {
      sortWrap.removeChild(clearBtn);
      clearBtn = null;
    }

    railButtons.forEach(function (btn) {
      var on = (btn.getAttribute('data-c') || '') === active;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });
  }

  /* the wish button sits inside the product link — its click must not navigate */
  if (shopMain) {
    shopMain.addEventListener('click', function (e) {
      var wish = e.target.closest ? e.target.closest('.piece__wish') : null;
      if (wish) e.preventDefault();
    });
  }

  /* ?c= is the whole URL contract: replaceState, then re-filter. Arriving on a
     filter should land on the grid, not the masthead. */
  function onParamsChange() {
    active = readActive();
    render();
    if (new URLSearchParams(location.search).get('c')) {
      var el = document.getElementById('catalogue');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function setActive(c) {
    var search = c === ALL ? '' : '?c=' + encodeURIComponent(c);
    if (location.search === search) return;
    history.replaceState(null, '', location.pathname + search);
    onParamsChange();
  }

  railButtons.forEach(function (btn) {
    btn.addEventListener('click', function () { setActive(btn.getAttribute('data-c') || ALL); });
  });

  medallions.forEach(function (btn) {
    btn.addEventListener('click', function () { setActive(btn.getAttribute('data-c') || ALL); });
  });

  function pageRail(dir) {
    if (!catRail) return;
    catRail.scrollBy({ left: dir * catRail.clientWidth * 0.8, behavior: 'smooth' });
  }
  if (arrowBtns[0]) arrowBtns[0].addEventListener('click', function () { pageRail(-1); });
  if (arrowBtns[1]) arrowBtns[1].addEventListener('click', function () { pageRail(1); });

  /* SortMenu — a listbox built from scratch so it can be styled, with the
     keyboard behaviour a select gives you for free put back by hand: arrows
     to move, enter to pick, escape to close, and a click anywhere outside
     to dismiss. The orders themselves are Liquid's: the page arrives sorted,
     and picking another one re-lays the cards already rendered. */
  var menuButton = menu.querySelector('.sortmenu__button');
  var menuValue = menu.querySelector('.sortmenu__value');
  var optionEls = list('.sortmenu__option', menu);
  var SORTS = optionEls.map(function (el) { return el.getAttribute('data-sort') || ''; });
  var open = false;
  var cursor = 0;

  /* the opening order is whatever Liquid rendered — read it back off the
     listbox so the menu and the grid can never disagree */
  var sort = SORTS[0] || '';
  optionEls.forEach(function (el, i) {
    if (el.getAttribute('aria-selected') === 'true') sort = SORTS[i];
  });

  function outside(e) {
    if (!menu.contains(e.target)) setOpen(false);
  }
  function esc(e) {
    if (e.key === 'Escape') setOpen(false);
  }

  function setOpen(v) {
    if (open === v) return;
    open = v;
    menu.classList.toggle('is-open', open);
    menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) {
      document.addEventListener('pointerdown', outside);
      document.addEventListener('keydown', esc);
    } else {
      document.removeEventListener('pointerdown', outside);
      document.removeEventListener('keydown', esc);
    }
  }

  function setCursor(i) {
    cursor = i;
    optionEls.forEach(function (el, j) { el.classList.toggle('is-cursor', j === cursor); });
  }

  function selectedIndex() {
    var i = SORTS.indexOf(sort);
    return i === -1 ? 0 : i;
  }

  function renderMenu() {
    optionEls.forEach(function (el, i) {
      var selected = SORTS[i] === sort;
      el.classList.toggle('is-selected', selected);
      el.setAttribute('aria-selected', selected ? 'true' : 'false');
      if (selected) menuValue.textContent = el.textContent;
    });
  }

  function cardName(card) {
    var el = card.querySelector('.piece__name');
    return el ? el.textContent : '';
  }
  function cardPrice(card) {
    return Number(card.getAttribute('data-price')) || 0;
  }

  function applySort() {
    if (!grid) return;
    var out = painted.slice(); /* never reorder the rendered order in place */
    if (sort === 'price-asc') out.sort(function (a, b) { return cardPrice(a) - cardPrice(b); });
    if (sort === 'price-desc') out.sort(function (a, b) { return cardPrice(b) - cardPrice(a); });
    if (sort === 'name') out.sort(function (a, b) { return cardName(a).localeCompare(cardName(b)); });
    out.forEach(function (card) { grid.appendChild(card); });
  }

  function pick(key) {
    sort = key;
    renderMenu();
    applySort();
    render();
    setOpen(false);
  }

  menuButton.addEventListener('click', function () {
    setCursor(selectedIndex());
    setOpen(!open);
  });

  menuButton.addEventListener('keydown', function (e) {
    if (!open) {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setCursor(selectedIndex());
        setOpen(true);
      }
      return;
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setCursor((cursor + 1) % SORTS.length);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setCursor((cursor - 1 + SORTS.length) % SORTS.length);
    } else if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      pick(SORTS[cursor]);
    } else if (e.key === 'Tab') {
      setOpen(false);
    }
  });

  optionEls.forEach(function (el, i) {
    el.addEventListener('pointerenter', function () { setCursor(i); });
    el.addEventListener('click', function () { pick(SORTS[i]); });
  });

  /* initial state from the URL (?c=), exactly as useSearchParams read it on mount */
  onParamsChange();
})();
</script>

