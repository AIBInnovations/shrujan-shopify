{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id
  assign has_layout = false
  if cfg.jr_cols != 3 or cfg.jr_cols_m != 1 or cfg.jr_ratio != 'default'
    assign has_layout = true
  endif
  comment
    Mobile group. `jr_ratio` above is written without a query because it is meant
    to hold at every width, so the phone shape has to come after it inside the
    900px query to win. The feature photograph has no ratio box on purpose — the
    stylesheet gives it a min-height floor instead (a comment there explains
    why), so the phone control is that floor, opt-in at 0.
  endcomment
  if cfg.jr_ratio_m != 'default' or cfg.jr_feature_h_m != 0
    assign has_layout = true
  endif
  if cfg.jr_show_tags and cfg.jr_show_tags_m == false
    assign has_layout = true
  endif
-%}
{%- if has_layout -%}
  <style>
    {%- comment -%}
      Each override sits inside the query the theme itself uses for that tier,
      so changing the desktop count leaves the mobile stack alone and vice versa.
    {%- endcomment -%}
    {%- if cfg.jr_cols != 3 -%}
      @media (min-width: 901px) {
        {{ sel }} .journal-grid { grid-template-columns: repeat({{ cfg.jr_cols }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.jr_cols_m != 1 -%}
      @media (max-width: 900px) {
        {{ sel }} .journal-grid { grid-template-columns: repeat({{ cfg.jr_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.jr_ratio != 'default' -%}
      {{ sel }} .journal-card__media { aspect-ratio: {{ cfg.jr_ratio }}; }
    {%- endif -%}

    {%- comment -%}
      Phone. 900px is the same tier `jr_cols_m` uses, and coming after the rule
      above is what lets a phone shape override an all-widths one.
    {%- endcomment -%}
    {%- if cfg.jr_ratio_m != 'default' or cfg.jr_show_tags_m == false -%}
      @media (max-width: 900px) {
        {%- if cfg.jr_ratio_m != 'default' -%}
          {{ sel }} .journal-card__media { aspect-ratio: {{ cfg.jr_ratio_m }}; }
        {%- endif -%}
        {%- if cfg.jr_show_tags and cfg.jr_show_tags_m == false -%}
          {{ sel }} .journal-pill { display: none; }
        {%- endif -%}
      }
    {%- endif -%}
    {%- if cfg.jr_feature_h_m != 0 -%}
      @media (max-width: 720px) {
        {{ sel }} .journal-feature__media { min-height: {{ cfg.jr_feature_h_m }}px; }
      }
    {%- endif -%}
  </style>
{%- endif -%}
<section class="section container journal" id="journal">
  <div class="journal__head" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">
      {{ section.settings.title_line_1 }}
      <br>
      {{ section.settings.title_line_2 }}
    </h2>
  </div>

  <a class="journal-feature" href="{{ section.settings.feature_url | default: '/pages/the-shrujan-story#journal' }}" data-reveal>
    <div class="journal-feature__media">
      <img src="{% if section.settings.feature_img %}{{ section.settings.feature_img | image_url: width: 1600 }}{% else %}{{ 'top-right.webp' | asset_url }}{% endif %}" alt="{{ section.settings.feature_alt | escape }}" loading="lazy">
    </div>

    <div class="journal-feature__body">
      {% if cfg.jr_show_tags %}<span class="journal-pill journal-pill--dark journal-feature__tag">{{ section.settings.feature_tag }}</span>{% endif %}
      <h3 class="journal-feature__title">{{ section.settings.feature_title }}</h3>
      <p class="journal-feature__excerpt">{{ section.settings.feature_excerpt }}</p>

      <span class="arrow-link journal-feature__link">
        {{ section.settings.feature_link_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
      </span>

      <div class="journal-feature__foot">
        {% if cfg.jr_show_author %}
        <div class="journal-author">
          <img src="{% if section.settings.author_img %}{{ section.settings.author_img | image_url: width: 1200 }}{% else %}{{ 'cat-c4.webp' | asset_url }}{% endif %}" alt="" loading="lazy">
          <div>
            <p class="journal-author__name">{{ section.settings.author_name }}</p>
            <p class="journal-author__role">{{ section.settings.author_role }}</p>
          </div>
        </div>
        {% endif %}
      </div>
    </div>
  </a>

  <div class="journal-grid" data-reveal-child>
    {%- for block in section.blocks %}
    <a class="journal-card" href="{{ block.settings.url | default: '/pages/the-shrujan-story#journal' }}" {{ block.shopify_attributes }}>
      <div class="journal-card__media">
        <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1600 }}{% else %}{{ block.settings.image_asset | asset_url }}{% endif %}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
        {% if cfg.jr_show_tags %}<span class="journal-pill">{{ block.settings.pill }}</span>{% endif %}
        {% if cfg.jr_show_arrow %}
        <span class="journal-card__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
        </span>
        {% endif %}
      </div>
      <h3 class="journal-card__title">{{ block.settings.title }}</h3>
    </a>
    {%- endfor %}
  </div>
</section>
