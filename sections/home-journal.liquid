{%- render 'section-design', section: section -%}
<section class="section container journal" id="journal">
  <div class="journal__head" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">
      {{ section.settings.title_line_1 }}
      <br>
      {{ section.settings.title_line_2 }}
    </h2>
  </div>

  <a class="journal-feature" href="{{ section.settings.feature_url | default: '/pages/the-shrujan-story#journal' }}" data-reveal>
    <div class="journal-feature__media">
      <img src="{% if section.settings.feature_img %}{{ section.settings.feature_img | image_url: width: 1600 }}{% else %}{{ 'top-right.webp' | asset_url }}{% endif %}" alt="{{ section.settings.feature_alt | escape }}" loading="lazy">
    </div>

    <div class="journal-feature__body">
      <span class="journal-pill journal-pill--dark journal-feature__tag">{{ section.settings.feature_tag }}</span>
      <h3 class="journal-feature__title">{{ section.settings.feature_title }}</h3>
      <p class="journal-feature__excerpt">{{ section.settings.feature_excerpt }}</p>

      <span class="arrow-link journal-feature__link">
        {{ section.settings.feature_link_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
      </span>

      <div class="journal-feature__foot">
        <div class="journal-author">
          <img src="{% if section.settings.author_img %}{{ section.settings.author_img | image_url: width: 1200 }}{% else %}{{ 'cat-c4.webp' | asset_url }}{% endif %}" alt="" loading="lazy">
          <div>
            <p class="journal-author__name">{{ section.settings.author_name }}</p>
            <p class="journal-author__role">{{ section.settings.author_role }}</p>
          </div>
        </div>
      </div>
    </div>
  </a>

  <div class="journal-grid" data-reveal-child>
    {%- for block in section.blocks %}
    <a class="journal-card" href="{{ block.settings.url | default: '/pages/the-shrujan-story#journal' }}" {{ block.shopify_attributes }}>
      <div class="journal-card__media">
        <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1600 }}{% else %}{{ block.settings.image_asset | asset_url }}{% endif %}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
        <span class="journal-pill">{{ block.settings.pill }}</span>
        <span class="journal-card__arrow" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
        </span>
      </div>
      <h3 class="journal-card__title">{{ block.settings.title }}</h3>
    </a>
    {%- endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Journal",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The Journal"
    },
    {
      "type": "text",
      "id": "title_line_1",
      "label": "Title line 1",
      "default": "Stories from the loom,"
    },
    {
      "type": "text",
      "id": "title_line_2",
      "label": "Title line 2",
      "default": "straight from the villages"
    },
    {
      "type": "header",
      "content": "Featured story"
    },
    {
      "type": "url",
      "id": "feature_url",
      "label": "Link"
    },
    {
      "type": "image_picker",
      "id": "feature_img",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "feature_alt",
      "label": "Image alt text",
      "default": "Close crop of mirror-work embroidery in crimson and gold threads"
    },
    {
      "type": "text",
      "id": "feature_tag",
      "label": "Tag pill",
      "default": "Craft Notes"
    },
    {
      "type": "text",
      "id": "feature_title",
      "label": "Title",
      "default": "5 Kutch embroidery styles and how to tell them apart"
    },
    {
      "type": "textarea",
      "id": "feature_excerpt",
      "label": "Excerpt",
      "default": "Suf, Kharek, Paako, Rabari, Mutava. Each village stitches its own signature. A field guide to reading the motifs, mirrors and thread counts that set them apart."
    },
    {
      "type": "text",
      "id": "feature_link_label",
      "label": "Link label",
      "default": "Read the story"
    },
    {
      "type": "header",
      "content": "Featured story author"
    },
    {
      "type": "image_picker",
      "id": "author_img",
      "label": "Author image"
    },
    {
      "type": "text",
      "id": "author_name",
      "label": "Author name",
      "default": "Kanta Ben Rabari"
    },
    {
      "type": "text",
      "id": "author_role",
      "label": "Author role",
      "default": "Master Artisan · Bhuj"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Journal card",
      "settings": [
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Image fallback asset",
          "info": "Theme asset filename used when no image is picked.",
          "default": "hero-bottom-2.webp"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Image alt text",
          "default": "Block-printing tools resting on embroidered plum cloth"
        },
        {
          "type": "text",
          "id": "pill",
          "label": "Tag pill",
          "default": "Care Guide"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "How to care for handwoven cloth"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Journal",
      "blocks": [
        {
          "type": "card",
          "settings": {
            "url": "/pages/the-shrujan-story#journal",
            "image_asset": "hero-bottom-2.webp",
            "image_alt": "Block-printing tools resting on embroidered plum cloth",
            "pill": "Care Guide",
            "title": "How to care for handwoven cloth"
