{%- render 'section-design', section: section -%}

{%- comment -%}
  Reels-specific controls. Autoplay is a script flag, so it travels as data-*;
  looping is the video element's own attribute; the seal and the rail's snapping
  are markup and CSS. With the seal gone the head drops from three tracks to
  two, otherwise the note would inherit the seal's narrow auto column.
{%- endcomment -%}
{%- liquid
  assign r = section.settings
  assign rsel = '#shopify-section-' | append: section.id

  assign r_style = false
  if r.show_seal == false or r.rail_snap == false
    assign r_style = true
  endif
  comment
    Mobile group. The rail is a flex scroller whose card count lives in the flex
    basis rather than in a grid: five across, and below 720px a fixed
    min of 76vw and 300px so the next reel always peeks. A phone count rewrites
    that same basis, gap included, which is why it is opt-in rather than
    carrying a whole number as its default.
  endcomment
  if r.reels_cols_m != 'default' or r.reels_ratio_m != 'default'
    assign r_style = true
  endif
  if r.show_seal and r.reels_show_seal_m == false
    assign r_style = true
  endif
-%}

{%- if r_style -%}
  <style>
    {%- if r.show_seal == false -%}
      {%- comment -%}
        Only above the 900px breakpoint — below it the head is already a single
        column, and an id-level rule would otherwise outrank that.
      {%- endcomment -%}
      @media (min-width: 901px) {
        {{ rsel }} .reels__head { grid-template-columns: 1fr 1fr; }
      }
    {%- endif -%}
    {%- if r.rail_snap == false -%}
      {{ rsel }} .reels__rail { scroll-snap-type: none; }
    {%- endif -%}

    {%- if r.reels_cols_m != 'default' or r.reels_ratio_m != 'default' or r.reels_show_seal_m == false -%}
      @media (max-width: 720px) {
        {%- if r.reels_cols_m != 'default' -%}
          {{ rsel }} .reel { flex: 0 0 calc((100% - ({{ r.reels_cols_m }} - 1) * var(--reel-gap)) / {{ r.reels_cols_m }}); }
        {%- endif -%}
        {%- if r.reels_ratio_m != 'default' -%}
          {{ rsel }} .reel__media { aspect-ratio: {{ r.reels_ratio_m }}; }
        {%- endif -%}
        {%- if r.show_seal and r.reels_show_seal_m == false -%}
          {{ rsel }} .reels__seal-link { display: none; }
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
{%- comment -%}
  The home page's version (assets/sj-home.css / sj-home.js): a meta row over
  the head, the title in two lines, the seal's words fitted to its ring, a
  number and a "Watch" line on every reel, and a "Watch" disc that follows the
  cursor. The theme's own reveal attributes are left off, since sj-home.js
  brings these blocks in itself.
{%- endcomment -%}
{%- liquid
  assign reel_count = section.blocks.size
  assign reel_total = reel_count
  if reel_count < 10
    assign reel_total = '0' | append: reel_count
  endif
  assign count_words = 'One,Two,Three,Four,Five,Six,Seven,Eight,Nine,Ten,Eleven,Twelve' | split: ','
  assign count_word = reel_count
  if reel_count > 0 and reel_count <= count_words.size
    assign count_i = reel_count | minus: 1
    assign count_word = count_words[count_i]
  endif
-%}
<section class="section reels" id="reels" aria-label="Instagram Feed"{% if r.autoplay == false %} data-autoplay="false"{% endif %}>
  <div class="container">
    <div class="reels__meta"><span>{{ r.rl_meta_l | escape }}</span><span>{{ count_word }} {% if reel_count == 1 %}reel{% else %}reels{% endif %}{% if r.rl_meta_r != blank %} · {{ r.rl_meta_r | escape }}{% endif %}</span></div>
    <div class="reels__head">
      <div class="reels__titles">
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="section-title rl__title"><span class="rl__line">{{ section.settings.title_l1 | escape }}</span><span class="rl__line rl__line--soft">{{ section.settings.title_l2 | escape }}</span></h2>
      </div>

      {%- if r.show_seal %}
      <a
        class="reels__seal-link"
        href="{{ section.settings.seal_link | default: 'https://www.instagram.com/shrujanindia/' }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Watch Shrujan reels on Instagram"
      >
        <span class="reels__seal" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs>
              <path id="reel-arc" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
            </defs>
            <text textLength="270" lengthAdjust="spacing">
              <textPath href="#reel-arc" startOffset="0">WATCH THE CRAFT · SHRUJAN IN MOTION ·</textPath>
            </text>
          </svg>
        </span>
        <span class="reels__seal-badge" aria-hidden="true">
          <i class="sj-i sj-i--instagram-logo fab" style="font-size:18px" aria-hidden="true"></i>
        </span>
      </a>
      {%- endif %}

      <div class="reels__note">
        <p>
          {{ section.settings.note | escape }}
        </p>
      </div>
    </div>
  </div>

  <div class="reels__rail-wrap">
    {%- comment -%}
      The caption sits on the footage rather than under the card: the titles run
      to different lengths and would push the cards to different heights. Under
      each card hangs one embroidered pennant, K · U · T · C · H, like a toran.
    {%- endcomment -%}
    {%- assign pennants = r.pennants | split: ',' -%}
    {%- assign pennant_count = pennants | size %}
    <div class="reels__rail">
      {%- for block in section.blocks %}
      <a class="reel" href="{{ block.settings.link | default: 'https://www.instagram.com/shrujanindia/' }}" target="_blank" rel="noopener noreferrer" {{ block.shopify_attributes }}>
        <div class="reel__media">
          <video src="{{ 'reel-' | append: forloop.index | append: '.mp4' | asset_url }}" poster="{{ 'reel-' | append: forloop.index | append: '-poster.jpg' | asset_url }}" muted {% if r.loop %}loop {% endif %}playsinline preload="none" aria-label="{{ block.settings.title | escape }}"></video>
          <span class="reel__scrim" aria-hidden="true"></span>
          <span class="reel__no" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}<span> / {{ reel_total }}</span></span>
          <p class="reel__title">{{ block.settings.title | escape }}</p>
          <span class="reel__go" aria-hidden="true">Watch on Instagram <span>↗</span></span>
        </div>
        {%- if r.show_pennants and pennant_count > 0 -%}
          {%- assign pennant_i = forloop.index0 | modulo: pennant_count -%}
          {%- assign pennant = pennants[pennant_i] | strip -%}
          {%- if pennant != blank %}
        <img class="reel__letter" src="{{ pennant | asset_url }}" alt="" aria-hidden="true" loading="lazy">
          {%- endif -%}
        {%- endif %}
      </a>
      {%- endfor %}
    </div>
  </div>
  <div class="rl__cursor" aria-hidden="true">Watch</div>
</section>

<script>
(function () {
  var root = document.querySelector('.reels');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  /* Play only what's on screen — five autoplaying videos at once is wasteful.
     Autoplay is on unless the section turns it off, in which case the cards stay
     on their posters until the visitor opens the reel. */
  var autoplay = root.getAttribute('data-autoplay') !== 'false';
  var rail = root.querySelector('.reels__rail');
  var io = null;
  if (autoplay && rail && 'IntersectionObserver' in window) {
    io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) v.play().catch(function () {});
          else v.pause();
        });
      },
      { threshold: 0.35 }
    );
    rail.querySelectorAll('video').forEach(function (v) { io.observe(v); });
  }

  /* On a phone the rail loops (port of Reels.jsx). Three copies run end to
     end and the scroll shifts by one copy whenever it drifts out of the middle
     one: a whole number of card pitches, so the snap lands identically and the
     jump is invisible. Desktop keeps the single set, which divides its rail
     exactly. The copies are decorative repeats, hidden from assistive tech. */
  var phone = window.matchMedia('(max-width: 720px)');
  var originals = rail ? Array.prototype.slice.call(rail.children) : [];
  var copies = [];
  var loopRaf = 0;

  function onLoopScroll() {
    if (loopRaf) return;
    loopRaf = requestAnimationFrame(function () {
      loopRaf = 0;
      var w = rail.scrollWidth / 3;
      if (rail.scrollLeft < w * 0.5) rail.scrollLeft += w;
      else if (rail.scrollLeft > w * 1.5) rail.scrollLeft -= w;
    });
  }

  function copyOf(card) {
    var c = card.cloneNode(true);
    c.setAttribute('aria-hidden', 'true');
    c.setAttribute('tabindex', '-1');
    // a reveal may have left the original mid-fade; the copy starts settled
    c.style.opacity = '';
    c.style.transform = '';
    c.style.visibility = '';
    return c;
  }

  function setLoop(on) {
    if (!rail || originals.length < 2) return;
    if (on && !copies.length) {
      // one copy ahead of the originals, one after; each lands in reading order
      originals.forEach(function (card) { var c = copyOf(card); copies.push(c); rail.insertBefore(c, originals[0]); });
      originals.forEach(function (card) { var c = copyOf(card); copies.push(c); rail.appendChild(c); });
      if (io) copies.forEach(function (c) { var v = c.querySelector('video'); if (v) io.observe(v); });
      // open on the middle copy, so the first swipe can go either way
      rail.scrollLeft = rail.scrollWidth / 3;
      rail.addEventListener('scroll', onLoopScroll, { passive: true });
    } else if (!on && copies.length) {
      rail.removeEventListener('scroll', onLoopScroll);
      copies.forEach(function (c) {
        var v = c.querySelector('video');
        if (v && io) io.unobserve(v);
        c.remove();
      });
      copies = [];
      rail.scrollLeft = 0;
    }
  }

  setLoop(phone.matches);
  if (phone.addEventListener) phone.addEventListener('change', function (e) { setLoop(e.matches); });

  var mm = gsap.matchMedia();

  /* the seal is optional, and GSAP should not be handed a null target */
  var seal = root.querySelector('.reels__seal');

  if (seal) mm.add('(prefers-reduced-motion: no-preference)', function () {
    gsap.fromTo(
      seal,
      { rotation: -60 },
      {
        rotation: 120,
        ease: 'none',
        scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.6 }
      }
    );
  });
})();
</script>

{% schema %}
{
