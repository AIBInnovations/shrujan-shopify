{%- render 'section-design', section: section -%}

{%- comment -%}
  Reels-specific controls. Autoplay is a script flag, so it travels as data-*;
  looping is the video element's own attribute; the seal and the rail's snapping
  are markup and CSS. With the seal gone the head drops from three tracks to
  two, otherwise the note would inherit the seal's narrow auto column.
{%- endcomment -%}
{%- liquid
  assign r = section.settings
  assign rsel = '#shopify-section-' | append: section.id

  assign r_style = false
  if r.show_seal == false or r.rail_snap == false
    assign r_style = true
  endif
-%}

{%- if r_style -%}
  <style>
    {%- if r.show_seal == false -%}
      {%- comment -%}
        Only above the 900px breakpoint — below it the head is already a single
        column, and an id-level rule would otherwise outrank that.
      {%- endcomment -%}
      @media (min-width: 901px) {
        {{ rsel }} .reels__head { grid-template-columns: 1fr 1fr; }
      }
    {%- endif -%}
    {%- if r.rail_snap == false -%}
      {{ rsel }} .reels__rail { scroll-snap-type: none; }
    {%- endif -%}
  </style>
{%- endif -%}
<section class="section reels" id="reels" aria-label="Shrujan in motion"{% if r.autoplay == false %} data-autoplay="false"{% endif %}>
  <div class="container">
    <div class="reels__head">
      <div class="reels__titles" data-reveal>
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h2 class="section-title">
          {{ section.settings.title_l1 | escape }}
          <br>
          <em>{{ section.settings.title_l2 | escape }}</em>
        </h2>
      </div>

      {%- if r.show_seal %}
      <a
        class="reels__seal-link"
        href="{{ section.settings.seal_link | default: 'https://www.instagram.com/shrujanindia/reels/' }}"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Watch Shrujan reels on Instagram"
      >
        <span class="reels__seal" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs>
              <path id="reel-arc" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
            </defs>
            <text>
              <textPath href="#reel-arc" startOffset="0">WATCH THE CRAFT · SHRUJAN IN MOTION ·</textPath>
            </text>
          </svg>
        </span>
        <span class="reels__seal-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="3.9"></circle>
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </span>
      </a>
      {%- endif %}

      <div class="reels__note" data-reveal>
        <p>
          {{ section.settings.note | escape }}
        </p>
      </div>
    </div>
  </div>

  <div class="reels__rail-wrap">
    <div class="reels__rail" data-reveal-child>
      {%- for block in section.blocks %}
      <a class="reel" href="{{ block.settings.link | default: 'https://www.instagram.com/shrujanindia/reels/' }}" target="_blank" rel="noopener noreferrer" {{ block.shopify_attributes }}>
        <div class="reel__media">
          <video src="{{ 'reel-' | append: forloop.index | append: '.mp4' | asset_url }}" poster="{{ 'reel-' | append: forloop.index | append: '-poster.jpg' | asset_url }}" muted {% if r.loop %}loop {% endif %}playsinline preload="none" aria-label="{{ block.settings.title | escape }}"></video>
          <span class="reel__scrim" aria-hidden="true"></span>
          <span class="reel__meta">{{ block.settings.meta | escape }}</span>
        </div>
        <p class="reel__title">{{ block.settings.title | escape }}</p>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('.reels');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  /* Play only what's on screen — five autoplaying videos at once is wasteful.
     Autoplay is on unless the section turns it off, in which case the cards stay
     on their posters until the visitor opens the reel. */
  var autoplay = root.getAttribute('data-autoplay') !== 'false';
  var rail = root.querySelector('.reels__rail');
  if (autoplay && rail && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) v.play().catch(function () {});
          else v.pause();
        });
      },
      { threshold: 0.35 }
    );
    rail.querySelectorAll('video').forEach(function (v) { io.observe(v); });
  }

  var mm = gsap.matchMedia();

  /* the seal is optional, and GSAP should not be handed a null target */
  var seal = root.querySelector('.reels__seal');

  if (seal) mm.add('(prefers-reduced-motion: no-preference)', function () {
    gsap.fromTo(
      seal,
      { rotation: -60 },
      {
        rotation: 120,
        ease: 'none',
        scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.6 }
      }
    );
  });
})();
</script>

{% schema %}
{
  "name": "Home reels",
  "max_blocks": 5,
  "settings": [
    {
      "type": "header",
      "content": "Playback"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay reels in view",
      "info": "Each film plays while it is on screen and pauses when it leaves. Off leaves every card on its poster.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop each reel",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "rail_snap",
      "label": "Snap the rail to cards",
      "info": "Scrolling settles on a card rather than stopping between two. Off gives free scrolling.",
      "default": true
    },
    {
      "type": "header",
      "content": "Head"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Shrujan in Motion"
    },
    {
      "type": "text",
      "id": "title_l1",
      "label": "Title line 1",
      "default": "Watch the craft"
    },
    {
      "type": "text",
      "id": "title_l2",
      "label": "Title line 2 (italic)",
      "default": "come alive"
    },
    {
      "type": "checkbox",
      "id": "show_seal",
      "label": "Show the rotating seal",
      "info": "The turning “Watch the craft” ring between the title and the note.",
      "default": true
    },
    {
      "type": "url",
      "id": "seal_link",
      "label": "Rotating seal link"
    },
    {
      "type": "textarea",
      "id": "note",
      "label": "Note",
      "default": "Forty seconds inside the workshop: a needle counting threads, madder boiling, a sari taking its first drape."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel card",
      "settings": [
        {
          "type": "paragraph",
          "content": "The film and its poster load from the theme assets reel-1 to reel-5, matched to this card's position in the rail."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Caption",
          "default": "Indigo mirror-work jacket"
        },
        {
          "type": "text",
          "id": "meta",
          "label": "Duration",
          "default": "0:27"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home reels",
      "blocks": [
        {
          "type": "reel",
          "settings": {
            "title": "Indigo mirror-work jacket",
            "meta": "0:27",
            "link": "https://www.instagram.com/shrujanindia/reels/"
          }
        },
        {
          "type": "reel",
          "settings": {
            "title": "Coral Kutchi embroidered sari",
            "meta": "0:33",
            "link": "https://www.instagram.com/shrujanindia/reels/"
          }
        },
        {
          "type": "reel",
          "settings": {
            "title": "Sheer embroidered kurta",
            "meta": "0:32",
            "link": "https://www.instagram.com/shrujanindia/reels/"
          }
        },
        {
          "type": "reel",
          "settings": {
            "title": "Shrujan, since 1969",
            "meta": "0:11",
            "link": "https://www.instagram.com/shrujanindia/reels/"
          }
        },
        {
          "type": "reel",
          "settings": {
            "title": "Turquoise Kutchi sari",
            "meta": "0:30",
            "link": "https://www.instagram.com/shrujanindia/reels/"
          }
        }
      ]
    }
  ]
}
{% endschema %}
