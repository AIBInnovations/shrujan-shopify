{%- render 'section-design', section: section -%}
{%- comment -%}
  Region + grid controls. Every default reproduces the built page: the scoped
  <style> is written only when a column count differs, and it is confined to the
  band the built rule owns (the strand cards stack below 900px) so an
  id-specificity rule cannot flatten the responsive steps.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign root_sel = '#shopify-section-' | append: section.id
-%}
{%- liquid
  comment
    Mobile group. Both of this page's layouts step at the same 900px: the strand
    cards go to one column, and the media/body rows stack — with the theme
    resetting the alternating order there so every row leads with its photograph.
    That reset is what a stacking-order control keys on. Neither the card nor the
    row photograph has a phone shape of its own; both hold 4:3 to 320px.
  endcomment
  assign sc_style = false
  if cfg.strand_cols != 3 or cfg.strand_cols_m != 1
    assign sc_style = true
  endif
  if cfg.strand_ratio_m != 'default' or cfg.row_order_m != 'image'
    assign sc_style = true
  endif
-%}
{%- if sc_style -%}
  <style>
    {%- if cfg.strand_cols != 3 -%}
      {{ root_sel }} { --strand-cols: {{ cfg.strand_cols }}; }
      @media (min-width: 901px) {
        {{ root_sel }} .strand-cards { grid-template-columns: repeat(var(--strand-cols), minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.strand_cols_m != 1 or cfg.strand_ratio_m != 'default' or cfg.row_order_m != 'image' -%}
      @media (max-width: 900px) {
        {%- if cfg.strand_cols_m != 1 -%}
          {{ root_sel }} .strand-cards { grid-template-columns: repeat({{ cfg.strand_cols_m }}, minmax(0, 1fr)); }
        {%- endif -%}
        {%- if cfg.strand_ratio_m != 'default' -%}
          {{ root_sel }} .strand-card__media { aspect-ratio: {{ cfg.strand_ratio_m }}; }
        {%- endif -%}
        {%- if cfg.row_order_m != 'image' -%}
          {{ root_sel }} .studio-row__media { order: 2; }
          {{ root_sel }} .studio-row__body { order: 1; }
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
<div class="page">
  <header class="page-hero page-hero--cover page-hero--frame" data-reveal>
    <div class="page-hero__bg" aria-hidden="true">
      <img src="{% if section.settings.hero_image %}{{ section.settings.hero_image | image_url: width: 2000 }}{% else %}{{ 'look-b2.webp' | asset_url }}{% endif %}" alt="" fetchpriority="high">
      <span class="page-hero__scrim"></span>
    </div>

    <div class="container page-hero__grid">
      <div class="page-hero__text">
        <p class="eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <h1 class="page-hero__title">{{ section.settings.hero_title }}</h1>
      </div>
    </div>

    <span class="page-hero__rule" aria-hidden="true"></span>
  </header>
{%- if section.settings.show_strands %}

  <section class="section container">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">{{ section.settings.strands_eyebrow | escape }}</p>
      <h2 class="section-title">{{ section.settings.strands_title }}</h2>
    </div>

    <ul class="strand-cards" data-reveal-child>
      {%- assign strand_i = 0 -%}
      {%- for block in section.blocks -%}
      {%- if block.type == 'strand' -%}
      {%- assign strand_i = strand_i | plus: 1 %}
      <li {{ block.shopify_attributes }}>
        <a class="strand-card" href="{{ block.settings.link | default: '/pages/studio-heritage' }}">
          <span class="strand-card__media">
            <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
          </span>
          <span class="strand-card__no">{% if strand_i < 10 %}0{% endif %}{{ strand_i }}</span>
          <span class="strand-card__name">{{ block.settings.name }}</span>
          <span class="strand-card__copy">{{ block.settings.copy | escape }}</span>
          <span class="strand-card__cta">{{ block.settings.cta_label | escape }} <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></span>
        </a>
      </li>
      {%- endif -%}
      {%- endfor %}
    </ul>
  </section>
{%- endif %}
{%- if section.settings.show_rows %}

  <div class="section container studio">
    {%- assign row_i = 0 -%}
    {%- for block in section.blocks -%}
    {%- if block.type == 'row' -%}
    {%- assign row_i = row_i | plus: 1 -%}
    {%- if row_i > 1 %}
{% endif %}
    <article class="studio-row" data-reveal {{ block.shopify_attributes }}>
      <div class="studio-row__media" data-parallax>
        <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1600 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.image_alt | escape }}" loading="lazy">
      </div>

      <div class="studio-row__body">
        <span class="studio-row__no" aria-hidden="true">{% if row_i < 10 %}0{% endif %}{{ row_i }}</span>
        <p class="studio-row__craft">{{ block.settings.craft | escape }}</p>
        <h2 class="studio-row__name">{{ block.settings.name }}</h2>
        <p class="studio-row__copy">{{ block.settings.copy | escape }}</p>

        <ul class="studio-row__facts">
          {%- assign row_facts = block.settings.facts | newline_to_br | split: '<br />' -%}
          {%- for fact in row_facts -%}
          {%- assign fact_text = fact | strip -%}
          {%- unless fact_text == blank %}
          <li>{{ fact_text | escape }}</li>
          {%- endunless -%}
          {%- endfor %}
        </ul>

        <a class="arrow-link studio-row__link" href="{{ block.settings.link | default: '/pages/studio-heritage' | escape }}">{{ block.settings.link_label | escape }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
      </div>
    </article>
    {%- endif -%}
    {%- endfor %}
  </div>
{%- endif %}
{%- if section.settings.show_cta %}

  <section class="section container page-cta" data-reveal>
    <p>{{ section.settings.cta_copy | escape }}</p>
    <a class="btn" href="{{ section.settings.cta_link | escape }}">{{ section.settings.cta_label | escape }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </section>
{%- endif %}
</div>
