{%- comment -%}
  An occasion-led gifting guide. Original settings and blocks are retained so
  existing page configuration stays compatible; the focused guide replaces
  the long studio rows. The enquiry is accepted only when Slide confirms it.
{%- endcomment -%}
{%- if section.settings.only_handle == blank or page.handle == section.settings.only_handle -%}
{%- render 'section-design', section: section -%}
{{ 'sj-gifting.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign cfg = section.settings
  assign gifting_id = 'sj-gifting-' | append: section.id
  assign gifting_phone = cfg.phone | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')'
  assign gifting_text = 'Hello Shrujan, I would like to know more about gifting and collaborations.' | url_encode
  assign gifting_asset = cfg.hero_asset | default: 'shop-hero.webp'
-%}
<div class="sj-gifting" id="{{ gifting_id }}">
  <section class="sj-gifting__guide" aria-labelledby="{{ gifting_id }}-title">
    <div class="sj-gifting__hero">
      <figure class="sj-gifting__photo">
        <img src="{% if cfg.hero_img %}{{ cfg.hero_img | image_url: width: 1800 }}{% else %}{{ gifting_asset | asset_url }}{% endif %}" alt="{{ cfg.hero_alt | escape }}" width="1600" height="809" fetchpriority="high">
      </figure>
      <div class="sj-gifting__hero-copy">
        <h1 class="sj-gifting__title" id="{{ gifting_id }}-title">{{ cfg.hero_title }}</h1>
        <p class="sj-gifting__lede">{{ cfg.hero_lede | escape }}</p>
      </div>
    </div>
    <div class="sj-gifting__panel">
      <div class="sj-gifting__content">
        <i class="sj-i sj-i--gift ms sj-gifting__icon" aria-hidden="true"></i>
        <p class="sj-gifting__occasions">{{ cfg.occasion_line | default: 'Corporate | Wedding | Festive' | escape }}</p>
        <h2 class="sj-gifting__help-title">{{ cfg.help_title | default: 'A gift, thoughtfully chosen' | escape }}</h2>
        <p class="sj-gifting__help-copy">{{ cfg.help_copy | default: 'Tell us about your occasion. Our studio will help you find something personal, from a single keepsake to a collection of gifts.' | escape }}</p>
        <div class="sj-gifting__actions">
          <a class="sj-gifting__button" href="https://api.whatsapp.com/send?phone={{ gifting_phone }}&amp;text={{ gifting_text }}" target="_blank" rel="noopener"><i class="sj-i sj-i--whatsapp-logo fab" aria-hidden="true"></i><span>{{ cfg.whatsapp_label | default: 'WhatsApp' | escape }}</span></a>
          {%- if cfg.show_enquiry -%}
            <span class="sj-gifting__or">or</span>
            <button class="sj-gifting__button" type="button" data-gifting-open aria-haspopup="dialog" aria-controls="{{ gifting_id }}-dialog">{{ cfg.form_label | default: 'Fill Form' | escape }}</button>
          {%- endif -%}
        </div>
        <p class="sj-gifting__contact"><a href="mailto:{{ cfg.email | escape }}">{{ cfg.email | escape }}</a></p>
      </div>
    </div>
  </section>
  {%- if cfg.show_enquiry -%}
  <dialog class="sj-gifting__dialog" id="{{ gifting_id }}-dialog" aria-labelledby="{{ gifting_id }}-enquiry-title" aria-describedby="{{ gifting_id }}-enquiry-copy" data-lenis-prevent>
    <div class="sj-gifting__dialog-panel">
      <button class="sj-gifting__close" type="button" data-gifting-close aria-label="Close gifting enquiry"><span aria-hidden="true">×</span></button>
      <p class="sj-gifting__eyebrow">{{ cfg.enq_eyebrow | escape }}</p>
      <h2 class="sj-gifting__dialog-title" id="{{ gifting_id }}-enquiry-title">{{ cfg.enq_title }}</h2>
      <p class="sj-gifting__dialog-copy" id="{{ gifting_id }}-enquiry-copy">{{ cfg.enq_copy | escape }}</p>
      <form class="sj-gifting__form">
        <div class="sj-gifting__fields">
          <p class="sj-gifting__field"><label for="{{ gifting_id }}-name">Name <span aria-hidden="true">*</span></label><input id="{{ gifting_id }}-name" name="name" type="text" required autocomplete="name"></p>
          <p class="sj-gifting__field"><label for="{{ gifting_id }}-phone">Contact number <span aria-hidden="true">*</span></label><input id="{{ gifting_id }}-phone" name="phone" type="tel" required autocomplete="tel"></p>
          <p class="sj-gifting__field"><label for="{{ gifting_id }}-email">Email</label><input id="{{ gifting_id }}-email" name="email" type="email" autocomplete="email"></p>
          <p class="sj-gifting__field"><label for="{{ gifting_id }}-city">City</label><input id="{{ gifting_id }}-city" name="city" type="text" autocomplete="address-level2"></p>
          <p class="sj-gifting__field sj-gifting__field--wide"><label for="{{ gifting_id }}-occasion">Quantity and occasion</label><input id="{{ gifting_id }}-occasion" name="extra" type="text" placeholder="For example, 50 gifts for a wedding"></p>
          <p class="sj-gifting__field sj-gifting__field--wide"><label for="{{ gifting_id }}-looking">What are you looking for?</label><textarea id="{{ gifting_id }}-looking" name="looking" rows="3"></textarea></p>
        </div>
        <p class="sj-gifting__note">* {{ cfg.note | escape }}</p>
        <p class="sj-gifting__error" role="alert" tabindex="-1" hidden>We couldn’t send your enquiry just now. Please try again, or <a href="https://api.whatsapp.com/send?phone={{ gifting_phone }}&amp;text={{ gifting_text }}" target="_blank" rel="noopener">speak to us on WhatsApp</a>.</p>
        <button class="sj-gifting__button sj-gifting__button--solid" type="submit"><span data-gifting-submit>{{ cfg.submit_label | escape }}</span><i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></button>
      </form>
      <div class="sj-gifting__success" role="status" hidden>
        <h3 tabindex="-1">{{ cfg.done_title | escape }}</h3>
        <p>{{ cfg.done_body }}</p>
        <button class="sj-gifting__button" type="button" data-gifting-again>{{ cfg.done_again | escape }}</button>
      </div>
      <p class="sj-gifting__dialog-contact">{{ cfg.call_label | escape }} <a href="tel:{{ cfg.phone | remove: ' ' | escape }}">{{ cfg.phone | escape }}</a> · <a href="mailto:{{ cfg.email | escape }}">{{ cfg.email | escape }}</a></p>
    </div>
  </dialog>
  <noscript><p class="sj-gifting__noscript">For gifting enquiries, <a href="mailto:{{ cfg.email | escape }}">email our studio</a> or contact us on WhatsApp.</p></noscript>
  {%- endif -%}
</div>
<script>
(function () {
  var root = document.getElementById({{ gifting_id | json }});
  if (!root || root.__giftingInit) return;
  root.__giftingInit = true;
  var dialog = root.querySelector('dialog');
  if (!dialog) return;
  var opener = root.querySelector('[data-gifting-open]');
  var form = dialog.querySelector('form');
  var success = dialog.querySelector('.sj-gifting__success');
  var error = dialog.querySelector('.sj-gifting__error');
  var submit = form.querySelector('[type="submit"]');
  var submitText = submit.querySelector('[data-gifting-submit]');
  var idleText = submitText.textContent;
  var previousFocus, savedOverflow, held = false;
  function release() {
    if (!held) return;
    held = false;
    document.documentElement.style.overflow = savedOverflow;
    if (window.Shrujan && window.Shrujan.startScroll) window.Shrujan.startScroll();
    if (previousFocus && previousFocus.isConnected) previousFocus.focus({ preventScroll: true });
  }
  opener.addEventListener('click', function () {
    if (typeof dialog.showModal !== 'function') {
      window.location.href = root.querySelector('.sj-gifting__contact a').href;
      return;
    }
    previousFocus = document.activeElement;
    savedOverflow = document.documentElement.style.overflow;
    dialog.showModal();
    if (window.Shrujan && window.Shrujan.stopScroll) window.Shrujan.stopScroll();
    document.documentElement.style.overflow = 'hidden';
    held = true;
    var focusTarget = success.hidden ? form.querySelector('input') : success.querySelector('h3');
    focusTarget.focus({ preventScroll: true });
  });
  dialog.querySelector('[data-gifting-close]').addEventListener('click', function () { dialog.close(); });
  dialog.addEventListener('close', release);
  dialog.addEventListener('cancel', function (event) { event.preventDefault(); dialog.close(); });
  dialog.addEventListener('click', function (event) {
    if (event.target !== dialog) return;
    var rect = dialog.getBoundingClientRect();
    if (event.clientX < rect.left || event.clientX > rect.right || event.clientY < rect.top || event.clientY > rect.bottom) dialog.close();
  });
  dialog.querySelector('[data-gifting-again]').addEventListener('click', function () {
    form.reset();
    form.hidden = false;
    success.hidden = true;
    error.hidden = true;
    form.querySelector('input').focus();
  });
  form.addEventListener('submit', function (event) {
    event.preventDefault();
    if (submit.disabled || !form.reportValidity()) return;
    submit.disabled = true;
    submitText.textContent = 'Sending…';
    form.setAttribute('aria-busy', 'true');
    error.hidden = true;
    Promise.resolve().then(function () {
      if (!window.SJSlide || typeof window.SJSlide.sendForm !== 'function') return false;
      return window.SJSlide.sendForm(form, { form: 'Gifting & Collaborations enquiry', type: 'Gifting & Collaborations', tags: ['enquiry', 'studio', 'gifting'] });
    }).then(function (ok) {
      if (ok !== true) throw new Error('Enquiry was not accepted');
      form.hidden = true;
      success.hidden = false;
      if (dialog.open) success.querySelector('h3').focus();
    }).catch(function () {
      error.hidden = false;
      if (dialog.open) error.focus();
    }).then(function () {
      submit.disabled = false;
      submitText.textContent = idleText;
      form.removeAttribute('aria-busy');
    });
  });
  document.addEventListener('shopify:section:unload', function (event) {
    if (event.target.contains(root)) { if (dialog.open) dialog.close(); release(); }
  });
})();
</script>
{%- endif -%}
