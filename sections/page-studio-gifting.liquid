{%- assign strand_blocks = section.blocks | where: 'type', 'strand' -%}
{%- assign meta_blocks = section.blocks | where: 'type', 'meta' -%}
{%- assign offer_blocks = section.blocks | where: 'type', 'offer' -%}
{%- assign step_blocks = section.blocks | where: 'type', 'step' -%}
<div class="page">
  <header class="page-hero page-hero--plain" data-reveal>
    <div class="container page-hero__grid">
      <div class="page-hero__text">
        <p class="eyebrow">{{ section.settings.hero_eyebrow | escape }}</p>
        <h1 class="page-hero__title">{{ section.settings.hero_title }}</h1>
        <p class="page-hero__lede">{{ section.settings.hero_lede }}</p>
        <ul class="page-meta">
{%- for block in meta_blocks %}
          <li {{ block.shopify_attributes }}><span class="page-meta__value">{{ block.settings.value }}</span><span class="page-meta__label">{{ block.settings.label }}</span></li>
{%- endfor %}
        </ul>
      </div>
    </div>

    <figure class="container page-hero__media" data-parallax>
      <img src="{% if section.settings.hero_img %}{{ section.settings.hero_img | image_url: width: 1600 }}{% else %}{{ 'shop-hero.webp' | asset_url }}{% endif %}" alt="{{ section.settings.hero_alt | escape }}" fetchpriority="high">
    </figure>
  </header>

  <nav class="strands" aria-label="Studio Collection">
    <div class="container strands__inner">
      <ol class="strands__list">
{%- for block in strand_blocks %}
        <li {{ block.shopify_attributes }}>
          <a href="{{ block.settings.link | default: '/pages/studio-gifting' }}" class="strands__link{% if block.settings.current %} is-active{% endif %}"{% if block.settings.current %} aria-current="page"{% endif %}>
            <span class="strands__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <span class="strands__label">{{ block.settings.label | escape }}</span>
          </a>
        </li>
{%- endfor %}
      </ol>
    </div>
  </nav>

  <section class="section container">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">{{ section.settings.ways_eyebrow | escape }}</p>
      <h2 class="section-title">{{ section.settings.ways_title }}</h2>
    </div>

    <div class="studio">
{%- for block in offer_blocks %}
      <article class="studio-row" data-reveal {{ block.shopify_attributes }}>
        <div class="studio-row__media">
          <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
        </div>

        <div class="studio-row__body">
          <span class="studio-row__no" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <h3 class="studio-row__name">{{ block.settings.name | escape }}</h3>
          <p class="studio-row__copy">{{ block.settings.copy }}</p>

          <ul class="studio-row__facts">
{%- if block.settings.fact_1 != blank %}
            <li>{{ block.settings.fact_1 }}</li>
{%- endif %}
{%- if block.settings.fact_2 != blank %}
            <li>{{ block.settings.fact_2 }}</li>
{%- endif %}
{%- if block.settings.fact_3 != blank %}
            <li>{{ block.settings.fact_3 }}</li>
{%- endif %}
          </ul>

          <a class="arrow-link studio-row__link" href="#gifting-enquiry">{{ block.settings.link_label }}</a>
        </div>
      </article>
{%- endfor %}
    </div>
  </section>

  <section class="section container">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">{{ section.settings.steps_eyebrow | escape }}</p>
      <h2 class="section-title">{{ section.settings.steps_title }}</h2>
    </div>

    <ol class="steps" data-reveal-child>
{%- for block in step_blocks %}
      <li class="step" {{ block.shopify_attributes }}>
        <span class="step__no">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
        <div class="step__body">
          <h3 class="step__title">{{ block.settings.title }}</h3>
          <p class="step__copy">{{ block.settings.copy }}</p>
        </div>
      </li>
{%- endfor %}
    </ol>

    <blockquote class="origin__pull" data-reveal>{{ section.settings.pull }}</blockquote>
  </section>

  <section class="section container enquiry" id="gifting-enquiry" data-done-title="{{ section.settings.done_title | escape }}" data-done-body="{{ section.settings.done_body | escape }}" data-done-again="{{ section.settings.done_again | escape }}">
    <div class="enquiry__intro" data-reveal>
      <p class="eyebrow">{{ section.settings.enq_eyebrow | escape }}</p>
      <h2 class="section-title">{{ section.settings.enq_title }}</h2>
      <p class="enquiry__copy">{{ section.settings.enq_copy }}</p>

      <dl class="enquiry__reach">
        <div>
          <dt>{{ section.settings.call_label }}</dt>
          <dd>
            <a href="tel:{{ section.settings.phone | remove: ' ' }}">{{ section.settings.phone }}</a>
          </dd>
        </div>
        <div>
          <dt>{{ section.settings.write_label }}</dt>
          <dd>
            <a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>
          </dd>
        </div>
        <div>
          <dt>{{ section.settings.hours_label }}</dt>
          <dd>{{ section.settings.hours }}</dd>
        </div>
      </dl>
    </div>

    <form class="enquiry__form" data-reveal>
      <p class="field">
        <label for="gifting-enquiry-name">Name <span aria-hidden="true">*</span></label>
        <input id="gifting-enquiry-name" name="name" type="text" required autocomplete="name">
      </p>

      <p class="field">
        <label for="gifting-enquiry-phone">Contact number <span aria-hidden="true">*</span></label>
        <input id="gifting-enquiry-phone" name="phone" type="tel" required autocomplete="tel">
      </p>

      <p class="field">
        <label for="gifting-enquiry-city">City</label>
        <input id="gifting-enquiry-city" name="city" type="text" autocomplete="address-level2">
      </p>

      <p class="field">
        <label for="gifting-enquiry-email">Email</label>
        <input id="gifting-enquiry-email" name="email" type="email" autocomplete="email">
      </p>

      <p class="field">
        <label for="gifting-enquiry-extra">Quantity and occasion</label>
        <input id="gifting-enquiry-extra" name="extra" type="text" placeholder="150 pieces, Diwali">
      </p>

      <p class="field field--wide">
        <label for="gifting-enquiry-looking">What are you looking for?</label>
        <textarea id="gifting-enquiry-looking" name="looking" rows="3"></textarea>
      </p>

      <p class="field">
        <label for="gifting-enquiry-slot">Preferred time slot</label>
        <select id="gifting-enquiry-slot" name="slot">
          <option value="" disabled selected>Choose a time</option>
          <option value="9:00 AM">9:00 AM</option>
          <option value="9:30 AM">9:30 AM</option>
          <option value="10:00 AM">10:00 AM</option>
          <option value="10:30 AM">10:30 AM</option>
          <option value="11:00 AM">11:00 AM</option>
          <option value="11:30 AM">11:30 AM</option>
          <option value="12:00 PM">12:00 PM</option>
          <option value="12:30 PM">12:30 PM</option>
          <option value="1:00 PM">1:00 PM</option>
          <option value="1:30 PM">1:30 PM</option>
          <option value="2:00 PM">2:00 PM</option>
          <option value="2:30 PM">2:30 PM</option>
          <option value="3:00 PM">3:00 PM</option>
          <option value="3:30 PM">3:30 PM</option>
          <option value="4:00 PM">4:00 PM</option>
          <option value="4:30 PM">4:30 PM</option>
          <option value="5:00 PM">5:00 PM</option>
          <option value="5:30 PM">5:30 PM</option>
        </select>
      </p>

      <div class="enquiry__submit">
        <button class="btn" type="submit">{{ section.settings.submit_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></button>
        <span class="enquiry__note"><span aria-hidden="true">*</span> {{ section.settings.note }}</span>
      </div>
    </form>
  </section>
</div>

<script>
(function () {
  var root = document.getElementById('gifting-enquiry');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var form = root.querySelector('.enquiry__form');
  if (!form) return;

  var arrow = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>';

  var done = document.createElement('div');
  done.className = 'enquiry__done';
  done.setAttribute('role', 'status');
  done.setAttribute('data-reveal', '');
  done.innerHTML =
    '<p class="enquiry__done-title">' + (root.getAttribute('data-done-title') || 'Thank you — we have your request.') + '</p>' +
    '<p>' + (root.getAttribute('data-done-body') || 'Someone from the Bhuj studio will call you in your chosen slot. If it is urgent, reach us on <a href="tel:+919099974319">+91 9099 974319</a>.') + '</p>' +
    '<button class="arrow-link" type="button">' + (root.getAttribute('data-done-again') || 'Send another enquiry') + ' ' + arrow + '</button>';

  done.querySelector('button').addEventListener('click', function () {
    form.reset();
    done.replaceWith(form);
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    form.replaceWith(done);
  });
})();
</script>
