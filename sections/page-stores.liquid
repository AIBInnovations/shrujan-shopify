{%- render 'section-design', section: section -%}
{%- comment -%}
  The Stores page (the user, 2026-10-29): every Shrujan store with its
  photograph (or its map, where there is no photograph yet), address,
  numbers, directions and a map; a filter by city. Written by
  awwwards-preview/stores_section.py from the same list as the home page's
  stores. Styles in sj-site.css (src/site.css, .stx).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign stores = 'Bhujodi|Kutch|Behind G.E.B Sub Station, Bhujodi, Bhuj, Kutch 370020|+91 2832 240272|+91 90999 74395|visit-campus.webp|The Shrujan campus at Bhujodi: the studio and the store, racks of embroidered pieces~LLDC Museum|Kutch|Living and Learning Design Centre, 705, Bhuj–Bhachau Road, Ajrakhpur, Bhuj, Kutch 370105|+91 2832 229090|+91 90818 99886|lldc-hero.webp|A gallery at the Living and Learning Design Centre, figures in the dress of Kutchi communities~Ahmedabad|Ahmedabad|Shop No. 1, Gala Business Centre 1, opp. Wagh Bakri Tea Lounge, near St. Xavier’s College Road, Navrangpura, Ahmedabad 380009||+91 72279 82099||~Mumbai|Mumbai|C.T.C 217/A Wing, 1st Floor, Flexcel Park, S.V. Road, near 24 Karat Multiplex, Jogeshwari (W), Mumbai 400102|+91 22 6215 7598|+91 98337 66584||~Bhuj Airport|Kutch|Bhuj Airport, Civil Enclave, Bhuj, Kutch 370001||+91 99784 18952||~Delhi|Delhi|C.C.I.C. International Craft Complex, Plot No. 8, Nelson Mandela Marg, Vasant Kunj, New Delhi 110070||+91 88665 83477||' | split: '~'
  assign regions = ''
  if section.blocks.size > 0
    for b in section.blocks
      assign regions = regions | append: b.settings.region | append: ','
    endfor
  else
    for d in stores
      assign f = d | split: '|'
      assign regions = regions | append: f[1] | append: ','
    endfor
  endif
  assign regions = regions | split: ',' | uniq
-%}
<section class="stx" id="stores" aria-labelledby="stx-title-{{ section.id }}">
  <header class="stx__head">
    {%- if s.eyebrow != blank %}<p class="stx__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
    <h1 class="stx__title" id="stx-title-{{ section.id }}"><span>{{ s.title_1 | escape }}</span>{% if s.title_2 != blank %} <em>{{ s.title_2 | escape }}</em>{% endif %}</h1>
    {%- if s.lede != blank %}<p class="stx__lede">{{ s.lede | escape }}</p>{% endif -%}
    {%- if s.show_filter and regions.size > 1 %}
    <div class="stx__filter" role="group" aria-label="Stores by city">
      <button type="button" class="is-on" data-stx-region="" aria-pressed="true">{{ s.all_label | default: 'All' | escape }}</button>
      {%- for r in regions -%}{%- if r != blank -%}<button type="button" data-stx-region="{{ r | handleize }}" aria-pressed="false">{{ r | escape }}</button>{%- endif -%}{%- endfor -%}
    </div>
    {%- endif %}
  </header>
  <div class="stx__list">
    {%- if section.blocks.size > 0 -%}
      {%- for b in section.blocks -%}
        {%- liquid
          assign s_n = b.settings.name
          assign s_r = b.settings.region
          assign s_a = b.settings.address
          assign s_t = b.settings.tel
          assign s_m = b.settings.mobile
          assign s_h = b.settings.hours
          assign s_q = b.settings.map_query
          assign s_alt = b.settings.image_alt
          assign s_img = ''
          if b.settings.image != blank
            assign s_img = b.settings.image | image_url: width: 1400
            assign s_alt = b.settings.image_alt | default: b.settings.image.alt
          elsif b.settings.image_asset != blank
            assign s_img = b.settings.image_asset | asset_url
          endif
        -%}
        {%- liquid
          assign q = s_q | default: s_a
          assign q = 'Shrujan, ' | append: q | url_encode
          assign slug = s_r | handleize
        -%}
        <article class="stx__store" data-region="{{ slug }}" {{ b.shopify_attributes }}>
          <div class="stx__media">
            {%- if s_img != blank -%}<img src="{{ s_img }}" alt="{{ s_alt | escape }}" loading="lazy">
            {%- else -%}<iframe class="stx__map stx__map--big" src="https://maps.google.com/maps?q={{ q }}&z=15&output=embed" title="Map: Shrujan {{ s_n | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>{%- endif -%}
          </div>
          <div class="stx__info">
            {%- if s_r != blank %}<p class="stx__region"><i class="sj-i sj-i--map-pin ms" aria-hidden="true"></i> {{ s_r | escape }}</p>{% endif %}
            <h2 class="stx__name">{{ s_n | escape }}</h2>
            <p class="stx__addr">{{ s_a | escape }}</p>
            {%- if s_h != blank %}<p class="stx__hours">{{ s_h | escape }}</p>{% endif %}
            <p class="stx__tel">{% if s_t != blank %}<a href="tel:{{ s_t | remove: ' ' }}"><i class="sj-i sj-i--phone ms" aria-hidden="true"></i>{{ s_t }}</a>{% endif %}{% if s_m != blank %}<a href="tel:{{ s_m | remove: ' ' }}"><i class="sj-i sj-i--phone ms" aria-hidden="true"></i>{{ s_m }}</a>{% endif %}</p>
            <a class="stx__go" href="https://www.google.com/maps/search/?api=1&query={{ q }}" target="_blank" rel="noopener">Get directions <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>
          </div>
          {%- if s_img != blank -%}
          <div class="stx__mapbox"><iframe class="stx__map" src="https://maps.google.com/maps?q={{ q }}&z=15&output=embed" title="Map: Shrujan {{ s_n | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    {%- else -%}
      {%- for d in stores -%}
        {%- assign f = d | split: '|' -%}
        {%- liquid
          assign s_n = f[0]
          assign s_r = f[1]
          assign s_a = f[2]
          assign s_t = f[3]
          assign s_m = f[4]
          assign s_h = ''
          assign s_q = ''
          assign s_alt = f[6]
          assign s_img = ''
          if f[5] != blank
            assign s_img = f[5] | asset_url
          endif
        -%}
        {%- liquid
          assign q = s_q | default: s_a
          assign q = 'Shrujan, ' | append: q | url_encode
          assign slug = s_r | handleize
        -%}
        <article class="stx__store" data-region="{{ slug }}">
          <div class="stx__media">
            {%- if s_img != blank -%}<img src="{{ s_img }}" alt="{{ s_alt | escape }}" loading="lazy">
            {%- else -%}<iframe class="stx__map stx__map--big" src="https://maps.google.com/maps?q={{ q }}&z=15&output=embed" title="Map: Shrujan {{ s_n | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>{%- endif -%}
          </div>
          <div class="stx__info">
            {%- if s_r != blank %}<p class="stx__region"><i class="sj-i sj-i--map-pin ms" aria-hidden="true"></i> {{ s_r | escape }}</p>{% endif %}
            <h2 class="stx__name">{{ s_n | escape }}</h2>
            <p class="stx__addr">{{ s_a | escape }}</p>
            {%- if s_h != blank %}<p class="stx__hours">{{ s_h | escape }}</p>{% endif %}
            <p class="stx__tel">{% if s_t != blank %}<a href="tel:{{ s_t | remove: ' ' }}"><i class="sj-i sj-i--phone ms" aria-hidden="true"></i>{{ s_t }}</a>{% endif %}{% if s_m != blank %}<a href="tel:{{ s_m | remove: ' ' }}"><i class="sj-i sj-i--phone ms" aria-hidden="true"></i>{{ s_m }}</a>{% endif %}</p>
            <a class="stx__go" href="https://www.google.com/maps/search/?api=1&query={{ q }}" target="_blank" rel="noopener">Get directions <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>
          </div>
          {%- if s_img != blank -%}
          <div class="stx__mapbox"><iframe class="stx__map" src="https://maps.google.com/maps?q={{ q }}&z=15&output=embed" title="Map: Shrujan {{ s_n | escape }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
          {%- endif -%}
        </article>
      {%- endfor -%}
    {%- endif -%}
  </div>
  {%- if s.cta_title != blank %}
  <aside class="stx__cta">
    <div><h2 class="stx__cta-title">{{ s.cta_title | escape }}</h2>{% if s.cta_copy != blank %}<p>{{ s.cta_copy | escape }}</p>{% endif %}</div>
    <div class="stx__cta-acts">
      {%- if s.cta_label != blank %}<a class="stx__btn stx__btn--solid" href="{{ s.cta_link | default: '/pages/shop-shrujan' }}">{{ s.cta_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>{% endif %}
      <a class="stx__btn" href="https://api.whatsapp.com/send?phone=919099974319" target="_blank" rel="noopener"><i class="sj-i sj-i--whatsapp-logo fab" aria-hidden="true"></i> WhatsApp</a>
    </div>
  </aside>
  {%- endif %}
</section>
<script>
(function () {
  var root = document.getElementById('stx-title-{{ section.id }}');
  root = root && root.closest('.stx');
  if (!root || root.__stx) return;
  root.__stx = true;
  var btns = [].slice.call(root.querySelectorAll('[data-stx-region]'));
  var stores = [].slice.call(root.querySelectorAll('.stx__store'));
  btns.forEach(function (b) {
    b.addEventListener('click', function () {
      var r = b.getAttribute('data-stx-region');
      btns.forEach(function (o) { var on = o === b; o.classList.toggle('is-on', on); o.setAttribute('aria-pressed', on ? 'true' : 'false'); });
      stores.forEach(function (st) { st.hidden = !!r && st.getAttribute('data-region') !== r; });
    });
  });
})();
</script>

{% schema %}
{
  "name": "Stores page",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Visit us"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title, first line",
      "default": "Shrujan"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title, second line (in red)",
      "default": "stores"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Line under the title",
      "default": "See the pieces in person: at the campus in Bhujodi, at the LLDC, or at a Shrujan store in Ahmedabad, Mumbai, Delhi or Bhuj Airport."
    },
    {
      "type": "checkbox",
      "id": "show_filter",
      "label": "Show the city filter",
      "default": true
    },
    {
      "type": "text",
      "id": "all_label",
      "label": "Filter: the 'all stores' tab",
      "default": "All"
    },
    {
      "type": "header",
      "content": "Closing band"
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Title",
      "default": "Can’t come in?"
    },
    {
      "type": "textarea",
      "id": "cta_copy",
      "label": "Line",
      "default": "Every piece in the stores is also online, and the studio answers on WhatsApp."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Shop online"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link",
      "default": "/pages/shop-shrujan"
    },
    {
      "type": "paragraph",
      "content": "Add store blocks to list the stores yourself; with none, the six Shrujan stores show."
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "region",
          "label": "City or area (the filter)"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "tel",
          "label": "Landline"
        },
        {
          "type": "text",
          "id": "mobile",
          "label": "Mobile"
        },
        {
          "type": "text",
          "id": "hours",
          "label": "Opening hours (optional)"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photograph of the store"
        },
        {
          "type": "text",
          "id": "image_asset",
          "label": "Or theme image file"
        },
        {
          "type": "text",
          "id": "image_alt",
          "label": "Photograph description"
        },
        {
          "type": "text",
          "id": "map_query",
          "label": "Map search (if the address finds the wrong place)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Stores page"
    }
  ]
}
{% endschema %}
