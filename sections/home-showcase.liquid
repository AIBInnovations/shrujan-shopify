      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Philosophy <em>&amp; Values</em>"
    },
    {
      "type": "header",
      "content": "Jharokha tilework"
    },
    {
      "type": "checkbox",
      "id": "show_arches",
      "label": "Flank the section with the tilework",
      "info": "Shown on screens wider than 1180px.",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "arch_img",
      "label": "Tilework image"
    },
    {
      "type": "text",
      "id": "arch_asset",
      "label": "Tilework theme asset (fallback)",
      "default": "heritage-arch.webp"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Intro copy",
      "default": "A responsible social enterprise since 1969."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Link label",
      "default": "Learn more"
    },
    {
      "type": "text",
      "id": "more_link",
      "label": "Link",
      "default": "/pages/the-shrujan-story"
    },
    {
      "type": "header",
      "content": "Seals between the arches"
    },
    {
      "type": "paragraph",
      "content": "The small line above is the eyebrow; the lede is the copy; the seals are the blocks, each with a ring of its name turning around it."
    },
    {
      "type": "text",
      "id": "prm_meta_r",
      "label": "Small line, right",
      "default": "Three values · since 1969"
    },
    {
      "type": "text",
      "id": "prm_line_1",
      "label": "Title, line 1",
      "default": "Philosophy"
    },
    {
      "type": "text",
      "id": "prm_line_2",
      "label": "Title, line 2",
      "default": "& Values"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "sw_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centred"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "range",
      "id": "sw_cols",
      "label": "Seals per row (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Applies above 1080px. Between 600 and 1080px the theme shows two."
    },
    {
      "type": "range",
      "id": "sw_cols_m",
      "label": "Seals per row (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 2,
      "info": "Applies below 600px."
    },
    {
      "type": "header",
      "content": "Seal content"
    },
    {
      "type": "checkbox",
      "id": "sw_show_number",
      "label": "Show seal number",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sw_show_ring",
      "label": "Show seal image",
      "default": true,
      "info": "The round portrait above each promise."
    },
    {
