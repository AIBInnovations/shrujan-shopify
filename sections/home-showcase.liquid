{%- render 'section-design', section: section -%}
{%- comment -%}
  Philosophy & Values, on the user's layout: one screen, two panels. Left:
  the small heading, the title in two lines (the second in maroon), a
  diamond rule, the line under it, the values as rows (number, round
  photograph, name in two lines, arrow) on a thin rail, Learn more and a
  line of small words. Right: the open value's photograph fading into the
  paper, its number out of all, its name, words and link, a drawn flower
  with the value's three words, and the previous and next buttons. The
  values are the section's blocks. Styles in sj-home.css (src/prm.css),
  behaviour in sj-home.js (src/prm.js); the preview's copy is build.py's.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign n = section.blocks.size
-%}
<section class="pv" id="promise" aria-labelledby="pv-title-{{ section.id }}">
  <div class="pv__grid">
    <div class="pv__side">
      <div class="pv__intro">
        {%- if cfg.eyebrow != blank -%}<p class="pv__eyebrow" data-pv-in style="--d:0">{{ cfg.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="pv__title" id="pv-title-{{ section.id }}" data-pv-in style="--d:1"><span>{{ cfg.prm_line_1 | escape }}</span>{% if cfg.prm_line_2 != blank %}<em>{{ cfg.prm_line_2 | escape }}</em>{% endif %}</h2>
        <span class="pv__orn" data-pv-in style="--d:2"><svg viewBox="0 0 58 14" aria-hidden="true"><path d="M0 7h21M37 7h21" stroke="currentColor" stroke-width="1"/><path d="M29 1.5 34.5 7 29 12.5 23.5 7z" fill="none" stroke="currentColor" stroke-width="1"/><path d="M29 4.6 31.4 7 29 9.4 26.6 7z" fill="currentColor" opacity=".55"/></svg></span>
        {%- if cfg.copy != blank -%}<p class="pv__lede" data-pv-in style="--d:3">{{ cfg.copy | escape }}</p>{%- endif -%}
      </div>
      <ol class="pv__list" role="tablist" aria-label="{{ cfg.prm_meta_r | default: 'Our values' | escape }}" data-pv-in style="--d:4">
        {%- for block in section.blocks -%}
          {%- liquid
            assign v_name = block.settings.title | strip
            assign v_first = v_name | split: ' ' | first
            assign v_rest = v_name | remove_first: v_first | strip
            if block.settings.img
              assign v_src = block.settings.img | image_url: width: 400
            else
              assign v_src = block.settings.fallback | asset_url
            endif
          -%}
        <li {{ block.shopify_attributes }}><button class="pv__row" type="button" role="tab" id="pv-tab-{{ section.id }}-{{ forloop.index0 }}" aria-controls="pv-panel-{{ section.id }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"><span class="pv__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><span class="pv__thumb"><img src="{{ v_src }}" alt="" loading="lazy" style="object-position:{{ block.settings.thumb_focus | default: '50% 40%' | escape }}"></span><span class="pv__name"><span>{{ v_first | escape }}</span><span>{{ v_rest | escape }}</span></span><i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></button></li>
        {%- endfor -%}
      </ol>
      <div class="pv__foot" data-pv-in style="--d:5">
        {%- if cfg.more_label != blank -%}<a class="pv__more" href="{{ cfg.more_link | default: '/pages/the-shrujan-story' }}">{{ cfg.more_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>{%- endif -%}
        {%- if cfg.foot_words != blank -%}<p class="pv__words">{{ cfg.foot_words | escape }}</p>{%- endif -%}
      </div>
    </div>
    <div class="pv__stage" id="pv-panel-{{ section.id }}" role="tabpanel" aria-label="{{ cfg.prm_meta_r | default: 'Our values' | escape }}">
      <div class="pv__photos">
        {%- for block in section.blocks -%}
          {%- if block.settings.img -%}{%- assign v_big = block.settings.img | image_url: width: 1800 -%}{%- else -%}{%- assign v_big = block.settings.fallback | asset_url -%}{%- endif -%}
        <figure class="pv__photo{% if forloop.first %} is-on{% endif %}"><img src="{{ v_big }}" alt="{{ block.settings.alt | escape }}" loading="lazy" style="object-position:{{ block.settings.focus | default: '60% 35%' | escape }}"></figure>
        {%- endfor -%}
      </div>
      <div class="pv__top" data-pv-in style="--d:2"><p class="pv__count" aria-hidden="true"><b>01</b><i>/</i><span>{% if n < 10 %}0{% endif %}{{ n }}</span></p>{% if cfg.prm_meta_r != blank %}<p class="pv__tag">{{ cfg.prm_meta_r | escape }}</p>{% endif %}</div>
      <div class="pv__texts" data-pv-in style="--d:3">
        {%- for block in section.blocks -%}
          {%- liquid
            assign v_name = block.settings.title | strip
            assign v_first = v_name | split: ' ' | first
            assign v_rest = v_name | remove_first: v_first | strip
          -%}
        <article class="pv__text{% if forloop.first %} is-on{% endif %}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"><h3 class="pv__head"><span>{{ v_first | escape }}</span><span>{{ v_rest | escape }}</span></h3><span class="pv__rule" aria-hidden="true"></span><p class="pv__copy">{{ block.settings.copy | strip | escape }}</p>{% if cfg.link_label != blank %}<a class="pv__link" href="{{ block.settings.link | default: cfg.more_link | default: '/pages/the-shrujan-story' }}">{{ cfg.link_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>{% endif %}</article>
        {%- endfor -%}
      </div>
      <div class="pv__bottom" data-pv-in style="--d:5">
        <span class="pv__flower"><svg viewBox="-50 -50 100 100" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.1"><path transform="rotate(0)" d="M0-9C9-17 11-33 0-46C-11-33-9-17 0-9Z"/><path transform="rotate(90)" d="M0-9C9-17 11-33 0-46C-11-33-9-17 0-9Z"/><path transform="rotate(180)" d="M0-9C9-17 11-33 0-46C-11-33-9-17 0-9Z"/><path transform="rotate(270)" d="M0-9C9-17 11-33 0-46C-11-33-9-17 0-9Z"/><path transform="rotate(45)" d="M0-9C6-15 7-25 0-33C-7-25-6-15 0-9Z"/><path transform="rotate(135)" d="M0-9C6-15 7-25 0-33C-7-25-6-15 0-9Z"/><path transform="rotate(225)" d="M0-9C6-15 7-25 0-33C-7-25-6-15 0-9Z"/><path transform="rotate(315)" d="M0-9C6-15 7-25 0-33C-7-25-6-15 0-9Z"/><circle r="5.5"/></g></svg></span>
        <div class="pv__trail"><p class="pv__vwords">{%- for block in section.blocks -%}<span{% if forloop.first %} class="is-on"{% endif %}>{{ block.settings.words | escape }}</span>{%- endfor -%}</p></div>
        <div class="pv__nav"><button class="pv__prev" type="button" aria-label="Previous value"><i class="sj-i sj-i--arrow-left ms" aria-hidden="true"></i></button><button class="pv__next" type="button" aria-label="Next value"><i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></button></div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Home promises",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Our foundation"
