{%- render 'section-design', section: section -%}
{%- comment -%}
  Philosophy & Values, on the user's layout: the title in two lines and the
  line under it, centred; the values as cards turning round the middle one
  (larger, raised, with a small maroon flower under its photograph), round
  previous and next buttons at the column's edges, dots, Learn more. The
  values are the section's blocks. Styles in sj-home.css (src/prm.css),
  behaviour in sj-home.js (src/prm.js); the preview's copy is build.py's.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign n = section.blocks.size
  assign mid = 0
  if n > 2
    assign mid = 1
  endif
  assign mid_l = mid | minus: 1
  assign mid_r = mid | plus: 1
-%}
<section class="pv" id="promise" aria-labelledby="pv-title-{{ section.id }}" aria-roledescription="carousel">
  <div class="pv__head">
    {%- if cfg.eyebrow != blank -%}<p class="pv__eyebrow" data-pv-in style="--d:0">{{ cfg.eyebrow | escape }}</p>{%- endif -%}
    <h2 class="pv__title" id="pv-title-{{ section.id }}" data-pv-in style="--d:0"><span>{{ cfg.prm_line_1 | escape }}</span>{% if cfg.prm_line_2 != blank %}<em>{{ cfg.prm_line_2 | escape }}</em>{% endif %}</h2>
    {%- if cfg.copy != blank -%}<p class="pv__lede" data-pv-in style="--d:1">{{ cfg.copy | escape }}</p>{%- endif -%}
  </div>
  <div class="pv__stage" data-pv-in style="--d:2">
    <button class="pv__arrow pv__arrow--prev" type="button" aria-label="Previous value"><i class="sj-i sj-i--caret-left ms" aria-hidden="true"></i></button>
    <ol class="pv__track">
      {%- for block in section.blocks -%}
        {%- liquid
          assign k = forloop.index0
          if k == mid
            assign pos = '0'
          elsif k == mid_l
            assign pos = '-1'
          elsif k == mid_r
            assign pos = '1'
          else
            assign pos = 'far-r'
          endif
          if block.settings.img
            assign v_src = block.settings.img | image_url: width: 1200
          else
            assign v_src = block.settings.fallback | asset_url
          endif
        -%}
      <li class="pv__card" data-pos="{{ pos }}" role="group" aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ n }}" {{ block.shopify_attributes }}><p class="pv__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</p><h3 class="pv__name">{{ block.settings.title | strip | escape }}</h3><p class="pv__copy">{{ block.settings.copy | strip | escape }}</p><span class="pv__photo"><img src="{{ v_src }}" alt="{{ block.settings.alt | escape }}" loading="lazy" style="object-position:{{ block.settings.focus | default: '50% 40%' | escape }}"></span><span class="pv__mark"><svg viewBox="-20 -20 40 40" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.3"><path transform="rotate(0)" d="M0-4C4-8 4-13 0-18C-4-13-4-8 0-4Z"/><path transform="rotate(90)" d="M0-4C4-8 4-13 0-18C-4-13-4-8 0-4Z"/><path transform="rotate(180)" d="M0-4C4-8 4-13 0-18C-4-13-4-8 0-4Z"/><path transform="rotate(270)" d="M0-4C4-8 4-13 0-18C-4-13-4-8 0-4Z"/><path d="M0-6 6 0 0 6-6 0Z" transform="rotate(45) scale(.7)"/><circle r="1.6" fill="currentColor"/></g></svg></span></li>
      {%- endfor -%}
    </ol>
    <button class="pv__arrow pv__arrow--next" type="button" aria-label="Next value"><i class="sj-i sj-i--caret-right ms" aria-hidden="true"></i></button>
  </div>
  <div class="pv__dots" data-pv-in style="--d:3">
    {%- for block in section.blocks -%}<button class="pv__dot" type="button" aria-label="Value {{ forloop.index }}" aria-current="{% if forloop.index0 == mid %}true{% else %}false{% endif %}"></button>{%- endfor -%}
  </div>
  {%- if cfg.more_label != blank -%}
  <a class="pv__more" href="{{ cfg.more_link | default: '/pages/the-shrujan-story' }}" data-pv-in style="--d:4">{{ cfg.more_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Home promises",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading above the title (optional)"
