{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id
  assign has_layout = false
  if cfg.sw_cols != 4 or cfg.sw_cols_m != 1 or cfg.sw_align != 'center'
    assign has_layout = true
  endif
  if cfg.sw_show_divider == false
    assign has_layout = true
  endif
-%}
{%- if has_layout -%}
  <style>
    {%- if cfg.sw_cols != 4 -%}
      @media (min-width: 1081px) {
        {{ sel }} .manifesto__grid { grid-template-columns: repeat({{ cfg.sw_cols }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.sw_cols_m != 1 -%}
      @media (max-width: 600px) {
        {{ sel }} .manifesto__grid { grid-template-columns: repeat({{ cfg.sw_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- comment -%}
      The intro is a centred grid, so left-aligning it means flipping the two
      properties that centre it rather than adding any.
    {%- endcomment -%}
    {%- if cfg.sw_align == 'left' -%}
      {{ sel }} .section-intro { text-align: left; justify-items: start; }
    {%- endif -%}
    {%- comment -%}
      The rule between seals is a pseudo-element, so only CSS can retire it.
    {%- endcomment -%}
    {%- if cfg.sw_show_divider == false -%}
      {{ sel }} .seal + .seal::before { display: none; }
    {%- endif -%}
  </style>
{%- endif -%}
<section class="section container manifesto" id="promise">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="section-title">
      {{ section.settings.title }}
    </h2>
    <p class="section-intro__copy">
      {{ section.settings.copy | escape }}
    </p>
  </div>

  <ol class="manifesto__grid" data-reveal-child>
    {%- for block in section.blocks %}
    <li class="seal" {{ block.shopify_attributes }}>
      {% if cfg.sw_show_number %}<span class="seal__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{% endif %}

      {% if cfg.sw_show_ring %}
      <span class="seal__ring">
        <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 900 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
      </span>
      {% endif %}

      <h3 class="seal__title">{{ block.settings.title | escape }}</h3>
      <p class="seal__copy">{{ block.settings.copy | escape }}</p>
    </li>
    {%- endfor %}
  </ol>

  {% if cfg.sw_show_more %}
  <div class="manifesto__more" data-reveal>
    <a class="arrow-link" href="{{ section.settings.more_link }}">
      {{ section.settings.more_label | escape }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
    </a>
  </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "Home promises",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The future of heritage is here"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "Craft that cares: <em>four promises</em> in every piece"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Intro copy",
      "default": "Living embroidery, natural cloth and honest making, held to the same four standards since 1969."
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Link label",
      "default": "How we make it"
    },
    {
      "type": "text",
      "id": "more_link",
      "label": "Link",
      "default": "#craft"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "sw_align",
      "label": "Heading alignment",
      "default": "center",
      "options": [
        {
          "value": "center",
          "label": "Centred"
        },
        {
          "value": "left",
          "label": "Left"
        }
      ]
    },
    {
      "type": "range",
      "id": "sw_cols",
      "label": "Seals per row (desktop)",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "info": "Applies above 1080px. Between 600 and 1080px the theme shows two."
    },
    {
      "type": "range",
      "id": "sw_cols_m",
      "label": "Seals per row (mobile)",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1,
      "info": "Applies below 600px."
    },
    {
      "type": "header",
      "content": "Seal content"
    },
    {
      "type": "checkbox",
      "id": "sw_show_number",
      "label": "Show seal number",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sw_show_ring",
      "label": "Show seal image",
      "default": true,
      "info": "The round portrait above each promise."
    },
    {
      "type": "checkbox",
      "id": "sw_show_divider",
      "label": "Show rule between seals",
      "default": true,
      "info": "Drawn only where seals sit side by side, so it already disappears once they stack."
    },
    {
      "type": "checkbox",
      "id": "sw_show_more",
      "label": "Show bottom link",
      "default": true
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    }
  ],
  "blocks": [
    {
      "type": "seal",
      "name": "Promise seal",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Fallback asset file",
          "info": "Theme asset filename used until an image is picked.",
          "default": "top-right.webp"
        },
        {
          "type": "text",
          "id": "alt",
          "label": "Image alt text",
          "default": "Close crop of mirror-work embroidery in crimson and gold threads"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Hand Embroidery"
        },
        {
          "type": "textarea",
          "id": "copy",
          "label": "Copy",
          "default": "Every motif counted and stitched by hand. No machine ever touches the cloth."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home promises",
      "blocks": [
        {
          "type": "seal",
          "settings": {
            "fallback": "top-right.webp",
            "alt": "Close crop of mirror-work embroidery in crimson and gold threads",
            "title": "Hand Embroidery",
            "copy": "Every motif counted and stitched by hand. No machine ever touches the cloth."
          }
        },
        {
          "type": "seal",
          "settings": {
            "fallback": "frame-r5t15.webp",
            "alt": "Close crop of turquoise Kutchi mirror-work embroidery",
            "title": "Natural Dyes",
            "copy": "Madder, indigo and pomegranate on handloom cotton and mulberry silk."
          }
        },
        {
          "type": "seal",
          "settings": {
            "fallback": "bottom-left.webp",
            "alt": "Master weaver working threads at his handloom",
            "title": "Fair Wages",
            "copy": "Paid per piece, on time, directly to the woman whose hands made it."
          }
        },
        {
          "type": "seal",
          "settings": {
            "fallback": "bottom-right.webp",
            "alt": "Model in a mehendi-green hand-embroidered kurta set",
            "title": "Made to Last",
            "copy": "Finished to be worn today, repaired for free, and handed down tomorrow."
          }
        }
      ]
    }
  ]
}
{% endschema %}
