  ],
  "blocks": [
    {
      "type": "seal",
      "name": "Promise seal",
      "settings": [
        {
          "type": "image_picker",
          "id": "img",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "fallback",
          "label": "Fallback asset file",
