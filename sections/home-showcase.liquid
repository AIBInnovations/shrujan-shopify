{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id
  assign has_layout = false
  if cfg.sw_cols != 4 or cfg.sw_cols_m != 2 or cfg.sw_align != 'center'
    assign has_layout = true
  endif
  if cfg.sw_show_divider == false
    assign has_layout = true
  endif
  comment
    Mobile group. The numeral and the ringed photograph are already markup
    switches, so the phone-only versions only have work to do while the seal is
    being rendered at all — hence the paired guard. The rule between seals needs
    no phone switch: the stylesheet already retires it at 1080px and under.
  endcomment
  if cfg.sw_show_number and cfg.sw_show_number_m == false
    assign has_layout = true
  endif
  if cfg.sw_show_ring and cfg.sw_show_ring_m == false
    assign has_layout = true
  endif
-%}
{%- if has_layout -%}
  <style>
    {%- if cfg.sw_cols != 4 -%}
      @media (min-width: 1081px) {
        {{ sel }} .manifesto__grid { grid-template-columns: repeat({{ cfg.sw_cols }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- if cfg.sw_cols_m != 2 -%}
      @media (max-width: 600px) {
        {{ sel }} .manifesto__grid { grid-template-columns: repeat({{ cfg.sw_cols_m }}, minmax(0, 1fr)); }
      }
    {%- endif -%}
    {%- comment -%}
      The intro is a centred grid, so left-aligning it means flipping the two
      properties that centre it rather than adding any.
    {%- endcomment -%}
    {%- if cfg.sw_align == 'left' -%}
      {{ sel }} .section-intro { text-align: left; justify-items: start; }
    {%- endif -%}
    {%- comment -%}
      The rule between seals is a pseudo-element, so only CSS can retire it.
    {%- endcomment -%}
    {%- if cfg.sw_show_divider == false -%}
      {{ sel }} .seal + .seal::before { display: none; }
    {%- endif -%}

    {%- comment -%}
      Phone. 600px is the seal grid's own narrowest step — the same query
      `sw_cols_m` above is written into.
    {%- endcomment -%}
    {%- if cfg.sw_show_number and cfg.sw_show_number_m == false -%}
      @media (max-width: 600px) { {{ sel }} .seal__no { display: none; } }
    {%- endif -%}
    {%- if cfg.sw_show_ring and cfg.sw_show_ring_m == false -%}
      @media (max-width: 600px) { {{ sel }} .seal__ring { display: none; } }
    {%- endif -%}
  </style>
{%- endif -%}
{%- comment -%}
  Craft that cares: the four round seals between the jharokha arches. With
  motion (assets/sj-home.js, styled by sj-home.css) the arches close in from
  the screen's edges, each seal's ring draws itself and its photograph opens,
  and a ring of words, the seal's name and Shrujan, turns around it. The seals
  are the section's blocks.
{%- endcomment -%}
{%- liquid
  if section.settings.arch_img
    assign arch_src = section.settings.arch_img | image_url: width: 600
  else
    assign arch_src = section.settings.arch_asset | asset_url
  endif
  assign prm_label = cfg.prm_line_1 | append: ' ' | append: cfg.prm_line_2
-%}
<section class="prm" id="promise" aria-label="{{ prm_label | escape }}">
  <div class="prm__meta"><span>{{ section.settings.eyebrow | escape }}</span><span>{{ cfg.prm_meta_r | escape }}</span></div>
  <div class="prm__head">
    <h2 class="prm__title"><span class="prm__line">{{ cfg.prm_line_1 | escape }}</span><span class="prm__line prm__line--soft">{{ cfg.prm_line_2 | escape }}</span></h2>
    <p class="prm__lede">{{ section.settings.copy | escape }}</p>
  </div>
  <div class="prm__stage">
    {%- if section.settings.show_arches %}
    <span class="prm__arch prm__arch--left" aria-hidden="true"><img src="{{ arch_src }}" alt="" decoding="async"></span>
    <span class="prm__arch prm__arch--right" aria-hidden="true"><img src="{{ arch_src }}" alt="" decoding="async"></span>
    {%- endif %}
    <ol class="prm__seals">
      {% for block in section.blocks -%}
      {%- assign seal_name = block.settings.title | strip | escape -%}
      <li class="prm__seal" style="--i:{{ forloop.index0 }}" {{ block.shopify_attributes }}>
        {%- if cfg.sw_show_number %}
        <span class="prm__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
        {%- endif %}
        <span class="prm__ring">
          <span class="prm__orbit"><svg class="prm__spin" viewBox="0 0 200 200" aria-hidden="true" data-name="{{ seal_name }}"><defs><path id="prm-orbit-{{ forloop.index0 }}" d="M34,9 H166 A25,25 0 0 1 191,34 V166 A25,25 0 0 1 166,191 H34 A25,25 0 0 1 9,166 V34 A25,25 0 0 1 34,9 H166 A25,25 0 0 1 191,34 V166 A25,25 0 0 1 166,191 H34 A25,25 0 0 1 9,166 V34 A25,25 0 0 1 34,9"/></defs><text textLength="685" lengthAdjust="spacing"><textPath href="#prm-orbit-{{ forloop.index0 }}">{{ seal_name }} · Shrujan · {{ seal_name }} · Shrujan · </textPath></text></svg></span>
          <svg class="prm__draw" viewBox="0 0 200 200" aria-hidden="true"><path d="M34,22 H166 A12,12 0 0 1 178,34 V166 A12,12 0 0 1 166,178 H34 A12,12 0 0 1 22,166 V34 A12,12 0 0 1 34,22 Z" pathLength="1"/></svg>
          <span class="prm__photo"><img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 900 }}{% else %}{{ block.settings.fallback | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy"></span>
        </span>
        <h3 class="prm__name">{{ seal_name }}</h3>
        <p class="prm__copy">{{ block.settings.copy | strip | escape }}</p>
      </li>
      {%- endfor %}
    </ol>
  </div>
  {%- if cfg.sw_show_more %}
  <div class="prm__more"><a class="arch__btn" href="{{ section.settings.more_link | default: '#craft' }}">{{ section.settings.more_label | default: 'How we make it' | escape }} <span aria-hidden="true">→</span></a></div>
  {%- endif %}
</section>

{% schema %}
{
  "name": "Home promises",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "What guides us"
