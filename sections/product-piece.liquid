{%- render 'section-design', section: section -%}
{%- comment -%}
  Product detail — the designed three-column page, rendered from the real
  product on the server.

  Everything the shopper reads about the piece is the merchant's own data: title,
  price and compare-at from the selected variant, the gallery from product.media,
  the description in the first accordion, and the four editable metafields in the
  `shrujan` namespace (craft, badge, swatches — occasion has no slot in this
  design). The rails are real collections.

  What stays a section setting is the copy the design repeats on every piece and
  that was never product data: the intro line, the "Made with" pills, the
  care/shipping accordions, the ordering options, and the review panel (reviews
  are blocks, so they stay editable).

  Add to bag is a real POST to the cart, so the built cart page receives it. The
  size row switches the posted variant when the product has real options; when it
  has only Shopify's default variant the row is presentational and the default
  variant is what gets added.
{%- endcomment -%}
{%- comment -%}
  Gallery layout. The ≤720px stylesheet already lays the thumbnail rail out
  under the shot, so "below" simply asks for that arrangement at every width;
  and the pinned block is released by returning .pdp__media to static, which is
  what it already becomes at ≤1080px. Both are written only when the merchant
  moves off the built design.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign root_sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. Two different breakpoints already own the gallery, and neither
    is invented here: 1080px is where the stylesheet stops pinning the block, and
    720px is where it moves the thumbnail rail under the shot as a sideways strip
    and drops the stage to min(64vh, 520px). So the phone controls are that same
    720px tier — whether the strip is worth its room, and what the stage's height
    should be, which also has to beat the taller height "below" publishes without
    a query of its own. The four maker portraits and the review columns are real
    grids that never step; the reviews stack at 720px, the portraits never do.

    There is no phone switch for un-pinning: the stylesheet has already released
    the block by 1080px, so a phone would never see it pinned.
  endcomment
  assign pdp_style = false
  if cfg.gallery_thumbs != 'left' or cfg.gallery_sticky == false
    assign pdp_style = true
  endif
  if cfg.gallery_thumbs_m != 'strip' or cfg.gallery_h_m != 0
    assign pdp_style = true
  endif
  if cfg.faces_cols_m != 4 or cfg.reviews_cols_m != 1
    assign pdp_style = true
  endif
  if cfg.show_reviews and cfg.show_reviews_m == false
    assign pdp_style = true
  endif
  if cfg.show_rec and cfg.show_rec_m == false
    assign pdp_style = true
  endif
  if cfg.show_other and cfg.show_other_m == false
    assign pdp_style = true
  endif
-%}
{%- if pdp_style -%}
  <style>
    {%- if cfg.gallery_thumbs == 'below' -%}
      {{ root_sel }} .pdp__media { grid-template-columns: minmax(0, 1fr); }
      {{ root_sel }} .pdp__rail {
        order: 2;
        grid-auto-flow: column;
        grid-auto-columns: 64px;
        overflow-x: auto;
        scrollbar-width: none;
        padding-top: 10px;
      }
      {{ root_sel }} .pdp__rail::-webkit-scrollbar { display: none; }
      {%- comment -%}
        The stage is sized to fill the screen, so with the rail moved underneath
        it the pinned block has to give back the strip's height (a 64px-wide
        thumbnail at 3/4 is ~85px tall, plus its 10px of padding) or the
        thumbnails would sit below the fold of the block that pins them.
      {%- endcomment -%}
      {{ root_sel }} .pdp__stage {
        order: 1;
        height: min(calc(100vh - 2 * clamp(14px, 1.6vw, 26px) - 104px), 756px);
      }
    {%- endif -%}
    {%- if cfg.gallery_sticky == false -%}
      {{ root_sel }} .pdp__media { position: static; }
    {%- endif -%}

    {%- comment -%}
      Phone. Coming after the block above is what lets the stage height here beat
      the un-mediated one "thumbnails below" writes.
    {%- endcomment -%}
    {%- if cfg.gallery_thumbs_m != 'strip' or cfg.gallery_h_m != 0 or cfg.faces_cols_m != 4 or cfg.reviews_cols_m != 1 -%}
      @media (max-width: 720px) {
        {%- if cfg.gallery_thumbs_m == 'hidden' -%}
          {{ root_sel }} .pdp__rail { display: none; }
        {%- endif -%}
        {%- if cfg.gallery_h_m != 0 -%}
          {{ root_sel }} .pdp__stage { height: {{ cfg.gallery_h_m }}px; }
        {%- endif -%}
        {%- if cfg.faces_cols_m != 4 -%}
          {{ root_sel }} .pdp__faces { grid-template-columns: repeat({{ cfg.faces_cols_m }}, minmax(0, 1fr)); }
        {%- endif -%}
        {%- if cfg.reviews_cols_m != 1 -%}
          {{ root_sel }} .reviews { grid-template-columns: repeat({{ cfg.reviews_cols_m }}, minmax(0, 1fr)); }
        {%- endif -%}
      }
    {%- endif -%}
    {%- if cfg.show_reviews_m == false or cfg.show_rec_m == false or cfg.show_other_m == false -%}
      @media (max-width: 720px) {
        {%- if cfg.show_reviews and cfg.show_reviews_m == false -%}
          {{ root_sel }} .pdp-reviews { display: none; }
        {%- endif -%}
        {%- if cfg.show_rec and cfg.show_rec_m == false -%}
          {{ root_sel }} .pdp-rec { display: none; }
        {%- endif -%}
        {%- if cfg.show_other and cfg.show_other_m == false -%}
          {{ root_sel }} .pdp-other { display: none; }
        {%- endif -%}
      }
    {%- endif -%}
  </style>
{%- endif -%}
{%- liquid
  comment
    The piece itself, from Shopify. The variant the page quotes and adds is the
    one Shopify has selected, or the first that can be bought.
  endcomment
  assign variant = product.selected_or_first_available_variant
  if variant == blank
    assign variant = product.variants.first
  endif

  assign craft = product.metafields.shrujan.craft.value
  if craft == blank
    assign craft = product.type
  endif

  comment
    The badge is decided by snippets/piece-badge.liquid, the same rules the grids
    use: sold out wins the one corner the design drew, then the discount worked
    out from the prices, then the shrujan.badge override.
  endcomment

  comment
    The swatch discs the shrujan.swatches metafield feeds are a card affordance —
    the designed buying column has no colour row, so the pieces on the rails below
    are where a product's colours are drawn.
  endcomment
  assign has_was = false
  if variant.compare_at_price > variant.price
    assign has_was = true
  endif

  comment
    The gallery is the image media in the order the merchant arranged it.
  endcomment
  assign shots = product.media | where: 'media_type', 'image'
  assign shot_count = shots.size
  if shot_count > cfg.gallery_max
    assign shot_count = cfg.gallery_max
  endif

  comment
    Sizes, real ones first: when the product carries the option, each button is a
    variant and picking it changes what the form posts. Products with only
    Shopify's default variant keep the built row, presentational, from the
    setting.
  endcomment
  assign size_pos = 0
  for opt in product.options_with_values
    assign opt_name = opt.name | downcase | strip
    if opt_name == 'size' or opt_name == 'sizes'
      assign size_list = opt.values
      assign size_pos = forloop.index
      break
    endif
  endfor
  if size_pos == 0 and product.has_only_default_variant == false
    assign first_opt = product.options_with_values | first
    assign size_list = first_opt.values
    assign size_pos = 1
  endif

  assign from_variants = true
  if size_pos == 0
    assign from_variants = false
    assign size_list = cfg.sizes | split: ','
    assign current_size = cfg.sizes_default | strip
  else
    case size_pos
      when 1
        assign current_size = variant.option1
      when 2
        assign current_size = variant.option2
      else
        assign current_size = variant.option3
    endcase
  endif

  assign spec_list = cfg.specs | strip | newline_to_br | split: '<br />'

  comment
    The star row is the rating rounded to whole stars; an unreadable rating keeps
    the five the design was drawn with.
  endcomment
  assign star_n = cfg.rating | plus: 0 | round
  if star_n < 1 or star_n > 5
    assign star_n = 5
  endif

  assign shop_url = cfg.shop_link | default: '/pages/shop-shrujan'

  comment
    The same-hands rail is the product's own group: product.type carries the
    collection name the catalogue was built from, so its handle addresses the
    same rail the design showed. Anything unfamiliar falls back to everything.
  endcomment
  assign type_handle = product.type | handleize
  assign rec_coll = collections[type_handle]
  unless rec_coll.products.size > 0
    assign rec_coll = collections['all']
  endunless
  comment
    The lower rail must not repeat what the upper one just showed, so both walk
    one `shown` list, delimited so `dupatta` cannot match `dupatta-copy`.
  endcomment
  assign shown = '|' | append: product.handle | append: '|'
  assign rail_max = 5
-%}
{%- capture icon_star -%}<svg viewBox="0 0 24 24" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="m12 2.6 2.9 6 6.6.9-4.8 4.6 1.2 6.6L12 17.6 6.1 20.7l1.2-6.6L2.5 9.5l6.6-.9Z"></path></svg>{%- endcapture -%}
{%- capture icon_arrow_15 -%}<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>{%- endcapture -%}
{%- capture icon_arrow_16 -%}<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>{%- endcapture -%}
{%- capture icon_plus -%}<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>{%- endcapture -%}
{%- capture stars_rating -%}<span class="pdp__stars" aria-label="{{ star_n }} out of 5 stars">{% for i in (1..star_n) %}{{ icon_star }}{% endfor %}</span>{%- endcapture -%}
{%- comment -%}
  The four packaged portraits the "worn by" row was built with. An image picked
  in the customizer replaces the one in its slot; the rest stay as designed.
{%- endcomment -%}
{%- assign face_files = 'cat-c1.webp,frame-r5t25.webp,cat-c5.webp,frame-r2t5.webp' | split: ',' -%}
{%- if product != blank -%}
  <div class="page pdp-page" data-cart-add="{{ routes.cart_add_url }}">
    <div class="container pdp">
      <div class="pdp__media">
        <div class="pdp__rail" aria-label="Product images">
          {%- for media in shots limit: shot_count -%}
            <button type="button" class="pdp__thumb{% if forloop.first %} is-active{% endif %}" aria-label="View image {{ forloop.index }} of {{ shot_count }}"{% if forloop.first %} aria-current="true"{% endif %}>
              <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
        <div class="pdp__stage">
          {%- if shot_count > 0 -%}
            {%- for media in shots limit: shot_count -%}
              <figure class="pdp__shot{% if forloop.first %} is-active{% endif %}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                {%- if forloop.first -%}
                  <img src="{{ media.preview_image | image_url: width: 1400 }}" alt="{{ media.preview_image.alt | default: product.title | escape }}" loading="eager" fetchpriority="high">
                {%- else -%}
                  <img src="{{ media.preview_image | image_url: width: 1400 }}" alt="" loading="lazy">
                {%- endif -%}
              </figure>
            {%- endfor -%}
          {%- else -%}
            <figure class="pdp__shot is-active" aria-hidden="false">{{ 'product-1' | placeholder_svg_tag: 'piece__ph' }}</figure>
          {%- endif -%}
          {%- render 'piece-badge', product: product, class: 'pdp__badge', sold_out_label: cfg.sold_out_label -%}
        </div>
      </div>

      <div class="pdp__buy">
        <div class="pdp__rating">{{ stars_rating }}<span>{{ cfg.rating }}</span><a href="#reviews">{{ cfg.review_count }} reviews</a></div>
        <h1 class="pdp__name">{{ product.title }}</h1>
        {%- if craft != blank -%}
          <p class="pdp__craft">{{ craft }}</p>
        {%- endif -%}
        {%- comment -%}
          A price line of its own only when the piece is marked down — the price
          the design shows lives on the ordering option and the button, and a
          struck-through was has nowhere to sit there.
        {%- endcomment -%}
        {%- if has_was -%}
          <p class="pdp__price" data-pdp-was-line>{{ variant.price | money }}<s>{{ variant.compare_at_price | money }}</s></p>
        {%- endif -%}
        {%- if cfg.copy != blank -%}
          <p class="pdp__copy">{{ cfg.copy }}</p>
        {%- endif -%}

        {%- if spec_list.size > 0 -%}
          <div class="pdp__block">
            <p class="pdp__label">Made with</p>
            <ul class="pdp__specs">
              {%- for spec in spec_list -%}
                {%- assign spec_text = spec | strip -%}
                {%- if spec_text != blank -%}
                  <li>{{ spec_text }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if cfg.show_sizes and size_list.size > 0 -%}
          <div class="pdp__block">
            <div class="pdp__label-row">
              <p class="pdp__label">Size</p>
              <button type="button" class="pdp__size-guide">Size guide</button>
            </div>
            <div class="pdp__sizes" role="group" aria-label="Size">
              {%- for sz in size_list -%}
                {%- liquid
                  assign size_label = sz | strip
                  assign size_id = ''
                  assign size_price = ''
                  assign size_was = ''
                  assign size_ok = false
                  comment
                    The variant a size adds is the first one carrying that value,
                    preferring one that is actually in stock.
                  endcomment
                  if from_variants
                    for v in product.variants
                      case size_pos
                        when 1
                          assign v_val = v.option1
                        when 2
                          assign v_val = v.option2
                        else
                          assign v_val = v.option3
                      endcase
                      unless v_val == size_label
                        continue
                      endunless
                      assign take = false
                      if size_id == ''
                        assign take = true
                      elsif size_ok == false and v.available
                        assign take = true
                      endif
                      if take
                        assign size_id = v.id
                        assign size_price = v.price | money
                        assign size_was = ''
                        if v.compare_at_price > v.price
                          assign size_was = v.compare_at_price | money
                        endif
                        assign size_ok = v.available
                      endif
                    endfor
                  endif
                -%}
                <button type="button" class="pdp__size{% if size_label == current_size %} is-active{% endif %}" aria-pressed="{% if size_label == current_size %}true{% else %}false{% endif %}"{% if size_id != '' %} data-variant="{{ size_id }}" data-price="{{ size_price | escape }}" data-was="{{ size_was | escape }}"{% endif %}{% if from_variants and size_ok == false %} disabled{% endif %}>{{ size_label }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if cfg.show_modes -%}
          <div class="pdp__options" role="radiogroup" aria-label="How it is made">
            <label class="pdp__option is-active"><input type="radio" name="pdp-mode" checked><span class="pdp__option-body"><span class="pdp__option-title">{{ cfg.mode1_title }}</span><span class="pdp__option-note">{{ cfg.mode1_note }}</span></span><span class="pdp__option-price">{{ variant.price | money }}</span></label>
            <label class="pdp__option"><input type="radio" name="pdp-mode"><span class="pdp__option-body"><span class="pdp__option-title">{{ cfg.mode2_title }}</span><span class="pdp__option-note">{{ cfg.mode2_note }}</span></span><span class="pdp__option-price">{% if cfg.mode2_amount > 0 %}+ {{ cfg.mode2_amount | times: 100 | money }}{% endif %}</span></label>
          </div>
        {%- endif -%}

        {%- comment -%}
          The CTA row is the form, so the grid the design draws is untouched and
          the bag is a plain POST — it works with the scripts blocked.
        {%- endcomment -%}
        <form class="pdp__cta" action="{{ routes.cart_add_url }}" method="post" accept-charset="UTF-8" novalidate>
          <input type="hidden" name="id" value="{{ variant.id }}" data-pdp-variant>
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          {%- if product.available -%}
            <button type="submit" class="btn pdp__add" data-add-label="{{ cfg.add_label | escape }}">{{ cfg.add_label }} — {{ variant.price | money }}</button>
          {%- else -%}
            <button type="submit" class="btn pdp__add" data-add-label="{{ cfg.add_label | escape }}" disabled>{{ cfg.sold_out_label }}</button>
          {%- endif -%}
          <button type="button" class="pdp__wish" aria-label="Save to wishlist"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg></button>
        </form>
        {%- if cfg.reassure != blank -%}
          <p class="pdp__reassure"><svg viewBox="0 0 32 32" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg> {{ cfg.reassure }}</p>
        {%- endif -%}

        {%- if cfg.show_details -%}
          <div class="pdp__details">
            {%- assign d_rendered = 0 -%}
            {%- assign fit_found = false -%}
            {%- for d_i in (1..5) -%}
              {%- liquid
                assign d_rich = false
                case forloop.index
                  when 1
                    assign d_title = cfg.detail1_title
                    assign d_body = product.description
                    assign d_rich = true
                  when 2
                    assign d_title = cfg.detail2_title
                    assign d_body = cfg.detail2_body
                  when 3
                    assign d_title = cfg.detail3_title
                    assign d_body = cfg.detail3_body
                  when 4
                    assign d_title = cfg.detail4_title
                    assign d_body = cfg.detail4_body
                  else
                    assign d_title = cfg.detail5_title
                    assign d_body = cfg.detail5_body
                endcase
              -%}
              {%- if d_title == blank or d_body == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- comment -%}
                "Size guide" opens the fit panel rather than pointing at a page
                that does not exist, and it finds it by its heading — so renaming
                or reordering the panels cannot open the wrong one.
              {%- endcomment -%}
              {%- assign is_fit = false -%}
              {%- assign d_title_low = d_title | downcase -%}
              {%- if fit_found == false and d_title_low contains 'fit' -%}
                {%- assign is_fit = true -%}
                {%- assign fit_found = true -%}
              {%- endif -%}
              <div class="pdp__detail{% if d_rendered == 0 %} is-open{% endif %}"{% if is_fit %} data-pdp-fit{% endif %}>
                <button type="button" class="pdp__detail-summary" aria-expanded="{% if d_rendered == 0 %}true{% else %}false{% endif %}" aria-controls="pdp-detail-{{ d_rendered }}">
                  <span>{{ d_title }}</span>
                  <span class="pdp__detail-icon" aria-hidden="true">{{ icon_plus }}</span>
                </button>
                <div class="pdp__detail-panel" id="pdp-detail-{{ d_rendered }}" role="region">
                  <div class="pdp__detail-inner">
                    {%- if d_rich and d_body contains '<' -%}
                      {{ d_body }}
                    {%- else -%}
                      <p>{{ d_body }}</p>
                    {%- endif -%}
                  </div>
                </div>
              </div>
              {%- assign d_rendered = d_rendered | plus: 1 -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        <div class="pdp__worn">
          <div class="pdp__label-row"><p class="pdp__label">Worn by</p><a href="#reviews">All {{ cfg.review_count }} reviews</a></div>
          <div class="pdp__faces">
            {%- for face_file in face_files -%}
              {%- assign face_key = 'face_' | append: forloop.index -%}
              {%- assign face_image = cfg[face_key] -%}
              {%- if face_image != blank -%}
                <img src="{{ face_image | image_url: width: 160 }}" alt="" loading="lazy">
              {%- else -%}
                <img src="{{ face_file | asset_url }}" alt="" loading="lazy">
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if cfg.quote != blank -%}
            <blockquote class="pdp__quote">“{{ cfg.quote }}”<cite>{{ cfg.quote_cite }}</cite></blockquote>
          {%- endif -%}
        </div>

        <a class="arrow-link pdp__back" href="{{ shop_url }}">Back to the catalogue {{ icon_arrow_15 }}</a>
      </div>
    </div>

    {%- if cfg.show_reviews -%}
      <section class="section container pdp-reviews" id="reviews">
        <div class="section-head" data-reveal>
          <div class="section-head__titles">
            <p class="eyebrow">{{ cfg.review_count }} reviews</p>
            <h2 class="section-title">What buyers <em>say</em></h2>
          </div>
          <a class="arrow-link" href="#write-review">Write a review {{ icon_arrow_16 }}</a>
        </div>
        <div class="reviews" data-reveal-child>
          <aside class="review-add" id="write-review">
            <p class="review-add__score">{{ cfg.rating }}</p>
            {{ stars_rating }}
            <p class="review-add__count">Based on {{ cfg.review_count }} reviews</p>
            <button type="button" class="btn">Write a review</button>
            {%- if cfg.review_note != blank -%}
              <p class="review-add__note">{{ cfg.review_note }}</p>
            {%- endif -%}
          </aside>
          {%- for block in section.blocks -%}
            {%- if block.type != 'review' -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign r_stars = block.settings.stars
              comment
                Each card's portrait is the block's own image, or the packaged one
                in that position — the row of four repeats for a fourth review.
              endcomment
              assign r_face_i = forloop.index0 | modulo: 4
              assign r_face = face_files[r_face_i]
            -%}
            <article class="review"{% if block.shopify_attributes != blank %} {{ block.shopify_attributes }}{% endif %}><span class="pdp__stars" aria-label="{{ r_stars }} out of 5 stars">{% for i in (1..r_stars) %}{{ icon_star }}{% endfor %}</span>
              <p class="review__body">{{ block.settings.body }}</p>
              <div class="review__who">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 120 }}" alt="" loading="lazy">{% else %}<img src="{{ r_face | asset_url }}" alt="" loading="lazy">{% endif %}<span><span class="review__name">{{ block.settings.name }}</span><span class="review__place">{{ block.settings.place }}</span></span></div>
            </article>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- if cfg.show_rec -%}
      <section class="section container pdp-rec" aria-label="Recommended">
        <div class="section-head" data-reveal>
          <div class="section-head__titles">
            <p class="eyebrow">You may also like</p>
            <h2 class="section-title">More from the <em>same hands</em></h2>
          </div>
        </div>
        <div class="curated__grid" data-reveal-child>
          {%- assign rec_n = 0 -%}
          {%- for p in rec_coll.products -%}
            {%- assign p_key = '|' | append: p.handle | append: '|' -%}
            {%- if shown contains p_key -%}
              {%- continue -%}
            {%- endif -%}
            {%- render 'piece-card', product: p, show_swatches: cfg.card_swatches, quick_label: cfg.add_label, sold_out_label: cfg.sold_out_label -%}
            {%- assign shown = shown | append: p.handle | append: '|' -%}
            {%- assign rec_n = rec_n | plus: 1 -%}
            {%- if rec_n >= rail_max -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- if cfg.show_other -%}
      <section class="section container pdp-other" aria-label="Other products">
        <div class="section-head" data-reveal>
          <div class="section-head__titles">
            <p class="eyebrow">Elsewhere in the catalogue</p>
            <h2 class="section-title">Other <em>pieces</em></h2>
          </div>
          <a class="arrow-link" href="{{ shop_url }}">Shop everything {{ icon_arrow_16 }}</a>
        </div>
        <div class="curated__grid" data-reveal-child>
          {%- assign other_n = 0 -%}
          {%- for p in collections['all'].products -%}
            {%- assign p_key = '|' | append: p.handle | append: '|' -%}
            {%- if shown contains p_key -%}
              {%- continue -%}
            {%- endif -%}
            {%- render 'piece-card', product: p, show_swatches: cfg.card_swatches, quick_label: cfg.add_label, sold_out_label: cfg.sold_out_label -%}
            {%- assign shown = shown | append: p.handle | append: '|' -%}
            {%- assign other_n = other_n | plus: 1 -%}
            {%- if other_n >= rail_max -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}
  </div>
{%- endif -%}

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root || root.__pdpInit) return;
  root.__pdpInit = true;

  var page = root.querySelector('.pdp-page');
  if (!page) return;

  var pdpEl = root.querySelector('.pdp');
  var detailsEl = root.querySelector('.pdp__details');
  var list = function (sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); };

  var thumbEls = list('.pdp__thumb');
  var shotEls = list('.pdp__shot');
  var sizeEls = list('.pdp__size');
  var optionEls = list('.pdp__option');
  var modeInputs = list('.pdp__option input');
  var detailEls = list('.pdp__detail');

  var variantInput = root.querySelector('[data-pdp-variant]');
  var addBtn = root.querySelector('.pdp__add');
  var wasLine = root.querySelector('[data-pdp-was-line]');
  /* the ready-to-ship option is the first one, and carries the live price */
  var modePriceEl = root.querySelector('.pdp__option .pdp__option-price');

  var active = 0;
  var open = 0; // the first panel is rendered open

  function setActive(i) {
    if (i === active) return;
    active = i;
    thumbEls.forEach(function (t, j) {
      t.classList.toggle('is-active', j === i);
      if (j === i) t.setAttribute('aria-current', 'true');
      else t.removeAttribute('aria-current');
    });
    shotEls.forEach(function (s, j) {
      s.classList.toggle('is-active', j === i);
      s.setAttribute('aria-hidden', j !== i ? 'true' : 'false');
    });
  }

  function applyOpen() {
    detailEls.forEach(function (d, j) {
      var isOpen = open === j;
      d.classList.toggle('is-open', isOpen);
      d.querySelector('.pdp__detail-summary').setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }

  function scrollTo(y) {
    if (window.Shrujan) window.Shrujan.scrollToY(y); // through Lenis, or it fights the smooth scroller
    else window.scrollTo(0, y);
  }

  // Thumbnails scroll to that shot's band rather than setting state directly,
  // so scroll position stays the single source of truth for what is showing.
  function jumpTo(i) {
    var el = pdpEl;
    if (!el || !shotEls.length) return;
    var travel = el.offsetHeight - window.innerHeight;
    if (travel <= 0) return;
    scrollTo(el.offsetTop + (travel * (i + 0.5)) / shotEls.length);
  }

  thumbEls.forEach(function (t, i) {
    t.addEventListener('click', function () { jumpTo(i); });
  });

  // A size is a variant when the product has real options — the button carries
  // the id the form posts, and the price the page shows.
  sizeEls.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      sizeEls.forEach(function (b) {
        var on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      var id = btn.getAttribute('data-variant');
      if (id && variantInput) variantInput.value = id;

      var price = btn.getAttribute('data-price');
      if (!price) return;
      if (modePriceEl) modePriceEl.textContent = price;
      if (addBtn && !addBtn.disabled) {
        addBtn.textContent = (addBtn.getAttribute('data-add-label') || '') + ' — ' + price;
      }
      if (wasLine) {
        var was = btn.getAttribute('data-was');
        wasLine.textContent = price;
        if (was) {
          var s = document.createElement('s');
          s.textContent = was;
          wasLine.appendChild(s);
        }
      }
    });
  });

  modeInputs.forEach(function (input, idx) {
    input.addEventListener('change', function () {
      optionEls.forEach(function (l, j) { l.classList.toggle('is-active', j === idx); });
    });
  });

  // "Size guide" opens the fit panel rather than pointing at a page that does
  // not exist. The panel is marked in the markup, so reordering the accordions
  // cannot silently open the wrong one.
  var sizeGuideBtn = root.querySelector('.pdp__size-guide');
  var fitEl = root.querySelector('[data-pdp-fit]');
  if (sizeGuideBtn && fitEl) {
    sizeGuideBtn.addEventListener('click', function () {
      var i = detailEls.indexOf(fitEl);
      if (i < 0) return;
      open = i;
      applyOpen();
      if (detailsEl) scrollTo(detailsEl.getBoundingClientRect().top + window.scrollY - 120);
    });
  }

  detailEls.forEach(function (d, i) {
    d.querySelector('.pdp__detail-summary').addEventListener('click', function () {
      open = open === i ? -1 : i;
      applyOpen();
    });
  });

  // The rail cards' own two controls sit inside the product link, so neither
  // may navigate: the heart is a wish, the label adds that piece to the bag.
  root.addEventListener('click', function (e) {
    var node = e.target.closest ? e.target : e.target.parentNode;
    if (!node || !node.closest) return;

    var wish = node.closest('.piece__wish');
    if (wish) {
      e.preventDefault();
      return;
    }

    var quick = node.closest('.piece__quick');
    var id = quick && quick.getAttribute('data-variant');
    if (!id) return;
    e.preventDefault();
    var add = document.createElement('form');
    add.method = 'post';
    add.action = page.getAttribute('data-cart-add') || '/cart/add';
    add.hidden = true;
    add.innerHTML =
      '<input type="hidden" name="id" value="' + id + '">' +
      '<input type="hidden" name="quantity" value="1">';
    document.body.appendChild(add);
    add.submit();
  });

  // Scroll drives the gallery. The section is divided into as many bands as
  // there are shots, and progress through it picks the one on screen — so the
  // image changes only when you move, never on its own.
  if (shotEls.length >= 2) {
    var queued = false;

    var read = function () {
      queued = false;
      var el = pdpEl;
      if (!el) return;
      var r = el.getBoundingClientRect();
      var travel = r.height - window.innerHeight;
      if (travel <= 0) return;
      var progress = Math.min(1, Math.max(0, -r.top / travel));
      setActive(Math.min(shotEls.length - 1, Math.floor(progress * shotEls.length)));
    };

    var onScroll = function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(read);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    read();
  }
})();
</script>

