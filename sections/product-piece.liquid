{%- capture pdpi_phone -%}<svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 3.5h3.2l1.6 4-2 1.3a10.5 10.5 0 0 0 5.4 5.4l1.3-2 4 1.6V17A2 2 0 0 1 16.4 19 14.5 14.5 0 0 1 3 5.6 2 2 0 0 1 5 3.5Z"/></svg>{%- endcapture -%}
