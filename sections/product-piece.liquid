{%- capture stars_rating -%}<span class="pdp__stars" aria-label="{{ star_n }} out of 5 stars">{% for i in (1..star_n) %}{{ icon_star }}{% endfor %}</span>{%- endcapture -%}
{%- comment -%}
  The four packaged portraits the "worn by" row was built with. An image picked
  in the customizer replaces the one in its slot; the rest stay as designed.
{%- endcomment -%}
{%- assign face_files = 'cat-c1.webp,frame-r5t25.webp,cat-c5.webp,frame-r2t5.webp' | split: ',' -%}
{%- if product != blank -%}
  <div class="page pdp-page" data-cart-add="{{ routes.cart_add_url }}">
    <div class="container pdp">
      <div class="pdp__media">
        <div class="pdp__rail" aria-label="Product images">
          {%- for media in shots limit: shot_count -%}
            <button type="button" class="pdp__thumb{% if forloop.first %} is-active{% endif %}" aria-label="View image {{ forloop.index }} of {{ shot_count }}"{% if forloop.first %} aria-current="true"{% endif %}>
              <img src="{{ media.preview_image | image_url: width: 200 }}" alt="" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
        <div class="pdp__stage">
          {%- if shot_count > 0 -%}
            {%- for media in shots limit: shot_count -%}
              <figure class="pdp__shot{% if forloop.first %} is-active{% endif %}" aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}">
                {%- if forloop.first -%}
                  <img src="{{ media.preview_image | image_url: width: 1400 }}" alt="{{ media.preview_image.alt | default: product.title | escape }}" loading="eager" fetchpriority="high">
                {%- else -%}
                  <img src="{{ media.preview_image | image_url: width: 1400 }}" alt="" loading="lazy">
                {%- endif -%}
              </figure>
            {%- endfor -%}
          {%- else -%}
            <figure class="pdp__shot is-active" aria-hidden="false">{{ 'product-1' | placeholder_svg_tag: 'piece__ph' }}</figure>
          {%- endif -%}
          {%- render 'piece-badge', product: product, class: 'pdp__badge', sold_out_label: cfg.sold_out_label -%}
        </div>
      </div>

      <div class="pdp__buy">
        {%- if cfg.show_reviews -%}
        <div class="pdp__rating">{{ stars_rating }}<span>{{ cfg.rating }}</span><a href="#reviews">{{ cfg.review_count }} reviews</a></div>
        {%- endif -%}
        <h1 class="pdp__name">{{ product.title }}</h1>
        {%- if craft != blank -%}
          <p class="pdp__craft">{{ craft }}</p>
        {%- endif -%}
        {%- comment -%}
          With the ordering options on, the price lives on the option and the
          button, and a line of its own appears only for a marked-down piece,
          whose struck-through was has nowhere else to sit. With them off the
          line is always there: a price that exists only inside a button is too
          easy to miss.
        {%- endcomment -%}
        {%- if has_was or cfg.show_modes == false -%}
          <p class="pdp__price" data-pdp-was-line>{{ variant.price | money | strip_html }}{% if has_was %}<s>{{ variant.compare_at_price | money | strip_html }}</s>{% endif %}</p>
        {%- endif -%}
        {%- if cfg.tax_note != blank %}<p class="pdp__tax">{{ cfg.tax_note | escape }}</p>{% endif -%}
        {%- if cfg.copy != blank -%}
          <p class="pdp__copy">{{ cfg.copy }}</p>
        {%- endif -%}

        {%- comment -%}
          Four ways into the piece, as the best craft houses offer them: how it
          is made, a call with us, the story, and how to care for it. A link
          starting with # goes to that part of this page (the making, the
          booking, or the care panel, which it opens).
        {%- endcomment -%}
        {%- if cfg.show_quick -%}
          <ul class="pdp__quick">
            {%- for q in (1..4) -%}
              {%- liquid
                assign q_label_key = 'quick' | append: q | append: '_label'
                assign q_link_key = 'quick' | append: q | append: '_link'
                assign q_label = cfg[q_label_key]
                assign q_link = cfg[q_link_key]
                case q
                  when 1
                    assign q_icon = pdpi_making
                  when 2
                    assign q_icon = pdpi_call
                  when 3
                    assign q_icon = pdpi_story
                  else
                    assign q_icon = pdpi_care
                endcase
              -%}
              {%- if q_label != blank -%}
              <li><a class="pdp__quick-link" href="{{ q_link | escape }}"{% if q_link == '#care' %} data-pdp-open="care"{% endif %}>{{ q_icon }}<span>{{ q_label | escape }}</span></a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if spec_list.size > 0 -%}
          <div class="pdp__block">
            <p class="pdp__label">Made with</p>
            <ul class="pdp__specs">
              {%- for spec in spec_list -%}
                {%- assign spec_text = spec | strip -%}
                {%- if spec_text != blank -%}
                  <li>{{ spec_text }}</li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if cfg.show_sizes and from_variants and size_list.size > 0 -%}
          <div class="pdp__block">
            <div class="pdp__label-row">
              <p class="pdp__label">Size</p>
              {%- comment -%}
                With a size chart page chosen the button opens that chart over
                the product, and stays hidden until the script has found this
                garment's rows in it. Without one it opens the fit panel.
              {%- endcomment -%}
              <button type="button" class="pdp__size-guide"{% if cfg.size_guide_page != blank %} data-pdp-guide-open hidden{% endif %}>Size guide</button>
            </div>
            <div class="pdp__sizes" role="group" aria-label="Size">
              {%- for sz in size_list -%}
                {%- liquid
                  assign size_label = sz | strip
                  assign size_id = ''
                  assign size_price = ''
                  assign size_was = ''
                  assign size_ok = false
                  comment
                    The variant a size adds is the first one carrying that value,
                    preferring one that is actually in stock.
                  endcomment
                  if from_variants
                    for v in product.variants
                      case size_pos
                        when 1
                          assign v_val = v.option1
                        when 2
                          assign v_val = v.option2
                        else
                          assign v_val = v.option3
                      endcase
                      unless v_val == size_label
                        continue
                      endunless
                      assign take = false
                      if size_id == ''
                        assign take = true
                      elsif size_ok == false and v.available
                        assign take = true
                      endif
                      if take
                        assign size_id = v.id
                        assign size_price = v.price | money | strip_html
                        assign size_was = ''
                        if v.compare_at_price > v.price
                          assign size_was = v.compare_at_price | money | strip_html
                        endif
                        assign size_ok = v.available
                      endif
                    endfor
                  endif
                -%}
                <button type="button" class="pdp__size{% if size_label == current_size %} is-active{% endif %}" aria-pressed="{% if size_label == current_size %}true{% else %}false{% endif %}"{% if size_id != '' %} data-variant="{{ size_id }}" data-price="{{ size_price | escape }}" data-was="{{ size_was | escape }}"{% endif %}{% if from_variants and size_ok == false %} disabled{% endif %}>{{ size_label }}</button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        {%- if cfg.show_modes -%}
          <div class="pdp__options" role="radiogroup" aria-label="How it is made">
            <label class="pdp__option is-active"><input type="radio" name="pdp-mode" checked><span class="pdp__option-body"><span class="pdp__option-title">{{ cfg.mode1_title }}</span><span class="pdp__option-note">{{ cfg.mode1_note }}</span></span><span class="pdp__option-price">{{ variant.price | money | strip_html }}</span></label>
            <label class="pdp__option"><input type="radio" name="pdp-mode"><span class="pdp__option-body"><span class="pdp__option-title">{{ cfg.mode2_title }}</span><span class="pdp__option-note">{{ cfg.mode2_note }}</span></span><span class="pdp__option-price">{% if cfg.mode2_amount > 0 %}+ {{ cfg.mode2_amount | times: 100 | money | strip_html }}{% endif %}</span></label>
          </div>
        {%- endif -%}

        {%- comment -%}
          The CTA row is the form, so the grid the design draws is untouched and
          the bag is a plain POST — it works with the scripts blocked.
        {%- endcomment -%}
        <form class="pdp__cta" action="{{ routes.cart_add_url }}" method="post" accept-charset="UTF-8" novalidate>
          <input type="hidden" name="id" value="{{ variant.id }}" data-pdp-variant>
          <input type="hidden" name="quantity" value="1">
          <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
          {%- if product.available -%}
            <button type="submit" class="btn pdp__add" data-add-label="{{ cfg.add_label | escape }}">{{ cfg.add_label }} — {{ variant.price | money | strip_html }}</button>
          {%- else -%}
            <button type="submit" class="btn pdp__add" data-add-label="{{ cfg.add_label | escape }}" disabled>{{ cfg.sold_out_label }}</button>
          {%- endif -%}
          <button type="button" class="pdp__wish" aria-label="Save to wishlist"><svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg></button>
        </form>
        {%- if cfg.ships_note != blank -%}
          <p class="pdp__ships"><b>{{ cfg.ships_label | escape }}</b> {{ cfg.ships_note | escape }}</p>
        {%- endif -%}
        {%- if cfg.show_trust -%}
          <ul class="pdp__trust">
            {%- for t in (1..4) -%}
              {%- liquid
                assign t_key = 'trust' | append: t
                case t
                  when 1
                    assign t_icon = pdpi_ship
                  when 2
                    assign t_icon = pdpi_since
                  when 3
                    assign t_icon = pdpi_assist
                  else
                    assign t_icon = pdpi_hand
                endcase
              -%}
              {%- if cfg[t_key] != blank %}<li>{{ t_icon }}<span>{{ cfg[t_key] | escape }}</span></li>{% endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if cfg.reassure != blank -%}
          <p class="pdp__reassure"><svg viewBox="0 0 32 32" width="13" height="13" fill="currentColor" aria-hidden="true"><path d="M16 2c1.3 4.6 3 7.4 5.2 8.8C23.4 12.2 26 13 30 13.4v.2c-4 .4-6.6 1.2-8.8 2.6C19 17.6 17.3 20.4 16 25c-1.3-4.6-3-7.4-5.2-8.8C8.6 14.8 6 14 2 13.6v-.2c4-.4 6.6-1.2 8.8-2.6C13 9.4 14.7 6.6 16 2Z"></path><circle cx="16" cy="28.5" r="1.6"></circle></svg> {{ cfg.reassure }}</p>
        {%- endif -%}

        {%- if cfg.show_details -%}
          <div class="pdp__details">
            {%- assign d_rendered = 0 -%}
            {%- assign fit_found = false -%}
            {%- for d_i in (1..5) -%}
              {%- liquid
                assign d_rich = false
                case forloop.index
                  when 1
                    assign d_title = cfg.detail1_title
                    assign d_body = product.description
                    assign d_rich = true
                  when 2
                    assign d_title = cfg.detail2_title
                    assign d_body = cfg.detail2_body
                  when 3
                    assign d_title = cfg.detail3_title
                    assign d_body = cfg.detail3_body
                  when 4
                    assign d_title = cfg.detail4_title
                    assign d_body = cfg.detail4_body
                  else
                    assign d_title = cfg.detail5_title
                    assign d_body = cfg.detail5_body
                endcase
              -%}
              {%- if d_title == blank or d_body == blank -%}
                {%- continue -%}
              {%- endif -%}
              {%- comment -%}
                "Size guide" opens the fit panel rather than pointing at a page
                that does not exist, and it finds it by its heading — so renaming
                or reordering the panels cannot open the wrong one.
              {%- endcomment -%}
              {%- assign is_fit = false -%}
              {%- assign d_title_low = d_title | downcase -%}
              {%- if fit_found == false and d_title_low contains 'fit' -%}
                {%- assign is_fit = true -%}
                {%- assign fit_found = true -%}
              {%- endif -%}
              {%- assign is_care = false -%}
              {%- if d_title_low contains 'care' -%}{%- assign is_care = true -%}{%- endif -%}
              <div class="pdp__detail{% if d_rendered == 0 %} is-open{% endif %}"{% if is_fit %} data-pdp-fit{% endif %}{% if is_care %} id="care" data-pdp-care{% endif %}>
                <button type="button" class="pdp__detail-summary" aria-expanded="{% if d_rendered == 0 %}true{% else %}false{% endif %}" aria-controls="pdp-detail-{{ d_rendered }}">
                  <span>{{ d_title }}</span>
                  <span class="pdp__detail-icon" aria-hidden="true">{{ icon_plus }}</span>
                </button>
                <div class="pdp__detail-panel" id="pdp-detail-{{ d_rendered }}" role="region">
                  <div class="pdp__detail-inner">
                    {%- if d_rich and d_body contains '<' -%}
                      {{ d_body }}
                    {%- else -%}
                      {%- assign d_lines = d_body | newline_to_br | split: '<br />' -%}
                      {%- for d_line in d_lines -%}{%- assign d_l = d_line | strip -%}{%- if d_l != blank %}<p>{{ d_l }}</p>{% endif -%}{%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
              </div>
              {%- assign d_rendered = d_rendered | plus: 1 -%}
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- comment -%} help, by the channel the shopper prefers {%- endcomment -%}
        {%- if cfg.show_assist -%}
          {%- capture wa_text -%}Hello Shrujan, I would like to know more about {{ product.title }} ({{ shop.url }}{{ product.url }}){%- endcapture -%}
          <div class="pdp__assist">
            <p class="pdp__assist-title">{{ cfg.assist_title | escape }}</p>
            <p class="pdp__assist-hours">{{ cfg.assist_hours | escape }}</p>
            <div class="pdp__assist-links">
              {%- if cfg.assist_whatsapp != blank %}<a href="https://api.whatsapp.com/send?phone={{ cfg.assist_whatsapp | remove: '+' | remove: ' ' }}&text={{ wa_text | url_encode }}" target="_blank" rel="noopener">{{ pdpi_wa }}<span>WhatsApp</span></a>{% endif -%}
              {%- if cfg.assist_phone != blank %}<a href="tel:{{ cfg.assist_phone | remove: ' ' }}">{{ pdpi_phone }}<span>Call</span></a>{% endif -%}
              {%- if cfg.assist_email != blank %}<a href="mailto:{{ cfg.assist_email }}?subject={{ product.title | url_encode }}">{{ pdpi_mail }}<span>Email</span></a>{% endif -%}
              {%- if cfg.assist_book_label != blank %}<a class="pdp__assist-book" href="#book">{{ pdpi_call }}<span>{{ cfg.assist_book_label | escape }}</span></a>{% endif -%}
            </div>
          </div>
        {%- endif -%}

        {%- if cfg.show_reviews -%}
        <div class="pdp__worn">
          <div class="pdp__label-row"><p class="pdp__label">Worn by</p><a href="#reviews">All {{ cfg.review_count }} reviews</a></div>
          <div class="pdp__faces">
            {%- for face_file in face_files -%}
              {%- assign face_key = 'face_' | append: forloop.index -%}
              {%- assign face_image = cfg[face_key] -%}
              {%- if face_image != blank -%}
                <img src="{{ face_image | image_url: width: 160 }}" alt="" loading="lazy">
              {%- else -%}
                <img src="{{ face_file | asset_url }}" alt="" loading="lazy">
              {%- endif -%}
            {%- endfor -%}
          </div>
          {%- if cfg.quote != blank -%}
            <blockquote class="pdp__quote">“{{ cfg.quote }}”<cite>{{ cfg.quote_cite }}</cite></blockquote>
          {%- endif -%}
        </div>
        {%- endif -%}

        <a class="arrow-link pdp__back" href="{{ shop_url }}">Back to the catalogue {{ icon_arrow_15 }}</a>
      </div>
    </div>

    {%- if cfg.show_reviews -%}
      <section class="section container pdp-reviews" id="reviews">
        <div class="section-head" data-reveal>
          <div class="section-head__titles">
            <p class="eyebrow">{{ cfg.review_count }} reviews</p>
            <h2 class="section-title">What buyers <em>say</em></h2>
          </div>
          <a class="arrow-link" href="#write-review">Write a review {{ icon_arrow_16 }}</a>
        </div>
        <div class="reviews" data-reveal-child>
          <aside class="review-add" id="write-review">
            <p class="review-add__score">{{ cfg.rating }}</p>
            {{ stars_rating }}
            <p class="review-add__count">Based on {{ cfg.review_count }} reviews</p>
            <button type="button" class="btn">Write a review</button>
            {%- if cfg.review_note != blank -%}
              <p class="review-add__note">{{ cfg.review_note }}</p>
            {%- endif -%}
          </aside>
          {%- for block in section.blocks -%}
            {%- if block.type != 'review' -%}
              {%- continue -%}
            {%- endif -%}
            {%- liquid
              assign r_stars = block.settings.stars
              comment
                Each card's portrait is the block's own image, or the packaged one
                in that position — the row of four repeats for a fourth review.
              endcomment
              assign r_face_i = forloop.index0 | modulo: 4
              assign r_face = face_files[r_face_i]
            -%}
            <article class="review"{% if block.shopify_attributes != blank %} {{ block.shopify_attributes }}{% endif %}><span class="pdp__stars" aria-label="{{ r_stars }} out of 5 stars">{% for i in (1..r_stars) %}{{ icon_star }}{% endfor %}</span>
              <p class="review__body">{{ block.settings.body }}</p>
              <div class="review__who">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 120 }}" alt="" loading="lazy">{% else %}<img src="{{ r_face | asset_url }}" alt="" loading="lazy">{% endif %}<span><span class="review__name">{{ block.settings.name }}</span><span class="review__place">{{ block.settings.place }}</span></span></div>
            </article>
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- if cfg.show_rec -%}
      <section class="section container pdp-rec" aria-label="Recommended">
        <div class="section-head" data-reveal>
          <div class="section-head__titles">
            <p class="eyebrow">Complete the look</p>
            <h2 class="section-title">Pieces to <em>wear with it</em></h2>
          </div>
        </div>
        <div class="curated__grid" data-reveal-child>
          {%- assign rec_n = 0 -%}
          {%- for p in rec_coll.products -%}
            {%- assign p_key = '|' | append: p.handle | append: '|' -%}
            {%- if shown contains p_key -%}
              {%- continue -%}
            {%- endif -%}
            {%- render 'piece-card', product: p, show_swatches: cfg.card_swatches, quick_label: cfg.add_label, sold_out_label: cfg.sold_out_label -%}
            {%- assign shown = shown | append: p.handle | append: '|' -%}
            {%- assign rec_n = rec_n | plus: 1 -%}
            {%- if rec_n >= rail_max -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- if cfg.show_other -%}
      <section class="section container pdp-other" aria-label="Other products">
        <div class="section-head" data-reveal>
          <div class="section-head__titles">
            <p class="eyebrow">Elsewhere in the catalogue</p>
            <h2 class="section-title">Other <em>pieces</em></h2>
          </div>
          <a class="arrow-link" href="{{ shop_url }}">Shop everything {{ icon_arrow_16 }}</a>
        </div>
        <div class="curated__grid" data-reveal-child>
          {%- assign other_n = 0 -%}
          {%- for p in collections['all'].products -%}
            {%- assign p_key = '|' | append: p.handle | append: '|' -%}
            {%- if shown contains p_key -%}
              {%- continue -%}
            {%- endif -%}
            {%- render 'piece-card', product: p, show_swatches: cfg.card_swatches, quick_label: cfg.add_label, sold_out_label: cfg.sold_out_label -%}
            {%- assign shown = shown | append: p.handle | append: '|' -%}
            {%- assign other_n = other_n | plus: 1 -%}
            {%- if other_n >= rail_max -%}
              {%- break -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </section>
    {%- endif -%}

    {%- comment -%}
      The size guide, over the product rather than on a page of its own. The
      store keeps one chart for every garment; the script keeps the rows for
      this one and hides the rest, matching a row group to the product by name
      (a group called Top to a product whose title, type, tags or collections
      say Top). The words the script matches against travel on the element.
    {%- endcomment -%}
    {%- if cfg.size_guide_page != blank and from_variants -%}
      {%- capture guide_context -%}{{ product.title }} | {{ product.type }} | {{ product.tags | join: ' | ' }}{% for guide_coll in product.collections %} | {{ guide_coll.title }}{% endfor %}{%- endcapture -%}
      <dialog class="pdp-guide" data-pdp-guide data-lenis-prevent aria-labelledby="pdp-guide-title-{{ section.id }}" data-context="{{ guide_context | strip_html | downcase | escape }}">
        <div class="pdp-guide__head">
          <div>
            <p class="pdp-guide__eyebrow">Size guide</p>
            <h2 class="pdp-guide__title" id="pdp-guide-title-{{ section.id }}" data-pdp-guide-title>{{ cfg.size_guide_page.title }}</h2>
          </div>
          <button type="button" class="pdp-guide__close" data-pdp-guide-close aria-label="Close the size guide"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg></button>
        </div>
        <div class="pdp-guide__body store-article">
          {{ cfg.size_guide_page.content | replace: '<p>&nbsp;</p>', '' | replace: '<p> </p>', '' | replace: '<p></p>', '' }}
        </div>
      </dialog>
    {%- endif -%}
  </div>
{%- endif -%}

<script>
(function () {
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root || root.__pdpInit) return;
  root.__pdpInit = true;

  var page = root.querySelector('.pdp-page');
  if (!page) return;

  var pdpEl = root.querySelector('.pdp');
  var detailsEl = root.querySelector('.pdp__details');
  var list = function (sel) { return Array.prototype.slice.call(root.querySelectorAll(sel)); };

  var thumbEls = list('.pdp__thumb');
  var shotEls = list('.pdp__shot');
  var sizeEls = list('.pdp__size');
  var optionEls = list('.pdp__option');
  var modeInputs = list('.pdp__option input');
  var detailEls = list('.pdp__detail');

  var variantInput = root.querySelector('[data-pdp-variant]');
  var addBtn = root.querySelector('.pdp__add');
  var wasLine = root.querySelector('[data-pdp-was-line]');
  /* the ready-to-ship option is the first one, and carries the live price */
  var modePriceEl = root.querySelector('.pdp__option .pdp__option-price');

  var active = 0;
  var open = 0; // the first panel is rendered open

  function setActive(i) {
    if (i === active) return;
    active = i;
    thumbEls.forEach(function (t, j) {
      t.classList.toggle('is-active', j === i);
      if (j === i) t.setAttribute('aria-current', 'true');
      else t.removeAttribute('aria-current');
    });
    shotEls.forEach(function (s, j) {
      s.classList.toggle('is-active', j === i);
      s.setAttribute('aria-hidden', j !== i ? 'true' : 'false');
    });
  }

  function applyOpen() {
    detailEls.forEach(function (d, j) {
      var isOpen = open === j;
      d.classList.toggle('is-open', isOpen);
      d.querySelector('.pdp__detail-summary').setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    });
  }

  function scrollTo(y) {
    if (window.Shrujan) window.Shrujan.scrollToY(y); // through Lenis, or it fights the smooth scroller
    else window.scrollTo(0, y);
  }

  // Which picture the scroll position asks for: the section is divided into as
  // many bands as there are shots. -1 when the page is too short to have any.
  function bandNow() {
    var el = pdpEl;
    if (!el || !shotEls.length) return -1;
    var r = el.getBoundingClientRect();
    var travel = r.height - window.innerHeight;
    if (travel <= 0) return -1;
    var progress = Math.min(1, Math.max(0, -r.top / travel));
    return Math.min(shotEls.length - 1, Math.floor(progress * shotEls.length));
  }

  // A thumbnail shows its picture where the page is. It used to scroll the page
  // to that picture's band, which moved the buying column out from under the
  // reader for the sake of a picture. The choice holds while the page stays in
  // the band it was made in; scroll into another and the scroll decides again.
  var pinnedBand = -1;
  thumbEls.forEach(function (t, i) {
    t.addEventListener('click', function () {
      pinnedBand = bandNow();
      setActive(i);
    });
  });

  // A size is a variant when the product has real options — the button carries
  // the id the form posts, and the price the page shows.
  sizeEls.forEach(function (btn) {
    btn.addEventListener('click', function () {
      if (btn.disabled) return;
      sizeEls.forEach(function (b) {
        var on = b === btn;
        b.classList.toggle('is-active', on);
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
      });

      var id = btn.getAttribute('data-variant');
      if (id && variantInput) variantInput.value = id;

      var price = btn.getAttribute('data-price');
      if (!price) return;
      if (modePriceEl) modePriceEl.textContent = price;
      if (addBtn && !addBtn.disabled) {
        addBtn.textContent = (addBtn.getAttribute('data-add-label') || '') + ' — ' + price;
      }
      if (wasLine) {
        var was = btn.getAttribute('data-was');
        wasLine.textContent = price;
        if (was) {
          var s = document.createElement('s');
          s.textContent = was;
          wasLine.appendChild(s);
        }
      }
    });
  });

  modeInputs.forEach(function (input, idx) {
    input.addEventListener('change', function () {
      optionEls.forEach(function (l, j) { l.classList.toggle('is-active', j === idx); });
    });
  });

  // "Size guide" opens the store's size chart over the product when a chart
  // page has been chosen. Otherwise it opens the fit panel, which is marked in
  // the markup so reordering the accordions cannot silently open the wrong one.
  // With neither, there is nothing for it to do and it is not shown.
  var sizeGuideBtn = root.querySelector('.pdp__size-guide');
  var fitEl = root.querySelector('[data-pdp-fit]');
  var guideEl = root.querySelector('[data-pdp-guide]');
  var guideWanted = sizeGuideBtn && sizeGuideBtn.hasAttribute('data-pdp-guide-open');

  // Keeps this garment's rows of the chart and hides the others. The chart is
  // read as it is written: the rows before the first one with figures are its
  // headings; a name in the first column starts a group that runs until the
  // next name. Returns the group's name, or null when the chart has no rows
  // for this product, in which case no guide is better than another garment's.
  function keepGarmentRows(table, context) {
    var rows = Array.prototype.slice.call(table.rows);
    var text = function (cell) { return cell ? cell.textContent.replace(/\u00a0/g, ' ').trim() : ''; };
    var hasFigures = function (row) {
      for (var c = 2; c < row.cells.length; c++) if (/\d/.test(text(row.cells[c]))) return true;
      return false;
    };
    var first = 0;
    while (first < rows.length && !hasFigures(rows[first])) first++;
    if (first === 0 || first >= rows.length) return null;

    var groups = [], current = null, headLabel = null;
    for (var h = 1; h < first; h++) {
      if (text(rows[h].cells[0])) { headLabel = rows[h].cells[0]; current = { name: text(headLabel), rows: [] }; }
    }
    if (current) groups.push(current);
    for (var i = first; i < rows.length; i++) {
      var label = text(rows[i].cells[0]);
      if (label) { current = { name: label, rows: [] }; groups.push(current); }
      if (current) current.rows.push(rows[i]);
    }

    var named = function (haystack) {
      for (var g = 0; g < groups.length; g++) {
        var word = groups[g].name.toLowerCase().replace(/[^a-z0-9 ]/g, '');
        if (word && new RegExp('(^|[^a-z])' + word + 's?([^a-z]|$)').test(haystack)) return groups[g];
      }
      return null;
    };
    // the title speaks first; the type, tags and collections only if it says nothing
    var match = named(context.split('|')[0]) || named(context);
    if (!match) return null;
    var keep = match.rows.filter(hasFigures);
    if (!keep.length) return null;

    for (var d = first; d < rows.length; d++) rows[d].hidden = keep.indexOf(rows[d]) < 0;
    // a group named on a heading row would otherwise sit over another garment's figures
    if (headLabel && text(headLabel) !== match.name) headLabel.textContent = '';
    return match.name;
  }

  if (guideWanted && guideEl) {
    var chart = guideEl.querySelector('table');
    var garment = chart ? keepGarmentRows(chart, guideEl.getAttribute('data-context') || '') : null;
    if (garment) {
      var guideTitle = guideEl.querySelector('[data-pdp-guide-title]');
      if (guideTitle) guideTitle.textContent = garment;
      sizeGuideBtn.hidden = false;
      sizeGuideBtn.addEventListener('click', function () {
        if (guideEl.showModal) guideEl.showModal();
        else guideEl.setAttribute('open', '');
        if (window.Shrujan && window.Shrujan.stopScroll) window.Shrujan.stopScroll();
      });
      var closeGuide = function () {
        if (guideEl.close) guideEl.close();
        else guideEl.removeAttribute('open');
      };
      guideEl.querySelector('[data-pdp-guide-close]').addEventListener('click', closeGuide);
      // a click on the dimmed page around the panel closes it; one inside does not
      guideEl.addEventListener('click', function (e) { if (e.target === guideEl) closeGuide(); });
      guideEl.addEventListener('close', function () {
        if (window.Shrujan && window.Shrujan.startScroll) window.Shrujan.startScroll();
      });
    }
  } else if (sizeGuideBtn && !guideWanted && !fitEl) {
    sizeGuideBtn.hidden = true;
  }
  if (sizeGuideBtn && !guideWanted && fitEl) {
    sizeGuideBtn.addEventListener('click', function () {
      var i = detailEls.indexOf(fitEl);
      if (i < 0) return;
      open = i;
      applyOpen();
      if (detailsEl) scrollTo(detailsEl.getBoundingClientRect().top + window.scrollY - 120);
    });
  }

  detailEls.forEach(function (d, i) {
    d.querySelector('.pdp__detail-summary').addEventListener('click', function () {
      open = open === i ? -1 : i;
      applyOpen();
    });
  });

  // The rail cards' own two controls sit inside the product link, so neither
  // may navigate: the heart is a wish, the label adds that piece to the bag.
  root.addEventListener('click', function (e) {
    var node = e.target.closest ? e.target : e.target.parentNode;
    if (!node || !node.closest) return;

    var wish = node.closest('.piece__wish');
    if (wish) {
      e.preventDefault();
      return;
    }

    var quick = node.closest('.piece__quick');
    var id = quick && quick.getAttribute('data-variant');
    if (!id) return;
    e.preventDefault();
    var add = document.createElement('form');
    add.method = 'post';
    add.action = page.getAttribute('data-cart-add') || '/cart/add';
    add.hidden = true;
    add.innerHTML =
      '<input type="hidden" name="id" value="' + id + '">' +
      '<input type="hidden" name="quantity" value="1">';
    document.body.appendChild(add);
    add.submit();
  });

  // Scroll drives the gallery. The section is divided into as many bands as
  // there are shots, and progress through it picks the one on screen — so the
  // image changes only when you move, never on its own.
  if (shotEls.length >= 2) {
    var queued = false;

    var read = function () {
      queued = false;
      var band = bandNow();
      if (band < 0) return;
      if (pinnedBand > -1) {
        if (band === pinnedBand) return; // a thumbnail's choice stands until the page moves on
        pinnedBand = -1;
      }
      setActive(band);
    };

    var onScroll = function () {
      if (queued) return;
      queued = true;
      requestAnimationFrame(read);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    read();
  }
})();
</script>

