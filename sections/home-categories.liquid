{%- render 'section-design', section: section -%}
{%- liquid
  assign cfg = section.settings
  assign sel = '#shopify-section-' | append: section.id

  comment
    Mobile group. There is no grid here to give a column count to: the bar is a
    flex row of panels that the stylesheet turns into a flex column at 900px, so
    what actually governs a phone is each panel's height — a clamp at 900px and
    a second, taller one at 600px. A single height replaces both, which is why
    the control is opt-in at 0 rather than carrying one of the two clamps as its
    default. The numeral and the scrim are markup switches already, so the phone
    versions only apply while the panel is still rendering them.
  endcomment
  assign cat_style = false
  if cfg.cat_panel_h_m != 0
    assign cat_style = true
  endif
  if cfg.cat_show_index and cfg.cat_show_index_m == false
    assign cat_style = true
  endif
  if cfg.cat_show_scrim and cfg.cat_show_scrim_m == false
    assign cat_style = true
  endif
-%}
{%- if cat_style -%}
  <style>
    @media (max-width: 720px) {
      {%- if cfg.cat_panel_h_m != 0 -%}
        {{ sel }} .catpanel { height: {{ cfg.cat_panel_h_m }}px; }
      {%- endif -%}
      {%- if cfg.cat_show_index and cfg.cat_show_index_m == false -%}
        {{ sel }} .catpanel__index { display: none; }
      {%- endif -%}
      {%- if cfg.cat_show_scrim and cfg.cat_show_scrim_m == false -%}
        {{ sel }} .catpanel__scrim { display: none; }
      {%- endif -%}
    }
  </style>
{%- endif -%}
<section class="section container" id="categories">
  <div class="section-head section-head--center" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow }}</p>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <a class="arrow-link" href="{{ section.settings.cta_link | default: '/pages/shop-shrujan' }}">{{ section.settings.cta_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </div>

  <div class="catbar" data-reveal-child>
    {%- for block in section.blocks %}
    <a class="catpanel" href="{{ block.settings.link | default: '/pages/shop-shrujan?c=kanchli' }}"{{ block.shopify_attributes }}>
      <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.img_asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
      {% if cfg.cat_show_scrim %}<span class="catpanel__scrim" aria-hidden="true"></span>{% endif %}
      {% if cfg.cat_show_index %}<span class="catpanel__index" aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>{% endif %}
      {% if cfg.cat_show_spine %}<span class="catpanel__spine" aria-hidden="true">{{ block.settings.name | escape }}</span>{% endif %}
      <span class="catpanel__open"><span class="catpanel__name">{{ block.settings.name | escape }}</span>{% if cfg.cat_show_copy %}<span class="catpanel__copy">{{ block.settings.copy }}</span>{% endif %}{% if cfg.cat_show_cta %}<span class="catpanel__foot"><span class="catpanel__cta">{{ section.settings.explore_label }} <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></span></span>{% endif %}</span>
    </a>
    {%- endfor %}
  </div>
</section>
{% schema %}
{
