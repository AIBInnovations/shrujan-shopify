      "id": "cat_show_index",
      "label": "Show panel number",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "cat_show_spine",
      "label": "Show vertical name",
      "default": true,
      "info": "The rotated label on a closed panel. Hidden below 900px either way."
