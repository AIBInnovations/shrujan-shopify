{%- liquid
  assign max_sold = 0
  for b in section.blocks
    assign s = b.settings.sold | plus: 0
    if s > max_sold
      assign max_sold = s
    endif
  endfor
  if max_sold == 0
    assign max_sold = 1
  endif
-%}
<section class="section container best" id="bestsellers">
  <div class="section-head" data-reveal>
    <div class="section-head__titles">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>

    <div class="section-head__aside">
      <p class="best__legend">{{ section.settings.legend }}</p>
      <div class="carousel-arrows">
        <button type="button" aria-label="Previous bestsellers">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 5.5 8 12l6.5 6.5"></path></svg>
        </button>
        <button type="button" aria-label="Next bestsellers">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9.5 5.5 6.5 6.5-6.5 6.5"></path></svg>
        </button>
      </div>
    </div>
  </div>

  <div class="best__rail" data-reveal-child>
    {%- for block in section.blocks %}
    <a class="best-card" href="{{ block.settings.link | default: '/products/kanchli-copy' }}"{{ block.shopify_attributes }}>
      <span class="best-card__rank"><span class="best-card__num">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span><span class="best-card__thread" aria-hidden="true"></span></span>
      <div class="best-card__media">
        <img src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1200 }}{% else %}{{ block.settings.img_asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
        <button class="best-card__wish" type="button" aria-label="Save {{ block.settings.name | escape }} to wishlist">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>
        </button>
        {% if block.settings.note != blank %}<span class="best-card__note">{{ block.settings.note }}</span>{% endif %}
      </div>
      <div class="best-card__info">
        <p class="best-card__name">{{ block.settings.name }}</p>
        <p class="best-card__craft">{{ block.settings.craft }}</p>
        <p class="best-card__price">{{ block.settings.price }}{% if block.settings.was_price != blank %}<span>{{ block.settings.was_price }}</span>{% endif %}</p>
        <span class="best-card__meter" style="--fill: {{ block.settings.sold | plus: 0 | times: 100.0 | divided_by: max_sold | round }}%" aria-hidden="true"></span>
        <p class="best-card__sold"><strong>{{ block.settings.sold }}</strong> {{ section.settings.sold_label }}</p>
        <span class="best-card__swatches" aria-hidden="true">{% assign swatch_list = block.settings.swatches | split: ',' %}{% for swatch in swatch_list %}<i style="background: {{ swatch | strip }}"></i>{% endfor %}</span>
      </div>
    </a>
    {%- endfor %}
  </div>

  <div class="best__more" data-reveal>
    <a class="arrow-link" href="{{ section.settings.more_link | default: '/pages/shop-shrujan#catalogue' }}">{{ section.settings.more_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('.best');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var rail = root.querySelector('.best__rail');

  // Scroll one full page — however many cards currently fit.
  function page(dir) {
    if (!rail) return;
    rail.scrollBy({ left: dir * rail.clientWidth, behavior: 'smooth' });
  }

  var arrows = root.querySelectorAll('.carousel-arrows button');
  if (arrows[0]) arrows[0].addEventListener('click', function () { page(-1); });
  if (arrows[1]) arrows[1].addEventListener('click', function () { page(1); });

  // The wish button sits inside the card link; keep a tap on it from navigating.
  root.querySelectorAll('.best-card__wish').forEach(function (btn) {
    btn.addEventListener('click', function (e) { e.preventDefault(); });
  });
})();
</script>
