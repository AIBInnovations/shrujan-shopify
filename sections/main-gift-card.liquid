{%- render 'section-design', section: section -%}
{%- comment -%}
  Gift card — the page the recipient lands on from their email.

  Everything is read off the real `gift_card` object: the live balance, the
  code through `format_code` (which groups it into readable blocks), the expiry
  when one is set, and the scannable identifier for use in the Bhuj store. The
  QR is drawn by Shopify's own hosted qrcode.js; if it fails to load the empty
  frame removes itself rather than sitting there blank.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
-%}
<section class="container store-gate">
  <div class="store-gate__inner" data-reveal>
    {%- if cfg.eyebrow != blank %}
    <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
    {%- endif %}
    <h1 class="store-gate__title">{{ cfg.heading }}</h1>
    {%- if cfg.copy != blank %}
    <p class="store-gate__copy">{{ cfg.copy }}</p>
    {%- endif %}

    <div class="store-gift">
      <p class="store-gift__label">{{ cfg.balance_label }}</p>
      <p class="store-gift__value">{{ gift_card.balance | money }}</p>
      {%- if cfg.show_initial and gift_card.balance != gift_card.initial_value %}
      <p class="store-gift__was">{{ cfg.initial_label }} {{ gift_card.initial_value | money }}</p>
      {%- endif %}

      {%- if gift_card.enabled == false %}
      <p class="store-errors">{{ cfg.disabled_note }}</p>
      {%- elsif gift_card.expired %}
      <p class="store-errors">{{ cfg.expired_note }}</p>
      {%- endif %}

      <p class="store-gift__label">{{ cfg.code_label }}</p>
      <p class="store-gift__code">{{ gift_card.code | format_code }}</p>
      {%- if cfg.code_note != blank %}
      <p class="store-note">{{ cfg.code_note }}</p>
      {%- endif %}

      {%- if cfg.show_qr %}
      <div class="store-gift__qr" data-qr="{{ gift_card.qr_identifier }}"></div>
      {%- if cfg.qr_note != blank %}
      <p class="store-gift__label">{{ cfg.qr_note }}</p>
      {%- endif %}
      {%- endif %}

      {%- if gift_card.expires_on and gift_card.expired == false %}
      <p class="store-note">{{ cfg.expiry_label }} {{ gift_card.expires_on | date: format: cfg.date_format }}</p>
      {%- endif %}
    </div>

    <div class="store-actions store-gift__actions">
      <a class="btn" href="{{ cfg.cta_url | default: '/pages/shop-shrujan' }}">{{ cfg.cta_label }}</a>
      {%- if cfg.show_print %}
      <button type="button" class="btn btn--ghost" data-gift-print>{{ cfg.print_label }}</button>
      {%- endif %}
    </div>
  </div>
</section>

{%- if cfg.show_qr %}
<script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
{%- endif %}
<script>
(function () {
  var host = document.querySelector('[data-qr]');
  var printer = document.querySelector('[data-gift-print]');

  if (printer) {
    printer.addEventListener('click', function () { window.print(); });
  }

  if (!host) return;

  /* qrcode.js is loaded with `defer`, so it is only guaranteed to be there by
     the load event. If it never arrives the frame takes itself away. */
  function draw() {
    if (typeof QRCode === 'undefined' || !host.getAttribute('data-qr')) {
      host.remove();
      return;
    }
    new QRCode(host, {
      text: host.getAttribute('data-qr'),
      width: 148,
      height: 148,
      colorDark: '#2b1d19',
      colorLight: '#ffffff'
    });
  }

  if (document.readyState === 'complete') draw();
  else window.addEventListener('load', draw);
})();
</script>
{% schema %}
{
  "name": "Gift card",
  "settings": [
    {
      "type": "header",
      "content": "Message"
    },
    {
      "type": "text",
      "id": "eyebrow",
