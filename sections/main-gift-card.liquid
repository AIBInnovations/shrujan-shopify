      "default": "A gift from Shrujan"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in <em> to set it in italic gerua.",
      "default": "Someone chose <em>handwork</em> for you"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Spend it on anything in the store. Every piece is embroidered by hand by the artisan women of Kutch, and each one carries her name."
    },
    {
      "type": "header",
      "content": "Value"
    },
    {
      "type": "text",
      "id": "balance_label",
      "label": "Balance label",
      "default": "Balance remaining"
    },
    {
      "type": "checkbox",
      "id": "show_initial",
      "label": "Show the original value once partly spent",
      "default": true
    },
    {
      "type": "text",
      "id": "initial_label",
      "label": "Original value label",
      "default": "Issued for"
    },
    {
      "type": "header",
      "content": "Code"
    },
    {
      "type": "text",
      "id": "code_label",
      "label": "Code label",
      "default": "Gift card code"
    },
    {
      "type": "text",
      "id": "code_note",
      "label": "Code note",
      "default": "Enter this at checkout, or show the code in our Bhuj store."
    },
    {
      "type": "checkbox",
      "id": "show_qr",
      "label": "Show the QR code",
      "default": true
    },
    {
      "type": "text",
      "id": "qr_note",
      "label": "QR note",
      "default": "Scan in store"
    },
    {
      "type": "header",
      "content": "Expiry & status"
    },
    {
