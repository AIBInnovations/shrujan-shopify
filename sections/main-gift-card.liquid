        {
          "value": "abbreviated_date",
          "label": "5 Aug 2026"
        },
        {
          "value": "date",
          "label": "August 5, 2026"
        },
        {
          "value": "month_day_year",
          "label": "08/05/2026"
        },
        {
          "value": "basic",
          "label": "05/08/2026"
        }
      ]
    },
    {
      "type": "text",
      "id": "expired_note",
      "label": "Expired message",
      "default": "This gift card has expired. Write to us and we will see what can be done."
    },
    {
      "type": "text",
      "id": "disabled_note",
      "label": "Disabled message",
      "default": "This gift card is no longer active."
    },
    {
      "type": "header",
      "content": "Actions"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Shop button",
      "default": "Shop the catalogue"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Shop link"
    },
    {
      "type": "checkbox",
      "id": "show_print",
      "label": "Show the print button",
      "default": true
    },
    {
      "type": "text",
      "id": "print_label",
      "label": "Print button",
      "default": "Print this card"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
