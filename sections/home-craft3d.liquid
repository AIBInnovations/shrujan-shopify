{%- comment -%}
  Wear the craft: four Kutch crafts, each on a Shrujan piece, its photograph
  rising over the last as the page scrolls. The markup is
  snippets/sj-craft3d.liquid, generated from the awwwards preview
  (awwwards-preview/export_theme.py); the scrolling is assets/sj-craft3d.js and
  the styles assets/sj-home.css, both of which layout/theme.liquid loads on the
  home page only.
{%- endcomment -%}
{% render 'sj-craft3d' %}

{% schema %}
{
  "name": "Wear the craft",
  "settings": [
    {
      "type": "paragraph",
      "content": "Four Kutch crafts, each on a Shrujan piece, the photographs rising one over another as the page scrolls. Its words and pictures come from the home page design files; it runs on the home page only."
    }
  ],
  "presets": [
    {
      "name": "Wear the craft"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
