{%- comment -%}
  Wear the craft: a dress form turning through four Kutch crafts as the page
  scrolls. The markup is snippets/sj-craft3d.liquid, generated from the
  awwwards preview (awwwards-preview/export_theme.py); the form itself is drawn
  by assets/sj-craft3d.js with three.js, and styled by assets/sj-home.css, both
  of which layout/theme.liquid loads on the home page only.
{%- endcomment -%}
{% render 'sj-craft3d' %}

{% schema %}
{
  "name": "Wear the craft (3D)",
  "settings": [
    {
      "type": "paragraph",
      "content": "A dress form turning through four Kutch crafts as the page scrolls. Its words and motion come from the home page design files; it runs on the home page only."
    }
  ],
  "presets": [
    {
      "name": "Wear the craft (3D)"
    }
  ],
  "enabled_on": {
    "templates": ["index"]
  }
}
{% endschema %}
