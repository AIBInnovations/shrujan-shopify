{%- render 'section-design', section: section -%}
<section class="section container faq-section" id="support">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    <h2 class="section-title">{{ section.settings.title }}</h2>
    <p class="section-intro__copy">
      {{ section.settings.intro }}
    </p>
  </div>

  <div class="faq" data-reveal>
    {%- for block in section.blocks %}
    <div class="faq__item{% if forloop.first %} is-open{% endif %}" {{ block.shopify_attributes }}>
      <button class="faq__summary" type="button" aria-expanded="{% if forloop.first %}true{% else %}false{% endif %}" aria-controls="faq-panel-{{ forloop.index0 }}">
        <span class="faq__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
        <span class="faq__q">{{ block.settings.question | escape }}</span>
        <span class="faq__icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"></path></svg>
        </span>
      </button>

      <div class="faq__panel" id="faq-panel-{{ forloop.index0 }}" role="region">
        <div class="faq__panel-inner">
          <p class="faq__a">{{ block.settings.answer }}</p>
        </div>
      </div>
    </div>
    {%- endfor %}
  </div>

</section>

<script>
(function () {
  var root = document.querySelector('.faq-section');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var items = Array.prototype.slice.call(root.querySelectorAll('.faq__item'));

  items.forEach(function (item) {
    var button = item.querySelector('.faq__summary');
    if (!button) return;
    button.addEventListener('click', function () {
      // setOpen(isOpen ? -1 : i) — one panel open at a time; clicking the
      // open one closes everything.
      var wasOpen = item.classList.contains('is-open');
      items.forEach(function (other) {
        var isOpen = !wasOpen && other === item;
        other.classList.toggle('is-open', isOpen);
        var btn = other.querySelector('.faq__summary');
        if (btn) btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
    });
  });
})();
</script>
{% schema %}
{
  "name": "FAQ",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
