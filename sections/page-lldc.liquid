{%- render 'section-design', section: section -%}
{%- capture nl %}
{% endcapture -%}
<div class="page">
  <header class="page-hero page-hero--cover page-hero--frame" data-reveal>
    <div class="page-hero__bg" aria-hidden="true">
      <img src="{% if section.settings.hero_img %}{{ section.settings.hero_img | image_url: width: 2000 }}{% else %}{{ 'lldc-hero.webp' | asset_url }}{% endif %}" alt="" fetchpriority="high">
      <span class="page-hero__scrim"></span>
    </div>

    <div class="container page-hero__grid">
      <div class="page-hero__text">
        <p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="page-hero__title">{{ section.settings.hero_title }}</h1>
      </div>
    </div>

    <span class="page-hero__rule" aria-hidden="true"></span>
  </header>

  <section class="section container">
    <div class="origin" data-reveal>
      <p class="origin__lead">{{ section.settings.origin_lead }}</p>
      <div class="origin__body">
        {%- assign origin_paras = section.settings.origin_body | strip | split: nl -%}
        {%- for para in origin_paras %}
        <p>{{ para | strip }}</p>
        {%- endfor %}
      </div>
    </div>

    <div class="craft__stats" data-reveal-child>
    {%- for block in section.blocks %}
    {%- if block.type == 'stat' %}
      <div class="stat" {{ block.shopify_attributes }}>
        <p class="stat__value">{{ block.settings.value }}</p>
        <p class="stat__label">{{ block.settings.label }}</p>
      </div>
    {%- endif %}
    {%- endfor %}
    </div>
  </section>

  <section class="section container">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">{{ section.settings.show_eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.show_title }}</h2>
      <p class="section-intro__copy">{{ section.settings.show_copy }}</p>
    </div>

    <div class="lldc-show" data-reveal-child>
    {%- for block in section.blocks %}
    {%- if block.type == 'figure' %}
      <figure {{ block.shopify_attributes }}>
        <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
      </figure>
    {%- endif %}
    {%- endfor %}
    </div>
  </section>

  <section class="section container lldc" aria-label="On the campus">
    <div class="section-head" data-reveal>
      <div class="section-head__titles">
        <p class="eyebrow">{{ section.settings.campus_eyebrow }}</p>
        <h2 class="section-title">{{ section.settings.campus_title }}</h2>
      </div>
    </div>

    <div class="lldc__mosaic" data-reveal-child>
    {%- for block in section.blocks %}
    {%- if block.type == 'card' %}
      <article class="lldc-card{% if block.settings.wide %} lldc-card--wide{% endif %}" {{ block.shopify_attributes }}>
        <div class="lldc-card__media">
          <img src="{% if block.settings.img %}{{ block.settings.img | image_url: width: 1200 }}{% else %}{{ block.settings.asset | asset_url }}{% endif %}" alt="{{ block.settings.alt | escape }}" loading="lazy">
        </div>
        <div class="lldc-card__body">
          <h3 class="lldc-card__name">{{ block.settings.name }}</h3>
          <p class="lldc-card__copy">{{ block.settings.copy }}</p>
        </div>
      </article>
    {%- endif %}
    {%- endfor %}
    </div>
  </section>

  <section class="section container lldc-visit">
    <div class="lldc-visit__head" data-reveal>
      <p class="eyebrow">{{ section.settings.visit_eyebrow }}</p>
      <h2 class="section-title">{{ section.settings.visit_title }}</h2>
    </div>

    <div class="visit-plates" data-reveal-child>
    {%- for block in section.blocks %}
    {%- if block.type == 'plate' %}
      <div class="plate" {{ block.shopify_attributes }}>
        <p class="plate__label">{{ block.settings.label }}</p>
        <p class="plate__head">{{ block.settings.head }}</p>
        <ul class="plate__lines">
          {%- assign plate_lines = block.settings.lines | strip | split: nl -%}
          {%- for line in plate_lines %}
          <li>{{ line | strip }}</li>
          {%- endfor %}
        </ul>
      </div>
    {%- endif %}
    {%- endfor %}
    </div>

    <div class="visit-bar" data-reveal>
      <div class="visit-bar__col">
        <p class="visit-bar__label">{{ section.settings.bar1_label }}</p>
        <p class="visit-bar__value">{{ section.settings.bar1_line1 }}<br>{{ section.settings.bar1_line2 }}</p>
      </div>

      <div class="visit-bar__col">
        <p class="visit-bar__label">{{ section.settings.bar2_label }}</p>
        <p class="visit-bar__value"><a href="mailto:{{ section.settings.bar_email | escape }}">{{ section.settings.bar_email }}</a><br><a href="tel:{{ section.settings.bar_tel | escape }}">{{ section.settings.bar_phone }}</a></p>
      </div>

      <div class="visit-bar__col visit-bar__col--note">
        <p class="visit-bar__label">{{ section.settings.bar3_label }}</p>
        <p class="visit-bar__value">{{ section.settings.bar3_note }}</p>
      </div>
    </div>
  </section>

  <section class="section container page-cta" data-reveal>
    <p>{{ section.settings.cta_text }}</p>
    <a class="btn" href="{{ section.settings.cta_url | default: 'https://shrujanlldc.org' }}" target="_blank" rel="noreferrer noopener">{{ section.settings.cta_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </section>
</div>

{% schema %}
{
