{%- render 'section-design', section: section -%}
{%- comment -%}
  Kaarigar, from the studio archive: the poster hung as six prints, one per
  craft, each cut from the painting at its own panel, turning into that craft's
  film on hover or focus (assets/sj-home.js, styled by sj-home.css). A print
  is "name | film | width | centre": its width in pixels of the 860px-wide
  painting and its centre in % across it, so a replacement artwork has to keep
  its six panels where these are. The films and their posters are the hero's
  craft montage.
{%- endcomment -%}
{%- liquid
  assign ps = section.settings
  if ps.art_img
    assign paint = ps.art_img | image_url: width: 1640
  else
    assign paint = ps.art_asset | default: 'kaarigar-art.webp' | asset_url
  endif
  assign prints = 'Kadhai|craft-embroidery|139|8.547,Ajrakh|craft-ajrakh|138|25.116,Discharge|craft-discharge|137|41.337,Bunai|craft-weaving|141|57.849,Mitti kala|craft-pottery|139|74.477,Tie-dye|craft-tiedye|141|91.337' | split: ','
-%}
<section class="arch" id="kaarigar" aria-label="From the studio archive: the makers of Kutch">
  <div class="arch__meta"><span>{{ ps.arch_meta_l | escape }}</span><span>{{ ps.arch_meta_r | escape }}</span></div>
  <h2 class="arch__title"><span class="arch__line">{{ ps.lead_l1 | escape }}</span><span class="arch__line arch__line--soft">{{ ps.lead_l2 | escape }}</span></h2>
  <div class="arch__strips" role="list" aria-label="Kaarigar, the six crafts of the poster">
    {% for p in prints -%}
    {%- assign f = p | split: '|' -%}
    <figure class="arch__item" role="listitem" tabindex="0" style="--w:{{ f[2] }};--c:{{ f[3] }}" data-film="{{ f[1] | append: '.mp4' | asset_url }}">
      <div class="arch__strip"><img class="arch__paint" src="{{ paint }}" alt="" loading="lazy"><video class="arch__film" muted loop playsinline preload="none" poster="{{ f[1] | append: '-poster.webp' | asset_url }}" aria-hidden="true"></video></div>
      <figcaption class="arch__label"><span>0{{ forloop.index }}</span>{{ f[0] }}</figcaption>
    </figure>
    {%- endfor %}
  </div>
  <ol class="arch__names" aria-hidden="true">
    {%- for p in prints -%}
    {%- assign f = p | split: '|' -%}
    <li><span>0{{ forloop.index }}</span>{{ f[0] }}</li>
    {%- endfor -%}
  </ol>
  <div class="arch__foot">
    <p class="arch__say">{{ ps.quiet | escape }}</p>
    <div class="arch__side">
      {%- comment -%} "tie-dye —" is kept on one line, so the dash never starts a line {%- endcomment %}
      <p class="arch__copy">{{ ps.copy | escape | replace: 'tie-dye —', '<span class="arch__keep">tie-dye —</span>' }}</p>
      <a class="arch__btn" href="{{ ps.link | default: '/pages/video' }}">{{ ps.link_label | escape }} <span aria-hidden="true">→</span></a>
    </div>
  </div>
</section>

