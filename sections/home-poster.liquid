{%- render 'section-design', section: section -%}
<!-- Kaarigar, from the studio archive — converted from src/components/CraftPoster.jsx -->
<section class="section poster" id="kaarigar" aria-label="{{ section.settings.caption | strip | escape }}"{% if section.settings.colour_on_scroll %} data-poster-colour{% endif %}>
  <div class="container poster__stage">
    {%- comment -%} curator's note, top right {%- endcomment %}
    <div class="poster__note poster__note--tr" data-reveal>
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      <p class="poster__lead">{{ section.settings.lead_l1 | escape }}{% if section.settings.lead_l2 != blank %}<br><em>{{ section.settings.lead_l2 | escape }}</em>{% endif %}</p>
      {%- if section.settings.copy != blank %}
      <p class="poster__copy">{{ section.settings.copy | escape }}</p>
      {%- endif %}
    </div>

    {%- comment -%} the art, centred on the page ground {%- endcomment %}
    <figure class="poster__art">
      <img src="{% if section.settings.art_img %}{{ section.settings.art_img | image_url: width: 1640 }}{% else %}{{ section.settings.art_asset | asset_url }}{% endif %}" alt="{{ section.settings.art_alt | escape }}" loading="lazy">
      {%- if section.settings.caption != blank %}
      <figcaption class="poster__caption"><span aria-hidden="true">—</span> {{ section.settings.caption | escape }} <span aria-hidden="true">—</span></figcaption>
      {%- endif %}
    </figure>

    {%- comment -%} plate line, bottom left {%- endcomment %}
    <div class="poster__note poster__note--bl" data-reveal>
      {%- if section.settings.plate != blank %}
      <p class="poster__plate">{{ section.settings.plate | escape }}</p>
      {%- endif -%}
      {%- if section.settings.quiet != blank %}
      <p class="poster__lead poster__lead--quiet"><em>{{ section.settings.quiet | escape }}</em></p>
      {%- endif -%}
      {%- if section.settings.link_label != blank %}
      <a class="arrow-link poster__link" href="{{ section.settings.link | default: '/pages/video' }}">{{ section.settings.link_label | escape }} <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
      {%- endif %}
    </div>

    {%- if section.settings.show_stamp %}
    <span class="poster__stamp" aria-hidden="true">
      <svg viewBox="0 0 120 120">
        <defs><path id="poster-arc-{{ section.id }}" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path></defs>
        <circle cx="60" cy="60" r="56" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
        <circle cx="60" cy="60" r="31" fill="none" stroke="currentColor" stroke-width="1"></circle>
        <text><textPath href="#poster-arc-{{ section.id }}" startOffset="0">{{ section.settings.stamp_text | escape }}</textPath></text>
        <text x="60" y="65" text-anchor="middle" class="poster-stamp__glyph">✦</text>
      </svg>
    </span>
    {%- endif %}
  </div>
</section>

<script>
(function () {
  /* One move on scroll: the art arrives black-and-white and takes its colour
     back as the section passes through, scrubbed to the scroll. With reduced
     motion, or the setting off, it is simply there in colour. */
  var root = document.querySelector('[data-poster-colour]');
  if (!root || root.__shrujanInit || !window.gsap || !window.ScrollTrigger) return;
  root.__shrujanInit = true;
  var art = root.querySelector('.poster__art img');
  if (!art) return;
  var mm = gsap.matchMedia();
  mm.add('(prefers-reduced-motion: no-preference)', function () {
    gsap.fromTo(art, { filter: 'grayscale(1)' }, {
      filter: 'grayscale(0)',
      ease: 'none',
      scrollTrigger: { trigger: art.parentElement, start: 'top 88%', end: 'center 48%', scrub: 0.6 }
    });
  });
  mm.add('(prefers-reduced-motion: reduce)', function () {
    gsap.set(art, { clearProps: 'filter' });
  });
})();
</script>

