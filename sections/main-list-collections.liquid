      "label": "Eyebrow",
      "default": "Catalogue"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "All collections"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Intro copy",
      "default": "From the Kutchi bodice to the cloth for your walls — each collection worked in the craft it has always been made in."
    },
    {
      "type": "header",
      "content": "Grid"
    },
    {
      "type": "select",
      "id": "order",
      "label": "Order",
      "info": "Shopify’s own order lists collections alphabetically by title.",
      "default": "shopify",
      "options": [
        {
          "value": "shopify",
          "label": "Shopify’s own order"
        },
        {
          "value": "title_asc",
          "label": "Title, A–Z"
        },
        {
          "value": "title_desc",
          "label": "Title, Z–A"
        },
        {
          "value": "count_desc",
          "label": "Most products first"
        },
        {
          "value": "count_asc",
          "label": "Fewest products first"
        }
      ]
    },
    {
      "type": "range",
      "id": "cols",
      "label": "Collections per row (desktop)",
      "info": "Applies above 900px.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "cols_t",
      "label": "Collections per row (tablet)",
      "info": "Applies between 601 and 900px.",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2
    },
    {
      "type": "range",
      "id": "cols_m",
      "label": "Collections per row (mobile)",
      "info": "Applies below 601px.",
      "min": 1,
      "max": 3,
      "step": 1,
      "default": 1
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default (4:5 portrait)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 4",
          "label": "Portrait, tall"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "16 / 9",
          "label": "Wide"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "hide_empty",
      "label": "Hide collections with no products",
      "default": false
    },
    {
      "type": "header",
      "content": "Collection card"
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show the product count",
      "default": true
    },
    {
      "type": "text",
      "id": "count_singular",
      "label": "Count word (one product)",
      "default": "piece"
    },
    {
      "type": "text",
      "id": "count_plural",
      "label": "Count word (several products)",
      "default": "pieces"
    },
    {
      "type": "text",
      "id": "card_link_label",
      "label": "Card link label",
      "default": "Shop"
    },
    {
      "type": "header",
      "content": "When there are no collections"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Heading",
      "default": "No collections yet"
    },
    {
