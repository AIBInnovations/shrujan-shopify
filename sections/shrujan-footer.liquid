    {
      "type": "select",
      "id": "nl_layout",
      "label": "Newsletter layout",
      "info": "Beside the mark is the packaged design. Stacked puts the sign-up above the mark on every screen — the same treatment small screens already get.",
      "default": "beside",
      "options": [
        {
          "value": "beside",
          "label": "Beside the brand mark"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "text",
      "id": "nl_eyebrow",
      "label": "Eyebrow",
      "default": "Letters from the Loom"
    },
    {
      "type": "inline_richtext",
      "id": "nl_title",
      "label": "Title",
      "default": "Stay close to the craft"
    },
    {
      "type": "textarea",
      "id": "nl_copy",
      "label": "Copy",
      "default": "New collections, artisan stories and early access to festive edits — once a month, written slowly."
    },
    {
      "type": "text",
      "id": "nl_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "nl_button",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "nl_success",
      "label": "Success message",
      "default": "Shukriya. Your first letter is on its way."
    },
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "text",
      "id": "brand_tag_1",
