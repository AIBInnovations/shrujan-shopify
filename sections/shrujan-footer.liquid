        {
          "value": "stacked",
          "label": "Stacked"
        }
      ]
    },
    {
      "type": "text",
      "id": "nl_eyebrow",
      "label": "Eyebrow",
      "default": "Letters from the Loom"
    },
    {
      "type": "inline_richtext",
      "id": "nl_title",
      "label": "Title",
      "default": "Stay close to the craft"
