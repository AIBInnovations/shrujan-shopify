{%- render 'section-design', section: section -%}
{%- comment -%}
  Password page — the storefront while it is still closed.

  Both forms are the real thing: `storefront_password` opens the store, and the
  `customer` form puts an email on the list so the wait is worth something.
  Wrong-password wording comes from Shopify itself, through the shared error
  snippet, so it stays correct in every language the shop sells in.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
-%}
<section class="container store-gate">
  <div class="store-gate__inner" data-reveal>
    {%- if cfg.show_logo %}
    <img class="store-gate__mark" src="{% if cfg.logo %}{{ cfg.logo | image_url: width: 600 }}{% else %}{{ 'logo-wordmark.png' | asset_url }}{% endif %}" alt="{{ shop.name | escape }}">
    {%- endif %}

    {%- if cfg.eyebrow != blank %}
    <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
    {%- endif %}
    <h1 class="store-gate__title">{{ cfg.heading }}</h1>
    {%- if cfg.copy != blank %}
    <p class="store-gate__copy">{{ cfg.copy }}</p>
    {%- endif %}

    {%- if cfg.show_shop_message and shop.password_message != blank %}
    <div class="store-gate__copy">{{ shop.password_message }}</div>
    {%- endif %}

    {%- form 'storefront_password' %}
      {%- render 'store-form-errors', form: form -%}
      <div class="store-form store-form--center">
        <label class="sr-only" for="StorefrontPassword">{{ cfg.password_label }}</label>
        <div class="store-form__row">
          <input type="password" id="StorefrontPassword" name="password" placeholder="{{ cfg.password_placeholder | escape }}" autocomplete="current-password" required>
          <button type="submit" class="store-btn">{{ cfg.password_button }}</button>
        </div>
      </div>
    {%- endform %}

    {%- if cfg.show_newsletter %}
    <div class="store-panel">
      <p class="store-panel__title">{{ cfg.nl_title }}</p>
      {%- if cfg.nl_copy != blank %}
      <p class="store-panel__copy">{{ cfg.nl_copy }}</p>
      {%- endif %}
      {%- form 'customer' %}
        {%- render 'store-form-errors', form: form -%}
        {%- if form.posted_successfully? %}
        <p class="store-success">{{ cfg.nl_success }}</p>
        {%- else %}
        <div class="store-form store-form--wide">
          <input type="hidden" name="contact[tags]" value="newsletter, opening-soon">
          <label class="sr-only" for="PasswordNewsletter">{{ cfg.nl_placeholder }}</label>
          <div class="store-form__row">
            <input type="email" id="PasswordNewsletter" name="contact[email]" value="{{ form.email }}" placeholder="{{ cfg.nl_placeholder | escape }}" autocomplete="email" required>
            <button type="submit" class="store-btn">{{ cfg.nl_button }}</button>
          </div>
        </div>
        {%- endif %}
      {%- endform %}
    </div>
    {%- endif %}

    <p class="store-note">{{ cfg.admin_note }} <a href="/admin">{{ cfg.admin_label }}</a></p>
  </div>
</section>
{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "header",
      "content": "Wordmark"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show the wordmark",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Wordmark image",
      "info": "Falls back to the theme’s Shrujan wordmark."
    },
    {
      "type": "header",
      "content": "Message"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Opening soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Wrap a word in <em> to set it in italic gerua.",
      "default": "Something is being <em>stitched</em>"
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Copy",
      "default": "Five decades of Kutchi hand embroidery are being readied for the web. Leave your email and we will write the day the doors open."
    },
    {
      "type": "checkbox",
      "id": "show_shop_message",
      "label": "Show the message set in Shopify admin",
      "default": false,
      "info": "Online Store → Preferences → Password page."
    },
    {
      "type": "header",
      "content": "Password form"
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password field label",
      "info": "Read out by screen readers.",
      "default": "Store password"
    },
    {
      "type": "text",
      "id": "password_placeholder",
      "label": "Password placeholder",
      "default": "Enter password"
    },
    {
      "type": "text",
      "id": "password_button",
      "label": "Password button",
      "default": "Enter"
    },
    {
      "type": "header",
      "content": "Sign-up"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show the sign-up",
      "default": true
    },
    {
      "type": "text",
      "id": "nl_title",
      "label": "Sign-up heading",
      "default": "Be told first"
    },
    {
      "type": "textarea",
      "id": "nl_copy",
      "label": "Sign-up copy",
      "default": "One letter when we open, and a few a year after that."
    },
    {
      "type": "text",
      "id": "nl_placeholder",
      "label": "Email placeholder",
      "default": "Your email address"
    },
    {
      "type": "text",
      "id": "nl_button",
      "label": "Sign-up button",
      "default": "Notify me"
    },
    {
      "type": "textarea",
      "id": "nl_success",
      "label": "Sign-up confirmation",
      "default": "Thank you — you are on the list. Watch your inbox."
    },
    {
      "type": "header",
      "content": "Store owner"
    },
    {
      "type": "text",
      "id": "admin_note",
      "label": "Owner note",
      "default": "Are you the store owner?"
    },
    {
      "type": "text",
      "id": "admin_label",
      "label": "Owner link label",
      "default": "Log in here"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    }
  ]
}
{% endschema %}
