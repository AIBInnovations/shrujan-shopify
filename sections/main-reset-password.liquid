{%- render 'section-design', section: section -%}
{%- comment -%}
  Reset password — reached from the link the recover form on the login page
  sends out. The `reset_customer_password` form tag carries the token in the
  URL, so the page only has to take the new password twice.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
-%}
<header class="store-head container" data-reveal>
  {%- if cfg.eyebrow != blank %}
  <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
  {%- endif %}
  <h1 class="store-head__title">{{ cfg.heading }}</h1>
  {%- if cfg.lede != blank %}
  <p class="store-head__lede">{{ cfg.lede }}</p>
  {%- endif %}
</header>

<div class="container" data-reveal>
  {%- form 'reset_customer_password' %}
    {%- render 'store-form-errors', form: form -%}
    <div class="store-form">
      <div class="store-field">
        <label for="ResetPassword">{{ cfg.password_label }}</label>
        <input type="password" id="ResetPassword" name="customer[password]" autocomplete="new-password" required>
      </div>
      <div class="store-field">
        <label for="ResetPasswordConfirm">{{ cfg.confirm_label }}</label>
        <input type="password" id="ResetPasswordConfirm" name="customer[password_confirmation]" autocomplete="new-password" required>
      </div>
      <button type="submit" class="store-btn">{{ cfg.submit_label }}</button>
    </div>
  {%- endform %}
</div>
{% schema %}
{
  "name": "Reset password",
  "settings": [
    {
      "type": "header",
      "content": "Masthead"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your account"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Set a new password"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction",
      "default": "Type it twice and you are back in. The link you followed works once, so finish here."
    },
    {
      "type": "header",
      "content": "Form"
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password label",
      "default": "New password"
    },
    {
      "type": "text",
      "id": "confirm_label",
      "label": "Confirm password label",
      "default": "Confirm new password"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "Save password"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "header",
      "content": "Design — mobile"
    },
    {
      "type": "select",
      "id": "sec_width_m",
      "label": "Section width on mobile",
      "info": "Only below 768px. Edge-to-edge removes the side gutter entirely.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow (wider gutters)"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "edge",
          "label": "Edge to edge"
        }
      ]
    },
    {
      "type": "select",
      "id": "sec_align_m",
      "label": "Text alignment on mobile",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Leave as designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "sec_custom_css_m",
      "label": "Custom CSS (mobile only)",
      "info": "Wrapped in a max-width: 767px media query for this section."
    }
  ]
}
{% endschema %}
