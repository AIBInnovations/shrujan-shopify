    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    }
  ],
  "blocks": [
    {
      "type": "assurance",
      "name": "Reassurance line",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free alterations and repairs, for as long as you own the piece."
        }
      ]
    }
  ]
}
{% endschema %}
