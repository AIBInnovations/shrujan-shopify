      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
