      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "header",
      "content": "Design — mobile"
    },
    {
      "type": "select",
      "id": "sec_width_m",
      "label": "Section width on mobile",
      "info": "Only below 768px. Edge-to-edge removes the side gutter entirely.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow (wider gutters)"
        },
        {
          "value": "full",
          "label": "Full width"
        },
        {
          "value": "edge",
          "label": "Edge to edge"
        }
      ]
    },
    {
      "type": "select",
      "id": "sec_align_m",
      "label": "Text alignment on mobile",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Leave as designed"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "textarea",
      "id": "sec_custom_css_m",
      "label": "Custom CSS (mobile only)",
      "info": "Wrapped in a max-width: 767px media query for this section."
    }
  ],
  "blocks": [
    {
      "type": "craft",
      "name": "Craft",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Craft name",
          "default": "Embroidery"
        },
        {
          "type": "text",
          "id": "short",
          "label": "Index label (short name)",
          "default": "Embroidery"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Eyebrow tag",
          "default": "Needle &amp; thread"
        },
        {
          "type": "text",
          "id": "video",
          "label": "Film asset filename",
          "info": "An .mp4 file uploaded to the theme assets.",
          "default": "craft-embroidery.mp4"
        },
        {
          "type": "text",
          "id": "poster",
          "label": "Poster asset filename",
          "info": "The still shown before the film plays.",
          "default": "craft-embroidery-poster.webp"
        },
        {
          "type": "text",
          "id": "f1_label",
          "label": "Fact 1 label",
          "default": "Practice"
        },
        {
          "type": "text",
          "id": "f1_value",
          "label": "Fact 1 value",
          "default": "Hand embroidery"
        },
        {
          "type": "text",
          "id": "f2_label",
          "label": "Fact 2 label",
          "default": "Made in"
        },
        {
          "type": "text",
          "id": "f2_value",
          "label": "Fact 2 value",
          "default": "Villages across Kutch"
        },
        {
          "type": "text",
          "id": "f3_label",
          "label": "Fact 3 label",
          "default": "Turning point"
        },
        {
          "type": "text",
          "id": "f3_value",
          "label": "Fact 3 value",
          "default": "The late 1960s"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Opening paragraphs (one per line)",
          "default": "Kutch has about forty-six thousand square kilometres of land. The astonishing diversity of crafts found in this relatively small region is perhaps unmatched anywhere in the world. Kutch has a vibrant crafts tradition that has been enriched over the centuries by the communities that have migrated to this region.\nHand embroidery is among the most famous crafts of Kutch. What makes this craft special is its sheer abundance and variety — which is why we speak of the 'embroideries' of Kutch, in the plural. Traditionally embroidery was a personal craft. Women used to decorate day-to-day as well as ceremonial clothing, household items and adornments for animals. Each community had its own distinct embroidery style that was passed on from mother to daughter."
        },
        {
          "type": "textarea",
          "id": "more",
          "label": "Read-more paragraphs (one per line)",
          "info": "Folded behind the Read more button. Leave empty to hide the button.",
          "default": "It was in the late 1960s that a fundamental shift took place in the role of embroidery. In addition to being practised as a personal craft, it also became, for the first time, a means of livelihood for women. Shrujan has been instrumental in this transformation. It has created a market for embroidered products and has provided the embroiderers with a platform to showcase their work and earn a sustainable income."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craft Traditions page",
      "blocks": [
        {
          "type": "craft",
          "settings": {
            "name": "Embroidery",
            "short": "Embroidery",
            "tag": "Needle &amp; thread",
            "video": "craft-embroidery.mp4",
            "poster": "craft-embroidery-poster.webp",
            "f1_label": "Practice",
            "f1_value": "Hand embroidery",
            "f2_label": "Made in",
            "f2_value": "Villages across Kutch",
            "f3_label": "Turning point",
            "f3_value": "The late 1960s",
            "body": "Kutch has about forty-six thousand square kilometres of land. The astonishing diversity of crafts found in this relatively small region is perhaps unmatched anywhere in the world. Kutch has a vibrant crafts tradition that has been enriched over the centuries by the communities that have migrated to this region.\nHand embroidery is among the most famous crafts of Kutch. What makes this craft special is its sheer abundance and variety — which is why we speak of the 'embroideries' of Kutch, in the plural. Traditionally embroidery was a personal craft. Women used to decorate day-to-day as well as ceremonial clothing, household items and adornments for animals. Each community had its own distinct embroidery style that was passed on from mother to daughter.",
            "more": "It was in the late 1960s that a fundamental shift took place in the role of embroidery. In addition to being practised as a personal craft, it also became, for the first time, a means of livelihood for women. Shrujan has been instrumental in this transformation. It has created a market for embroidered products and has provided the embroiderers with a platform to showcase their work and earn a sustainable income."
          }
        },
        {
