{%- render 'section-design', section: section -%}
{%- comment -%}
  Layout override for the sticky-player control. Nothing is emitted while the
  control sits at its default, so the page ships exactly as it was hand-built.
{%- endcomment -%}
{%- if section.settings.films_sticky == false -%}
  <style>
    {%- assign sel = '#shopify-section-' | append: section.id -%}
    {{ sel }} .craft-atlas__media { position: static; }
    {%- comment -%}
      Below 900px the stylesheet gives the pinned player a full-bleed ivory
      backdrop so body copy cannot show through it; unpinned it has nothing to
      cover, so the chrome comes off with the stickiness.
    {%- endcomment -%}
    @media (max-width: 900px) {
      {{ sel }} .craft-atlas__media {
        padding: 0;
        background: none;
        box-shadow: none;
        clip-path: none;
      }
    }
  </style>
{%- endif -%}
{%- capture nl %}
{% endcapture -%}
{%- assign first_craft = section.blocks.first -%}
<div class="page">
  <header class="page-hero page-hero--cover page-hero--frame" data-reveal>
    <div class="page-hero__bg" aria-hidden="true">
      <img src="{% if section.settings.hero_img %}{{ section.settings.hero_img | image_url: width: 2000 }}{% else %}{{ 'craft-hero.webp' | asset_url }}{% endif %}" alt="" fetchpriority="high">
      <span class="page-hero__scrim"></span>
    </div>

    <div class="container page-hero__grid">
      <div class="page-hero__text">
        <p class="eyebrow">{{ section.settings.hero_eyebrow }}</p>
        <h1 class="page-hero__title">{{ section.settings.hero_title }}</h1>
      </div>
    </div>

    <span class="page-hero__rule" aria-hidden="true"></span>
  </header>

  {%- if section.settings.show_intro %}
  <section class="section container craft-open" data-reveal>
    <p class="craft-open__lead">{{ section.settings.open_lead }}</p>
    <div class="craft-open__copy">
      {%- assign open_paras = section.settings.open_copy | strip | split: nl -%}
      {%- for para in open_paras %}
      <p>{{ para | strip }}</p>
      {%- endfor %}
    </div>
  </section>
  {%- endif %}

  <section class="section craft-atlas" aria-label="The crafts"{% unless section.settings.film_autoplay %} data-film-autoplay="false"{% endunless %}{% if section.settings.film_posters_only %} data-film-posters-only="true"{% endif %}>
    <div class="container craft-atlas__grid">
      <div class="craft-atlas__media">
        <div class="craft-stage">
          <video class="craft-stage__video" poster="{{ first_craft.settings.poster | asset_url }}" playsinline muted{% if section.settings.film_loop %} loop{% endif %} preload="none"{% if section.settings.film_autoplay %} tabindex="-1"{% else %} controls{% endif %}>
            {%- unless section.settings.film_posters_only %}
            <source src="{{ first_craft.settings.video | asset_url }}" type="video/mp4">
            {%- endunless %}
          </video>

          <div class="craft-stage__tag" aria-hidden="true">
            <span class="craft-stage__no">01</span>
            <span class="craft-stage__name">{{ first_craft.settings.name }}</span>
          </div>
        </div>

        <ol class="craft-index">
{%- for block in section.blocks %}
          <li>
            <button type="button" class="craft-index__pick{% if forloop.first %} is-active{% endif %}"{% if forloop.first %} aria-current="true"{% endif %}>
              <span class="craft-index__no">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <span class="craft-index__name">{{ block.settings.short }}</span>
            </button>
          </li>
{%- endfor %}
        </ol>

        <p class="craft-credit">{{ section.settings.credit }}</p>
      </div>

      <div class="craft-atlas__text">
{%- for block in section.blocks %}
{% unless forloop.first %}
{% endunless %}        <article id="{{ block.id }}" class="craft-entry{% if forloop.first %} is-active{% endif %}" {{ block.shopify_attributes }}>
          <p class="craft-entry__eyebrow"><span aria-hidden="true">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span> {{ block.settings.tag }}</p>
          <h2 class="craft-entry__title">{{ block.settings.name }}</h2>

          <dl class="craft-facts">
            <div>
              <dt>{{ block.settings.f1_label }}</dt>
              <dd>{{ block.settings.f1_value }}</dd>
            </div>
            <div>
              <dt>{{ block.settings.f2_label }}</dt>
              <dd>{{ block.settings.f2_value }}</dd>
            </div>
            <div>
              <dt>{{ block.settings.f3_label }}</dt>
              <dd>{{ block.settings.f3_value }}</dd>
            </div>
          </dl>

          <div class="craft-entry__body" id="{{ block.id }}-body">
            {%- assign body_paras = block.settings.body | strip | split: nl -%}
            {%- for para in body_paras %}
            <p>{{ para | strip }}</p>
            {%- endfor %}
          </div>
          {%- assign more_clean = block.settings.more | strip -%}
          {%- if more_clean != blank and section.settings.craft_read_more %}

          <button type="button" class="craft-entry__more arrow-link" aria-expanded="false" aria-controls="{{ block.id }}-body">Read more · {{ more_clean | split: nl | size }} more</button>
          {%- endif %}
        </article>
{%- endfor %}
      </div>
    </div>
  </section>

  {%- if section.settings.show_cta %}
  <section class="section container page-cta" data-reveal>
    <p>{{ section.settings.cta_text }}</p>
    <a class="btn" href="{{ section.settings.cta_url | default: '/pages/shop-shrujan' }}">{{ section.settings.cta_label }} <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></a>
  </section>
  {%- endif %}
</div>

<script type="application/json" data-craft-atlas-data>
  {
    "crafts": [
      {%- for block in section.blocks %}
      { "no": "{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}", "name": {{ block.settings.name | json }}, "src": {{ block.settings.video | prepend: '/' | json }}, "poster": {{ block.settings.poster | prepend: '/' | json }} }{% unless forloop.last %},{% endunless %}
      {%- endfor %}
    ],
    "more": {
      {%- assign more_printed = false -%}
      {%- for block in section.blocks -%}
      {%- assign more_clean = block.settings.more | strip -%}
      {%- if more_clean != blank %}
      {% if more_printed %},{% endif %}{{ block.id | json }}: [
        {%- assign more_lines = more_clean | split: nl -%}
        {%- for line in more_lines %}
        {{ line | strip | json }}{% unless forloop.last %},{% endunless %}
        {%- endfor %}
      ]
      {%- assign more_printed = true -%}
      {%- endif -%}
      {%- endfor %}
    }
  }
</script>

<script>
(function () {
  var root = document.querySelector('.craft-atlas');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var STICKY_TOP = 96; // clears the fixed header at its tallest

  // Behaviour flags carried on the section root. An absent attribute means the
  // hand-built default, so today's behaviour stands untouched.
  var AUTOPLAY = root.getAttribute('data-film-autoplay') !== 'false';
  var POSTERS_ONLY = root.getAttribute('data-film-posters-only') === 'true';

  // CRAFTS and MORE are built from the section's craft blocks, serialized
  // into the JSON data tag rendered just above this script.
  var DATA = JSON.parse(document.querySelector('[data-craft-atlas-data]').textContent);
  var CRAFTS = DATA.crafts;
  var MORE = DATA.more;

  var video = root.querySelector('.craft-stage__video');
  // absent in posters-only mode, where no film is ever put in the document
  var source = video.querySelector('source');
  var tagNo = root.querySelector('.craft-stage__no');
  var tagName = root.querySelector('.craft-stage__name');
  var picks = Array.prototype.slice.call(root.querySelectorAll('.craft-index__pick'));
  var articles = Array.prototype.slice.call(root.querySelectorAll('.craft-entry'));

  var active = 0;
  var open = null; // slug whose full text is expanded
  // The films run to ~10MB each. Nothing plays — and so nothing downloads
  // beyond its poster — until the player has actually reached the viewport.
  var armed = false;

  // Swapping the <source> alone will not restart playback; the element has to
  // be told to reload before it will pick the new file up. An unmuted <video>
  // is refused autoplay outright — set the property, not just the attribute.
  function playVideo() {
    if (!video || !armed) return;
    video.muted = true;
    video.load();
    var p = video.play();
    if (p && p.catch) p.catch(function () {});
  }

  function setActive(i) {
    if (i === active) return;
    active = i;
    var c = CRAFTS[i];
    video.setAttribute('poster', SHRUJAN.asset(c.poster));
    if (source) source.setAttribute('src', SHRUJAN.asset(c.src));
    tagNo.textContent = c.no;
    tagName.textContent = c.name;
    picks.forEach(function (btn, j) {
      btn.classList.toggle('is-active', j === i);
      if (j === i) btn.setAttribute('aria-current', 'true');
      else btn.removeAttribute('aria-current');
    });
    articles.forEach(function (el, j) {
      el.classList.toggle('is-active', j === i);
    });
    playVideo();
  }

  function renderEntry(slug) {
    var body = root.querySelector('#' + slug + '-body');
    var btn = root.querySelector('[aria-controls="' + slug + '-body"]');
    if (!body || !btn) return;
    var isOpen = open === slug;
    var extra = MORE[slug] || [];
    if (isOpen) {
      for (var k = 0; k < extra.length; k++) {
        var p = document.createElement('p');
        p.textContent = extra[k];
        body.appendChild(p);
      }
    } else {
      while (body.children.length > 2) body.removeChild(body.lastElementChild);
    }
    btn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
    btn.textContent = isOpen ? 'Read less' : 'Read more · ' + extra.length + ' more';
  }

  // Expanding an entry changes every article boundary below it, and the
  // triggers were measured against the old ones.
  function setOpen(slug) {
    if (slug === open) return;
    var prev = open;
    open = slug;
    if (prev) renderEntry(prev);
    if (slug) renderEntry(slug);
    ScrollTrigger.refresh();
  }

  // The index chips scroll the matching article to just under the player.
  function goTo(i) {
    var el = articles[i];
    if (!el) return;
    setActive(i);
    Shrujan.scrollToY(el.getBoundingClientRect().top + window.scrollY - STICKY_TOP - 40);
  }

  picks.forEach(function (btn, i) {
    btn.addEventListener('click', function () { goTo(i); });
  });

  Array.prototype.forEach.call(root.querySelectorAll('.craft-entry__more'), function (btn) {
    var slug = btn.getAttribute('aria-controls').replace(/-body$/, '');
    btn.addEventListener('click', function () {
      setOpen(open === slug ? null : slug);
    });
  });

  // Deliberately outside matchMedia: these triggers animate nothing, they only
  // report which craft owns the viewport. Skipping them for reduced-motion
  // visitors would leave the player stuck on craft 01 while they read craft 05.
  articles.forEach(function (el, i) {
    ScrollTrigger.create({
      trigger: el,
      // onToggle rather than onEnter/onEnterBack, so scrolling up reports
      // the same boundaries scrolling down did
      start: 'top ' + (STICKY_TOP + 180) + 'px',
      end: 'bottom ' + (STICKY_TOP + 180) + 'px',
      onToggle: function (self) { if (self.isActive) setActive(i); }
    });
  });

  // Never armed when autoplay is off or the films are held back to posters, so
  // playVideo's `armed` guard keeps every byte of film off the wire.
  if (AUTOPLAY && !POSTERS_ONLY) {
    ScrollTrigger.create({
      trigger: '.craft-atlas',
      start: 'top 70%',
      once: true,
      onEnter: function () {
        armed = true;
        playVideo();
      }
    });
  }

  ScrollTrigger.refresh();
})();
</script>

{% schema %}
{
  "name": "Craft Traditions page",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_img",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Craft Traditions of Kutch"
    },
    {
      "type": "inline_richtext",
      "id": "hero_title",
      "label": "Title",
      "default": "Six living crafts, <em>one desert</em>"
    },
    {
      "type": "header",
      "content": "Introduction"
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Show the introduction",
      "info": "The lead line and paragraphs between the hero and the films.",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "open_lead",
      "label": "Lead line",
      "default": "Each craft carries its own materials, techniques and <em>cultural memory</em>."
    },
    {
      "type": "textarea",
      "id": "open_copy",
      "label": "Paragraphs (one per line)",
      "default": "Kutch is home to a remarkable range of craft practices shaped by landscape, community and generations of knowledge. From textiles and natural dyes to pottery, weaving, metal and more, each craft carries its own materials, techniques and cultural memory.\nShrujan works closely with many of these traditions, learning from artisans and supporting processes that allow their knowledge to remain alive and relevant. What you see here is not a catalogue, but an introduction to living practices — each with its own story, skill and sense of place."
    },
    {
      "type": "header",
      "content": "Films"
    },
    {
      "type": "checkbox",
      "id": "film_autoplay",
      "label": "Play the film when it scrolls into view",
      "info": "Off, the player shows the still and gains the browser's own controls so a visitor can start it themselves.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "film_loop",
      "label": "Loop the film",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "film_posters_only",
      "label": "Posters only — never load the films",
      "info": "Keeps each craft's still and leaves the films (about 10 MB each) out of the page entirely.",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "films_sticky",
      "label": "Pin the player beside the text",
      "info": "On, the player and craft index follow the reader down the entry they belong to.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "craft_read_more",
      "label": "Show the Read more expansion",
      "info": "Off, each entry keeps only its opening paragraphs and the button is dropped.",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "credit",
      "label": "Films credit line",
      "default": "Films from the <a href=\"/pages/lldc\">Living &amp; Learning Design Centre</a>, Bhuj"
    },
    {
      "type": "header",
      "content": "Closing call to action"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show the closing call to action",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Line",
      "default": "See these crafts on the cloth itself."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop by craft"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
