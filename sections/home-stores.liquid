{%- render 'section-design', section: section -%}
{%- comment -%}
  The stores on the home page: the way to the Find Us page, which has the
  addresses, numbers and maps (the user, 2026-11-01). A length of red cloth
  hemmed with a running stitch, one thread sewn across it through the stores,
  each a cross-stitch that opens that store on Find Us (its card's id is the
  store's name, handleized). Written by awwwards-preview/stores_section.py,
  which also draws the preview. Styles in sj-site.css (src/site.css, .st), the
  sewing in sj-home.js (src/rest.js).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign link = s.cta_link | default: '/pages/find-us'
  assign list = 'Bhujodi|The campus~LLDC Museum|Ajrakhpur~Bhuj Airport|Kutch~Ahmedabad|Navrangpura~Mumbai|Jogeshwari~Delhi|Vasant Kunj'
  if section.blocks.size > 0
    assign list = ''
    for b in section.blocks
      assign list = list | append: b.settings.name | append: '|' | append: b.settings.place | append: '~'
    endfor
  endif
  assign stops = list | split: '~'
-%}
<section class="st" id="stores" aria-labelledby="st-title-{{ section.id }}">
  <div class="st__head">
    <div class="st__words">
      {%- if s.eyebrow != blank %}<p class="st__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
      <h2 class="st__title" id="st-title-{{ section.id }}"><span>{{ s.title_1 | escape }}</span>{% if s.title_2 != blank %}<em>{{ s.title_2 | escape }}</em>{% endif %}</h2>
      {%- if s.lede != blank %}<p class="st__lede">{{ s.lede | escape }}</p>{% endif -%}
    </div>
    {%- if s.cta_label != blank %}<a class="st__cta" href="{{ link | escape }}">{{ s.cta_label | escape }} <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a>{% endif -%}
  </div>
  <ol class="st__route">
    {%- for d in stops -%}
      {%- assign f = d | split: '|' -%}
      <li class="st__stop" style="--i:{{ forloop.index0 }}"><svg class="st__thread" viewBox="0 0 200 64" preserveAspectRatio="none" aria-hidden="true"><path d="M0 32C36 32 44 56 100 56S164 32 200 32"/></svg><a class="st__link" href="{{ link | escape }}#{{ f[0] | handleize }}"><span class="st__x" aria-hidden="true"></span><span class="st__label"><span class="st__name">{{ f[0] | escape }}</span><span class="st__place">{{ f[1] | escape }}</span></span></a></li>
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "Home — Stores",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Visit us"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title, first line",
      "default": "Six stores,"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title, second line",
      "default": "from Bhujodi to Delhi"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Line under the title",
      "default": "See the pieces in person, at the campus in Bhujodi, the LLDC, or a Shrujan store near you."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button",
      "default": "Find a store"
    },
    {
      "type": "text",
      "id": "cta_link",
      "label": "Button link (the Find Us page)",
      "default": "/pages/find-us"
    },
    {
      "type": "paragraph",
      "content": "Add store blocks to set the stops along the thread yourself; with none, the six Shrujan stores show."
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name, as on the Find Us page"
        },
        {
          "type": "text",
          "id": "place",
          "label": "Where it is"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home — Stores"
    }
  ]
}
{% endschema %}
