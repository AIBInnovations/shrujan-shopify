{%- render 'section-design', section: section -%}
{%- comment -%}
  Shrujan stores on the home page (the user): each store with its address,
  numbers and directions; the same details as the product page's stores.
  Written by awwwards-preview/stores_section.py, which also draws the
  preview. Styles in sj-site.css (src/site.css, .st).
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign stores = 'Bhujodi|Behind G.E.B Sub Station, Bhujodi, Bhuj, Kutch 370020|+91 2832 240272|+91 90999 74395~LLDC Museum|Living and Learning Design Centre, 705, Bhuj–Bhachau Road, Ajrakhpur, Bhuj, Kutch 370105|+91 2832 229090|+91 90818 99886~Ahmedabad|Shop No. 1, Gala Business Centre 1, opp. Wagh Bakri Tea Lounge, near St. Xavier’s College Road, Navrangpura, Ahmedabad 380009||+91 72279 82099~Mumbai|C.T.C 217/A Wing, 1st Floor, Flexcel Park, S.V. Road, near 24 Karat Multiplex, Jogeshwari (W), Mumbai 400102|+91 22 6215 7598|+91 98337 66584~Bhuj Airport|Bhuj Airport, Civil Enclave, Bhuj, Kutch 370001||+91 99784 18952~Delhi|C.C.I.C. International Craft Complex, Plot No. 8, Nelson Mandela Marg, Vasant Kunj, New Delhi 110070||+91 88665 83477' | split: '~'
-%}
<section class="st" id="stores" aria-labelledby="st-title-{{ section.id }}">
  <div class="st__head">
    {%- if s.eyebrow != blank %}<p class="st__eyebrow">{{ s.eyebrow | escape }}</p>{% endif -%}
    <h2 class="st__title" id="st-title-{{ section.id }}"><span>{{ s.title_1 | escape }}</span>{% if s.title_2 != blank %}<em>{{ s.title_2 | escape }}</em>{% endif %}</h2>
    {%- if s.lede != blank %}<p class="st__lede">{{ s.lede | escape }}</p>{% endif -%}
  </div>
  <ul class="st__grid">
    {%- if section.blocks.size > 0 -%}
      {%- for b in section.blocks -%}
        {%- liquid
          assign s_n = b.settings.name
          assign s_a = b.settings.address
          assign s_t = b.settings.tel
          assign s_m = b.settings.mobile
        -%}
        <li class="st__card" {{ b.shopify_attributes }}><span class="st__pin"><i class="sj-i sj-i--map-pin ms" aria-hidden="true"></i></span><h3 class="st__name">{{ s_n | escape }}</h3><p class="st__addr">{{ s_a | escape }}</p><p class="st__tel">{% if s_t != blank %}<a href="tel:{{ s_t | remove: ' ' }}">{{ s_t }}</a>{% endif %}{% if s_m != blank %}<a href="tel:{{ s_m | remove: ' ' }}">{{ s_m }}</a>{% endif %}</p><a class="st__go" href="https://www.google.com/maps/search/?api=1&query={{ 'Shrujan ' | append: s_a | url_encode }}" target="_blank" rel="noopener">Directions <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a></li>
      {%- endfor -%}
    {%- else -%}
      {%- for d in stores -%}
        {%- assign f = d | split: '|' -%}
        {%- liquid
          assign s_n = f[0]
          assign s_a = f[1]
          assign s_t = f[2]
          assign s_m = f[3]
        -%}
        <li class="st__card"><span class="st__pin"><i class="sj-i sj-i--map-pin ms" aria-hidden="true"></i></span><h3 class="st__name">{{ s_n | escape }}</h3><p class="st__addr">{{ s_a | escape }}</p><p class="st__tel">{% if s_t != blank %}<a href="tel:{{ s_t | remove: ' ' }}">{{ s_t }}</a>{% endif %}{% if s_m != blank %}<a href="tel:{{ s_m | remove: ' ' }}">{{ s_m }}</a>{% endif %}</p><a class="st__go" href="https://www.google.com/maps/search/?api=1&query={{ 'Shrujan ' | append: s_a | url_encode }}" target="_blank" rel="noopener">Directions <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i></a></li>
      {%- endfor -%}
    {%- endif -%}
  </ul>
</section>

{% schema %}
{
  "name": "Home — Stores",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Visit us"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Title, first line",
      "default": "Shrujan"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Title, second line (in red)",
      "default": "stores"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Line under the title",
      "default": "See the pieces in person, at the campus in Bhujodi, the LLDC, or a Shrujan store near you."
    },
    {
      "type": "paragraph",
      "content": "Add a store block to list stores yourself; with none, the six Shrujan stores show."
    }
  ],
  "blocks": [
    {
      "type": "store",
      "name": "Store",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "textarea",
          "id": "address",
          "label": "Address"
        },
        {
          "type": "text",
          "id": "tel",
          "label": "Landline"
        },
        {
          "type": "text",
          "id": "mobile",
          "label": "Mobile"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home — Stores"
    }
  ]
}
{% endschema %}
