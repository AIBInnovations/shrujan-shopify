{%- render 'section-design', section: section -%}
{%- comment -%}
  Customer login. Two real Shopify forms on one page:

    customer_login              — signs the customer in
    recover_customer_password   — mails a reset link

  Both are shown at once rather than toggled, so there is nothing to click
  before you can type and nothing that breaks without JavaScript. Shopify
  redirects a successful recovery back here, where the second form reports it.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
-%}
<header class="store-head container" data-reveal>
  {%- if cfg.eyebrow != blank %}
  <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
  {%- endif %}
  <h1 class="store-head__title">{{ cfg.heading }}</h1>
  {%- if cfg.lede != blank %}
  <p class="store-head__lede">{{ cfg.lede }}</p>
  {%- endif %}
</header>

<div class="container store-duo" data-reveal>
  <div>
    {%- form 'customer_login' %}
      {%- render 'store-form-errors', form: form -%}
      <div class="store-form store-form--wide">
        <div class="store-field">
          <label for="LoginEmail">{{ cfg.email_label }}</label>
          <input type="email" id="LoginEmail" name="customer[email]" autocomplete="email" autocapitalize="off" spellcheck="false" required>
        </div>
        <div class="store-field">
          <label for="LoginPassword">{{ cfg.password_label }}</label>
          <input type="password" id="LoginPassword" name="customer[password]" autocomplete="current-password" required>
        </div>
        <button type="submit" class="store-btn">{{ cfg.submit_label }}</button>
      </div>
    {%- endform %}
  </div>

  <div class="store-stack">
    {%- if cfg.show_register %}
    <div class="store-panel">
      <p class="store-panel__title">{{ cfg.register_title }}</p>
      <p class="store-panel__copy">{{ cfg.register_copy }}</p>
      <div class="store-address__actions">
        <a class="store-btn store-btn--quiet" href="{{ routes.account_register_url }}">{{ cfg.register_label }}</a>
      </div>
    </div>
    {%- endif %}

    {%- if cfg.show_recover %}
    <div class="store-panel" id="recover">
      <p class="store-panel__title">{{ cfg.recover_title }}</p>
      <p class="store-panel__copy">{{ cfg.recover_copy }}</p>
      {%- form 'recover_customer_password' %}
        {%- render 'store-form-errors', form: form -%}
        {%- if form.posted_successfully? %}
        <p class="store-success">{{ cfg.recover_success }}</p>
        {%- else %}
        <div class="store-form store-form--wide">
          <div class="store-field">
            <label for="RecoverEmail">{{ cfg.recover_email_label }}</label>
            <input type="email" id="RecoverEmail" name="email" autocomplete="email" autocapitalize="off" spellcheck="false" required>
          </div>
          <button type="submit" class="store-btn store-btn--quiet">{{ cfg.recover_submit_label }}</button>
        </div>
        {%- endif %}
      {%- endform %}
    </div>
    {%- endif %}
  </div>
</div>
{% schema %}
{
  "name": "Login",
  "settings": [
    {
      "type": "header",
      "content": "Masthead"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Your account"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Welcome back"
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Introduction",
      "default": "Sign in to follow an order, keep your addresses, and look back at everything you have collected."
    },
    {
      "type": "header",
      "content": "Sign in"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "password_label",
      "label": "Password label",
      "default": "Password"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Sign-in button",
      "default": "Sign in"
    },
    {
      "type": "header",
      "content": "New customers"
    },
    {
      "type": "checkbox",
      "id": "show_register",
      "label": "Show the create-account panel",
      "default": true
    },
    {
      "type": "text",
      "id": "register_title",
      "label": "Panel heading",
      "default": "New to Shrujan?"
    },
    {
      "type": "textarea",
      "id": "register_copy",
      "label": "Panel copy",
      "default": "An account keeps your measurements, addresses and order history in one place. It takes a minute."
    },
    {
      "type": "text",
      "id": "register_label",
      "label": "Panel button",
      "default": "Create an account"
    },
    {
      "type": "header",
      "content": "Forgotten password"
    },
    {
      "type": "checkbox",
      "id": "show_recover",
      "label": "Show the reset panel",
      "default": true
    },
    {
      "type": "text",
      "id": "recover_title",
      "label": "Panel heading",
      "default": "Forgotten your password?"
    },
    {
      "type": "textarea",
      "id": "recover_copy",
      "label": "Panel copy",
      "default": "Give us the email you signed up with and we will send a link to set a new one."
    },
    {
      "type": "text",
      "id": "recover_email_label",
      "label": "Email label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "recover_submit_label",
      "label": "Reset button",
      "default": "Email me a link"
    },
    {
      "type": "textarea",
      "id": "recover_success",
      "label": "Reset confirmation",
      "default": "Check your inbox — if that email is on file, a reset link is on its way."
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "select",
      "id": "sec_width",
      "label": "Section width",
      "info": "Theme default keeps the shared page rail.",
      "default": "default",
      "options": [
        {
          "value": "default",
          "label": "Theme default"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ]
    },
    {
      "type": "range",
      "id": "sec_space_top",
      "label": "Extra top spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom",
      "label": "Extra bottom spacing",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_top_m",
      "label": "Extra top spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "sec_space_bottom_m",
      "label": "Extra bottom spacing (mobile)",
      "min": -120,
      "max": 240,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "sec_bg",
      "label": "Background",
      "info": "Leave empty to keep the section’s own background."
    },
    {
      "type": "color",
      "id": "sec_text",
      "label": "Text colour"
    },
    {
      "type": "color",
      "id": "sec_accent",
      "label": "Accent colour"
    },
    {
      "type": "checkbox",
      "id": "sec_animate",
      "label": "Animate on scroll",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "sec_hide_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "sec_hide_desktop",
      "label": "Hide on desktop",
      "default": false
    },
    {
      "type": "textarea",
      "id": "sec_custom_css",
      "label": "Custom CSS",
      "info": "Applies to this section only, e.g. .hero__title { letter-spacing: 2px; }"
    }
  ]
}
{% endschema %}
