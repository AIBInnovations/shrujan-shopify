{%- render 'section-design', section: section -%}
{%- comment -%}
  Article — the editorial page the journal cards lead into.

  Everything below the prose (share row, next/previous, comments) sits on the
  same 78ch measure `.store-article` sets, so the column reads as one piece;
  the prose gives its page gap to that foot whenever any of it renders.
{%- endcomment -%}
{%- liquid
  assign cfg = section.settings
  assign comments_on = false
  if cfg.show_comments and blog.comments_enabled?
    assign comments_on = true
  endif
  assign has_nav = false
  if cfg.show_nav
    if blog.previous_article or blog.next_article
      assign has_nav = true
    endif
  endif
  assign has_foot = false
  if cfg.show_share or comments_on or has_nav
    assign has_foot = true
  endif
-%}

<article>
  <header class="store-head container" data-reveal>
    <a class="store-back" href="{{ blog.url }}">
      <i class="ph-light ph-arrow-left" style="font-size:15px" aria-hidden="true"></i>
      {{ cfg.back_label }}
    </a>
    {%- if cfg.eyebrow != blank %}
    <p class="store-head__eyebrow">{{ cfg.eyebrow }}</p>
    {%- endif %}
    <h1 class="store-head__title">{{ article.title }}</h1>

    {%- if cfg.show_date or cfg.show_author %}
    <p class="store-meta">
      {%- if cfg.show_date %}
      <time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: cfg.date_format }}</time>
      {%- endif %}
      {%- if cfg.show_date and cfg.show_author and article.author != blank %}<span class="store-meta__dot" aria-hidden="true">&#8226;</span>{% endif %}
      {%- if cfg.show_author and article.author != blank %}{{ cfg.author_prefix }} {{ article.author }}{% endif %}
      {%- if comments_on and article.comments_count > 0 %}<span class="store-meta__dot" aria-hidden="true">&#8226;</span><a href="#comments">{{ article.comments_count }} {{ cfg.comments_title }}</a>{% endif %}
    </p>
    {%- endif %}

    {%- if cfg.show_tags and article.tags.size > 0 %}
    <div class="store-chips">
      {%- for tag in article.tags %}
      <a class="store-chip" href="{{ blog.url }}/tagged/{{ tag | handleize }}">{{ tag }}</a>
      {%- endfor %}
    </div>
    {%- endif %}
  </header>

  {%- if cfg.show_image and article.image %}
  <div class="container" data-reveal>
    <div class="store-article__media">
      <img src="{{ article.image | image_url: width: 2000 }}" alt="{{ article.image.alt | default: article.title | escape }}" width="{{ article.image.width }}" height="{{ article.image.height }}">
    </div>
  </div>
  {%- endif %}

  <div class="container">
    <div class="store-article{% if has_foot %} store-article--tight{% endif %}" data-reveal>
      {{ article.content }}
    </div>
  </div>

  {%- if has_foot %}
  <div class="container store-article__foot">
    {%- if cfg.show_share %}
    {%- assign share_url = shop.url | append: article.url -%}
    {%- assign share_title = article.title | url_encode -%}
    <div class="store-rail store-share">
      <p class="store-share__label">{{ cfg.share_label }}</p>
      <div class="store-share__links">
        <a class="store-share__link" href="https://www.facebook.com/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noreferrer noopener" aria-label="Share on Facebook">
          <i class="ph-light ph-facebook-logo" style="font-size:16px" aria-hidden="true"></i>
        </a>
        <a class="store-share__link" href="https://www.pinterest.com/pin/create/button/?url={{ share_url | url_encode }}&amp;description={{ share_title }}" target="_blank" rel="noreferrer noopener" aria-label="Save to Pinterest">
          <i class="ph-light ph-pinterest-logo" style="font-size:16px" aria-hidden="true"></i>
        </a>
        <a class="store-share__link" href="https://api.whatsapp.com/send?text={{ share_title }}%20{{ share_url | url_encode }}" target="_blank" rel="noreferrer noopener" aria-label="Share on WhatsApp">
          <i class="ph-light ph-whatsapp-logo" style="font-size:16px" aria-hidden="true"></i>
        </a>
        <a class="store-share__link" href="mailto:?subject={{ article.title | url_encode }}&amp;body={{ share_url | url_encode }}" aria-label="Share by email">
          <i class="ph-light ph-envelope-simple" style="font-size:16px" aria-hidden="true"></i>
        </a>
      </div>
    </div>
    {%- endif %}

    {%- if has_nav %}
    <nav class="store-rail store-postnav" aria-label="{{ cfg.nav_label | escape }}">
      {%- if blog.previous_article %}
      <a class="store-postnav__item" href="{{ blog.previous_article.url }}" rel="prev">
        <p class="store-postnav__label">{{ cfg.nav_prev_label }}</p>
        <p class="store-postnav__title">{{ blog.previous_article.title }}</p>
      </a>
      {%- endif %}
      {%- if blog.next_article %}
      <a class="store-postnav__item store-postnav__item--next" href="{{ blog.next_article.url }}" rel="next">
        <p class="store-postnav__label">{{ cfg.nav_next_label }}</p>
        <p class="store-postnav__title">{{ blog.next_article.title }}</p>
      </a>
      {%- endif %}
    </nav>
    {%- endif %}

    {%- if comments_on %}
    <section class="store-rail store-comments" id="comments">
      {%- if article.comments_count > 0 %}
      <h2 class="store-comments__title">{{ cfg.comments_title }} ({{ article.comments_count }})</h2>
      <div>
        {%- for comment in article.comments %}
        <article class="store-comment" id="comment-{{ comment.id }}">
          <p class="store-comment__meta">
            <strong>{{ comment.author }}</strong>
            <span class="store-meta__dot" aria-hidden="true">&#8226;</span>
            <time datetime="{{ comment.created_at | date: '%Y-%m-%d' }}">{{ comment.created_at | date: format: cfg.date_format }}</time>
          </p>
          <div class="store-comment__body">{{ comment.content }}</div>
        </article>
        {%- endfor %}
      </div>
      {%- endif %}

      <h3 class="store-comments__title store-comments__title--form">{{ cfg.comment_form_title }}</h3>
      {%- form 'new_comment', article %}
        {%- render 'store-form-errors', form: form -%}
        {%- if form.posted_successfully? %}
        <p class="store-success">{% if blog.moderated? %}{{ cfg.comment_moderated_note }}{% else %}{{ cfg.comment_success }}{% endif %}</p>
        {%- endif %}
        <div class="store-form store-form--wide">
          <div class="store-fields">
            <div class="store-field">
              <label for="CommentAuthor">{{ cfg.comment_name_label }}</label>
              <input type="text" id="CommentAuthor" name="comment[author]" value="{{ form.author }}" autocomplete="name" required>
            </div>
            <div class="store-field">
              <label for="CommentEmail">{{ cfg.comment_email_label }}</label>
              <input type="email" id="CommentEmail" name="comment[email]" value="{{ form.email }}" autocomplete="email" required>
            </div>
          </div>
          <div class="store-field">
            <label for="CommentBody">{{ cfg.comment_body_label }}</label>
            <textarea id="CommentBody" name="comment[body]" rows="6" required>{{ form.body }}</textarea>
          </div>
          {%- if blog.moderated? %}
          <p class="store-note">{{ cfg.comment_moderated_note }}</p>
          {%- endif %}
          <button type="submit" class="store-btn">{{ cfg.comment_button }}</button>
        </div>
      {%- endform %}
    </section>
    {%- endif %}
  </div>
  {%- endif %}
</article>
{% schema %}
{
  "name": "Article",
  "settings": [
    {
      "type": "header",
