{% if page.handle == 'find-us' %}
<section class="stx fux" aria-labelledby="find-us-connect-{{ section.id }}">
  <header class="stx__head">
    <p class="stx__eyebrow">Stay in touch</p>
    <h2 class="stx__title" id="find-us-connect-{{ section.id }}">Shrujan <em>online</em></h2>
    <p class="stx__lede">For pieces, visits and collaborations, get in touch with the studio. Follow the work and the people behind it.</p>
  </header>
  <div class="fux__links">
  {% for block in section.blocks %}
    <a class="fux__link" href="{{ block.settings.url | escape }}"{% unless block.settings.url contains 'mailto:' or block.settings.url contains 'tel:' %} target="_blank" rel="noopener noreferrer"{% endunless %} {{ block.shopify_attributes }}>
      <span><strong>{{ block.settings.title | escape }}</strong><span>{{ block.settings.detail | escape }}</span></span>
      <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i>
    </a>
  {% endfor %}
  </div>
  <p class="fux__note">Studio hours: 10 AM to 7 PM. Please call your chosen store before travelling to confirm opening hours.</p>
</section>
<style>
.fux { padding-top: 0; }
.fux__links { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); border-top:1px solid var(--hairline); border-left:1px solid var(--hairline); }
.fux__link { display:flex; align-items:center; justify-content:space-between; gap:20px; padding:clamp(22px,3vw,38px); color:var(--ink); text-decoration:none; border-right:1px solid var(--hairline); border-bottom:1px solid var(--hairline); transition:background .2s; }
.fux__link:hover { background:var(--ivory-2); }
.fux__link:focus-visible { outline:2px solid var(--indigo); outline-offset:-4px; }
.fux__link strong { display:block; font:400 var(--fs-xl)/1.3 var(--font-display); }
.fux__link span span { display:block; margin-top:8px; font:400 var(--fs-sm)/1.6 var(--font-sans); color:var(--ink-soft); overflow-wrap:anywhere; }
.fux__note { margin-top:24px; font:400 var(--fs-sm)/1.7 var(--font-sans); color:var(--ink-soft); }
@media(max-width:900px) { .fux__links { grid-template-columns:repeat(2,minmax(0,1fr)); } }
@media(max-width:540px) { .fux__links { grid-template-columns:1fr; } }
</style>
{% endif %}
