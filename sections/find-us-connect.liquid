{{ 'sj-live-find-us.css' | asset_url | stylesheet_tag }}
<section class="sj-live-find-us stx fux" aria-labelledby="find-us-connect-{{ section.id }}">
  <header class="stx__head">
    <p class="stx__eyebrow">Stay in touch</p>
    <h2 class="stx__title" id="find-us-connect-{{ section.id }}">Shrujan <em>online</em></h2>
    <p class="stx__lede">For pieces, visits and collaborations, get in touch with the studio. Follow the work and the people behind it.</p>
  </header>
  <div class="fux__links">
  {% for block in section.blocks %}
    <a class="fux__link" href="{{ block.settings.url | escape }}"{% unless block.settings.url contains 'mailto:' or block.settings.url contains 'tel:' %} target="_blank" rel="noopener noreferrer"{% endunless %} {{ block.shopify_attributes }}>
      <div><strong>{{ block.settings.title | escape }}</strong><div class="fux__detail">{{ block.settings.detail | escape }}</div></div>
      <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i>
    </a>
  {% endfor %}
  {% if section.blocks.size == 0 %}
    {% assign contacts = 'Instagram|@shrujanindia|https://www.instagram.com/shrujanindia/~Facebook|Shrujan India|https://www.facebook.com/shrujanindia~Pinterest|Shrujan Creations|https://www.pinterest.com/shrujancreations/~WhatsApp|+91 9099 974319|https://api.whatsapp.com/send?phone=919099974319~Email|marketing@shrujan.com|mailto:marketing@shrujan.com~Call the studio|+91 90818 99882|tel:+919081899882' | split: '~' %}
    {% for contact in contacts %}
      {% assign fields = contact | split: '|' %}
      <a class="fux__link" href="{{ fields[2] | escape }}"{% unless fields[2] contains 'mailto:' or fields[2] contains 'tel:' %} target="_blank" rel="noopener noreferrer"{% endunless %}>
        <div><strong>{{ fields[0] | escape }}</strong><div class="fux__detail">{{ fields[1] | escape }}</div></div>
        <i class="sj-i sj-i--arrow-right ms" aria-hidden="true"></i>
      </a>
    {% endfor %}
  {% endif %}
  </div>
  <p class="fux__note">Studio hours: 10 AM to 7 PM. Please call your chosen store before travelling to confirm opening hours.</p>
</section>
{% schema %}
{
  "name": "Find Us — Connect",
  "settings": [],
  "blocks": [
    {
      "type": "link",
      "name": "Contact or social link",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Description"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Find Us — Connect",
      "blocks": [
        {
          "type": "link",
          "settings": {
            "title": "Instagram",
            "detail": "@shrujanindia",
            "url": "https://www.instagram.com/shrujanindia/"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Facebook",
            "detail": "Shrujan India",
            "url": "https://www.facebook.com/shrujanindia"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Pinterest",
            "detail": "Shrujan Creations",
            "url": "https://www.pinterest.com/shrujancreations/"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "WhatsApp",
            "detail": "+91 9099 974319",
            "url": "https://api.whatsapp.com/send?phone=919099974319"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Email",
            "detail": "marketing@shrujan.com",
            "url": "mailto:marketing@shrujan.com"
          }
        },
        {
          "type": "link",
          "settings": {
            "title": "Call the studio",
            "detail": "+91 90818 99882",
            "url": "tel:+919081899882"
          }
        }
      ]
    }
  ],
  "class": "sj-live-find-us-page"
}
{% endschema %}
