<div class="page">
  <header class="page-hero page-hero--ghost" data-reveal>
    <span class="page-hero__ghost" aria-hidden="true">Avinya</span>

    <div class="container page-hero__grid">
      <div class="page-hero__text">
        <p class="eyebrow">Studio Collection · Avinya</p>
        <h1 class="page-hero__title">Avinya — change, and <em>new beginnings</em></h1>
        <p class="page-hero__lede">A collaboration between Shrujan and the LLDC that brings the artisans of Kutch together to make original work, rooted in their own perspective and their own hand.</p>
        <ul class="page-meta">
          <li><span class="page-meta__value">2–3</span><span class="page-meta__label">Artisans per team</span></li>
          <li><span class="page-meta__value">12</span><span class="page-meta__label">Craft traditions</span></li>
          <li><span class="page-meta__value">1969</span><span class="page-meta__label">Building since</span></li>
        </ul>
      </div>
    </div>
  </header>

  <nav class="strands" aria-label="Studio Collection">
    <div class="container strands__inner">
      <ol class="strands__list">
        <li>
          <a href="/pages/studio-heritage" class="strands__link">
            <span class="strands__no">01</span>
            <span class="strands__label">Heritage</span>
          </a>
        </li>
        <li>
          <a href="/pages/studio-avinya" class="strands__link is-active" aria-current="page">
            <span class="strands__no">02</span>
            <span class="strands__label">Avinya</span>
          </a>
        </li>
        <li>
          <a href="/pages/studio-gifting" class="strands__link">
