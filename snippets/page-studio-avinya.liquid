  <section class="section container enquiry" id="avinya-enquiry">
    <div class="enquiry__intro" data-reveal>
      <p class="eyebrow">Enquire</p>
      <h2 class="section-title">Commission an Avinya work</h2>
      <p class="enquiry__copy">Avinya pieces are made in small numbers and released as the teams finish them. Leave your details and we will call when the next works come off the frame.</p>

      <dl class="enquiry__reach">
        <div>
          <dt>Call</dt>
          <dd>
            <a href="tel:+919099974319">+91 9099 974319</a>
          </dd>
        </div>
        <div>
          <dt>Write</dt>
          <dd>
            <a href="mailto:marketing@shrujan.com">marketing@shrujan.com</a>
          </dd>
        </div>
        <div>
          <dt>Studio hours</dt>
          <dd>10 AM – 7 PM, Bhuj</dd>
        </div>
      </dl>
    </div>

    <form class="enquiry__form" data-reveal>
      <p class="field">
        <label for="avinya-enquiry-name">Name <span aria-hidden="true">*</span></label>
        <input id="avinya-enquiry-name" name="name" type="text" required autocomplete="name">
      </p>

      <p class="field">
        <label for="avinya-enquiry-phone">Contact number <span aria-hidden="true">*</span></label>
        <input id="avinya-enquiry-phone" name="phone" type="tel" required autocomplete="tel">
      </p>

      <p class="field">
        <label for="avinya-enquiry-city">City</label>
        <input id="avinya-enquiry-city" name="city" type="text" autocomplete="address-level2">
      </p>

      <p class="field">
        <label for="avinya-enquiry-email">Email</label>
        <input id="avinya-enquiry-email" name="email" type="email" autocomplete="email">
      </p>

      <p class="field field--wide">
        <label for="avinya-enquiry-looking">What are you looking for?</label>
        <textarea id="avinya-enquiry-looking" name="looking" rows="3"></textarea>
      </p>

      <p class="field">
        <label for="avinya-enquiry-slot">Preferred time slot</label>
        <select id="avinya-enquiry-slot" name="slot">
          <option value="" disabled selected>Choose a time</option>
          <option value="9:00 AM">9:00 AM</option>
          <option value="9:30 AM">9:30 AM</option>
          <option value="10:00 AM">10:00 AM</option>
          <option value="10:30 AM">10:30 AM</option>
          <option value="11:00 AM">11:00 AM</option>
          <option value="11:30 AM">11:30 AM</option>
          <option value="12:00 PM">12:00 PM</option>
          <option value="12:30 PM">12:30 PM</option>
          <option value="1:00 PM">1:00 PM</option>
          <option value="1:30 PM">1:30 PM</option>
          <option value="2:00 PM">2:00 PM</option>
          <option value="2:30 PM">2:30 PM</option>
          <option value="3:00 PM">3:00 PM</option>
          <option value="3:30 PM">3:30 PM</option>
          <option value="4:00 PM">4:00 PM</option>
          <option value="4:30 PM">4:30 PM</option>
          <option value="5:00 PM">5:00 PM</option>
          <option value="5:30 PM">5:30 PM</option>
        </select>
      </p>

      <div class="enquiry__submit">
        <button class="btn" type="submit">Request a callback <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></button>
        <span class="enquiry__note"><span aria-hidden="true">*</span> Required. We only use these details to call you back.</span>
      </div>
    </form>
  </section>
</div>

<script>
(function () {
  var root = document.getElementById('avinya-enquiry');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var form = root.querySelector('.enquiry__form');
  if (!form) return;

  var arrow = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>';

  var done = document.createElement('div');
  done.className = 'enquiry__done';
  done.setAttribute('role', 'status');
  done.setAttribute('data-reveal', '');
  done.innerHTML =
    '<p class="enquiry__done-title">Thank you — we have your request.</p>' +
    '<p>Someone from the Bhuj studio will call you in your chosen slot. If it is urgent, reach us on <a href="tel:+919099974319">+91 9099 974319</a>.</p>' +
    '<button class="arrow-link" type="button">Send another enquiry ' + arrow + '</button>';

  done.querySelector('button').addEventListener('click', function () {
    form.reset();
    done.replaceWith(form);
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    form.replaceWith(done);
  });
})();
</script>
