<section class="section container manifesto" id="promise">
  <div class="section-intro" data-reveal>
    <p class="eyebrow">The future of heritage is here</p>
    <h2 class="section-title">
      Craft that cares: <em>four promises</em> in every piece
    </h2>
    <p class="section-intro__copy">
      Living embroidery, natural cloth and honest making, held to the same four standards since 1969.
    </p>
  </div>

  <ol class="manifesto__grid" data-reveal-child>
    <li class="seal">
      <span class="seal__no">01</span>

      <span class="seal__ring">
        <img src="{{ 'top-right.webp' | asset_url }}" alt="Close crop of mirror-work embroidery in crimson and gold threads" loading="lazy">
      </span>

      <h3 class="seal__title">Hand Embroidery</h3>
      <p class="seal__copy">Every motif counted and stitched by hand. No machine ever touches the cloth.</p>
    </li>
    <li class="seal">
      <span class="seal__no">02</span>

      <span class="seal__ring">
        <img src="{{ 'frame-r5t15.webp' | asset_url }}" alt="Close crop of turquoise Kutchi mirror-work embroidery" loading="lazy">
      </span>

      <h3 class="seal__title">Natural Dyes</h3>
      <p class="seal__copy">Madder, indigo and pomegranate on handloom cotton and mulberry silk.</p>
    </li>
    <li class="seal">
      <span class="seal__no">03</span>

      <span class="seal__ring">
        <img src="{{ 'bottom-left.webp' | asset_url }}" alt="Master weaver working threads at his handloom" loading="lazy">
      </span>

      <h3 class="seal__title">Fair Wages</h3>
      <p class="seal__copy">Paid per piece, on time, directly to the woman whose hands made it.</p>
    </li>
    <li class="seal">
      <span class="seal__no">04</span>

      <span class="seal__ring">
        <img src="{{ 'bottom-right.webp' | asset_url }}" alt="Model in a mehendi-green hand-embroidered kurta set" loading="lazy">
      </span>

      <h3 class="seal__title">Made to Last</h3>
      <p class="seal__copy">Finished to be worn today, repaired for free, and handed down tomorrow.</p>
    </li>
  </ol>

  <div class="manifesto__more" data-reveal>
    <a class="arrow-link" href="#craft">
      How we make it <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>
    </a>
  </div>
</section>
