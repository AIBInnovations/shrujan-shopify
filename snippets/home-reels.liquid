<section class="section reels" id="reels" aria-label="Shrujan in motion">
  <div class="container">
    <div class="reels__head">
      <div class="reels__titles" data-reveal>
        <p class="eyebrow">Shrujan in Motion</p>
        <h2 class="section-title">
          Watch the craft
          <br>
          <em>come alive</em>
        </h2>
      </div>

      <a
        class="reels__seal-link"
        href="https://www.instagram.com/shrujanindia/reels/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Watch Shrujan reels on Instagram"
      >
        <span class="reels__seal" aria-hidden="true">
          <svg viewBox="0 0 120 120">
            <defs>
              <path id="reel-arc" d="M60,60 m-44,0 a44,44 0 1,1 88,0 a44,44 0 1,1 -88,0"></path>
            </defs>
            <text>
              <textPath href="#reel-arc" startOffset="0">WATCH THE CRAFT · SHRUJAN IN MOTION ·</textPath>
            </text>
          </svg>
        </span>
        <span class="reels__seal-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <rect x="3.5" y="3.5" width="17" height="17" rx="5"></rect>
            <circle cx="12" cy="12" r="3.9"></circle>
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none"></circle>
          </svg>
        </span>
      </a>

      <div class="reels__note" data-reveal>
        <p>
          Forty seconds inside the workshop: a needle counting threads, madder boiling, a sari taking its first drape.
        </p>
      </div>
    </div>
  </div>

  <div class="reels__rail-wrap">
    <div class="reels__rail" data-reveal-child>
      <a class="reel" href="https://www.instagram.com/shrujanindia/reels/" target="_blank" rel="noopener noreferrer">
        <div class="reel__media">
          <video src="{{ 'reel-1.mp4' | asset_url }}" poster="{{ 'reel-1-poster.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Indigo mirror-work jacket"></video>
          <span class="reel__scrim" aria-hidden="true"></span>
          <span class="reel__meta">0:27</span>
        </div>
        <p class="reel__title">Indigo mirror-work jacket</p>
      </a>
      <a class="reel" href="https://www.instagram.com/shrujanindia/reels/" target="_blank" rel="noopener noreferrer">
        <div class="reel__media">
          <video src="{{ 'reel-2.mp4' | asset_url }}" poster="{{ 'reel-2-poster.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Coral Kutchi embroidered sari"></video>
          <span class="reel__scrim" aria-hidden="true"></span>
          <span class="reel__meta">0:33</span>
        </div>
        <p class="reel__title">Coral Kutchi embroidered sari</p>
      </a>
      <a class="reel" href="https://www.instagram.com/shrujanindia/reels/" target="_blank" rel="noopener noreferrer">
        <div class="reel__media">
          <video src="{{ 'reel-3.mp4' | asset_url }}" poster="{{ 'reel-3-poster.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Sheer embroidered kurta"></video>
          <span class="reel__scrim" aria-hidden="true"></span>
          <span class="reel__meta">0:32</span>
        </div>
        <p class="reel__title">Sheer embroidered kurta</p>
      </a>
      <a class="reel" href="https://www.instagram.com/shrujanindia/reels/" target="_blank" rel="noopener noreferrer">
        <div class="reel__media">
          <video src="{{ 'reel-4.mp4' | asset_url }}" poster="{{ 'reel-4-poster.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Shrujan, since 1969"></video>
          <span class="reel__scrim" aria-hidden="true"></span>
          <span class="reel__meta">0:11</span>
        </div>
        <p class="reel__title">Shrujan, since 1969</p>
      </a>
      <a class="reel" href="https://www.instagram.com/shrujanindia/reels/" target="_blank" rel="noopener noreferrer">
        <div class="reel__media">
          <video src="{{ 'reel-5.mp4' | asset_url }}" poster="{{ 'reel-5-poster.jpg' | asset_url }}" muted loop playsinline preload="none" aria-label="Turquoise Kutchi sari"></video>
          <span class="reel__scrim" aria-hidden="true"></span>
          <span class="reel__meta">0:30</span>
        </div>
        <p class="reel__title">Turquoise Kutchi sari</p>
      </a>
    </div>
  </div>
</section>

<script>
(function () {
  var root = document.querySelector('.reels');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  /* Play only what's on screen — five autoplaying videos at once is wasteful. */
  var rail = root.querySelector('.reels__rail');
  if (rail && 'IntersectionObserver' in window) {
    var io = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          var v = entry.target;
          if (entry.isIntersecting) v.play().catch(function () {});
          else v.pause();
        });
      },
      { threshold: 0.35 }
    );
    rail.querySelectorAll('video').forEach(function (v) { io.observe(v); });
  }

  var mm = gsap.matchMedia();

  mm.add('(prefers-reduced-motion: no-preference)', function () {
    gsap.fromTo(
      root.querySelector('.reels__seal'),
      { rotation: -60 },
      {
        rotation: 120,
        ease: 'none',
        scrollTrigger: { trigger: root, start: 'top bottom', end: 'bottom top', scrub: 0.6 }
      }
    );
  });
})();
</script>
