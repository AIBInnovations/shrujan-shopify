<script>
(function () {
  var root = document.querySelector('.shop-body');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var page = root.closest('.page') || document;
  var SHRUJAN = window.SHRUJAN;

  /* Filter by COLLECTION, not craft — collection is what the live site
     organises by, and every product carries a real one. */
  var ALL = 'Everything';

  var SORTS = [
    { key: 'featured', label: 'Featured' },
    { key: 'price-asc', label: 'Price, low to high' },
    { key: 'price-desc', label: 'Price, high to low' },
    { key: 'name', label: 'Name, A–Z' }
  ];

  /* '₹ 25,000' -> 25000, so the price sorts numerically rather than as text */
  function priceValue(p) { return Number(String(p.price).replace(/[^0-9.]/g, '')) || 0; }

  /* a rotating tint, so grids carry colour of their own rather than reading as
     rectangles on flat ivory */
  var TINTS = ['var(--ivory-2)', 'var(--gerua-100)', 'var(--mehendi-200)', 'var(--sand)'];

  var collections = [ALL];
  SHRUJAN.PIECES.forEach(function (p) {
    if (p.collection && collections.indexOf(p.collection) === -1) collections.push(p.collection);
  });

  /* the URL is the source of truth, so a header link lands on the right filter */
  function readActive() {
    var key = new URLSearchParams(location.search).get('c');
    for (var i = 0; i < collections.length; i++) {
      if (SHRUJAN.collectionKey(collections[i]) === key) return collections[i];
    }
    return ALL;
  }

  var active = ALL;
  var sort = 'featured';

  var catRail = page.querySelector('.shop-cats__rail');
  var medallions = Array.prototype.slice.call(page.querySelectorAll('.shop-cats__rail .medallion'));
  var arrowBtns = page.querySelectorAll('.shop-cats__arrows button');
  var railButtons = Array.prototype.slice.call(root.querySelectorAll('.shop-rail__item'));
  var countEl = root.querySelector('.shop-main__count');
  var shopMain = root.querySelector('.shop-main');
  var sortWrap = root.querySelector('.shop-sort');
  var listEl = root.querySelector('.shop-grid');
  var clearBtn = null;

  var HEART_16 = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19.8S4.5 15.3 4.5 9.9c0-2.6 2-4.4 4.2-4.4 1.5 0 2.7.8 3.3 2 .6-1.2 1.8-2 3.3-2 2.2 0 4.2 1.8 4.2 4.4 0 5.4-7.5 9.9-7.5 9.9Z"></path></svg>';

  function cardHtml(p, i) {
    var html = '<a class="piece shop-piece" href="/products/' + SHRUJAN.productSlug(p) + '">';
    html += '<div class="piece__media" style="--tint: ' + TINTS[i % TINTS.length] + '">';
    html += '<img src="' + SHRUJAN.asset(p.img) + '" alt="' + p.alt + '" loading="lazy">';
    if (p.badge) html += '<span class="piece__badge">' + p.badge + '</span>';
    html += '<button class="piece__wish" type="button" aria-label="Save ' + p.name + ' to wishlist">' + HEART_16 + '</button>';
    html += '<span class="piece__quick">Add to bag</span>';
    html += '</div>';
    html += '<div class="piece__info">';
    html += '<p class="piece__name">' + p.name + '</p>';
    html += '<p class="piece__craft">' + p.craft + '</p>';
    html += '<p class="piece__price">' + p.price + (p.was ? '<span>' + p.was + '</span>' : '') + '</p>';
    var swatches = '';
    p.swatches.forEach(function (c) { swatches += '<i style="background: ' + c + '"></i>'; });
    html += '<span class="piece__swatches" aria-hidden="true">' + swatches + '</span>';
    html += '</div>';
    html += '</a>';
    return html;
  }

  function shownList() {
    var list = active === ALL
      ? SHRUJAN.PIECES
      : SHRUJAN.PIECES.filter(function (p) { return p.collection === active; });
    if (sort === 'featured') return list;
    var out = list.slice(); /* never sort the source array in place */
    if (sort === 'price-asc') out.sort(function (a, b) { return priceValue(a) - priceValue(b); });
    if (sort === 'price-desc') out.sort(function (a, b) { return priceValue(b) - priceValue(a); });
    if (sort === 'name') out.sort(function (a, b) { return a.name.localeCompare(b.name); });
    return out;
  }

  function render() {
    var shown = shownList();

    countEl.textContent =
      shown.length + ' ' + (shown.length === 1 ? 'piece' : 'pieces') + (active !== ALL ? ' in ' + active : '');

    if (active !== ALL) {
      if (!clearBtn) {
        clearBtn = document.createElement('button');
        clearBtn.type = 'button';
        clearBtn.className = 'shop-main__clear';
        clearBtn.textContent = 'Clear filter';
        clearBtn.addEventListener('click', function () { setActive(ALL); });
        sortWrap.insertBefore(clearBtn, sortWrap.firstChild);
      }
    } else if (clearBtn) {
      sortWrap.removeChild(clearBtn);
      clearBtn = null;
    }

    railButtons.forEach(function (btn, i) {
      var on = collections[i] === active;
      btn.classList.toggle('is-active', on);
      btn.setAttribute('aria-pressed', on ? 'true' : 'false');
    });

    if (shown.length === 0) {
      var empty = document.createElement('p');
      empty.className = 'shop-main__empty';
      empty.innerHTML = 'Nothing online in this collection right now. <a href="mailto:marketing@shrujan.com?subject=Collection%20enquiry">Ask the studio</a>.';
      listEl.parentNode.replaceChild(empty, listEl);
      listEl = empty;
    } else {
      if (listEl.className.indexOf('shop-grid') === -1) {
        var grid = document.createElement('div');
        grid.className = 'curated__grid shop-grid';
        grid.setAttribute('data-reveal-child', '');
        listEl.parentNode.replaceChild(grid, listEl);
        listEl = grid;
      }
      var html = '';
      shown.forEach(function (p, i) { html += cardHtml(p, i); });
      listEl.innerHTML = html;
    }
  }

  /* the wish button sits inside the product link — its click must not navigate */
  shopMain.addEventListener('click', function (e) {
    var wish = e.target.closest ? e.target.closest('.piece__wish') : null;
    if (wish) e.preventDefault();
  });

  /* setParams({ c }, { replace: true }) — and arriving on a filter should land
     on the grid, not the masthead */
  function onParamsChange() {
    active = readActive();
    render();
    if (new URLSearchParams(location.search).get('c')) {
      var el = document.getElementById('catalogue');
      if (el) el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }

  function setActive(c) {
    var search = c === ALL ? '' : '?c=' + SHRUJAN.collectionKey(c);
    if (location.search === search) return;
    history.replaceState(null, '', location.pathname + search);
    onParamsChange();
  }

  railButtons.forEach(function (btn, i) {
    btn.addEventListener('click', function () { setActive(collections[i]); });
  });

  medallions.forEach(function (btn, i) {
    btn.addEventListener('click', function () { setActive(collections[i + 1]); });
  });

  function pageRail(dir) {
    var rail = catRail;
    if (!rail) return;
    rail.scrollBy({ left: dir * rail.clientWidth * 0.8, behavior: 'smooth' });
  }
  if (arrowBtns[0]) arrowBtns[0].addEventListener('click', function () { pageRail(-1); });
  if (arrowBtns[1]) arrowBtns[1].addEventListener('click', function () { pageRail(1); });

  /* SortMenu — a listbox built from scratch so it can be styled, with the
     keyboard behaviour a select gives you for free put back by hand: arrows
     to move, enter to pick, escape to close, and a click anywhere outside
     to dismiss. */
  var menu = root.querySelector('.sortmenu');
  var menuButton = menu.querySelector('.sortmenu__button');
  var menuValue = menu.querySelector('.sortmenu__value');
  var optionEls = Array.prototype.slice.call(menu.querySelectorAll('.sortmenu__option'));
  var open = false;
  var cursor = 0;

  function outside(e) {
    if (!menu.contains(e.target)) setOpen(false);
  }
  function esc(e) {
    if (e.key === 'Escape') setOpen(false);
  }

  function setOpen(v) {
    if (open === v) return;
    open = v;
    menu.classList.toggle('is-open', open);
    menuButton.setAttribute('aria-expanded', open ? 'true' : 'false');
    if (open) {
      document.addEventListener('pointerdown', outside);
      document.addEventListener('keydown', esc);
    } else {
      document.removeEventListener('pointerdown', outside);
      document.removeEventListener('keydown', esc);
    }
  }

  function setCursor(i) {
    cursor = i;
    optionEls.forEach(function (el, j) { el.classList.toggle('is-cursor', j === cursor); });
  }

  function selectedIndex() {
    for (var i = 0; i < SORTS.length; i++) if (SORTS[i].key === sort) return i;
    return 0;
  }

  function currentSort() {
    for (var i = 0; i < SORTS.length; i++) if (SORTS[i].key === sort) return SORTS[i];
    return SORTS[0];
  }

  function renderMenu() {
    menuValue.textContent = currentSort().label;
    optionEls.forEach(function (el, i) {
      var selected = SORTS[i].key === sort;
      el.classList.toggle('is-selected', selected);
      el.setAttribute('aria-selected', selected ? 'true' : 'false');
    });
  }

  function pick(key) {
    sort = key;
    renderMenu();
    render();
    setOpen(false);
  }

  menuButton.addEventListener('click', function () {
    setCursor(selectedIndex());
    setOpen(!open);
  });

  menuButton.addEventListener('keydown', function (e) {
    if (!open) {
      if (e.key === 'ArrowDown' || e.key === 'ArrowUp' || e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        setCursor(selectedIndex());
        setOpen(true);
      }
      return;
    }
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      setCursor((cursor + 1) % SORTS.length);
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      setCursor((cursor - 1 + SORTS.length) % SORTS.length);
    } else if (e.key === 'Enter' || e.key === ' ') {
      e.preventDefault();
      pick(SORTS[cursor].key);
    } else if (e.key === 'Tab') {
      setOpen(false);
    }
  });

  optionEls.forEach(function (el, i) {
    el.addEventListener('pointerenter', function () { setCursor(i); });
    el.addEventListener('click', function () { pick(SORTS[i].key); });
  });

  /* initial state from the URL (?c=), exactly as useSearchParams reads it on mount */
  onParamsChange();
})();
</script>
