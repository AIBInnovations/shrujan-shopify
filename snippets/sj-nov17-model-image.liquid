      assign model_sku = 'SHWL1330012200028'
    when 'pista-handwoven-merino-wool-shawl-with-soof-embroidery'
      assign model_sku = 'SHWL0000012600043'
    when 'sky-blue-handwoven-merino-wool-shawl-with-sodha-mix-embroidery'
