    when 'black-handwoven-merino-wool-shawl-with-soof-embroidery'
      assign model_sku = 'SHWL0000012500071'
    when 'dark-olive-green-handwoven-merino-wool-shawl-with-neran-embroidery'
      assign model_sku = 'SHWL0000012500097'
    when 'dark-olive-green-handwoven-merino-wool-shawl-with-sodha-mix-embroidery'
      assign model_sku = 'SHWL0000012500149'
    when 'dark-purple-handwoven-merino-wool-shawl-with-sodha-mix-embroidery'
      assign model_sku = 'SHWL0000012500143'
    when 'dark-sea-blue-handwoven-merino-wool-shawl-with-neran-embroidery'
      assign model_sku = 'SHWL0000012500135'
    when 'light-lavender-handwoven-merino-wool-shawl-with-soof-embroidery'
      assign model_sku = 'SHWL0000012500095'
    when 'magenta-handwoven-merino-wool-shawl-with-soof-embroidery'
