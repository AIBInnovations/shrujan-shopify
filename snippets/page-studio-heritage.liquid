    <form class="enquiry__form" data-reveal>
      <p class="field">
        <label for="heritage-enquiry-name">Name <span aria-hidden="true">*</span></label>
        <input id="heritage-enquiry-name" name="name" type="text" required autocomplete="name">
      </p>

      <p class="field">
        <label for="heritage-enquiry-phone">Contact number <span aria-hidden="true">*</span></label>
