<script>
(function () {
  var root = document.getElementById('heritage-enquiry');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var form = root.querySelector('.enquiry__form');
  if (!form) return;

  var arrow = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>';

  var done = document.createElement('div');
  done.className = 'enquiry__done';
  done.setAttribute('role', 'status');
  done.setAttribute('data-reveal', '');
  done.innerHTML =
    '<p class="enquiry__done-title">Thank you — we have your request.</p>' +
    '<p>Someone from the Bhuj studio will call you in your chosen slot. If it is urgent, reach us on <a href="tel:+919099974319">+91 9099 974319</a>.</p>' +
    '<button class="arrow-link" type="button">Send another enquiry ' + arrow + '</button>';

  done.querySelector('button').addEventListener('click', function () {
    form.reset();
    done.replaceWith(form);
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    form.replaceWith(done);
  });
})();
</script>
