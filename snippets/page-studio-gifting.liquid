<div class="page">
  <header class="page-hero page-hero--plain" data-reveal>
    <div class="container page-hero__grid">
      <div class="page-hero__text">
        <p class="eyebrow">Studio Collection · Gifting &amp; Collaborations</p>
        <h1 class="page-hero__title">Gifts that carry a craft, and <em>a name</em></h1>
        <p class="page-hero__lede">We work with organisations and individuals to create refined handcrafted gifts that reflect care, craft and cultural meaning.</p>
        <ul class="page-meta">
          <li><span class="page-meta__value">25+</span><span class="page-meta__label">Minimum order</span></li>
          <li><span class="page-meta__value">4–12</span><span class="page-meta__label">Weeks to deliver</span></li>
          <li><span class="page-meta__value">40</span><span class="page-meta__label">Villages at work</span></li>
        </ul>
      </div>
    </div>

    <figure class="container page-hero__media" data-parallax>
      <img src="{{ 'shop-hero.webp' | asset_url }}" alt="An embroidered tote, potli and cushion beside models in Kutchi dupattas" fetchpriority="high">
    </figure>
  </header>

  <nav class="strands" aria-label="Studio Collection">
    <div class="container strands__inner">
      <ol class="strands__list">
        <li>
          <a href="/pages/studio-heritage" class="strands__link">
            <span class="strands__no">01</span>
            <span class="strands__label">Heritage</span>
          </a>
        </li>
        <li>
          <a href="/pages/studio-avinya" class="strands__link">
            <span class="strands__no">02</span>
            <span class="strands__label">Avinya</span>
          </a>
        </li>
        <li>
          <a href="/pages/studio-gifting" class="strands__link is-active" aria-current="page">
            <span class="strands__no">03</span>
            <span class="strands__label">Gifting &amp; Collaborations</span>
          </a>
        </li>
      </ol>
    </div>
  </nav>

  <section class="section container">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">Three ways to work with us</p>
      <h2 class="section-title">From a hundred pouches to a single commission</h2>
    </div>

    <div class="studio">
      <article class="studio-row" data-reveal>
        <div class="studio-row__media">
          <img src="{{ 'sj-jat-garasiya-mobile-pouch-31-1.webp' | asset_url }}" alt="Hand-embroidered mobile pouches in Jat Garasiya work" loading="lazy">
        </div>

        <div class="studio-row__body">
          <span class="studio-row__no" aria-hidden="true">01</span>
          <h3 class="studio-row__name">Corporate &amp; Institutional Gifting</h3>
          <p class="studio-row__copy">Meaningful, high-quality gifts rooted in craft, for organisations marking a milestone, a partnership or an occasion. Chosen for craftsmanship and cultural integrity, so the gift carries depth as well as value.</p>

          <ul class="studio-row__facts">
            <li>From 25 pieces</li>
            <li>4–8 weeks</li>
            <li>Presentation packaging</li>
          </ul>

          <a class="arrow-link studio-row__link" href="#gifting-enquiry">Enquire about this</a>
        </div>
      </article>
      <article class="studio-row" data-reveal>
        <div class="studio-row__media">
          <img src="{{ 'sj-jat-garasiya-party-bag-copy-1-1.webp' | asset_url }}" alt="Hand-embroidered party bags arranged together" loading="lazy">
        </div>

        <div class="studio-row__body">
          <span class="studio-row__no" aria-hidden="true">02</span>
          <h3 class="studio-row__name">Wedding &amp; Occasion Gifting</h3>
          <p class="studio-row__copy">Handcrafted pieces chosen for celebrations — for how they look, and for the artisan skill and the story they carry with them.</p>

          <ul class="studio-row__facts">
            <li>From 50 pieces</li>
            <li>6–10 weeks</li>
            <li>Custom colourways</li>
          </ul>

          <a class="arrow-link studio-row__link" href="#gifting-enquiry">Enquire about this</a>
        </div>
      </article>
      <article class="studio-row" data-reveal>
        <div class="studio-row__media">
          <img src="{{ 'sj-handloom-weaving-cushion-cover-5-1.webp' | asset_url }}" alt="Handloom cushion covers in natural dyed cotton" loading="lazy">
        </div>

        <div class="studio-row__body">
          <span class="studio-row__no" aria-hidden="true">03</span>
          <h3 class="studio-row__name">Custom Collaborations</h3>
          <p class="studio-row__copy">Some projects call for something more specific. We take on custom commissions involving particular colours, materials or craft techniques, developed through dialogue and aligned with Shrujan’s craft values.</p>

          <ul class="studio-row__facts">
            <li>By commission</li>
            <li>12+ weeks</li>
            <li>Developed with the artisans</li>
          </ul>

          <a class="arrow-link studio-row__link" href="#gifting-enquiry">Enquire about this</a>
        </div>
      </article>
    </div>
  </section>

  <section class="section container">
    <div class="section-intro" data-reveal>
      <p class="eyebrow">How an order runs</p>
      <h2 class="section-title">Brief to delivery, start to finish</h2>
    </div>

    <ol class="steps" data-reveal-child>
      <li class="step">
        <span class="step__no">01</span>
        <div class="step__body">
          <h3 class="step__title">The brief</h3>
          <p class="step__copy">Numbers, budget, occasion and how long you have. We will tell you honestly what is possible in the time.</p>
        </div>
      </li>
      <li class="step">
        <span class="step__no">02</span>
        <div class="step__body">
          <h3 class="step__title">Selection</h3>
          <p class="step__copy">We put a shortlist together from the crafts that suit the brief, with samples where the order justifies them.</p>
        </div>
      </li>
      <li class="step">
        <span class="step__no">03</span>
        <div class="step__body">
          <h3 class="step__title">The making</h3>
          <p class="step__copy">The order goes to the villages best suited to it. Artisans are paid per piece, on time, for every unit made.</p>
        </div>
      </li>
      <li class="step">
        <span class="step__no">04</span>
        <div class="step__body">
          <h3 class="step__title">Delivery</h3>
          <p class="step__copy">Packed, documented and shipped — with a card naming the craft and the community behind the piece.</p>
        </div>
      </li>
    </ol>

    <blockquote class="origin__pull" data-reveal>A gift that names the woman who made it says something a logo cannot.</blockquote>
  </section>

  <section class="section container enquiry" id="gifting-enquiry">
    <div class="enquiry__intro" data-reveal>
      <p class="eyebrow">Enquire</p>
      <h2 class="section-title">Start a gifting conversation</h2>
      <p class="enquiry__copy">Tell us the occasion, the numbers and the date you need them by. We will come back with what the crafts can do in that time.</p>

      <dl class="enquiry__reach">
        <div>
          <dt>Call</dt>
          <dd>
            <a href="tel:+919099974319">+91 9099 974319</a>
          </dd>
        </div>
        <div>
          <dt>Write</dt>
          <dd>
            <a href="mailto:marketing@shrujan.com">marketing@shrujan.com</a>
          </dd>
        </div>
        <div>
          <dt>Studio hours</dt>
          <dd>10 AM – 7 PM, Bhuj</dd>
        </div>
      </dl>
    </div>

    <form class="enquiry__form" data-reveal>
      <p class="field">
        <label for="gifting-enquiry-name">Name <span aria-hidden="true">*</span></label>
        <input id="gifting-enquiry-name" name="name" type="text" required autocomplete="name">
      </p>

      <p class="field">
        <label for="gifting-enquiry-phone">Contact number <span aria-hidden="true">*</span></label>
        <input id="gifting-enquiry-phone" name="phone" type="tel" required autocomplete="tel">
      </p>

      <p class="field">
        <label for="gifting-enquiry-city">City</label>
        <input id="gifting-enquiry-city" name="city" type="text" autocomplete="address-level2">
      </p>

      <p class="field">
        <label for="gifting-enquiry-email">Email</label>
        <input id="gifting-enquiry-email" name="email" type="email" autocomplete="email">
      </p>

      <p class="field">
        <label for="gifting-enquiry-extra">Quantity and occasion</label>
        <input id="gifting-enquiry-extra" name="extra" type="text" placeholder="150 pieces, Diwali">
      </p>

      <p class="field field--wide">
        <label for="gifting-enquiry-looking">What are you looking for?</label>
        <textarea id="gifting-enquiry-looking" name="looking" rows="3"></textarea>
      </p>

      <p class="field">
        <label for="gifting-enquiry-slot">Preferred time slot</label>
        <select id="gifting-enquiry-slot" name="slot">
          <option value="" disabled selected>Choose a time</option>
          <option value="9:00 AM">9:00 AM</option>
          <option value="9:30 AM">9:30 AM</option>
          <option value="10:00 AM">10:00 AM</option>
          <option value="10:30 AM">10:30 AM</option>
          <option value="11:00 AM">11:00 AM</option>
          <option value="11:30 AM">11:30 AM</option>
          <option value="12:00 PM">12:00 PM</option>
          <option value="12:30 PM">12:30 PM</option>
          <option value="1:00 PM">1:00 PM</option>
          <option value="1:30 PM">1:30 PM</option>
          <option value="2:00 PM">2:00 PM</option>
          <option value="2:30 PM">2:30 PM</option>
          <option value="3:00 PM">3:00 PM</option>
          <option value="3:30 PM">3:30 PM</option>
          <option value="4:00 PM">4:00 PM</option>
          <option value="4:30 PM">4:30 PM</option>
          <option value="5:00 PM">5:00 PM</option>
          <option value="5:30 PM">5:30 PM</option>
        </select>
      </p>

      <div class="enquiry__submit">
        <button class="btn" type="submit">Request a callback <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg></button>
        <span class="enquiry__note"><span aria-hidden="true">*</span> Required. We only use these details to call you back.</span>
      </div>
    </form>
  </section>
</div>

<script>
(function () {
  var root = document.getElementById('gifting-enquiry');
  if (!root || root.__shrujanInit) return;
  root.__shrujanInit = true;

  var form = root.querySelector('.enquiry__form');
  if (!form) return;

  var arrow = '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12h15"></path><path d="m13.5 6.5 5.5 5.5-5.5 5.5"></path></svg>';

  var done = document.createElement('div');
  done.className = 'enquiry__done';
  done.setAttribute('role', 'status');
  done.setAttribute('data-reveal', '');
  done.innerHTML =
    '<p class="enquiry__done-title">Thank you — we have your request.</p>' +
    '<p>Someone from the Bhuj studio will call you in your chosen slot. If it is urgent, reach us on <a href="tel:+919099974319">+91 9099 974319</a>.</p>' +
    '<button class="arrow-link" type="button">Send another enquiry ' + arrow + '</button>';

  done.querySelector('button').addEventListener('click', function () {
    form.reset();
    done.replaceWith(form);
  });

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    form.replaceWith(done);
  });
})();
</script>
